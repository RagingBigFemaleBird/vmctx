#!/bin/sh
# Auto-fetch and load vmctx on boot, so an SSH session finds it ready.
# Runs via the openrc 'local' service. Non-fatal on any failure.
#
# The server is whichever host this diskless system got its apk repo from.
SERVER="$(awk -F/ '/http/{print $3; exit}' /etc/apk/repositories 2>/dev/null | cut -d: -f1)"

# --- Ensure sshd is actually up, independent of boot ordering / init pkg ---
# Robust even if the openrc init script subpackage is absent: generate host
# keys and launch the daemon directly.
if [ -x /usr/sbin/sshd ] || command -v sshd >/dev/null 2>&1; then
	[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
	if ! pgrep -x sshd >/dev/null 2>&1; then
		rc-service sshd start >/dev/null 2>&1 || /usr/sbin/sshd || sshd || true
	fi
	logger -t vmctx "local.d: sshd ensured up"
fi

[ -z "$SERVER" ] && exit 0
BASE="http://$SERVER:8080/vmctx"

cd /tmp || exit 0
for f in vmctx.ko dumpvm vmselftest vmmon vmremote vmmig vmhome; do
	wget -q "$BASE/$f" -O "/tmp/$f" || exit 0
done
chmod +x /tmp/dumpvm /tmp/vmselftest /tmp/vmmon /tmp/vmremote /tmp/vmmig
mkdir -p /usr/local/bin
install -m755 /tmp/dumpvm /tmp/vmselftest /tmp/vmmon /tmp/vmremote /tmp/vmmig /tmp/vmhome /usr/local/bin/
modprobe vmctx 2>/dev/null || insmod /tmp/vmctx.ko 2>/dev/null || true
logger -t vmctx "local.d: vmctx loaded from $BASE"
exit 0
