+	prev = vma_prev(&vmi);
+	if (start > vma->vm_start) prev = vma;
+	tlb_gather_mmu(&tlb, mm);
+	for_each_vma_range(vmi, vma, end) {
+		unsigned long lo = max(start, vma->vm_start);
+		unsigned long hi = min(end, vma->vm_end);
+		vm_flags_t oldflags = vma->vm_flags;
+		vm_flags_t flags = (oldflags & ~(VM_ACCESS_FLAGS | VM_FLAGS_CLEAR)) |
+			calc_vm_prot_bits(prot, 0);
