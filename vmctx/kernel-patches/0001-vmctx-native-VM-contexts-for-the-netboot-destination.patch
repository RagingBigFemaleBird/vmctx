+	if ((start & ~PAGE_MASK) || (len & ~PAGE_MASK) ||
+	    (prot & ~(PROT_READ | PROT_WRITE | PROT_EXEC)))
+		return -EINVAL;
+	if (!len) return 0;
+	end = start + len;
