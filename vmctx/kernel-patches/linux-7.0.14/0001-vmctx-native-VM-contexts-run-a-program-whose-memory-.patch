diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index 1c2dd03f1..80cc54517 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -152,6 +152,59 @@ void futex_wake_mark(struct wake_q_head *wake_q, struct futex_q *q)
 /*
  * Wake up waiters matching bitset queued on this futex (uaddr).
  */
+/*
+ * vmctx: wake every waiter on (mm, uaddr) WITHOUT being a task of that mm.
+ *
+ * A futex is memory plus a waiter queue, and only the memory travels in
+ * vmctx's page protocol: the queue is keyed to the address space and lives in
+ * whichever kernel executed the WAIT. The wake for it therefore cannot be
+ * "performed by a context" -- every live context's one assisted-call slot may
+ * legitimately be occupied by a blocked WAIT, including the very WAIT the
+ * wake must end. This performs the wake the way the waiter queue is actually
+ * keyed: on the mm, from any thread at all.
+ *
+ * Both key forms an anonymous word can be queued under are woken -- the
+ * PRIVATE form, and the shared-request-on-anonymous-page form that differs
+ * only by FUT_OFF_MMSHARED (glibc's join futexes are the second kind). The
+ * caller holds a reference on mm.
+ */
+int futex_wake_mm(struct mm_struct *mm, unsigned long addr, int nr_wake)
+{
+	union futex_key key = FUTEX_KEY_INIT;
+	int pass, woken = 0;
+
+	key.both.offset = addr % PAGE_SIZE;
+	key.private.mm = mm;
+	key.private.address = addr - key.both.offset;
+
+	for (pass = 0; pass < 2; pass++) {
+		struct futex_q *this, *next;
+		DEFINE_WAKE_Q(wake_q);
+
+		if (pass == 1)
+			key.both.offset |= FUT_OFF_MMSHARED;
+		{
+			CLASS(hb, hb)(&key);
+
+			if (!futex_hb_waiters_pending(hb))
+				continue;
+			spin_lock(&hb->lock);
+			plist_for_each_entry_safe(this, next, &hb->chain, list) {
+				if (futex_match(&this->key, &key)) {
+					if (this->pi_state || this->rt_waiter)
+						continue;
+					this->wake(&wake_q, this);
+					if (++woken >= nr_wake)
+						break;
+				}
+			}
+			spin_unlock(&hb->lock);
+			wake_up_q(&wake_q);
+		}
+	}
+	return woken;
+}
+
 int futex_wake(u32 __user *uaddr, unsigned int flags, int nr_wake, u32 bitset)
 {
 	struct futex_q *this, *next;
