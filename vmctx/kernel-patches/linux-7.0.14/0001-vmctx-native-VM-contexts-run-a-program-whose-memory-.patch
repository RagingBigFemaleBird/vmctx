+/*
+ * Address spaces that belong to a VM context, so a fault taken on one by any
+ * task can be recognised. Registered when a context starts holding a program
+ * and forgotten when it stops; a handful at a time, and only consulted for a
+ * fault on a foreign mm, which is rare.
+ */
+/*
+ * The address spaces that belong to a context, and how many contexts each one
+ * has. Every hook in this file asks this table first, so what is in it decides
+ * whether a fault on a page is asked about or silently invented.
+ *
+ * THE COUNT IS THE WHOLE POINT, and it was missing. This was a set: note()
+ * deduplicated, so four threads of one program filled one slot, and forget()
+ * -- called from vmctx_task_exit(), once per exiting CONTEXT -- cleared that
+ * slot the first time ANY of them exited. From that instant the address space
+ * was not a context's as far as this file was concerned, while its other
+ * threads were still running in it. Every hook fell through:
+ *
+ *   do_anonymous_page()  invented pages for addresses the other machine owns
+ *   do_wp_page()         stopped being counted, let alone refused
+ *   vmctx_install_single() went false, so THP and large-folio batch installs
+ *                        came back and populated whole ranges of NEIGHBOURS
+ *                        that nobody faulted on
+ *   vmctx_fault_seen()   stopped counting -- so the instrument that was
+ *                        supposed to notice went blind at the same instant,
+ *                        which is why "every fault is reported" measured clean
+ *
+ * tests/ws1 is exactly this shape: four threads, each returns, then main
+ * touches .bss on its way through exit(). Once the first worker exits, main's
+ * memory is unhooked for the rest of the run.
+ *
+ * So the slot is refcounted, incremented and decremented on precisely the
+ * events that already maintain vmctx_nr_active -- vc->active going 0->1 and
+ * 1->0 -- which is what makes the pairing exact rather than hopeful.
+ */
+/*
+ * 256, up from 64. The table overflowed on the live box (vmctx_mm_overflow=1,
+ * session 27) under an 8-way pool of fork-heavy work, and an overflowed
+ * address space is not "unhooked": every one of its fault hooks falls
+ * through, so do_anonymous_page zero-fills addresses nobody was asked about
+ * -- silent invention, the one thing this file exists to forbid. Every scan
+ * below is a pointer compare per slot; four times 64 of them costs nothing
+ * next to the fault they gate. An overflow is still counted and warned.
+ */
+#define VMCTX_MM_SLOTS 256
+/*
+ * The address space's own change log: ranges the mm-mutation hook (the mmu
+ * notifier's invalidate_range_start, event MMU_NOTIFY_UNMAP) saw VACATED,
+ * ring-buffered per mm until the monitor drains them with VMCTX_CTL_MMLOG.
+ *
+ * This exists because propagation used to be keyed on decoding syscall
+ * numbers in userspace, and a switch on syscall numbers structurally cannot
+ * enumerate every way an mm loses memory -- mremap was missing from it for
+ * the project's whole life (netsurf's exit-242 wall), MAP_FIXED's implicit
+ * unmap and brk-shrink were never in it at all. The kernel's own notifier
+ * fires for all of them, because it fires where the memory is actually
+ * released, not where a call was named.
+ *
+ * head/tail are free-running; head - tail is the fill. One refcounted notifier
+ * per mm produces each invalidation once, regardless of the context count.
+ * Repeated equal intervals must remain distinct: another mapping incarnation
+ * may occupy the same addresses. A full ring still counts lost entries; this
+ * legacy destructive log is not an acknowledged commit journal.
+ */
+#define VMCTX_MM_VACLOG 64
+#define VMCTX_ACCESS_LIMIT 65536
+struct vmctx_access_node {
+	struct list_head link;
+	struct vmctx_access_event event;
+};
+struct vmctx_mm_slot {
+	struct mm_struct *mm;
+	int n;			/* active contexts in this address space */
+	/*
+	 * Each logged event carries the mm's own event counter (seq), stamped
+	 * HERE, under the lock, at the moment the hook records it -- because
+	 * this is the only place that knows the true order of the address
+	 * space's mutations. The monitor used to stamp ranges when it DRAINED
+	 * them, and a drain is a userspace race: two connection threads pop
+	 * concurrently, the later stamp lands on the earlier event, and a
+	 * stale vacate outranks the mmap that superseded it -- the destination
+	 * then punches a live mapping (netsurf's font scan died exactly there:
+	 * munmap, re-mmap into the same hole, and the recycled range's old
+	 * vacate arrived stamped newer than the new mapping's construction).
+	 * VMCTX_CTL_MMLOG hands the seq out per entry, and `cur` -- the
+	 * counter at the drain, read under the same lock -- is the stamp a
+	 * reply's constructions carry: everything logged before that instant
+	 * has a smaller seq, and a construction's address is unpublished until
+	 * its reply, so no event that outranks it can precede the sample.
+	 */
+	struct { u64 start, end, seq; } vac[VMCTX_MM_VACLOG];
+	unsigned int vac_head, vac_tail;
+	u64 vac_seq_ctr;
+	u64 vac_dropped;
+	u64 trace_id, trace_seq;
+	struct list_head access_log;
+	struct xarray constructions;
+	u64 access_acked, access_offered;
+	u32 access_count, access_error;
+	u32 execution_running, execution_paused;
+	/*
+	 * THE PAGE RECORD (kernel #154; the uapi comment at VMCTX_PG_* says
+	 * why it lives here). One entry per page that has ever changed hands
+	 * or been claimed, indexed by page number, packed into an xarray
+	 * value: state | sum | gen | stamp -- see vmctx_pgrec_mk(). The
+	 * xarray's own lock orders every transition; the page-table action
+	 * each transition describes is made in the same mmap_read section
+	 * (SERVE, LAND) or by the faulting task itself (the claim). pg_wq
+	 * parks a fault that finds its page CLAIMED by a sibling; every
+	 * transition out of CLAIM wakes it. Kept only for a SERVICE context's
+	 * address space (rec): a guest context's memory is its object's.
+	 */
+	struct xarray pg;
+	struct xarray recalls;
+	wait_queue_head_t pg_wq;
+	bool rec;
+	/*
+	 * The thread group that SUPPLIES this address space's pages -- the
+	 * monitor's. Recorded so vmctx_fault_seen() can split "a task that is
+	 * not this mm's own faulted it" into the supplier (vmhome/vmremote's
+	 * POKE/PEEK/SERVE, the designed path) and a THIRD PARTY (a debugger,
+	 * /proc/<pid>/mem, an io_uring worker, kthread_use_mm) -- the second
+	 * kind lands whatever the local kernel invents into a context's
+	 * memory, and until this split the two were one number (10.3M per
+	 * session) a defect could hide in. A pid number, never a pointer:
+	 * the slot outlives monitors and a stale tgid misattributes at worst
+	 * one counter tick, never a use-after-free.
+	 */
+	pid_t mon_tgid;
+};
+static struct vmctx_mm_slot vmctx_mms[VMCTX_MM_SLOTS];
+static DEFINE_SPINLOCK(vmctx_mm_lock);
+static long vmctx_mm_live;	/* address spaces currently in the table       */
+static u64 vmctx_mm_trace_next;
+static bool vmctx_map_trace;
+core_param(vmctx_map_trace, vmctx_map_trace, bool, 0644);
+
+/* Diagnostic sequence within one address-space lifetime. This is deliberately
+ * separate from the old vacate counter: observations are not commit records.
+ * Called under native MM/PTE locks too; never accesses or faults guest bytes. */
+void vmctx_trace_mm(struct mm_struct *mm, const char *stage,
+		    unsigned long start, unsigned long end, unsigned long detail)
+{
+	unsigned long flags;
+	u64 id = 0, seq = 0, vac = 0;
+	int i;
+
+	if (!READ_ONCE(vmctx_map_trace) || !READ_ONCE(vmctx_mm_live))
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++) {
+		struct vmctx_mm_slot *s = &vmctx_mms[i];
+		if (s->mm != mm || !s->rec)
+			continue;
+		id = s->trace_id;
+		seq = ++s->trace_seq;
+		vac = s->vac_seq_ctr;
+		break;
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (id)
+		pr_info("vmctx-map as=%llu event=%llu vac=%llu pid=%d stage=%s range=%lx-%lx detail=%lx\n",
+			id, seq, vac, task_pid_nr(current), stage, start, end, detail);
+}
+
+struct vmctx_recall_ticket {
+	struct list_head owner_link;
+	struct vmctx_mm_slot *slot;
+	struct mm_struct *mm;
+	struct task_struct *owner;
+	/* Only the synchronous TAKE COW may authorize an existing zero PTE. */
+	struct task_struct *zero_cow_task;
+	unsigned long idx, prior;
+	u64 id;
+	bool cancelled;
+};
+static LIST_HEAD(vmctx_recall_tickets); /* protected by vmctx_mm_lock */
+static u64 vmctx_recall_next;
+static long vmctx_recall_live;
+core_param(vmctx_recall_live, vmctx_recall_live, long, 0444);
+static void vmctx_recall_owner_exit(struct task_struct *owner);
+static void vmctx_transfer_owner_exit(struct task_struct *owner);
+static void vmctx_quiesce_owner_exit(struct task_struct *owner);
+
+static bool vmctx_recall_busy(struct vmctx_mm_slot *slot, unsigned long idx)
+{
+	unsigned long flags;
+	bool busy;
+	if (!slot)
+		return false;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	busy = xa_load(&slot->recalls, idx) != NULL;
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return busy;
+}
+
+/*
+ * The record entry, packed. An xarray value carries 62 usable bits:
+ *   bits  0..3   state (VMCTX_PG_*)
+ *   bits  4..19  the 16-bit episode sum SERVE stamped on a TRANSIT entry
+ *   bits 20..51  the take generation (the other machine's capture count of
+ *                the copy this side last received; 0 = never came from there)
+ *   bits 52..61  ten bits of jiffies at the last transition, for the one
+ *                diagnostic transition stamp. Age never settles ownership.
+ */
+#define VMCTX_PGREC_STATE(v)	((unsigned int)((v) & 0xf))
+#define VMCTX_PGREC_SUM(v)	((unsigned int)(((v) >> 4) & 0xffff))
+#define VMCTX_PGREC_GEN(v)	((u32)(((v) >> 20) & 0xffffffffUL))
+#define VMCTX_PGREC_STAMP(v)	((unsigned long)(((v) >> 52) & 0x3ff))
+static inline unsigned long vmctx_pgrec_mk(unsigned int state, unsigned int sum,
+					   u32 gen)
+{
+	return (state & 0xf) | ((unsigned long)(sum & 0xffff) << 4) |
+	       ((unsigned long)gen << 20) | ((jiffies & 0x3ff) << 52);
+}
+static inline unsigned long vmctx_pgrec_of(void *entry)
+{
+	return entry ? xa_to_value(entry) : 0;	/* NULL = NONE, gen 0 */
+}
+static inline void *vmctx_pgrec_entry(unsigned long v)
+{
+	return VMCTX_PGREC_STATE(v) == VMCTX_PG_NONE && !VMCTX_PGREC_GEN(v) ?
+	       NULL : xa_mk_value(v);
+}
+static long vmctx_pgrec_claims;		/* faults that claimed their page      */
+static long vmctx_pgrec_waits;		/* faults parked on a sibling's claim  */
+static long vmctx_pgrec_wait_timeouts;	/* ...and gave up waiting              */
+static long vmctx_pgrec_serve_claiming;	/* SERVE answered CLAIMING             */
+static long vmctx_pgrec_serve_absent;	/* SERVE answered ABSENT               */
+static long vmctx_pgrec_serve_taken;	/* SERVE handed a page over            */
+static long vmctx_pgrec_serve_copied;	/* SERVE copied a page                 */
+static long vmctx_pgrec_serve_busy;	/* SERVE refused by a syscall hold     */
+static long vmctx_pgrec_serve_home_absent; /* HOME record, page not here: a
+					    * local fill landing (CLAIMING)     */
+static long vmctx_pgrec_healed;		/* retired age-healing counter: always zero */
+static long vmctx_pgrec_home_healed;	/* HOME-and-absent asked 255 times: a
+					 * ghost claim, healed REMOTE/ABSENT   */
+static long vmctx_pgrec_acks, vmctx_pgrec_ack_stale;
+static long vmctx_pgrec_lands, vmctx_pgrec_land_present;
+static long vmctx_pgrec_erased;		/* entries dropped by a vacate         */
+static long vmctx_pgrec_nomem;		/* a transition could not be recorded  */
+core_param(vmctx_pgrec_claims, vmctx_pgrec_claims, long, 0644);
+core_param(vmctx_pgrec_waits, vmctx_pgrec_waits, long, 0644);
+core_param(vmctx_pgrec_wait_timeouts, vmctx_pgrec_wait_timeouts, long, 0644);
+core_param(vmctx_pgrec_serve_claiming, vmctx_pgrec_serve_claiming, long, 0644);
+core_param(vmctx_pgrec_serve_absent, vmctx_pgrec_serve_absent, long, 0644);
+core_param(vmctx_pgrec_serve_taken, vmctx_pgrec_serve_taken, long, 0644);
+core_param(vmctx_pgrec_serve_copied, vmctx_pgrec_serve_copied, long, 0644);
+core_param(vmctx_pgrec_serve_busy, vmctx_pgrec_serve_busy, long, 0644);
+core_param(vmctx_pgrec_serve_home_absent, vmctx_pgrec_serve_home_absent, long, 0644);
+core_param(vmctx_pgrec_healed, vmctx_pgrec_healed, long, 0444);
+core_param(vmctx_pgrec_home_healed, vmctx_pgrec_home_healed, long, 0444);
+core_param(vmctx_pgrec_acks, vmctx_pgrec_acks, long, 0644);
+core_param(vmctx_pgrec_ack_stale, vmctx_pgrec_ack_stale, long, 0644);
+core_param(vmctx_pgrec_lands, vmctx_pgrec_lands, long, 0644);
+core_param(vmctx_pgrec_land_present, vmctx_pgrec_land_present, long, 0644);
+core_param(vmctx_pgrec_erased, vmctx_pgrec_erased, long, 0644);
+core_param(vmctx_pgrec_nomem, vmctx_pgrec_nomem, long, 0644);
+
+/*
+ * The slot of a live mm, without the table lock: the slots are static, and
+ * a caller holds the mm it names (its own, or one it took a reference to),
+ * so the slot cannot be recycled under it. NULL for an address space no
+ * context has noted -- or one whose record is off.
+ */
+static struct vmctx_mm_slot *vmctx_pgrec_slot(struct mm_struct *mm)
+{
+	int i;
+
+	if (!mm || !READ_ONCE(vmctx_mm_live))
+		return NULL;
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (READ_ONCE(vmctx_mms[i].mm) == mm)
+			return READ_ONCE(vmctx_mms[i].rec) ? &vmctx_mms[i] : NULL;
+	return NULL;
+}
+
+static inline unsigned long vmctx_pgrec_load(struct vmctx_mm_slot *s,
+					     unsigned long idx)
+{
+	return vmctx_pgrec_of(xa_load(&s->pg, idx));
+}
+
+/*
+ * Replace the entry at idx if it still reads `old`; the caller re-reads and
+ * retries on a miss. GFP_ATOMIC: the fault hook calls this with mm locks
+ * held, and a miss to allocate is answered as "not recorded" (counted) --
+ * the callers treat it as a transient refusal, never as an answer.
+ */
+static int vmctx_pgrec_cas(struct vmctx_mm_slot *s, unsigned long idx,
+			   unsigned long old, unsigned long new)
+{
+	void *oe = vmctx_pgrec_entry(old), *ne = vmctx_pgrec_entry(new);
+	void *cur = xa_cmpxchg(&s->pg, idx, oe, ne, GFP_ATOMIC);
+
+	if (xa_is_err(cur)) {
+		vmctx_pgrec_nomem++;
+		return -ENOMEM;
+	}
+	return cur == oe ? 0 : -EAGAIN;
+}
+
+/* Set the state (keeping gen), whatever the entry reads now. */
+static unsigned long vmctx_pgrec_set(struct vmctx_mm_slot *s, unsigned long idx,
+				     unsigned int state, unsigned int sum,
+				     bool keep_gen, u32 gen)
+{
+	unsigned long old, new;
+
+	do {
+		old = vmctx_pgrec_load(s, idx);
+		new = vmctx_pgrec_mk(state, sum,
+				     keep_gen ? VMCTX_PGREC_GEN(old) : gen);
+	} while (vmctx_pgrec_cas(s, idx, old, new) == -EAGAIN);
+	return old;
+}
+
+/* Drop every entry of [start, end): the range was vacated or discarded. */
+static void vmctx_pgrec_erase_range(struct vmctx_mm_slot *s, u64 start, u64 end)
+{
+	unsigned long idx, last;
+	void *entry;
+
+	if (end <= start)
+		return;
+	last = ((end - 1) >> PAGE_SHIFT);
+	/* Caller holds vmctx_mm_lock. Keep the ticket until its owner consumes
+	 * it: an old reply must never acquire a newly mapped object at this VA. */
+	xa_for_each_range(&s->recalls, idx, entry, start >> PAGE_SHIFT, last)
+		WRITE_ONCE(((struct vmctx_recall_ticket *)entry)->cancelled, true);
+	xa_for_each_range(&s->pg, idx, entry, start >> PAGE_SHIFT, last) {
+		xa_erase(&s->pg, idx);
+		vmctx_pgrec_erased++;
+	}
+	wake_up_all(&s->pg_wq);
+}
+
+/*
+ * How often the old rule would have unhooked an address space that still had
+ * contexts running in it. Counted in BOTH arms, because it is a fact about the
+ * program rather than about the fix: it says how often the bug had the chance
+ * to fire, which is the denominator every measurement below needs.
+ */
+static long vmctx_mm_early_drop;
+static long vmctx_mm_overflow;	/* no free slot: unhooked, silently, until now */
+static bool vmctx_mm_refcount = true;
+core_param(vmctx_mm_early_drop, vmctx_mm_early_drop, long, 0644);
+core_param(vmctx_mm_overflow, vmctx_mm_overflow, long, 0644);
+core_param(vmctx_mm_live, vmctx_mm_live, long, 0444);
+core_param(vmctx_mm_refcount, vmctx_mm_refcount, bool, 0444);
+
+/*
+ * The monitor can bind AFTER the mm is noted (VMCTX_CTL_ATTACH follows the
+ * context's own arming), and a slot noted with mon_tgid 0 attributed every
+ * one of that monitor's supplies to a third party -- vmremote-local's
+ * writes were the census's loudest "third party" until this. Recorded
+ * late, once, first-binder-wins, same lock as the registry.
+ */
+static void vmctx_mm_set_monitor(struct mm_struct *mm, pid_t tgid)
+{
+	unsigned long flags;
+	int i;
+
+	if (!mm || !tgid)
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			if (!vmctx_mms[i].mon_tgid)
+				vmctx_mms[i].mon_tgid = tgid;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+}
+
+/* Invoked with the native mutation lock still held, after its store. The
+ * journal lock never acquires an MM/PTE lock. Allocation is atomic because
+ * guard markers commit under the PTE lock. A failed append poisons this MM's
+ * journal; neither READ nor ACK may hide a missing event. */
+void vmctx_access_commit(struct mm_struct *mm, unsigned long start,
+			 unsigned long end, unsigned int kind, unsigned long vm_flags)
+{
+	struct vmctx_mm_slot *s;
+	struct vmctx_access_node *node;
+	unsigned long flags;
+	void *old;
+
+	if (start >= end || !READ_ONCE(vmctx_mm_live))
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_pgrec_slot(mm);
+	if (!s || s->access_error)
+		goto out;
+	if (s->access_count == VMCTX_ACCESS_LIMIT ||
+	    s->vac_seq_ctr >= (ULONG_MAX >> 1) - 1) {
+		s->access_error = EOVERFLOW;
+		goto out;
+	}
+	node = kmalloc(sizeof(*node), GFP_ATOMIC);
+	if (!node) {
+		s->access_error = ENOMEM;
+		goto out;
+	}
+	node->event = (struct vmctx_access_event) {
+		.seq = ++s->vac_seq_ctr, .start = start, .end = end, .kind = kind,
+		.prot = ((vm_flags & VM_READ) ? PROT_READ : 0) |
+			((vm_flags & VM_WRITE) ? PROT_WRITE : 0) |
+			((vm_flags & VM_EXEC) ? PROT_EXEC : 0),
+	};
+	if (kind == VMCTX_ACCESS_CONSTRUCT) {
+		old = xa_store(&s->constructions, task_pid_nr(current),
+			       xa_mk_value(node->event.seq), GFP_ATOMIC);
+		if (xa_is_err(old)) {
+			s->access_error = -xa_err(old);
+			kfree(node);
+			goto out;
+		}
+	}
+	if (kind == VMCTX_ACCESS_DENY)
+		vmctx_pgrec_erase_range(s, start, end);
+	list_add_tail(&node->link, &s->access_log);
+	s->access_count++;
+out:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+}
+
+static void vmctx_mm_note(struct mm_struct *mm, bool service, pid_t mon_tgid)
+{
+	unsigned long flags;
+	int i, free = -1;
+
+	if (!mm)
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++) {
+		if (vmctx_mms[i].mm == mm) {
+			vmctx_mms[i].n++;
+			if (service)
+				vmctx_mms[i].rec = true;
+			if (mon_tgid && !vmctx_mms[i].mon_tgid)
+				vmctx_mms[i].mon_tgid = mon_tgid;
+			goto out;
+		}
+		if (!vmctx_mms[i].mm && free < 0)
+			free = i;
+	}
+	if (free >= 0) {
+		/*
+		 * The record of the previous occupant is gone with it
+		 * (vmctx_mm_forget); a fresh slot starts empty and records
+		 * only for a service context's address space.
+		 */
+		xa_init(&vmctx_mms[free].pg);
+		xa_init(&vmctx_mms[free].recalls);
+		xa_init(&vmctx_mms[free].constructions);
+		INIT_LIST_HEAD(&vmctx_mms[free].access_log);
+		vmctx_mms[free].access_acked = 0;
+		vmctx_mms[free].access_offered = 0;
+		vmctx_mms[free].access_count = 0;
+		vmctx_mms[free].access_error = 0;
+		vmctx_mms[free].execution_running = 0;
+		vmctx_mms[free].execution_paused = 0;
+		init_waitqueue_head(&vmctx_mms[free].pg_wq);
+		vmctx_mms[free].rec = service;
+		vmctx_mms[free].mm = mm;
+		vmctx_mms[free].n  = 1;
+		vmctx_mms[free].mon_tgid = mon_tgid;
+		/*
+		 * A reused slot must not hand the previous address space's
+		 * vacated ranges to this one's monitor.
+		 */
+		vmctx_mms[free].vac_head = vmctx_mms[free].vac_tail = 0;
+		vmctx_mms[free].vac_seq_ctr = 0;
+		vmctx_mms[free].vac_dropped = 0;
+		vmctx_mms[free].trace_id = ++vmctx_mm_trace_next;
+		vmctx_mms[free].trace_seq = 0;
+		vmctx_mm_live++;
+	} else {
+		/*
+		 * Nowhere to put it, and until this counter existed that was
+		 * silent: the address space simply was not a context's, so
+		 * every hook fell through for the whole of its life. Said out
+		 * loud, because a run that hits this is not measuring what it
+		 * thinks it is.
+		 */
+		vmctx_mm_overflow++;
+		pr_warn_ratelimited("vmctx: no free mm slot (%d in use); this address space's faults will NOT be asked about\n",
+				    VMCTX_MM_SLOTS);
+	}
+out:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+}
+
+static void vmctx_mm_forget(struct mm_struct *mm)
+{
+	unsigned long flags;
+	int i;
+
+	if (!mm)
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			if (--vmctx_mms[i].n > 0) {
+				/*
+				 * Other contexts are still running in this
+				 * address space. The old rule dropped it here.
+				 */
+				vmctx_mm_early_drop++;
+				if (vmctx_mm_refcount || vmctx_mms[i].execution_paused ||
+				    vmctx_mms[i].execution_running || !xa_empty(&vmctx_mms[i].recalls))
+					break;
+			}
+			/* Destroy before publishing the slot as free. Otherwise a
+			 * concurrent adoption can initialize it before this teardown
+			 * destroys the new occupant's xarray. Lock order is mm -> xa,
+			 * the same as the mutation notifier and recall operations. */
+			xa_destroy(&vmctx_mms[i].pg);
+			xa_destroy(&vmctx_mms[i].recalls);
+			xa_destroy(&vmctx_mms[i].constructions);
+			while (!list_empty(&vmctx_mms[i].access_log)) {
+				struct vmctx_access_node *node = list_first_entry(
+					&vmctx_mms[i].access_log, struct vmctx_access_node, link);
+				list_del(&node->link);
+				kfree(node);
+			}
+			vmctx_mms[i].mm = NULL;
+			vmctx_mms[i].n  = 0;
+			vmctx_mms[i].rec = false;
+			vmctx_mm_live--;
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			return;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+}
+
+#include "vmctx-memory-core.h"
+
+/* A local page operation participates in recall exclusion for its entire
+ * duration. Its stack reservation cannot outlive the kernel call. */
+static long vmctx_page_guard_acquire(struct mm_struct *mm, unsigned long addr,
+				   struct vmctx_recall_ticket *g, bool capture)
+{
+	struct vmctx_mm_slot *s;
+	unsigned long flags;
+	void *old;
+	long ret = 0;
+
+	memset(g, 0, sizeof(*g));
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_pgrec_slot(mm);
+	if (!s) goto out;
+	g->idx = addr >> PAGE_SHIFT;
+	if (xa_load(&s->recalls, g->idx)) { ret = -EBUSY; goto out; }
+	/* A source fault owns CLAIM until LAND. An outgoing capture which
+	 * only observes that claim must not reserve its landing path. Check
+	 * under the same lock as fault admission and guard publication. */
+	if (capture) {
+		unsigned int state = VMCTX_PGREC_STATE(vmctx_pgrec_load(s, g->idx));
+		if (state == VMCTX_PG_CLAIM || state == VMCTX_PG_TRANSIT) {
+			ret = -EBUSY;
+			goto out;
+		}
+	}
+	if (s->n==INT_MAX) { ret=-EOVERFLOW; goto out; }
+	old = xa_store(&s->recalls, g->idx, g, GFP_ATOMIC);
+	if (xa_is_err(old)) { ret = xa_err(old); goto out; }
+	g->slot = s;
+	g->mm = mm;
+	s->n++;
+out:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return ret;
+}
+
+static long vmctx_page_guard_begin(struct mm_struct *mm, unsigned long addr,
+				  struct vmctx_recall_ticket *g)
+{
+	return vmctx_page_guard_acquire(mm, addr, g, false);
+}
+
+static long vmctx_capture_guard_begin(struct mm_struct *mm, unsigned long addr,
+				     struct vmctx_recall_ticket *g)
+{
+	return vmctx_page_guard_acquire(mm, addr, g, true);
+}
+
+static void vmctx_page_guard_end(struct vmctx_recall_ticket *g)
+{
+	unsigned long flags;
+	if (!g->slot) return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	xa_erase(&g->slot->recalls, g->idx);
+	wake_up_all(&g->slot->pg_wq);
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	vmctx_mm_forget(g->mm);
+}
+
+#include "vmctx-quiesce-core.h"
+
+bool vmctx_mm_is_context(struct mm_struct *mm)
+{
+	unsigned long flags;
+	int i;
+	bool theirs = false;
+
+	if (!mm)
+		return false;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			theirs = true;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return theirs;
+}
+EXPORT_SYMBOL_GPL(vmctx_mm_is_context);
+
+/*
+ * The mm_forbids_zeropage() hook -- see the comment at its definition in
+ * <linux/mm.h>. Called from every anonymous read fault on the machine, so
+ * it must cost nothing where vmctx is idle and no lock anywhere: the
+ * vmctx_mm_live read is the whole cost on an ordinary box. The slot scan
+ * is deliberately lockless -- a false negative (mm adopted mid-scan) is
+ * today's behavior arriving one adoption earlier, and a false positive
+ * (mm just released) costs one ordinary zeroed folio. Both are benign;
+ * the fault path pays no spinlock. The counter is racy for the same
+ * reason and is a diagnostic, not an accounting.
+ */
+static long vmctx_zeropage_forbidden;
+core_param(vmctx_zeropage_forbidden, vmctx_zeropage_forbidden, long, 0444);
+
+bool vmctx_mm_forbids_zeropage(struct mm_struct *mm)
+{
+	int i;
+
+	if (likely(!READ_ONCE(vmctx_mm_live)) || !mm)
+		return false;
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (READ_ONCE(vmctx_mms[i].mm) == mm) {
+			vmctx_zeropage_forbidden++;
+			return true;
+		}
+	return false;
+}
+EXPORT_SYMBOL_GPL(vmctx_mm_forbids_zeropage);
+
+/*
+ * One page per fault for a context's memory -- see the declaration.
+ *
+ * vmctx_batch_install=Y restores the batch installs, so a run with them and a
+ * run without them can be measured against each other on one boot.
+ */
+static bool vmctx_batch_install;
+core_param(vmctx_batch_install, vmctx_batch_install, bool, 0644);
+static long vmctx_single_installs;
+core_param(vmctx_single_installs, vmctx_single_installs, long, 0444);
+
+/*
+ * Whether a read-only private file fault asks the monitor (the Firefox fix) or
+ * is served from this side's own file as it was before. Default on; the switch
+ * exists so the class-aware fix and the pre-change behaviour can be measured
+ * against each other on one boot -- vmctx_fault_ro_file=0 is pre-change.
+ */
+bool vmctx_fault_ro_file = true;
+core_param(vmctx_fault_ro_file, vmctx_fault_ro_file, bool, 0644);
+EXPORT_SYMBOL_GPL(vmctx_fault_ro_file);
+
+bool vmctx_install_single(struct mm_struct *mm)
+{
+	if (likely(!atomic_read(&vmctx_nr_active)))
+		return false;
+	if (vmctx_batch_install)
+		return false;
+	if (!current->vmctx && !vmctx_mm_is_context(mm))
+		return false;
+	vmctx_single_installs++;
+	return true;
+}
+EXPORT_SYMBOL_GPL(vmctx_install_single);
+
+/*
+ * A page of a context, faulted by somebody who is not that context.
+ *
+ * The obvious repair -- report it to the context's monitor, exactly as the
+ * context's own faults are reported -- deadlocks, and the reason is worth
+ * stating because it is what decides the shape of this: the commonest foreign
+ * faulter IS the monitor. It is writing the page in order to answer the fault
+ * it was just asked about, so asking it about its own write would have it wait
+ * for itself. Measured, ten pg3 runs: 21000 to 79000 of these per run.
+ *
+ * So the answer is not who is faulting but which way:
+ *
+ *   a WRITE is somebody about to put real bytes at that address -- a monitor's
+ *   POKE installing a page it holds. Whatever the kernel allocates here is
+ *   covered by the write before anyone reads it, so let it allocate. (A write
+ *   of PART of a page still leaves the rest invented; that is the caller's to
+ *   avoid, and both monitors already fetch a page before writing a run of it.)
+ *
+ *   a READ has nothing coming to cover it. What the kernel allocates IS the
+ *   answer the reader takes away, and for a context's address space that answer
+ *   is a page of zeros invented for memory that lives on another machine --
+ *   PRINCIPLES.md §3, in the last place in this design that still did it. There
+ *   is nothing to ask (see the deadlock above) so it is refused: the fault
+ *   fails, get_user_pages() turns that into a short read, and
+ *   access_process_vm() returns what it managed. "This side does not hold that
+ *   page" is a sentence every caller of PEEK already knows how to hear, and it
+ *   is true.
+ *
+ * vmctx_foreign_refuse=0 restores the old behaviour, so the two can be measured
+ * against each other on one boot.
+ */
+vm_fault_t vmctx_wp_fault(struct mm_struct *mm, unsigned long addr,
+			  int own, int shared, int filed,
+			  int zero)
+{
+	unsigned long flags;
+	int i, theirs = 0;
+	bool take_zero = false;
+
+	if (!atomic_read(&vmctx_nr_active))
+		return VM_FAULT_FALLBACK;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			struct vmctx_recall_ticket *g;
+
+			theirs = 1;
+			g = xa_load(&vmctx_mms[i].recalls, addr >> PAGE_SHIFT);
+			take_zero = g && !g->cancelled && g->zero_cow_task == current;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (!theirs)
+		return VM_FAULT_FALLBACK;
+	if (own)
+		vmctx_wp_own++;
+	else
+		vmctx_wp_foreign++;
+	if (shared)
+		vmctx_wp_shared++;
+	if (filed)
+		vmctx_wp_filed++;
+	if (!zero)
+		return VM_FAULT_FALLBACK;
+	vmctx_wp_zero++;
+	/* The PTE lock establishes that this is still an existing zero PTE.
+	 * A matching TAKE reservation permits native private COW of those
+	 * local bytes. It grants neither VMA write permission nor remote data. */
+	if (take_zero && !shared)
+		return VM_FAULT_FALLBACK;
+	/*
+	 * ...but only when somebody other than the context is writing.
+	 *
+	 * Everything above is argued about foreign faulters, and the refusal
+	 * was written as if only they could reach here. They cannot. A context
+	 * writing a zero page of its OWN address space is the ordinary
+	 * copy-on-write that follows its own read: the read installed the
+	 * shared zero page, and whether zeros were the right answer was decided
+	 * THEN, by do_anonymous_page and the monitor that declined it. Refusing
+	 * the write second-guesses a decision already taken, and there is
+	 * nothing left to ask -- the page is present and it is this task's.
+	 *
+	 * Measured: it costs a browser. netsurf and links2 both die in a VM
+	 * context on exactly one refused write --
+	 *
+	 *   unrecoverable guest #PF at 0x7eee733151a0 err 0x7 (-14)
+	 *
+	 * err 0x7 being present|write|user, a protection fault, and -14 the
+	 * SIGBUS below arriving as EFAULT through fixup_user_fault(). With the
+	 * refusal off both browsers render exactly as they do natively (three
+	 * windows for netsurf, two for links2, same colours); with it on,
+	 * neither draws a pixel. Two arms each, alternating, one boot.
+	 *
+	 * vmctx_wp_zero_own counts the ones now let through, so "the guard
+	 * never fires" stays a measurement rather than an assumption.
+	 */
+	if (own) {
+		vmctx_wp_zero_own++;
+		return VM_FAULT_FALLBACK;
+	}
+	if (!vmctx_wp_zero_refuse)
+		return VM_FAULT_FALLBACK;
+	vmctx_wp_zero_refused++;
+	pr_warn_ratelimited("vmctx: a foreign write to the shared zero page in a context's address space: there is nothing to copy, so this kernel would invent one; refusing instead\n");
+	return VM_FAULT_SIGBUS;
+}
+EXPORT_SYMBOL_GPL(vmctx_wp_fault);
+
+/*
+ * The fault path that has no hook at all: a FILE fault on somebody else's
+ * address space.
+ *
+ * vmctx_foreign_anon_fault() below covers do_anonymous_page(), and do_fault()'s
+ * own hook is guarded on current->vmctx and on !VM_SHARED. Between them they
+ * miss the case that matters most on a destination: every guest page there is a
+ * MAP_SHARED mapping of the context's backing memfd (vmctx_back_fault() makes
+ * it so), and a monitor reading such a page -- process_vm_readv, PEEK,
+ * get_user_pages_remote -- faults the CONTEXT's mm while current is the
+ * monitor. Neither hook fires. shmem_fault() then allocates a fresh zero folio
+ * and inserts it INTO THE OBJECT, permanently, for an address whose contents
+ * may be on the other machine, with nobody asked and nothing recorded.
+ *
+ * Every sibling context that later maps that offset gets the invented folio,
+ * so this is not a private mistake in one task's page table: it replaces the
+ * address space's memory.
+ *
+ * Counted, not refused, and that order was deliberate. A foreign WRITE here is
+ * how the monitor installs a page in bulk (process_vm_writev, the chunk
+ * install) and MUST succeed; a foreign READ is the dangerous one, but refusing
+ * it also breaks page_read_as()'s legitimate fall back to the object. So this
+ * said how often it happens first.
+ *
+ * IT NEVER HAPPENS, and that is the number the switch was waiting for.
+ * vmctx_ffile_invent -- foreign reads of a context's file mapping for an offset
+ * the object does NOT hold, the only ones that would invent a folio -- reads 0
+ * across the suite, the browsers and the page tests, against a live denominator
+ * in vmctx_ffile_ctx. So the refusal costs nothing measurable, and the
+ * objection above (that it would break page_read_as()'s fall back) is answered:
+ * that fall back reads offsets the object HAS, which filemap_get_folio() finds
+ * and this hook lets through untouched.
+ *
+ * REFUSING BY DEFAULT WAS MEASURED FALSE, TWICE, AND IS OFF AGAIN.
+ *
+ * First attempt, refusing every file mapping: 10 refusals in one suite and
+ * tests/rd1 failed both of its file cases, because rd1 maps a REAL FILE whose
+ * pages legitimately arrive from disk. Narrowing to shmem_mapping() -- the only
+ * kind with nothing behind a hole -- was correct and is kept.
+ *
+ * Second attempt, refusing shmem holes only: 32 refusals, and rd1 failed 3 of 3
+ * rounds, deterministically --
+ *
+ *   store-forward   FAIL  write(2) from the mapping delivered ||
+ *   exit-writeback  FAIL  the file holds || after the process ended
+ *
+ * -- against 7607 foreign reads let through on real files in the same run. A
+ * hole in the backing object is not only an invention about to happen: it is
+ * also how a page that a context holds, but that is not resident in the object,
+ * is legitimately read back. Refusing at fault time turns that into a short
+ * read, the destination can no longer serve the page to the source, and the
+ * guest's store is lost -- which is a worse failure than the one being
+ * prevented, and a visible one.
+ *
+ * So the default goes back off and the counters stay. vmctx_ffile_invent says
+ * how often the case arises (32 per suite) and it is a real gap, but the fix is
+ * for the READER to ask whoever holds the page rather than for the fault to be
+ * refused underneath it. vmctx_foreign_file_refuse=1 still turns it on.
+ *
+ * The path that WAS closed, and stays closed, is the decline: a fault for a page
+ * whose bytes exist somewhere now kills the program (VMR_EXIT_INVENTED_PAGE)
+ * rather than being answered with zeros.
+ */
+static long vmctx_ffile_all;	/* foreign file faults, anywhere            */
+static long vmctx_ffile_ctx;	/* ...on a live context's address space     */
+static long vmctx_ffile_read;	/* ...of those, reads (the invented ones)   */
+static long vmctx_ffile_shared;	/* ...of those, on a MAP_SHARED vma         */
+static long vmctx_ffile_invent;	/* ...of those reads, the ones that would INVENT */
+static long vmctx_ffile_refused;
+/* Foreign reads let through because a real filesystem is behind the hole. */
+static long vmctx_ffile_filed;
+static bool vmctx_foreign_file_refuse;
+core_param(vmctx_ffile_all, vmctx_ffile_all, long, 0644);
+core_param(vmctx_ffile_ctx, vmctx_ffile_ctx, long, 0644);
+core_param(vmctx_ffile_read, vmctx_ffile_read, long, 0644);
+core_param(vmctx_ffile_shared, vmctx_ffile_shared, long, 0644);
+core_param(vmctx_ffile_invent, vmctx_ffile_invent, long, 0644);
+core_param(vmctx_ffile_refused, vmctx_ffile_refused, long, 0644);
+core_param(vmctx_ffile_filed, vmctx_ffile_filed, long, 0644);
+core_param(vmctx_foreign_file_refuse, vmctx_foreign_file_refuse, bool, 0644);
+
+/* ---- every folio the kernel CREATES in a live context's object ---------- */
+/*
+ * The hx2 residual (HANDOFF-session35): a context's mapping held an ALL-ZERO
+ * folio for a page mid-run, with no userspace install of it in the trail and
+ * every instrumented door silent -- MAPOBJ refuses holes (vmctx_mapobj_holes
+ * 0), a foreign read of a hole is counted (vmctx_ffile_invent did not move),
+ * the decline counters did not move. So a zero folio entered the object by a
+ * path nothing counts. A per-door audit is how a door gets overlooked, so
+ * this counts at the one place EVERY folio of a shmem object is created --
+ * shmem_get_folio_gfp()'s allocation -- and classifies by who asked:
+ *
+ *   self_user     the context's own user-mode #PF on the host path (a fault
+ *                 the module did not take in guest mode)
+ *   self_kern     the context task in KERNEL mode: a copy_to_user/put_user
+ *                 inside a syscall run locally, a signal frame, the clear-tid
+ *                 word, or the module's own fixup_user_fault (lsvc = inside
+ *                 vmctx_declined_to_local)
+ *   mapper        a task that maps the object but is not a context (vmremote's
+ *                 own mapping of it)
+ *   foreign_write another task writing through GUP: the chunk install
+ *                 (process_vm_writev) -- the legitimate producer
+ *   foreign_read  another task READING through GUP: PEEK on a hole
+ *   file_write    write(2)/pwrite on the object: the other install
+ *   file_falloc   fallocate
+ *   file_other    anything else (reads allocate nothing: SGP_READ)
+ *
+ * Two things make it decisive rather than a census. Every allocation is also
+ * stamped into a table keyed by (object, page): the LAST allocation for that
+ * page, which is the folio the object holds now, because a folio only ever
+ * enters the object through this one function. And TAKEOBJ, when the page
+ * it captures is all zero, looks the stamp up and names it: which path made
+ * the folio, when, by which task, at what address and instruction -- or says
+ * that no allocation is on record (the stamp was overwritten by a collision,
+ * or the folio predates the boot's counters). A guest's genuinely-zero page
+ * is explained the same way (an install from ABSENT, a file write of zeros);
+ * the one the residual is about will name a door nothing counted before.
+ *
+ * "Live object" = an object some context mm maps at this page (an i_mmap
+ * walk bounded to the one index, plus a small cache of objects already seen
+ * live, so a file write to an offset nobody has mapped yet is counted too).
+ */
+enum vmctx_shm_path {
+	VMCTX_SHM_SELF_USER,
+	VMCTX_SHM_SELF_KERN,
+	VMCTX_SHM_MAPPER,
+	VMCTX_SHM_FOREIGN_WRITE,
+	VMCTX_SHM_FOREIGN_READ,
+	VMCTX_SHM_FILE_WRITE,
+	VMCTX_SHM_FILE_FALLOC,
+	VMCTX_SHM_FILE_OTHER,
+	VMCTX_SHM_NPATH,
+};
+static const char *const vmctx_shm_path_name[VMCTX_SHM_NPATH] = {
+	"self_user", "self_kern", "mapper", "foreign_write", "foreign_read",
+	"file_write", "file_falloc", "file_other",
+};
+struct vmctx_shm_stamp {
+	struct address_space *mapping;
+	pgoff_t index;
+	u64 when;			/* jiffies64 */
+	unsigned long addr;		/* faulting address (fault paths) */
+	unsigned long ip;		/* current's user ip at the time */
+	u64 sysnr;			/* orig_ax of current's frame */
+	pid_t pid;
+	char comm[TASK_COMM_LEN];
+	u8 path, order, vmctx, lsvc, msys, write, valid;
+};
+#define VMCTX_SHM_STAMPS 65536		/* direct-mapped by page index */
+static struct vmctx_shm_stamp vmctx_shm_stamps[VMCTX_SHM_STAMPS];
+static DEFINE_SPINLOCK(vmctx_shm_lock);
+#define VMCTX_SHM_OBJS 8
+static struct { struct address_space *mapping; u64 seen; } vmctx_shm_objs[VMCTX_SHM_OBJS];
+
+static long vmctx_shm_live;		/* allocations in a live context's object */
+static long vmctx_shm_self_user;
+static long vmctx_shm_self_kern;
+static long vmctx_shm_self_kern_lsvc;	/* ...of self_kern, inside the declined-to-local service */
+static long vmctx_shm_mapper;
+static long vmctx_shm_foreign_write;
+static long vmctx_shm_foreign_read;
+static long vmctx_shm_file_write;
+static long vmctx_shm_file_falloc;
+static long vmctx_shm_file_other;
+static long vmctx_shm_large;		/* order > 0: neighbours invented in one go */
+static long vmctx_takeobj_zero;		/* TAKEOBJ captured an all-zero page */
+static long vmctx_takeobj_zero_named;	/* ...and the stamp named its maker */
+static long vmctx_takeobj_zero_unnamed;	/* ...and no allocation was on record */
+core_param(vmctx_shm_live, vmctx_shm_live, long, 0644);
+core_param(vmctx_shm_self_user, vmctx_shm_self_user, long, 0644);
+core_param(vmctx_shm_self_kern, vmctx_shm_self_kern, long, 0644);
+core_param(vmctx_shm_self_kern_lsvc, vmctx_shm_self_kern_lsvc, long, 0644);
+core_param(vmctx_shm_mapper, vmctx_shm_mapper, long, 0644);
+core_param(vmctx_shm_foreign_write, vmctx_shm_foreign_write, long, 0644);
+core_param(vmctx_shm_foreign_read, vmctx_shm_foreign_read, long, 0644);
+core_param(vmctx_shm_file_write, vmctx_shm_file_write, long, 0644);
+core_param(vmctx_shm_file_falloc, vmctx_shm_file_falloc, long, 0644);
+core_param(vmctx_shm_file_other, vmctx_shm_file_other, long, 0644);
+core_param(vmctx_shm_large, vmctx_shm_large, long, 0644);
+core_param(vmctx_takeobj_zero, vmctx_takeobj_zero, long, 0644);
+core_param(vmctx_takeobj_zero_named, vmctx_takeobj_zero_named, long, 0644);
+core_param(vmctx_takeobj_zero_unnamed, vmctx_takeobj_zero_unnamed, long, 0644);
+
+static bool vmctx_shm_object_live(struct address_space *mapping, pgoff_t index)
+{
+	struct vm_area_struct *vma;
+	unsigned long flags;
+	u64 now = get_jiffies_64();
+	bool live = false;
+	int i, oldest = 0;
+
+	spin_lock_irqsave(&vmctx_shm_lock, flags);
+	for (i = 0; i < VMCTX_SHM_OBJS; i++) {
+		if (vmctx_shm_objs[i].mapping == mapping &&
+		    time_before64(now, vmctx_shm_objs[i].seen + 60 * HZ)) {
+			live = true;
+			break;
+		}
+		if (time_before64(vmctx_shm_objs[i].seen, vmctx_shm_objs[oldest].seen))
+			oldest = i;
+	}
+	spin_unlock_irqrestore(&vmctx_shm_lock, flags);
+	if (live)
+		return true;
+
+	i_mmap_lock_read(mapping);
+	vma_interval_tree_foreach(vma, &mapping->i_mmap, index, index) {
+		if (vmctx_mm_is_context(vma->vm_mm)) {
+			live = true;
+			break;
+		}
+	}
+	i_mmap_unlock_read(mapping);
+	if (!live)
+		return false;
+
+	spin_lock_irqsave(&vmctx_shm_lock, flags);
+	vmctx_shm_objs[oldest].mapping = mapping;
+	vmctx_shm_objs[oldest].seen = now;
+	spin_unlock_irqrestore(&vmctx_shm_lock, flags);
+	return true;
+}
+
+/*
+ * THE DOOR, named by the census above on kernel #150 (session 36): every
+ * all-zero page TAKEOBJ captured of hx2's page was a folio created 0-1 ms
+ * earlier by foreign_read -- the monitor's VMCTX_CTL_PEEK (access_process_vm
+ * -> GUP read fault -> shmem_fault) of a hole that a TAKEOBJ had punched
+ * between the monitor's pagemap check and the read. The allocation is the
+ * invention: from then on the object "holds" the page as zeros and every
+ * sibling maps them as the address space's memory.
+ *
+ * vmctx_foreign_file_fault() counted and (with vmctx_foreign_file_refuse)
+ * refused this from do_fault(), but it looks the folio up BEFORE the fault
+ * proceeds: a folio present at that moment and punched a microsecond later
+ * passes it, and shmem_get_folio_gfp()'s own repeat loop then finds the hole
+ * and allocates. That is why ffile_invent read 10 while this census counted
+ * 18 foreign reads that allocated, and why the old refusal "had nothing to
+ * refuse" in session 35. A decision about an allocation has to be made where
+ * the allocation is made, after the last lookup -- here.
+ *
+ * A foreign READ that finds a hole in a context's object answers -EFAULT
+ * (VM_FAULT_SIGBUS to GUP, a short count to access_process_vm): the reader is
+ * told the page is not here, which is the truth, and asks whoever holds it
+ * (vmremote's peek_at counts it as n_peek_short; vmhome's ctx_peek returns the
+ * short count). A foreign WRITE is the install and must allocate; the
+ * context's own faults and the object's file ops are untouched.
+ *
+ * The switch this was gated on for the A/B is gone; the measurement is
+ * kept below, at the counters.
+ */
+/*
+ * ...and only for the ANONYMOUS objects: the backing memfd and MAP_SHARED
+ * anonymous memory, which live on the kernel's internal shm mount
+ * (SB_KERNMOUNT) and whose hole has nothing behind it. A named tmpfs file is
+ * also shmem, and refusing there was measured wrong on #151 (kernel 36's
+ * first form): tests/rd1 maps /tmp/rd1.XXXXXX -- tmpfs on the box -- and the
+ * owner's sh_file reclaim PEEKs that file's page before a forwarded write(2)
+ * to pull the guest's store over it; told "hole", it pulled nothing and the
+ * write delivered zeros (rd1 FAIL, the same shape as the two earlier
+ * refusal experiments in vmctx_foreign_file_fault's comment). A file's hole
+ * reads as the file's zeros by the file's own semantics, and the monitor's
+ * file machinery owns its coherence; the anonymous object IS the memory.
+ */
+/*
+ * The A/B that proved it, and was then deleted (PRINCIPLES: no optional
+ * correctness -- the numbers stay, the switch does not). Chains of suite x1
+ * + 48x8 hx2/pg3/ws1/sig1 on one box, graded by guest.out:
+ *   #150, no refusal (s36a):        34/0  46/48 47/48 48/48 48/48 -- both hx2
+ *         fails had a foreign_read-made zero folio of the hx2 page, 1 of 46
+ *         passes did;
+ *   #151, refusal on ALL shmem (s36b): 33/1 48/48 48/48 48/48 48/48 -- rd1
+ *         FAIL (the tmpfs-file case above);
+ *   #152, refusal on kern-mounted shmem only (s36c, s36d):
+ *                                    34/0  48/48 48/48 48/48 48/48 and
+ *                                    34/0  47/48 48/48 48/48 48/48 -- zero
+ *         foreign_read allocations in all four pools of both chains, every
+ *         all-zero take an install; the one s36d miss an exit-242 NULL
+ *         dereference of the pre-existing family (NOTES 6.1a), the run's
+ *         only decline being that NULL page, no refusal near it.
+ */
+static long vmctx_shm_refused;		/* foreign reads of a hole refused here */
+static long vmctx_shm_filed;		/* ...let through: a named tmpfs file */
+core_param(vmctx_shm_refused, vmctx_shm_refused, long, 0644);
+core_param(vmctx_shm_filed, vmctx_shm_filed, long, 0644);
+
+bool vmctx_shmem_may_alloc(struct address_space *mapping, pgoff_t index,
+			   struct vm_fault *vmf)
+{
+	struct vm_area_struct *vma = vmf ? vmf->vma : NULL;
+
+	if (!vma || vma->vm_mm == current->mm || (vmf->flags & FAULT_FLAG_WRITE))
+		return true;
+	if (!vmctx_mm_is_context(vma->vm_mm))
+		return true;
+	if (!(mapping->host->i_sb->s_flags & SB_KERNMOUNT)) {
+		vmctx_shm_filed++;
+		return true;
+	}
+	vmctx_shm_refused++;
+	pr_info_ratelimited("vmctx: SHMEM-REFUSED foreign_read: page 0x%lx of a context's object is a hole; pid %d %s (addr 0x%lx sysnr %ld) is told so instead of a zero folio (#%ld)\n",
+			    (unsigned long)index << PAGE_SHIFT,
+			    task_pid_nr(current), current->comm,
+			    vmf->address,
+			    current->mm ? (long)task_pt_regs(current)->orig_ax : -1L,
+			    vmctx_shm_refused);
+	return false;
+}
+EXPORT_SYMBOL_GPL(vmctx_shmem_may_alloc);
+
+void vmctx_shmem_alloced(struct address_space *mapping, struct folio *folio,
+			 struct vm_fault *vmf, int sgp_write, int sgp_falloc)
+{
+	struct vm_area_struct *vma = vmf ? vmf->vma : NULL;
+	struct vmctx_task *vc = current->vmctx;
+	struct pt_regs *regs = current->mm ? task_pt_regs(current) : NULL;
+	struct vmctx_shm_stamp *st;
+	unsigned long flags;
+	pgoff_t index = folio->index;
+	int path, order = folio_order(folio);
+	bool quiet;
+
+	if (vma) {
+		if (vma->vm_mm != current->mm)
+			path = (vmf->flags & FAULT_FLAG_WRITE) ?
+				VMCTX_SHM_FOREIGN_WRITE : VMCTX_SHM_FOREIGN_READ;
+		else if (!vmctx_mm_is_context(vma->vm_mm))
+			path = VMCTX_SHM_MAPPER;
+		else
+			path = (vmf->flags & FAULT_FLAG_USER) ?
+				VMCTX_SHM_SELF_USER : VMCTX_SHM_SELF_KERN;
+		if (path == VMCTX_SHM_MAPPER) {
+			/*
+			 * A task that is not a context faulting its OWN mapping
+			 * of the object. vmremote maps the own.h ownership
+			 * segment, a memfd its contexts inherit, so the i_mmap
+			 * walk alone called every first touch of that segment a
+			 * context's memory (shm_mapper ~1k per pool on #150).
+			 * The guest object is mapped at offset == address in
+			 * every context; only that shape is the guest's memory.
+			 */
+			if (vma->vm_pgoff != (vma->vm_start >> PAGE_SHIFT) ||
+			    !vmctx_shm_object_live(mapping, index))
+				return;
+		} else if (path == VMCTX_SHM_FOREIGN_WRITE ||
+			   path == VMCTX_SHM_FOREIGN_READ) {
+			if (!vmctx_mm_is_context(vma->vm_mm))
+				return;
+		}
+	} else {
+		if (!vmctx_shm_object_live(mapping, index))
+			return;
+		path = sgp_write ? VMCTX_SHM_FILE_WRITE :
+		       sgp_falloc ? VMCTX_SHM_FILE_FALLOC : VMCTX_SHM_FILE_OTHER;
+	}
+
+	vmctx_shm_live++;
+	switch (path) {
+	case VMCTX_SHM_SELF_USER:	vmctx_shm_self_user++; break;
+	case VMCTX_SHM_SELF_KERN:
+		vmctx_shm_self_kern++;
+		if (vc && vc->in_local_service)
+			vmctx_shm_self_kern_lsvc++;
+		break;
+	case VMCTX_SHM_MAPPER:		vmctx_shm_mapper++; break;
+	case VMCTX_SHM_FOREIGN_WRITE:	vmctx_shm_foreign_write++; break;
+	case VMCTX_SHM_FOREIGN_READ:	vmctx_shm_foreign_read++; break;
+	case VMCTX_SHM_FILE_WRITE:	vmctx_shm_file_write++; break;
+	case VMCTX_SHM_FILE_FALLOC:	vmctx_shm_file_falloc++; break;
+	default:			vmctx_shm_file_other++; break;
+	}
+	if (order)
+		vmctx_shm_large++;
+
+	spin_lock_irqsave(&vmctx_shm_lock, flags);
+	st = &vmctx_shm_stamps[hash_long((unsigned long)index ^
+					  (unsigned long)mapping,
+					  ilog2(VMCTX_SHM_STAMPS))];
+	st->mapping = mapping;
+	st->index = index;
+	st->when = get_jiffies_64();
+	st->addr = vma ? vmf->address : 0;
+	st->ip = regs ? regs->ip : 0;
+	st->sysnr = regs ? (u64)regs->orig_ax : (u64)-1;
+	st->pid = task_pid_nr(current);
+	memcpy(st->comm, current->comm, TASK_COMM_LEN);
+	st->path = path;
+	st->order = order;
+	st->vmctx = !!vc;
+	st->lsvc = vc ? !!vc->in_local_service : 0;
+	st->msys = vc ? !!vc->in_monitor_syscall : 0;
+	st->write = vma ? !!(vmf->flags & FAULT_FLAG_WRITE) : sgp_write;
+	st->valid = 1;
+	spin_unlock_irqrestore(&vmctx_shm_lock, flags);
+
+	/* The installs are the noise; everything else is said out loud. */
+	quiet = (path == VMCTX_SHM_FOREIGN_WRITE || path == VMCTX_SHM_FILE_WRITE ||
+		 path == VMCTX_SHM_FILE_FALLOC) && !order;
+	if (!quiet)
+		pr_info_ratelimited("vmctx: SHMEM-ALLOC %s: page 0x%lx (order %d) of a live context's object created by pid %d %s, addr 0x%lx ip 0x%lx sysnr %lld vmctx=%d lsvc=%d msys=%d write=%d\n",
+				    vmctx_shm_path_name[path],
+				    (unsigned long)index << PAGE_SHIFT, order,
+				    task_pid_nr(current), current->comm,
+				    st->addr, st->ip, (long long)st->sysnr,
+				    !!vc, st->lsvc, st->msys, st->write);
+}
+EXPORT_SYMBOL_GPL(vmctx_shmem_alloced);
+
+/*
+ * TAKEOBJ captured an all-zero page: say who made the folio it came from.
+ */
+static void vmctx_shm_explain_zero(struct address_space *mapping, pgoff_t index,
+				   unsigned long addr, struct task_struct *target)
+{
+	struct vmctx_shm_stamp *st, c;
+	unsigned long flags;
+	u64 now = get_jiffies_64();
+
+	vmctx_takeobj_zero++;
+	spin_lock_irqsave(&vmctx_shm_lock, flags);
+	st = &vmctx_shm_stamps[hash_long((unsigned long)index ^
+					  (unsigned long)mapping,
+					  ilog2(VMCTX_SHM_STAMPS))];
+	c = *st;
+	spin_unlock_irqrestore(&vmctx_shm_lock, flags);
+
+	if (c.valid && c.mapping == mapping && c.index == index) {
+		vmctx_takeobj_zero_named++;
+		pr_info_ratelimited("vmctx: ZERO-TAKE 0x%lx pid %d (#%ld): the object's folio was created %llu ms ago by %s -- pid %d %s, addr 0x%lx ip 0x%lx sysnr %lld vmctx=%d lsvc=%d msys=%d write=%d order %d\n",
+				    addr, task_pid_nr(target), vmctx_takeobj_zero,
+				    (unsigned long long)jiffies64_to_msecs(now - c.when),
+				    vmctx_shm_path_name[c.path], c.pid, c.comm,
+				    c.addr, c.ip, (long long)c.sysnr, c.vmctx,
+				    c.lsvc, c.msys, c.write, c.order);
+	} else {
+		vmctx_takeobj_zero_unnamed++;
+		pr_info_ratelimited("vmctx: ZERO-TAKE 0x%lx pid %d (#%ld): NO allocation of the object's folio on record (stamp %s)\n",
+				    addr, task_pid_nr(target), vmctx_takeobj_zero,
+				    c.valid ? "overwritten by another page" : "empty");
+	}
+}
+
+/* ---- the complete accounting: every fault on a context's memory --------- */
+/*
+ * A per-path audit is how a path gets overlooked, so this counts at the one
+ * place EVERY user fault passes through -- handle_mm_fault() -- and the hooks
+ * that report to a monitor count themselves. The difference is the number that
+ * matters and it cannot be wrong by construction:
+ *
+ *     faults on a context's memory that NOBODY WAS ASKED ABOUT
+ *         = vmctx_f_seen - vmctx_f_reported
+ *
+ * Broken down so a non-zero difference can be attributed rather than merely
+ * noticed: by who faulted (the context itself, or a monitor reaching in), and
+ * by what kind of mapping it was (anonymous, private file, shared file). On a
+ * destination the third of those is all of guest memory.
+ *
+ * "Resolved locally" is not automatically wrong -- a context's own backing
+ * object IS the answer for its own pages, and asking the monitor about them
+ * would be a loop. What the split says is WHERE the unasked ones are, so the
+ * ones that should have been asked can be told from the ones that must not be.
+ */
+/*
+ * Clear-tid words written inside the protocol at teardown, so the exit path
+ * cannot write them outside it. `failed` counts the ones whose put_user still
+ * returned an error -- a genuinely bad pointer, or a fault the monitor could
+ * not answer; mm_release() ignored that error too, and so does this.
+ */
+static long vmctx_cleartid_inband;
+static long vmctx_cleartid_failed;
+core_param(vmctx_cleartid_inband, vmctx_cleartid_inband, long, 0644);
+core_param(vmctx_cleartid_failed, vmctx_cleartid_failed, long, 0644);
+/*
+ * The in-band clear for the SERVICE role is OFF by default (session 41).
+ *
+ * The owner's teardown performs the protocol clear BEFORE it lets the
+ * service thread die: poke_owned(0) with a sibling fallback, a re-armed
+ * FUTEX wake on a live member, then a verify-read -- and only then the
+ * assisted exit. By the time this exit path runs, the word is already
+ * zero on the one true copy; put_user here re-takes the descriptor page
+ * from the joiner that has just read it (one needless cross-machine
+ * bounce per thread exit), and when the fault service is itself mid-
+ * teardown the fault sits the whole 6 s deadline inside the dying thread
+ * (vmctx_cleartid_failed: 128 over one session, fault_deadline_hits ~1
+ * per chain). Runtime-flippable while ws1/sig1/pg1 judge; the pointer is
+ * still NULLed either way so mm_release() can never repeat the write
+ * outside the protocol.
+ */
+static bool vmctx_cleartid_inband_on;
+core_param(vmctx_cleartid_inband_on, vmctx_cleartid_inband_on, bool, 0644);
+static long vmctx_cleartid_svc_deferred; /* service exits that left the clear to the owner's teardown */
+core_param(vmctx_cleartid_svc_deferred, vmctx_cleartid_svc_deferred, long, 0644);
+
+/*
+ * The drop-and-retry fault path: how often it is taken, how often the caller
+ * would not tolerate a dropped lock, and how often the answer was a kill (which
+ * the retry pass turns into SIGBUS, with the lock held, where that is legal).
+ * vmctx_fault_retry=0 restores the old behaviour for an A/B.
+ */
+static long vmctx_af_retry;
+static long vmctx_af_nowait;
+static long vmctx_af_retry_killed;
+static long vmctx_af_noretry;
+static long vmctx_af_retry_tried;	/* TRIED passes that dropped the lock too */
+static int  vmctx_fault_retry = 1;
+core_param(vmctx_af_retry, vmctx_af_retry, long, 0644);
+core_param(vmctx_af_nowait, vmctx_af_nowait, long, 0644);
+core_param(vmctx_af_retry_killed, vmctx_af_retry_killed, long, 0644);
+core_param(vmctx_af_noretry, vmctx_af_noretry, long, 0644);
+core_param(vmctx_af_retry_tried, vmctx_af_retry_tried, long, 0644);
+core_param(vmctx_fault_retry, vmctx_fault_retry, int, 0644);
+
+static long vmctx_f_seen;	/* faults on a live context's mm, all paths  */
+static long vmctx_f_own;	/* ...taken by the context itself            */
+static long vmctx_f_foreign;	/* ...taken by somebody else (a monitor)     */
+static long vmctx_f_anon;	/* ...on an anonymous vma                    */
+static long vmctx_f_filepriv;	/* ...on a private file vma                  */
+static long vmctx_f_fileshared;	/* ...on a shared file vma (the guest's own) */
+static long vmctx_f_write;	/* ...write faults                           */
+static long vmctx_f_exec;	/* ...instruction fetches                    */
+static long vmctx_f_reported;	/* ...that a monitor was actually asked about */
+core_param(vmctx_f_seen, vmctx_f_seen, long, 0644);
+core_param(vmctx_f_own, vmctx_f_own, long, 0644);
+core_param(vmctx_f_foreign, vmctx_f_foreign, long, 0644);
+/*
+ * vmctx_f_foreign, split by WHO (session 41; the owner's rule: any task
+ * that uses ANY part of a context's mm must be handled by the protocol).
+ * The supplier is the monitor's thread group -- its POKE/PEEK/SERVE/LAND
+ * remote accesses are the designed supply path and its faults land in
+ * pages the protocol is placing. A THIRD PARTY is everything else: a
+ * debugger, /proc/<pid>/mem, process_vm_readv, an io_uring worker or any
+ * kthread_use_mm user. Their faults are answered by the LOCAL kernel
+ * (do_anonymous_page invents a page into the context's address space),
+ * which is the "no invented pages" rule broken through a side door --
+ * counted and NAMED here first; refusal or redirection comes after the
+ * numbers say who actually arrives by this door.
+ */
+static long vmctx_f_supplier;	/* foreign faults by the monitor's threads   */
+static long vmctx_f_third;	/* foreign faults by anybody else            */
+core_param(vmctx_f_supplier, vmctx_f_supplier, long, 0644);
+core_param(vmctx_f_third, vmctx_f_third, long, 0644);
+/*
+ * ...and the census's first consequence (session 41b, kernel #164): a
+ * third party's fault on a MISSING page of a context's mm is REFUSED
+ * (VM_FAULT_SIGBUS -> the reader's EFAULT / short read) instead of
+ * letting the local kernel invent a zero page into the context's memory.
+ * Refusal is the honest floor of the owner's rule -- the bytes exist, on
+ * whichever machine holds them, and a reader that cannot have them must
+ * hear that rather than be handed zeros that then SHADOW the real page
+ * for the context itself. Measured before this: pgrep/ps reading
+ * /proc/<ctx>/cmdline invented pages into context mms hundreds of times
+ * per harness run. The supplier (the monitor's thread group) is exempt --
+ * its fallback-and-poke is the designed supply path. Runtime-flippable
+ * for the A/B; serving third parties THROUGH the protocol (publish and
+ * wait on pg_wq like a sibling fault) is the possible later step if a
+ * legitimate consumer ever needs the bytes rather than the truth.
+ */
+/* vmctx_third_refuse / vmctx_third_refused are declared beside
+ * vmctx_foreign_refuse -- vmctx_foreign_anon_fault() is where they act. */
+/*
+ * Shared objects a context maps, and the FOREIGN address spaces that touch
+ * them. A context's VM_SHARED file mapping (a SysV segment shmat'ed to an
+ * X server, a memfd handed to a sandbox helper) is memory two mms share
+ * with only ONE of them under the protocol's hooks: the other side's
+ * stores are invisible to the change log and its reads see whatever copy
+ * its own kernel holds. Register the mapping when a context faults it;
+ * count (and name, first few) every fault on the same mapping from an mm
+ * the protocol does not know, excluding the registering monitor's own
+ * thread group. Keys are compared, never dereferenced: a dead mapping's
+ * key misattributes at worst one tick.
+ */
+#define VMCTX_SHOBJ_SLOTS 32
+static struct {
+	struct address_space *host;	/* compared only, never dereferenced */
+	pid_t mon_tgid;
+	char name[24];
+} vmctx_shobj[VMCTX_SHOBJ_SLOTS];
+static int vmctx_nshobj;
+static long vmctx_f_sharedobj_foreign;	/* foreign-mm faults on those       */
+static long vmctx_shobj_overflow;
+core_param(vmctx_f_sharedobj_foreign, vmctx_f_sharedobj_foreign, long, 0644);
+core_param(vmctx_shobj_overflow, vmctx_shobj_overflow, long, 0644);
+core_param(vmctx_f_anon, vmctx_f_anon, long, 0644);
+core_param(vmctx_f_filepriv, vmctx_f_filepriv, long, 0644);
+core_param(vmctx_f_fileshared, vmctx_f_fileshared, long, 0644);
+core_param(vmctx_f_write, vmctx_f_write, long, 0644);
+core_param(vmctx_f_exec, vmctx_f_exec, long, 0644);
+core_param(vmctx_f_reported, vmctx_f_reported, long, 0644);
+
+void vmctx_fault_seen(struct vm_area_struct *vma, unsigned int flags)
+{
+	unsigned long irqflags;
+	struct mm_struct *mm = vma->vm_mm;
+	struct address_space *host = vma->vm_file ?
+				     vma->vm_file->f_mapping : NULL;
+	pid_t mon = 0;
+	int i, theirs = 0;
+
+	if (!atomic_read(&vmctx_nr_active))
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, irqflags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			theirs = 1;
+			mon = vmctx_mms[i].mon_tgid;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, irqflags);
+	if (!theirs) {
+		/*
+		 * Not a context's mm -- but is it a context's MEMORY? A fault
+		 * on a shared mapping a context also maps is the other half
+		 * of the sharing this function exists to see.
+		 */
+		if (host && (vma->vm_flags & VM_SHARED)) {
+			int n = READ_ONCE(vmctx_nshobj);
+
+			for (i = 0; i < n && i < VMCTX_SHOBJ_SLOTS; i++)
+				if (vmctx_shobj[i].host == host &&
+				    task_tgid_nr(current) !=
+				    vmctx_shobj[i].mon_tgid) {
+					vmctx_f_sharedobj_foreign++;
+					pr_warn_ratelimited("vmctx: SHARED-OBJECT foreign touch: %s (pid %d) %s '%s', a mapping a context also maps; that address space's stores are outside the protocol\n",
+							    current->comm,
+							    task_pid_nr(current),
+							    (flags & FAULT_FLAG_WRITE) ?
+							    "WRITES" : "reads",
+							    vmctx_shobj[i].name);
+					break;
+				}
+		}
+		return;
+	}
+
+	vmctx_f_seen++;
+	if (mm == current->mm) {
+		vmctx_f_own++;
+	} else {
+		vmctx_f_foreign++;
+		if (mon && task_tgid_nr(current) == mon) {
+			vmctx_f_supplier++;
+		} else {
+			char owner[TASK_COMM_LEN] = "?";
+#ifdef CONFIG_MEMCG
+			struct task_struct *ow;
+
+			rcu_read_lock();
+			ow = rcu_dereference(mm->owner);
+			if (ow)
+				strscpy(owner, ow->comm, sizeof(owner));
+			rcu_read_unlock();
+#endif
+			vmctx_f_third++;
+			pr_warn_ratelimited("vmctx: THIRD-PARTY access: %s (pid %d, tgid %d) %s the address space of '%s' (slot mon_tgid %d); %s\n",
+					    current->comm,
+					    task_pid_nr(current),
+					    task_tgid_nr(current),
+					    (flags & FAULT_FLAG_WRITE) ?
+					    "WRITE-faulted" : "faulted",
+					    owner, mon,
+					    !(flags & FAULT_FLAG_WRITE) ?
+					    "reads of missing pages are refused (vmctx_foreign_refuse)" :
+					    mon ? "an attributed third-party write is refused (vmctx_third_refuse)" :
+					    "UNATTRIBUTED WRITE: what the local kernel fills here is invented");
+		}
+	}
+	if (!vma->vm_file) {
+		vmctx_f_anon++;
+	} else if (vma->vm_flags & VM_SHARED) {
+		vmctx_f_fileshared++;
+		/*
+		 * A context maps this file SHARED: register the mapping so a
+		 * foreign mm's touch on it (above) is seen. Registered from
+		 * the fault path because that is the one place the vma, the
+		 * file and the fact of the sharing are all in hand.
+		 */
+		if (host) {
+			int n = READ_ONCE(vmctx_nshobj);
+
+			for (i = 0; i < n && i < VMCTX_SHOBJ_SLOTS; i++)
+				if (vmctx_shobj[i].host == host) {
+					/*
+					 * Registered before ATTACH recorded
+					 * the monitor: refresh, or the
+					 * monitor's own object service reads
+					 * as foreign forever (measured: 1912
+					 * self-touches of memfd:vmctx-* per
+					 * suite, every real signal drowned).
+					 */
+					if (!vmctx_shobj[i].mon_tgid && mon)
+						vmctx_shobj[i].mon_tgid = mon;
+					break;
+				}
+			if (i >= VMCTX_SHOBJ_SLOTS) {
+				vmctx_shobj_overflow++;
+			} else if (i == n) {
+				spin_lock_irqsave(&vmctx_mm_lock, irqflags);
+				n = vmctx_nshobj;
+				for (i = 0; i < n; i++)
+					if (vmctx_shobj[i].host == host)
+						break;
+				if (i == n && n < VMCTX_SHOBJ_SLOTS) {
+					vmctx_shobj[n].host = host;
+					vmctx_shobj[n].mon_tgid = mon;
+					strscpy(vmctx_shobj[n].name,
+						vma->vm_file->f_path.dentry ?
+						(const char *)vma->vm_file->f_path.dentry->d_name.name :
+						"?",
+						sizeof(vmctx_shobj[n].name));
+					/* Publish the row before the count. */
+					smp_wmb();
+					WRITE_ONCE(vmctx_nshobj, n + 1);
+				} else if (i == n) {
+					vmctx_shobj_overflow++;
+				}
+				spin_unlock_irqrestore(&vmctx_mm_lock,
+						       irqflags);
+			}
+		}
+	} else {
+		vmctx_f_filepriv++;
+	}
+	if (flags & FAULT_FLAG_WRITE)
+		vmctx_f_write++;
+	if (flags & FAULT_FLAG_INSTRUCTION)
+		vmctx_f_exec++;
+}
+EXPORT_SYMBOL_GPL(vmctx_fault_seen);
+
+/* Counted by every hook that actually puts the question to a monitor. */
+void vmctx_fault_reported(void)
+{
+	vmctx_f_reported++;
+}
+EXPORT_SYMBOL_GPL(vmctx_fault_reported);
+
+vm_fault_t vmctx_foreign_file_fault(struct mm_struct *mm, int write, int shared,
+				    struct address_space *mapping, pgoff_t pgoff)
+{
+	unsigned long flags;
+	struct folio *folio;
+	int i, theirs = 0;
+
+	if (!atomic_read(&vmctx_nr_active))
+		return VM_FAULT_FALLBACK;
+	vmctx_ffile_all++;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			theirs = 1;
+			vmctx_ffile_ctx++;
+			if (!write)
+				vmctx_ffile_read++;
+			if (shared)
+				vmctx_ffile_shared++;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+
+	if (!theirs || write)
+		return VM_FAULT_FALLBACK;
+
+	/*
+	 * A foreign read splits in two, and only one half is a problem.
+	 *
+	 * If the page cache already holds this offset, mapping it is right and
+	 * necessary -- that IS the address space's memory and the reader must
+	 * see it. If it does not, shmem_fault() is about to ALLOCATE a zero
+	 * folio and insert it into the object, permanently, for an address
+	 * whose contents may be on the other machine. That is not a read; it is
+	 * an invention, and it replaces the address space's memory rather than
+	 * one task's page table, because every sibling context maps the same
+	 * object at the same offset.
+	 *
+	 * filemap_get_folio() does not allocate, so asking costs a lookup and
+	 * changes nothing. Counted first and refused only when asked to: the
+	 * count is the measurement, and the refusal is the A/B against it.
+	 */
+	if (!mapping)
+		return VM_FAULT_FALLBACK;
+	/*
+	 * ...and only where a hole means INVENTION, which is shmem and nothing
+	 * else.
+	 *
+	 * A real file has a filesystem behind it: an offset missing from the
+	 * page cache is read from disk, and refusing that read breaks a
+	 * perfectly good access without preventing anything. Only an anonymous
+	 * object -- the context's backing memfd, which is what every guest page
+	 * on a destination is mapped from -- has nothing behind a hole, so
+	 * there the allocation IS the invention.
+	 *
+	 * Measured, and this is why the test is here: turning the refusal on for
+	 * every file mapping refused 10 faults in one suite and failed tests/rd1
+	 * on both of its file cases --
+	 *
+	 *   store-forward   FAIL  write(2) from the mapping delivered ||
+	 *   exit-writeback  FAIL  the file holds || after the process ended
+	 *
+	 * -- because rd1 maps a real file and its pages legitimately arrive from
+	 * disk. The claim that the refusal 'costs nothing' rested on
+	 * vmctx_ffile_invent reading 0, and that zero had been read mid-suite on
+	 * a boot with the refusal off: the check had not run, which is the
+	 * oldest way to be sure of something false.
+	 */
+	if (!shmem_mapping(mapping)) {
+		vmctx_ffile_filed++;
+		return VM_FAULT_FALLBACK;
+	}
+	folio = filemap_get_folio(mapping, pgoff);
+	if (!IS_ERR_OR_NULL(folio)) {
+		folio_put(folio);
+		return VM_FAULT_FALLBACK;	/* the object has it: map it */
+	}
+	vmctx_ffile_invent++;
+	if (!vmctx_foreign_file_refuse)
+		return VM_FAULT_FALLBACK;
+	vmctx_ffile_refused++;
+	return VM_FAULT_SIGBUS;
+}
+EXPORT_SYMBOL_GPL(vmctx_foreign_file_fault);
+
+vm_fault_t vmctx_foreign_anon_fault(struct mm_struct *mm, int write)
+{
+	unsigned long flags;
+	pid_t mon = 0;
+	int i, theirs = 0;
+
+	if (!atomic_read(&vmctx_nr_active))
+		return VM_FAULT_FALLBACK;
+	vmctx_foreign_all++;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm) {
+			theirs = 1;
+			mon = vmctx_mms[i].mon_tgid;
+			vmctx_foreign_ctx++;
+			if (!write)
+				vmctx_foreign_read++;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+
+	if (!theirs)
+		return VM_FAULT_FALLBACK;
+	/*
+	 * A foreign WRITE is either the monitor SUPPLYING a page -- POKE and
+	 * LAND arrive exactly here, and refusing them starves the guest --
+	 * or a third party (ptrace POKEDATA, /proc/<pid>/mem writes,
+	 * process_vm_writev) about to have the local kernel mint a page the
+	 * protocol never placed. The reads have been refused since
+	 * vmctx_foreign_refuse landed; the writes could not be told apart
+	 * until the registry carried the monitor's thread group (session
+	 * 41c/41d). Now they can: an ATTRIBUTED non-monitor write is refused
+	 * like a read; an unattributed one (mon 0, the pre-service window)
+	 * still falls through, counted by the census.
+	 */
+	if (write) {
+		if (vmctx_third_refuse && mon &&
+		    task_tgid_nr(current) != mon) {
+			vmctx_third_refused++;
+			return VM_FAULT_SIGBUS;
+		}
+		return VM_FAULT_FALLBACK;
+	}
+	if (!vmctx_foreign_refuse)
+		return VM_FAULT_FALLBACK;
+	vmctx_foreign_refused++;
+	return VM_FAULT_SIGBUS;
+}
+EXPORT_SYMBOL_GPL(vmctx_foreign_anon_fault);
+
+#include <linux/anon_inodes.h>
+#include <linux/file.h>
+#include "vmctx-monitor-core.h"
+#include "vmctx-object-files.h"
+
+/* Defined below; vmctx_run_current() needs it to undo a failed start. */
+static void vmctx_finish(struct task_struct *t, struct pt_regs *regs);
+
+static void vmctx_task_free(struct kref *kref);
+static void vmctx_task_free_rcu(struct rcu_head *rcu)
+{
+	struct vmctx_task *vc = container_of(rcu, struct vmctx_task, context_rcu);
+	/* Deferred retirement also bounds stack depth for an unexported chain
+	 * of committed children: each child's final put schedules another RCU
+	 * callback rather than recursively freeing the entire ancestry. */
+	if (vc->gate_child_task) put_task_struct(vc->gate_child_task);
+	if (vc->gate_child_vc) kref_put(&vc->gate_child_vc->kref, vmctx_task_free);
+	if (vc->sys_gate_owner) put_task_struct(vc->sys_gate_owner);
+	vmctx_drop_monitor(vc);
+	vmctx_object_drop(vc);
+	kfree(vc);
+}
+static void vmctx_task_free(struct kref *kref)
+{
+	struct vmctx_task *vc = container_of(kref, struct vmctx_task, kref);
+	call_rcu(&vc->context_rcu, vmctx_task_free_rcu);
+}
+#include "vmctx-context-core.h"
+
+static struct vmctx_backend *vmctx_backend;
+static DEFINE_MUTEX(vmctx_backend_lock);
+
+/*
+ * Number of tasks currently running as VM contexts. Read on every
+ * return-to-user to decide whether the switch-path guest hook applies;
+ * kept as a plain counter so ordinary tasks pay only a load + branch.
+ */
+atomic_t vmctx_nr_active = ATOMIC_INIT(0);
+EXPORT_SYMBOL_GPL(vmctx_nr_active);
+
+bool vmctx_task_active(struct task_struct *t)
+{
+	struct vmctx_task *vc = t->vmctx;
+
+	return vc && vc->active;
+}
+EXPORT_SYMBOL_GPL(vmctx_task_active);
+
+static int vmctx_register_backend_mode(struct vmctx_backend *b, bool gated)
+{
+	int ret = 0;
+
+	if (!b || !b->create || !b->run || !b->destroy)
+		return -EINVAL;
+	mutex_lock(&vmctx_backend_lock);
+	if (vmctx_backend)
+		ret = -EBUSY;
+	else {
+		vmctx_backend = b;
+		vmctx_execution_backend = gated ? b : NULL;
+	}
+	mutex_unlock(&vmctx_backend_lock);
+	pr_info("vmctx: backend %s\n", ret ? "rejected (busy)" : "registered");
+	return ret;
+}
+
+int vmctx_register_backend(struct vmctx_backend *b)
+{
+	return vmctx_register_backend_mode(b, false);
+}
+EXPORT_SYMBOL_GPL(vmctx_register_backend);
+
+int vmctx_register_execution_backend(struct vmctx_backend *b)
+{
+	return vmctx_register_backend_mode(b, true);
+}
+EXPORT_SYMBOL_GPL(vmctx_register_execution_backend);
+
+void vmctx_unregister_backend(struct vmctx_backend *b)
+{
+	mutex_lock(&vmctx_backend_lock);
+	if (vmctx_backend == b)
+		vmctx_backend = NULL;
+	if (vmctx_execution_backend == b)
+		vmctx_execution_backend = NULL;
+	mutex_unlock(&vmctx_backend_lock);
+	pr_info("vmctx: backend unregistered\n");
+}
+EXPORT_SYMBOL_GPL(vmctx_unregister_backend);
+
+/*
+ * Set up the calling task as a VM context and return. The guest is NOT run
+ * here: it runs in the return-to-user / context-switch path
+ * (exit_to_user_mode_loop -> vmctx_guest_step). This is what makes guest
+ * entry happen at the point the scheduler switches to the task, rather than
+ * inside a syscall loop. The syscall appears to block until the guest exits
+ * because the return-to-user loop keeps re-entering the guest before it
+ * actually lets the task return to user space.
+ */
+long vmctx_run_current(struct vmctx_run_config __user *ucfg)
+{
+	struct task_struct *t = current;
+	struct vmctx_run_config cfg;
+	struct vmctx_backend *b;
+	struct vmctx_task *vc;
+	long ret;
+
+	if (copy_from_user(&cfg, ucfg, sizeof(cfg)))
+		return -EFAULT;
+	if (cfg.flags & ~(__u64)(VMCTX_FLAG_USERCODE | VMCTX_FLAG_EXIT_PROCESS |
+				 VMCTX_FLAG_REDIRECT_SYSCALL |
+				 VMCTX_FLAG_REDIRECT_FAULT |
+				 VMCTX_FLAG_WAIT_MONITOR |
+				 VMCTX_FLAG_SERVICE |
+				 VMCTX_FLAG_RESTORE))
+		return -EINVAL;
+	/* Restored registers are installed by a monitor before release. */
+	if ((cfg.flags & VMCTX_FLAG_RESTORE) &&
+	    !(cfg.flags & VMCTX_FLAG_WAIT_MONITOR))
+		return -EINVAL;
+	if (t->vmctx)
+		return -EBUSY;
+
+	/*
+	 * A service context never enters a guest, so it needs no backend and
+	 * the machine it runs on needs no virtualisation at all. That is the
+	 * point of it: the side that owns a program has to hold its memory and
+	 * make its syscalls, not execute it.
+	 */
+	if (cfg.flags & VMCTX_FLAG_SERVICE) {
+		b = NULL;
+	} else {
+		mutex_lock(&vmctx_backend_lock);
+		b = vmctx_backend;
+		if (b && !try_module_get(b->owner))
+			b = NULL;
+		mutex_unlock(&vmctx_backend_lock);
+		if (!b)
+			return -ENODEV;
+	}
+
+	vc = kzalloc(sizeof(*vc), GFP_KERNEL);
+	if (!vc) {
+		if (b)
+			module_put(b->owner);
+		return -ENOMEM;
+	}
+	kref_init(&vc->kref);
+	vmctx_object_init(vc);
+	vc->backend   = b;
+	vc->ucfg      = ucfg;
+	vc->max_exits = cfg.max_exits;
+	vc->flags     = cfg.flags;
+	vc->entry     = cfg.entry;
+	vc->backing_fd = cfg.backing_fd;
+	vc->shared_fd  = cfg.shared_fd;
+	vc->stack     = cfg.stack;
+	vc->exit_process = !!(cfg.flags & VMCTX_FLAG_EXIT_PROCESS);
+	init_waitqueue_head(&vc->ev_wq);
+	init_waitqueue_head(&vc->reply_wq);
+	init_waitqueue_head(&vc->sys_wq);
+	spin_lock_init(&vc->ev_lock);
+	mutex_init(&vc->cpu_ctl_lock);
+	spin_lock_init(&vc->sys_pages_lock);
+
+	ret = vmctx_object_bind_initial(vc);
+	if (ret) {
+		kref_put(&vc->kref, vmctx_task_free);
+		if (b) module_put(b->owner);
+		return ret;
+	}
+	task_lock(t);
+	t->vmctx = vc;
+	task_unlock(t);
+	if (b) {
+		ret = b->create(t);
+		if (ret) {
+			task_lock(t);
+			t->vmctx = NULL;
+			task_unlock(t);
+			kref_put(&vc->kref, vmctx_task_free);
+			module_put(b->owner);
+			return ret;
+		}
+	}
+
+	/* Arm the switch-path hook. The guest runs on the way back to user. */
+	vc->noted_mm = t->mm;
+	vmctx_mm_note(t->mm, !!(vc->flags & VMCTX_FLAG_SERVICE),
+		      vmctx_monitor_tgid(vc));
+	atomic_inc(&vmctx_nr_active);
+	smp_store_release(&vc->active, 1);
+
+	/*
+	 * Optionally hold the guest here until a monitor attaches. The context
+	 * exists from this point (so VMCTX_CTL_ATTACH can find it) but has not
+	 * executed yet, which closes the race where a short-lived guest runs to
+	 * completion before its monitor can attach. If nobody attaches in time,
+	 * a context that redirects anywhere is refused (see below) and one that
+	 * does not carries on handling its own events.
+	 */
+	if (cfg.flags & VMCTX_FLAG_WAIT_MONITOR) {
+		/*
+		 * A restoring monitor has work to do before the guest may run —
+		 * it installs the checkpointed registers with SETREGS — so wait
+		 * for it to say "go" with an explicit RESUME rather than
+		 * starting the moment it attaches. Without this the guest could
+		 * begin executing whatever the task's registers happened to hold
+		 * and race the restore.
+		 */
+		long left = wait_event_interruptible_timeout(vc->reply_wq,
+			READ_ONCE(vc->monitor) != NULL || READ_ONCE(vc->monitor_lost),
+			5 * HZ);
+
+		ret = (vc->flags & VMCTX_FLAG_RESTORE) ? vmctx_wait_restore(vc, left) : 0;
+		if (ret) {
+			/* Attachment alone never opens the restore gate. SETCPU may
+			 * already have replaced registers, TLS and FPU state, so an
+			 * unsuccessful restore has no native user frame to return to. */
+			pr_warn("vmctx: pid %d: restore not released (%ld); terminating executor\n",
+				task_pid_nr(t), ret);
+			vc->exit_status = ret;
+			vmctx_finish(t, NULL);
+			if (fatal_signal_pending(t))
+				do_group_exit(SIGKILL);
+			do_exit(((-ret) & 0xff) << 8);
+		}
+
+		if (!READ_ONCE(vc->monitor)) {
+			/*
+			 * Nobody came. For a context whose memory and syscalls
+			 * live on another machine that is not something to
+			 * carry on from: "handling its own events" means this
+			 * kernel inventing an anonymous zero page for every
+			 * fault and running the program's syscalls -- including
+			 * its signal dispositions -- on the wrong machine
+			 * entirely. It used to do exactly that, and say so in
+			 * one pr_info nobody reads.
+			 *
+			 * Refuse instead. A context that asked for redirection
+			 * has no meaning without the thing it redirects to.
+			 */
+			if (vc->flags & (VMCTX_FLAG_REDIRECT_FAULT |
+					 VMCTX_FLAG_REDIRECT_SYSCALL)) {
+				pr_warn("vmctx: pid %d: no monitor attached%s, and this context's memory and syscalls are not this kernel's to supply; refusing to start it\n",
+					task_pid_nr(t),
+					left == 0 ? " (timeout)" : "");
+				vc->exit_status = -ENOENT;
+				vmctx_finish(t, NULL);
+				return -ENOENT;
+			}
+			pr_info("vmctx: pid %d: no monitor attached%s; handling its own events\n",
+				task_pid_nr(t), left == 0 ? " (timeout)" : "");
+		}
+	}
+	if (vc->flags & VMCTX_FLAG_RESTORE) {
+		/* The syscall wrapper writes this return into pt_regs, just as
+		 * with native sigreturn. Preserve the installed guest AX and
+		 * remove native syscall restart semantics from the user frame. */
+		struct pt_regs *regs = task_pt_regs(t);
+
+		regs->orig_ax = -1;
+		return (long)regs->ax;
+	}
+	return 0;
+}
+
+/*
+ * Finish a VM context: write back stats, set the syscall return value (when
+ * we have the task's user regs), tear down the guest, and disarm the hook.
+ */
+static void vmctx_finish(struct task_struct *t, struct pt_regs *regs)
+{
+	struct vmctx_task *vc = t->vmctx;
+	struct vmctx_run_config cfg;
+
+	if (!vc)
+		return;
+
+	/* A source task must remain attached through native robust-futex and
+	 * clear-child-TID processing. Enter do_exit before destroying it, even
+	 * when the service loop itself requested process termination. */
+	if (regs && vc->exit_process && (vc->flags & VMCTX_FLAG_SERVICE))
+		do_exit((vc->exit_status & 0xff) << 8);
+
+	/* Execution tasks have no native source futex state. Suppress their
+	 * native exit accesses before futex_exit_release/mm_release run. The
+	 * source's corresponding task performs those operations in its own OS. */
+	if (t == current && !(vc->flags & VMCTX_FLAG_SERVICE)) {
+		t->clear_child_tid = NULL;
+		t->robust_list = NULL;
+#ifdef CONFIG_COMPAT
+		t->compat_robust_list = NULL;
+#endif
+	}
+
+	vc->terminal_status = READ_ONCE(t->exit_code);
+	vc->terminal_mm_identity = vmctx_context_mm_identity(vc->noted_mm);
+	if (vc->active) {
+		vc->active = 0;
+		/*
+		 * vc->noted_mm, not t->mm: execve replaces the address space
+		 * under a live context, and a decrement that lands on a slot
+		 * the matching increment never touched corrupts both.
+		 */
+		vmctx_mm_forget(vc->noted_mm);
+		vc->noted_mm = NULL;
+		atomic_dec(&vmctx_nr_active);
+	}
+
+	/*
+	 * Release any monitor waiting on this context: mark it dead so their
+	 * wait predicate fires, then wake them. They hold their own reference,
+	 * so the structure stays alive until they are done with it.
+	 */
+	smp_store_release(&vc->dead, 1);
+	vmctx_drop_monitor(vc);
+	vc->ev_pending = 0;
+	wake_up_all(&vc->ev_wq);
+	wake_up_all(&vc->reply_wq);
+	/*
+	 * And a monitor waiting for a syscall this context will now never
+	 * perform. Its wait tests vc->dead as well as vc->sys_done, but nothing
+	 * woke that queue, so an exit_group asked for through VMCTX_CTL_SYSCALL
+	 * -- the ordinary way to end a context with the status its program
+	 * chose -- left the monitor asleep for the full thirty-second timeout.
+	 */
+	wake_up_all(&vc->sys_wq);
+
+	if (regs && vc->ucfg) {
+		memset(&cfg, 0, sizeof(cfg));
+		cfg.max_exits       = vc->max_exits;
+		cfg.out_enters      = vc->enters;
+		cfg.out_exits       = vc->exits;
+		cfg.out_counter     = vc->counter;
+		cfg.out_faults      = vc->faults;
+		cfg.out_exit_reason = vc->last_exit_reason;
+		cfg.out_status      = vc->exit_status;
+		if (copy_to_user(vc->ucfg, &cfg, sizeof(cfg))) {
+			/* Task is on its way out; nothing more we can do. */
+		}
+		/* vmctx_run(2) "returns" the guest exit status. */
+		regs->ax = (unsigned long)(long)vc->exit_status;
+	}
+
+	{
+		bool kill_process = vc->exit_process;
+		int status = vc->exit_status;
+
+		/* Death wakes assisted callers before taking their control lock.
+		 * Once it is held, no state operation can race backend destruction. */
+		mutex_lock(&vc->cpu_ctl_lock);
+		down_write(&vc->object_sem);
+		vmctx_mn_detach(vc);
+		if (vc->backend) {
+			vc->backend->destroy(t);
+			module_put(vc->backend->owner);
+		}
+		task_lock(t);
+		t->vmctx = NULL;
+		task_unlock(t);
+		up_write(&vc->object_sem);
+		mutex_unlock(&vc->cpu_ctl_lock);
+		kref_put(&vc->kref, vmctx_task_free);
+
+		/*
+		 * When the guest *is* the process (it exec'd a program, or the
+		 * caller asked for it), a guest exit must end the process: there
+		 * is no meaningful user frame left to return to. Everything is
+		 * already torn down and t->vmctx cleared, so the do_exit() path
+		 * (which calls vmctx_task_exit) has nothing left to do.
+		 */
+		if (kill_process && regs)
+			do_exit((status & 0xff) << 8);
+	}
+}
+
+/*
+ * Run the guest once from the return-to-user loop. Called with interrupts
+ * enabled, in the task's own context — so a VMEXIT delivered as a host
+ * interrupt (e.g. the timer) is taken normally, and if it set need_resched
+ * the enclosing loop's schedule() switches this task out with the guest
+ * suspended in its VMCB. On the next switch-in we come back here and
+ * re-enter the guest.
+ */
+/*
+ * Perform the syscall a monitor asked for, here, as this task.
+ *
+ * The registers are borrowed and put back. Syscalls read their arguments out of
+ * the frame, and some write it -- so the frame has to be the task's real one
+ * rather than a copy, and it has to be restored afterwards or the guest resumes
+ * with the arguments of a call it never made.
+ *
+ * Nothing about which syscall this is appears here: the number goes through the
+ * kernel's own table, exactly as a guest's own syscall does.
+ */
+static void uregs_from_ptregs(struct vmctx_uregs *u, const struct pt_regs *r);
+
+/*
+ * Which registers differ between the frame before the call and the frame
+ * after. Computed here because both copies are in hand and the comparison is
+ * a few loads; the monitor would otherwise need the whole register set twice,
+ * across a machine boundary, to learn that a call wrote RAX.
+ */
+static __u32 vmctx_regs_changed(const struct pt_regs *a, const struct pt_regs *b)
+{
+	__u32 m = 0;
+
+	if (a->ax  != b->ax)  m |= VMCTX_REG_RAX;
+	if (a->bx  != b->bx)  m |= VMCTX_REG_RBX;
+	if (a->cx  != b->cx)  m |= VMCTX_REG_RCX;
+	if (a->dx  != b->dx)  m |= VMCTX_REG_RDX;
+	if (a->si  != b->si)  m |= VMCTX_REG_RSI;
+	if (a->di  != b->di)  m |= VMCTX_REG_RDI;
+	if (a->bp  != b->bp)  m |= VMCTX_REG_RBP;
+	if (a->sp  != b->sp)  m |= VMCTX_REG_RSP;
+	if (a->r8  != b->r8)  m |= VMCTX_REG_R8;
+	if (a->r9  != b->r9)  m |= VMCTX_REG_R9;
+	if (a->r10 != b->r10) m |= VMCTX_REG_R10;
+	if (a->r11 != b->r11) m |= VMCTX_REG_R11;
+	if (a->r12 != b->r12) m |= VMCTX_REG_R12;
+	if (a->r13 != b->r13) m |= VMCTX_REG_R13;
+	if (a->r14 != b->r14) m |= VMCTX_REG_R14;
+	if (a->r15 != b->r15) m |= VMCTX_REG_R15;
+	if (a->ip  != b->ip)  m |= VMCTX_REG_RIP;
+	if (a->flags != b->flags) m |= VMCTX_REG_RFLAGS;
+	return m;
+}
+
+/* A permission query never populates a page. Hold mmap_lock while walking
+ * so a guard marker is not confused with ordinary absent backing. */
+static bool vmctx_guarded(struct mm_struct *mm, unsigned long addr)
+{
+	pgd_t *pgd = pgd_offset(mm, addr);
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+	spinlock_t *ptl;
+	bool guard;
+
+	mmap_assert_locked(mm);
+	if (pgd_none(*pgd) || pgd_bad(*pgd))
+		return false;
+	p4d = p4d_offset(pgd, addr);
+	if (p4d_none(*p4d) || p4d_bad(*p4d))
+		return false;
+	pud = pud_offset(p4d, addr);
+	if (pud_none(*pud) || pud_leaf(*pud) || pud_bad(*pud))
+		return false;
+	pmd = pmd_offset(pud, addr);
+	if (pmd_none(*pmd) || pmd_leaf(*pmd) || pmd_bad(*pmd))
+		return false;
+	pte = pte_offset_map_lock(mm, pmd, addr, &ptl);
+	if (!pte)
+		return false;
+	guard = softleaf_is_guard_marker(softleaf_from_pte(ptep_get(pte)));
+	pte_unmap_unlock(pte, ptl);
+	return guard;
+}
+
+static int vmctx_access_check(struct mm_struct *mm, unsigned long addr, u64 err)
+{
+	struct vm_area_struct *vma;
+	int ret = 0;
+
+	mmap_read_lock(mm);
+	vma = find_vma(mm, addr);
+	if (vma && vma->vm_start > addr) {
+		vma = expand_stack(mm, addr);
+		if (!vma) /* expand_stack dropped the lock */
+			return -EFAULT;
+	}
+	if (!vma)
+		ret = -EFAULT;
+	else if ((err & X86_PF_INSTR) ? !(vma->vm_flags & VM_EXEC) :
+		 (err & X86_PF_WRITE) ? !(vma->vm_flags & VM_WRITE) :
+		 !(vma->vm_flags & (VM_READ | VM_WRITE | VM_EXEC)))
+		ret = -EACCES;
+	else if ((err & X86_PF_PK) || vmctx_guarded(mm, addr))
+		ret = -EACCES;
+	mmap_read_unlock(mm);
+	return ret;
+}
+
+/* This adapter is the program's Linux/x86 owner. The remote only reports
+ * hardware state. Signal dispositions, masks, frames, alternate stacks and
+ * FPU setup all remain in the normal source-kernel signal machinery. */
+static int vmctx_queue_exception(struct vmctx_task *vc, struct pt_regs *regs)
+{
+	unsigned int trap = vc->sys_nr;
+	unsigned long error = vc->sys_args[0];
+	unsigned long addr = vc->sys_args[1];
+	int sig, code, access;
+	void __user *where = (void __user *)regs->ip;
+
+	current->thread.trap_nr = trap;
+	current->thread.error_code = error;
+	switch (trap) {
+	case X86_TRAP_PF:
+		access = vmctx_access_check(current->mm, addr, error);
+		if (!access)
+			return 2;
+		current->thread.cr2 = addr;
+		current->thread.error_code = (error & ~X86_PF_PROT) |
+			(access == -EACCES ? X86_PF_PROT : 0);
+		sig = SIGSEGV;
+		code = access == -EFAULT ? SEGV_MAPERR : SEGV_ACCERR;
+		where = (void __user *)addr;
+		break;
+	case X86_TRAP_DB:
+		/* #DB has no error code. The reported field carries positive
+		 * polarity architectural DR6 cause bits, never a source signal. */
+		current->thread.error_code = 0;
+		vmctx_debug_user(regs, error);
+		return 0;
+	case X86_TRAP_DE: sig = SIGFPE; code = FPE_INTDIV; break;
+	case X86_TRAP_UD: sig = SIGILL; code = ILL_ILLOPN; break;
+	case X86_TRAP_BP: sig = SIGTRAP; code = SI_KERNEL; where = NULL; break;
+	case X86_TRAP_GP: sig = SIGSEGV; code = SI_KERNEL; where = NULL; break;
+	case X86_TRAP_AC: sig = SIGBUS; code = BUS_ADRALN; where = NULL; break;
+	case X86_TRAP_MF:
+	case X86_TRAP_XF: {
+		struct fpu *fpu = x86_task_fpu(current);
+
+		fpu_sync_fpstate(fpu);
+		sig = SIGFPE;
+		code = fpu__exception_code(fpu, trap);
+		if (!code)
+			return 0; /* an architecturally spurious FPU exception */
+		break;
+	}
+	default:
+		return -EINVAL; /* rejected at admission; never dispatch as a call */
+	}
+	force_sig_fault(sig, code, where);
+	return 0;
+}
+
+/* Keep native admission, the preparation wait, dispatch and exit work on
+ * the same kernel stack and current_pt_regs. No return-to-user loop or second
+ * SETCPU can overwrite a tracer's changes between admission and commit. */
+static long vmctx_run_gated_syscall(struct task_struct *t,
+				   struct vmctx_task *vc, struct pt_regs *regs)
+{
+	struct vmctx_syscall_gate *gate = &vc->syscall_gate;
+	long nr;
+	unsigned long args[6];
+
+	regs->ax = -ENOSYS;
+	nr = syscall_enter_from_user_mode_work(regs, syscall_get_nr(t, regs));
+	vc->sys_nr = nr;
+	syscall_get_arguments(t, regs, args);
+	memcpy(vc->sys_args, args, sizeof(args));
+	vc->assist_nr = nr;
+	vc->assist_arg0 = args[0];
+	gate->call.nr = nr;
+	memcpy(gate->call.args, vc->sys_args, sizeof(vc->sys_args));
+	spin_lock(&vc->sys_pages_lock);
+	for (int ai = 0; ai < 6; ai++) {
+		u64 a = vc->sys_args[ai];
+
+		if (a >= PAGE_SIZE && a < TASK_SIZE_MAX &&
+		    vc->sys_npages < (int)ARRAY_SIZE(vc->sys_pages)) {
+			vc->sys_pages_when[vc->sys_npages] = get_jiffies_64();
+			vc->sys_pages_write[vc->sys_npages] = 0;
+			vc->sys_pages[vc->sys_npages++] = a & PAGE_MASK;
+		}
+	}
+	spin_unlock(&vc->sys_pages_lock);
+	smp_store_release(&gate->state, VMCTX_GATE_ADMITTED);
+	wake_up(&vc->sys_wq);
+
+	while (smp_load_acquire(&gate->state) == VMCTX_GATE_ADMITTED) {
+		if (wait_event_killable_timeout(vc->sys_wq,
+			    smp_load_acquire(&gate->state) != VMCTX_GATE_ADMITTED ||
+			    vc->dead || !READ_ONCE(vc->monitor), HZ) < 0)
+			do_group_exit(SIGKILL);
+		if (READ_ONCE(vc->dead) || !READ_ONCE(vc->monitor) ||
+		    (READ_ONCE(vc->sys_gate_owner->flags) & PF_EXITING) ||
+		    !pid_alive(vc->sys_gate_owner))
+			do_group_exit(SIGKILL);
+	}
+	if (fatal_signal_pending(t))
+		do_group_exit(SIGKILL);
+	if (nr != -1)
+		vmctx_dispatch_syscall_number(regs, nr);
+	gate->dispatch_ret = regs->ax;
+	/* On 7.0 this helper performs only native one-time syscall work;
+	 * unlike its 6.18 counterpart it does not enter the return loop. */
+	syscall_exit_to_user_mode_work(regs);
+	return regs->ax;
+}
+
+static void vmctx_do_monitor_syscall(struct task_struct *t,
+				     struct vmctx_task *vc,
+				     struct pt_regs *regs)
+{
+	struct pt_regs saved, handed;
+	unsigned long handed_fs, handed_gs;
+	long ret;
+
+	if (!regs)
+		return;
+
+	saved = *regs;
+
+	if (vc->sys_exception == 1 || vc->sys_exception == 2) {
+		regs->orig_ax = -1; /* exceptions and checkpoints cannot restart a call */
+	} else if (vc->sys_exception != 3) {
+		regs->orig_ax = vc->sys_nr;
+		regs->ax      = vc->sys_nr;
+		regs->di      = vc->sys_args[0];
+		regs->si      = vc->sys_args[1];
+		regs->dx      = vc->sys_args[2];
+		regs->r10     = vc->sys_args[3];
+		regs->r8      = vc->sys_args[4];
+		regs->r9      = vc->sys_args[5];
+	}
+
+	/*
+	 * The frame as the call receives it, which is what the answer has to be
+	 * compared against.
+	 *
+	 * Comparing with the frame from before the arguments were placed counts
+	 * this function's own stores: setting up write(2) reported RDI, RSI,
+	 * RDX, R9, R10 and RAX as "changed by the call", when the call changed
+	 * only RAX. tests/../vmsys caught it on the first run.
+	 */
+	if (vc->sys_exception == 3) {
+		unsigned long args[6];
+
+		vc->sys_nr = syscall_get_nr(t, regs);
+		syscall_get_arguments(t, regs, args);
+		memcpy(vc->sys_args, args, sizeof(args));
+	}
+	handed = *regs;
+	handed_fs = t->thread.fsbase;
+	handed_gs = t->thread.gsbase;
+
+	/*
+	 * What this context is executing, readable by the requester that gave
+	 * up on it. A second assisted call that times out prints this; without
+	 * it a "did not perform the monitor's syscall" line names only the call
+	 * that lost, never the call that is sitting on the slot.
+	 */
+	vc->assist_nr   = vc->sys_nr;
+	vc->assist_arg0 = vc->sys_args[0];
+
+	/*
+	 * Open the window in which pages this call faults in are held against
+	 * hand-over. See the sys_pages comment in the struct: the call is
+	 * going to touch what it faulted in, and for O_DIRECT the toucher is a
+	 * device that no page table can see coming.
+	 */
+	spin_lock(&vc->sys_pages_lock);
+	vc->sys_npages = 0;
+	vc->sys_pages_over = 0;
+	vc->sys_started = get_jiffies_64();
+	/* The safety net's epoch: the call's own CPU time from here on.
+	 * t is current on this path, so the read is the task's own. */
+	vc->sys_exec_start = t->se.sum_exec_runtime;
+	/*
+	 * Seed the registry with every argument that looks like a user
+	 * address, one page each. Syscall-AGNOSTIC on purpose (no per-syscall
+	 * argument tables -- memory problems get memory-level answers): an
+	 * integer that happens to look like an address costs one irrelevant
+	 * page held for one call, which is nothing, and a buffer pointer
+	 * caught here is the difference pg3 measured. The registry is what a
+	 * call keeps across its own fault-waits (ev_pending); the presence
+	 * rule lifts there (see vmctx_syscall_holds_one), so a call's
+	 * arg-named buffer -- present at entry, touched with no fault, and
+	 * about to be touched again the instant the fault is answered -- was
+	 * protected while the call RAN but not while it WAITED, and pg3 lost
+	 * 3 of 48 through exactly that gap on the kernel that first scoped
+	 * the ev_pending arm. Registered with the write bit OFF so the
+	 * end-of-call lost-write audit stays a statement about stores the
+	 * call demonstrably made.
+	 */
+	{
+		int ai;
+
+		for (ai = 0; ai < 6; ai++) {
+			u64 a = vc->sys_args[ai];
+
+			if (a >= PAGE_SIZE && a < TASK_SIZE_MAX &&
+			    vc->sys_npages < (int)ARRAY_SIZE(vc->sys_pages)) {
+				vc->sys_pages_when[vc->sys_npages] =
+					vc->sys_started;
+				vc->sys_pages_write[vc->sys_npages] = 0;
+				vc->sys_pages[vc->sys_npages++] =
+					a & PAGE_MASK;
+			}
+		}
+	}
+	vc->in_monitor_syscall = 1;
+	spin_unlock(&vc->sys_pages_lock);
+
+	ret = vc->sys_exception == 3 ? vmctx_run_gated_syscall(t, vc, regs) :
+		vc->sys_exception == 2 ? 0 :
+		vc->sys_exception ? vmctx_queue_exception(vc, regs) :
+		vmctx_dispatch_syscall(regs);
+
+	/* Credits can expire CPU timers while the real work ran remotely.
+	 * Complete their task work at this architectural boundary before
+	 * signal frames and the CPU state are returned to the executor. */
+#ifdef CONFIG_POSIX_TIMERS
+	{
+		unsigned long timer_flags;
+		local_irq_save(timer_flags);
+		run_posix_cpu_timers();
+		local_irq_restore(timer_flags);
+	}
+#endif
+	task_work_run();
+
+	/*
+	 * And then finish the call the way this kernel finishes any syscall.
+	 *
+	 * A syscall does not end at the handler's return statement. What
+	 * follows it on the way back to user mode is the rest of the ABI:
+	 * a pending signal is delivered -- a frame pushed onto the program's
+	 * own stack and the frame pointed at the handler -- and -ERESTARTSYS
+	 * is turned into either a rewind onto the SYSCALL instruction or
+	 * -EINTR. Both of those are expressed entirely as changes to this
+	 * pt_regs, which is exactly what the monitor is handed back.
+	 *
+	 * Without this the work still happened, one iteration later, in
+	 * __exit_to_user_mode_loop() -- and was then thrown away. The order is
+	 * the whole of it: the registers were snapshotted here, the monitor was
+	 * woken with them, the loop delivered the signal into the frame
+	 * afterwards, and the next forwarded syscall's SETREGS overwrote the
+	 * result. Measured on tests/sig1.c: after the guest's raise(3), the
+	 * service context stood at rip 0x402070 -- the program's own SIGUSR1
+	 * handler -- with a complete signal frame written into the program's
+	 * stack at rsp 0x7fffffffe2f8, while the machine running the program
+	 * carried on from the instruction after its SYSCALL, never entered the
+	 * handler, and died in __printf_buffer with the frame sitting in memory
+	 * it believed was free. Three of every five runs; the two that survived
+	 * are the ones whose stack the frame happened to miss.
+	 *
+	 * Nothing here is specific to signals, and nothing decides anything: it
+	 * runs the same architecture code the return-to-user path runs, one
+	 * step earlier, so that the frame it leaves is the frame the monitor
+	 * reports. The owner of the program then does what it does with any
+	 * call that moved the program -- hands the register set back -- and the
+	 * machine executing the instructions enters the handler knowing nothing
+	 * about signals, which is the rule this whole design is built on.
+	 *
+	 * Drained rather than called once, because delivery can leave a second
+	 * signal deliverable and the loop that would have taken it is the loop
+	 * whose result is discarded. Bounded so that a flag this kernel cannot
+	 * clear cannot wedge a context here.
+	 */
+	{
+		int guard = 0;
+
+		while (!(vc->sys_exception == 1 && ret == 2) &&
+		       (test_thread_flag(TIF_SIGPENDING) ||
+			test_thread_flag(TIF_NOTIFY_SIGNAL)) && guard++ < 16)
+			arch_do_signal_or_restart(regs);
+		/*
+		 * The return value is part of that state and moves with it: a
+		 * restart puts the syscall number back in AX, and an
+		 * interrupted call becomes -EINTR. Reporting the value the
+		 * handler returned would contradict the register set reported
+		 * beside it, and the guest is given both.
+		 */
+		if (!vc->sys_exception || vc->sys_exception == 3)
+			ret = (long)regs->ax;
+	}
+
+	/*
+	 * The call is over -- including the signal delivery above, whose frame
+	 * writes may also have faulted pages in -- so nothing will touch what
+	 * it faulted in on its behalf any more. Let the pages go; a claim that
+	 * was waiting on one of them succeeds on its next ask.
+	 */
+	/*
+	 * Before letting them go: is every page this call WROTE still here?
+	 *
+	 * The list is thrown away below without ever being looked at, and it is
+	 * the only record of what the call touched. A page on it that is no
+	 * longer present was taken from this address space while the call was
+	 * writing it -- so whatever the call stored into it went to a copy the
+	 * guest can no longer see, and the guest reads whatever it had. That is
+	 * a LOST WRITE, and it is the shape pg3 fails with under a pool:
+	 *
+	 *   B round 19815: wanted |B00019815-00019815| got |B00019814-00019814|
+	 *
+	 * exactly one round stale, with the forwarded read(2) having returned
+	 * its full 18 bytes.
+	 *
+	 * Counted, not fixed, and deliberately: the hold was suspected and
+	 * MEASURED INNOCENT first -- 64 pool runs per arm with the TTL at 100ms
+	 * and at 10000ms gave 7 failures against 3, which is noise, and one
+	 * block came out backwards. So the question "is a written page actually
+	 * being taken mid-call?" has to be ASKED rather than assumed, and this
+	 * is the cheapest way to ask it: a presence check per written page, once
+	 * per forwarded call, on a list that is about to be discarded anyway.
+	 *
+	 * follow_page-free on purpose: this runs with no mmap_lock held and the
+	 * call is over, so it asks the page tables directly and tolerates a
+	 * racing answer -- a count that is occasionally one out is still the
+	 * difference between zero and not-zero, which is the whole question.
+	 */
+	if (vc->in_monitor_syscall) {
+		struct mm_struct *mm = READ_ONCE(t->mm);
+		int i, gone = 0;
+
+		spin_lock(&vc->sys_pages_lock);
+		/*
+		 * Write entries only: the registry now records read fault-ins
+		 * too (they are held while the call runs), but a read page
+		 * that left mid-call lost nothing the call stored -- counting
+		 * it here would dilute the one number that must stay zero.
+		 */
+		for (i = 0; i < vc->sys_npages; i++)
+			if (vc->sys_pages_write[i] && mm &&
+			    !vmctx_page_present_in(mm, vc->sys_pages[i]))
+				gone++;
+		/*
+		 * The denominator, and it is not optional. "0 pages were lost"
+		 * and "the check never ran" are the same reading without it,
+		 * and this project has been fooled by that difference before.
+		 */
+		vmctx_syscall_pages_checked += vc->sys_npages;
+		if (vc->sys_npages)
+			vmctx_syscall_calls_checked++;
+		if (gone) {
+			vmctx_syscall_pages_lost += gone;
+			vmctx_syscall_calls_lost++;
+			pr_warn_ratelimited("vmctx: pid %d: syscall %llu wrote %d page(s) that were gone by the time it finished (of %d it faulted in to write); anything it stored there went to a copy the guest cannot see\n",
+					    task_pid_nr(t), vc->sys_nr, gone,
+					    vc->sys_npages);
+		}
+		spin_unlock(&vc->sys_pages_lock);
+	}
+
+	spin_lock(&vc->sys_pages_lock);
+	vc->in_monitor_syscall = 0;
+	vc->sys_npages = 0;
+	vc->sys_pages_over = 0;
+	spin_unlock(&vc->sys_pages_lock);
+
+	/*
+	 * What the call did to the machine state, before the frame is put
+	 * back. The monitor is told and decides; nothing is imposed on a
+	 * context by a call it did not make itself.
+	 */
+	vc->sys_changed = vmctx_regs_changed(&handed, regs);
+	uregs_from_ptregs(&vc->sys_regs, regs);
+	/*
+	 * The bases are not in pt_regs, so they are compared separately or the
+	 * mask cannot report the one call whose whole effect is to change one.
+	 */
+	if (handed_fs != t->thread.fsbase)
+		vc->sys_changed |= VMCTX_REG_FSBASE;
+	if (handed_gs != t->thread.gsbase)
+		vc->sys_changed |= VMCTX_REG_GSBASE;
+	vc->sys_regs.fs_base = t->thread.fsbase;
+	vc->sys_regs.gs_base = t->thread.gsbase;
+
+	if (vc->sys_exception == 3) {
+		/* The native gate owns the canonical frame. GETCPU and ptrace
+		 * must see the same final state as the completed gate reply. */
+		vc->guest_fsbase = t->thread.fsbase;
+		vc->guest_gsbase = t->thread.gsbase;
+		vc->fsgs_valid = 1;
+	} else {
+		*regs = saved;
+	}
+
+	vc->sys_ret     = ret;
+	if (vc->sys_exception == 3) {
+		vc->syscall_gate.call.ret = ret;
+		vc->syscall_gate.call.changed = vc->sys_changed;
+		vc->syscall_gate.call.regs = vc->sys_regs;
+		smp_store_release(&vc->syscall_gate.state, VMCTX_GATE_COMPLETE);
+	}
+	vc->assist_nr = 0;
+	/* Release: a spinning VMCTX_CTL_SYSCALL reads the answer after this. */
+	smp_store_release(&vc->sys_done, 1);
+	/* Last store: admission may reuse the slot only after every result is final. */
+	smp_store_release(&vc->sys_pending, 0);
+	wake_up(&vc->sys_wq);
+}
+
+/*
+ * Hold a signal back until this context has somewhere to put it.
+ *
+ * A signal is delivered at an instruction boundary: the kernel pushes a frame
+ * onto the stack the program is standing on, saving the registers it was about
+ * to resume with, and points the frame at the handler. Every one of those
+ * things is a fact about where the program *is*.
+ *
+ * A service context is never where the program is. It holds the program's
+ * address space, its descriptors and its identity, and another machine executes
+ * its instructions; the one moment the two agree is while a forwarded syscall
+ * is being performed, because the monitor loads the program's registers into
+ * this task before the call and reads them back after it. Everywhere else this
+ * task's frame is a leftover — the registers of whatever call it last made —
+ * and a signal delivered against it writes a frame at an address the program is
+ * not using, saving a resume point the program passed long ago. Nothing
+ * complains: the frame is well formed, the delivery is counted, and the signal
+ * is simply gone.
+ *
+ * Measured, on tests/sig1.c's "child" case, where a second process signals a
+ * parent that is asleep in usleep(3): hits=0 after 100 waits, in a run whose
+ * other six cases all passed. The parent's context took the signal between two
+ * forwarded calls, built the frame from the previous call's registers, and the
+ * next call's SETREGS overwrote the result.
+ *
+ * So it waits. vmctx_do_monitor_syscall() runs the same delivery immediately
+ * after the call it was held for, on registers that are the program's, and the
+ * frame it leaves is reported to the monitor with the rest of the machine
+ * state.
+ *
+ * Only a signal that has somewhere to go is held, and that is the whole of the
+ * test below. A frame and a boundary are what *entering a handler* needs; a
+ * signal that kills the process, stops it, or is thrown away needs neither, and
+ * holding one is not a deferral but a refusal. The first version of this held
+ * everything except SIGKILL, and tests/pf3.c said so immediately: the owner
+ * answers an unhandled fault by setting the disposition to default and sending
+ * the signal, so all three of its children reported "exited 242 rather than
+ * dying" -- a program that had earned a SIGSEGV and could not be given one.
+ *
+ * Task work is not held either. It is not a signal, it is this kernel's own
+ * work, and holding it stalls whoever queued it.
+ */
+bool vmctx_defer_signal_work(struct task_struct *t, unsigned long ti_work)
+{
+	struct vmctx_task *vc = t->vmctx;
+	unsigned long flags;
+	sigset_t deliverable;
+	bool defer = false;
+	int sig;
+
+	if (!vc || !(vc->flags & VMCTX_FLAG_SERVICE))
+		return false;
+	if (vc->dead || !vc->active)
+		return false;
+	if (ti_work & _TIF_NOTIFY_SIGNAL)
+		return false;
+	if (fatal_signal_pending(t))
+		return false;
+
+	if (!lock_task_sighand(t, &flags))
+		return false;
+	sigorsets(&deliverable, &t->pending.signal,
+		  &t->signal->shared_pending.signal);
+	sigandnsets(&deliverable, &deliverable, &t->blocked);
+	for (sig = 1; sig < _NSIG; sig++) {
+		__sighandler_t h;
+
+		if (!sigismember(&deliverable, sig))
+			continue;
+		h = t->sighand->action[sig - 1].sa.sa_handler;
+		if (h == SIG_DFL || h == SIG_IGN) {
+			/*
+			 * Whatever this one does -- kill, stop, or nothing at
+			 * all -- it is the kernel's to do now, and doing it
+			 * needs no frame. Deliver everything and hold nothing:
+			 * a set containing one of these is not a set that can
+			 * wait.
+			 */
+			defer = false;
+			break;
+		}
+		/* A handler to enter, and no boundary to enter it at yet. */
+		defer = true;
+	}
+	unlock_task_sighand(t, &flags);
+	/*
+	 * A set that turned out to be empty leaves defer false on purpose:
+	 * TIF_SIGPENDING is then stale, and only get_signal() clears it.
+	 */
+	return defer;
+}
+EXPORT_SYMBOL_GPL(vmctx_defer_signal_work);
+
+void vmctx_guest_step(struct pt_regs *regs)
+{
+	struct task_struct *t = current;
+	struct vmctx_task *vc = t->vmctx;
+	int r;
+
+	if (!vc)
+		return;
+	/*
+	 * Hook the address space's change log before the first forwarded call
+	 * can mutate it -- for EVERY context, service ones included: the
+	 * service context is exactly the task whose mm the forwarded syscalls
+	 * run in, and it parks below without ever reaching the guest run. A
+	 * no-op when already attached to this mm; re-registers after exec.
+	 */
+/* This hook follows native syscall-exit and initial signal/ptrace
+	 * work. A newly cloned child's earlier ptrace stop is not a CPU
+	 * state that the remote executor may resume. */
+	if (vc->flags & VMCTX_FLAG_SERVICE)
+		smp_store_release(&vc->service_ready, true);
+	r = vmctx_mn_attach(vc);
+	if (r) {
+		pr_err("vmctx: pid %d: cannot subscribe to mm mutations: %d\n",
+			task_pid_nr(t), r);
+		do_exit(SIGKILL);
+	}
+	/*
+	 * Before anything else, and even for a context whose guest is not
+	 * running: a monitor waiting on this is holding a program's syscall.
+	 */
+	if (smp_load_acquire(&vc->sys_pending))
+		vmctx_do_monitor_syscall(t, vc, regs);
+	if (!vc->active)
+		return;
+	/*
+	 * A service context parks here and never returns to user mode.
+	 *
+	 * It holds a program -- its memory, its descriptors, its credentials,
+	 * its identity -- for a machine that runs that program's instructions
+	 * somewhere else. So the one thing it must never do is execute any of
+	 * them itself. Returning from here would do exactly that: the task
+	 * would carry on at whatever the program's entry point is.
+	 *
+	 * So it sleeps until there is a syscall to make, and the loop above
+	 * makes it. Interruptibly, because the task must still be killable and
+	 * must still take signals like any other.
+	 */
+	if (vc->flags & VMCTX_FLAG_SERVICE) {
+		/*
+		 * Killable rather than interruptible, and that is the other
+		 * half of vmctx_defer_signal_work().
+		 *
+		 * A signal that is being held back until the context next
+		 * completes a syscall leaves TIF_SIGPENDING set, and an
+		 * interruptible wait returns the instant that flag is set. The
+		 * loop above would then spin at full speed with the signal
+		 * never delivered and nothing else to do. A killable wait
+		 * ignores it, which is exactly the deferral this needs — and
+		 * still lets a fatal signal through, so the context is as
+		 * killable as any other task.
+		 */
+		{
+			struct vmctx_spin sp;
+
+			vmctx_spin_begin(&sp, VMCTX_SPIN_PARK);
+			vmctx_spin_wait(vc, VMCTX_SPIN_PARK,
+					smp_load_acquire(&vc->sys_pending) ||
+					READ_ONCE(vc->dead) ||
+					!READ_ONCE(vc->active));
+			wait_event_killable(vc->sys_wq,
+					    vc->sys_pending || vc->dead ||
+					    !vc->active);
+			vmctx_spin_end(vc, &sp);
+		}
+		return;
+	}
+
+	/*
+	 * execve() replaced the address space the guest was running on. Rebuild
+	 * the guest against the new mm, entering at the entry point exec set up
+	 * in the task's user frame — so the exec'd program itself runs as the
+	 * guest.
+	 */
+	if (vc->needs_rebuild) {
+		vc->needs_rebuild = 0;
+		vc->backend->destroy(t);
+		vc->entry = regs ? regs->ip : 0;
+		vc->stack = regs ? regs->sp : 0;
+		vc->exit_process = 1;   /* nothing to return to after exec */
+		r = vc->backend->create(t);
+		if (r) {
+			vc->exit_status = r;
+			vmctx_finish(t, regs);
+			return;
+		}
+		pr_debug("vmctx: pid %d rebuilt guest after exec: entry 0x%llx sp 0x%llx\n",
+			 task_pid_nr(t), vc->entry, vc->stack);
+	}
+
+	r = vc->backend->run(t);
+	if (r == VMCTX_RUN_CONTINUE) {
+		if (vc->runtime_error || vmctx_runtime_checkpoint(t, regs) < 0) {
+			vc->exit_status = vc->runtime_error ? -vc->runtime_error : -ECANCELED;
+			vmctx_finish(t, regs);
+			return;
+		}
+		if (vc->max_exits && vc->exits >= vc->max_exits) {
+			vc->exit_status = 0;
+			vmctx_finish(t, regs);
+		}
+		return;
+	}
+
+	/* VMCTX_RUN_EXIT or a negative error ends the guest. */
+	if (r < 0)
+		vc->exit_status = r;
+	vmctx_finish(t, regs);
+}
+
+/*
+ * fork()/clone(): the child must get its OWN VM context. dup_task_struct()
+ * copies task_struct wholesale, so the child arrives here holding the
+ * parent's vmctx pointer — it is overwritten unconditionally below, which is
+ * also what keeps an ordinary child of a VM context clean.
+ */
+/*
+ * kernel_clone(), once the child's pid exists (vmctx_copy_task runs before
+ * alloc_pid, so it cannot do this): remember the child's HOST-namespace pid
+ * on the parent's context. The clone's return value is the pid as the
+ * PARENT'S namespace names it -- what the guest must see -- but the monitor
+ * addresses tasks in the init namespace, and inside a sandbox's fresh pid
+ * namespace those are different numbers. VMCTX_CTL_LASTCHILD reads this
+ * back; one slot suffices because the task runs one syscall at a time and
+ * the monitor asks back-to-back with the assisted clone.
+ */
+void vmctx_clone_noted(struct task_struct *parent, pid_t host_pid)
+{
+	struct vmctx_task *vc = parent->vmctx;
+
+	if (vc && vc->active)
+		WRITE_ONCE(vc->last_child_hostpid, host_pid);
+}
+
+/* The child is visible only after copy_process and parent-TID writes have
+ * committed. Publish before the parent can stop in ptrace or vfork; returning
+ * from the parent's syscall is not a precondition for running its child. */
+void vmctx_gate_child_created(struct task_struct *parent, struct task_struct *child)
+{
+	struct vmctx_task *vc = parent->vmctx;
+	struct vmctx_syscall_gate *gate;
+
+	if (!vc || !vc->active || vc->sys_exception != 3 || !child->vmctx)
+		return;
+	gate = &vc->syscall_gate;
+	if (smp_load_acquire(&gate->state) != VMCTX_GATE_RUNNING)
+		return;
+	get_task_struct(child);
+	kref_get(&child->vmctx->kref);
+	vc->gate_child_task = child;
+	vc->gate_child_vc = child->vmctx;
+	vmctx_context_identity(child->vmctx, child);
+	gate->child_pid = task_pid_vnr(child);
+	gate->child_shared_mm = parent->mm == child->mm;
+	smp_store_release(&gate->child_host_pid, (__u64)task_pid_nr(child));
+	wake_up(&vc->sys_wq);
+}
+
+int vmctx_copy_task(struct task_struct *dst, struct task_struct *src,
+		    unsigned long clone_flags)
+{
+	struct vmctx_task *svc = src->vmctx;
+	struct vmctx_task *vc;
+	int ret;
+
+	dst->vmctx = NULL;
+
+	if (!svc || !svc->active)
+		return 0;
+	if (!dst->mm)
+		return 0;
+	/*
+	 * CLONE_VM (a thread) needs nothing special: the child shares the
+	 * address space, which is what the guest's CR3 already says, and
+	 * copy_thread() has put the new thread's stack in the child's pt_regs.
+	 */
+
+	/*
+	 * A service context has no backend: nothing is ever entered, so there
+	 * is no module holding the entry code and none to pin. Asking for one
+	 * here dereferenced NULL, which is a fork of the task that owns a
+	 * program -- exactly what a guest fork has to do.
+	 */
+	if (svc->backend && !try_module_get(svc->backend->owner))
+		return 0;
+
+	vc = kzalloc(sizeof(*vc), GFP_KERNEL);
+	if (!vc) {
+		if (svc->backend)
+			module_put(svc->backend->owner);
+		return -ENOMEM;
+	}
+
+	kref_init(&vc->kref);
+	vmctx_object_init(vc);
+	/* Inherit the run parameters, not the counters. */
+	vc->backend      = svc->backend;
+	vc->flags        = svc->flags;
+	vc->cpu_model = svc->cpu_model;
+	vc->cpu_model_ready = svc->cpu_model_ready;
+	vc->backing_fd   = svc->backing_fd;
+	/*
+	 * Inherited as it is, not copied -- which is the point of it. The
+	 * child's own memory is a copy of its parent's; this stays the same
+	 * object so a store by one is seen by the other.
+	 */
+	vc->shared_fd    = svc->shared_fd;
+	vmctx_object_copy(vc, svc);
+	vc->entry        = svc->entry;
+	vc->stack        = svc->stack;
+	vc->max_exits    = svc->max_exits;
+	vc->exit_process = 1;	/* the child has no vmctx_run frame of its own */
+	vc->ucfg         = NULL;	/* do not write stats into the child's mm  */
+	init_waitqueue_head(&vc->ev_wq);
+	init_waitqueue_head(&vc->reply_wq);
+	init_waitqueue_head(&vc->sys_wq);
+	spin_lock_init(&vc->ev_lock);
+	mutex_init(&vc->cpu_ctl_lock);
+	spin_lock_init(&vc->sys_pages_lock);
+
+	/*
+	 * Inherit the monitor. A child born without one handles its own events,
+	 * and for a context whose memory or syscalls live somewhere else that
+	 * means the kernel answers them locally — a fault becomes a zero page
+	 * and the child runs memory nobody supplied. There is no window in
+	 * which the monitor could attach instead: the child may fault before
+	 * its parent's clone() has even returned.
+	 *
+	 * Any thread of the monitoring process may drive a context, so one
+	 * monitor can service a whole process tree.
+	 */
+	vc->monitor = vmctx_monitor_get(svc);
+
+	dst->vmctx = vc;
+	/*
+	 * A backend with no clone is the destination's: it runs guest code but
+	 * never builds a child itself, because a clone is the source's to run --
+	 * the source's kernel makes the child and the destination stands up the
+	 * execution context on instruction. A service context has no backend at
+	 * all. Either way there is nothing to clone here.
+	 */
+	ret = (vc->backend && vc->backend->clone) ?
+		vc->backend->clone(dst, src) : 0;
+	if (ret) {
+		dst->vmctx = NULL;
+		kref_put(&vc->kref, vmctx_task_free);
+		if (svc->backend)
+			module_put(svc->backend->owner);
+		return ret;
+	}
+
+	vc->active = 1;
+	vc->noted_mm = dst->mm;
+	vmctx_mm_note(dst->mm, !!(vc->flags & VMCTX_FLAG_SERVICE),
+		      vmctx_monitor_tgid(vc));
+	/*
+	 * NOT wiped -- three builds of the wipe (#169/#170 session 42c,
+	 * #173 and #175 session 43), each refutation naming the next
+	 * missing serve-chain piece. A fork child's copied page tables
+	 * carry stale source-side pages, and an assisted syscall reads one
+	 * with nobody asked (the roaming exit-127 family); the wipe turns
+	 * those reads into faults, which is right, and each build then
+	 * died where the fault could not be answered:
+	 *
+	 *   #169  the private-file fallback served loader-diverged pages
+	 *         as the file's pristine bytes (closed in 43b: the refused
+	 *         COWBREAK now lands the parent's own page);
+	 *   #173  the parent read was RECURSIVE -- the parent's page wiped
+	 *         at ITS fork (closed in 43e: vmhome walks the chain to
+	 *         the nearest ancestor whose mm HOLDS the page, by
+	 *         pagemap, both in fault service and in the ctx_page
+	 *         chain serve);
+	 *   #175  a page held ONLY by the FIRST context's guest on the
+	 *         other machine: no source ancestor has it, and the
+	 *         destination's cow_give_from_chain refuses because its
+	 *         gate wants the fork-protect mark on the intermediate
+	 *         ancestor, which never held the page and so was never
+	 *         marked (gcc's grandchild TLS, "fork-protected 0").
+	 *
+	 * #175's answer was the ESCALATED break (iteration 4, kernel #177):
+	 * when every route of the asking side has failed, the ask carries
+	 * rq.len == 1 and the destination serves the nearest ancestor page
+	 * it can READ, protect mark or not. THAT WORKED -- gcc, make, git
+	 * and the whole toolchain ran green under the wipe, which proves
+	 * the serve chain is now COMPLETE for it. What iteration 4 then
+	 * measured is that the wipe's cost lands somewhere else entirely:
+	 * fork children live longer (every page re-faulted), and the
+	 * multi-child pipeline shapes wedge in the TEARDOWN ORDER -- the
+	 * destination's monitor leaves while the source still has forwarded
+	 * calls in flight for live contexts (dash parked in wait4, its
+	 * stack page stranded THEIRS, its service killed as unservable).
+	 * That is the standing lifecycle frontier (the netsurf CLAIM stall,
+	 * the session-37 join residual, the parked daemonize wall -- one
+	 * protocol hole wearing four coats), and the wipe rides on ITS
+	 * redesign, not before it. The escalated-break machinery stays in
+	 * the userspace halves, correct and dormant until then.
+	 */
+	atomic_inc(&vmctx_nr_active);
+	return 0;
+}
+
+/*
+ * execve(): called once the new address space is installed. The old guest
+ * state describes an mm that no longer exists, so mark the context for
+ * rebuild; vmctx_guest_step() re-creates it at the new entry point.
+ */
+void vmctx_exec_notify(struct task_struct *t)
+{
+	struct vmctx_task *vc = t->vmctx;
+
+	if (vc && vc->active) {
+		vc->needs_rebuild = 1;
+		/*
+		 * And the address space this context is counted into is not
+		 * the one it was counted into: exec built a new mm and freed
+		 * the old. Without this the old slot is never given back (64
+		 * of them, and the leak is permanent until reboot) and the new
+		 * mm is in no slot at all, so every fault in the exec'd
+		 * program is invented rather than asked about.
+		 */
+		if (vc->noted_mm != t->mm) {
+			vmctx_mm_forget(vc->noted_mm);
+			vc->noted_mm = t->mm;
+			vmctx_mm_note(t->mm,
+				      !!(vc->flags & VMCTX_FLAG_SERVICE),
+				      vmctx_monitor_tgid(vc));
+		}
+	}
+}
+
+/* Called from do_exit() for a task that is killed while running a guest. */
+void vmctx_task_exit(struct task_struct *t)
+{
+	struct vmctx_task *vc = t->vmctx;
+
+	vmctx_transfer_owner_exit(t);
+	vmctx_recall_owner_exit(t);
+	vmctx_quiesce_owner_exit(t);
+	/* do_exit calls this before PF_EXITING and before native futex cleanup.
+	 * Keep a source's fault service and mm record alive until exit_mm_release
+	 * has completed. Failed-fork cleanup of another task still releases it
+	 * immediately: that task will never enter do_exit itself. */
+	if (t == current && t->mm && vc && (vc->flags & VMCTX_FLAG_SERVICE))
+		return;
+	if (vc)
+		vmctx_finish(t, NULL);
+}
+
+void vmctx_task_exit_mm(struct task_struct *t)
+{
+	/* Called after the native robust-list walk and clear-TID/wake, while
+	 * current->mm remains available. No guest memory accesses follow here. */
+	if (t->vmctx)
+		vmctx_finish(t, NULL);
+}
+
+/* ---- redirection to a monitor process (avm.md objectives 2/3) ---------- */
+
+/*
+ * How long to wait between checks that the monitor is still alive — not a
+ * deadline for answering. A monitor may take arbitrarily long and still be
+ * working correctly: servicing one guest syscall can mean executing a blocking
+ * one (pselect, a read on a socket, wait4) on another machine, which finishes
+ * when the world says so. Treating slowness as death was fatal — the monitor
+ * was dropped mid-page-fault and the guest handed a blank page.
+ */
+#define VMCTX_MONITOR_POLL (2 * HZ)
+/* Say something if one event takes this long, so a real hang stays visible. */
+#define VMCTX_MONITOR_LOUD (60 * HZ)
+/*
+ * A fault is different: no correct resolution of a page fault takes two
+ * seconds. The bytes are on this machine or one network hop away, and every
+ * step that can stall (a take on a busy page) is itself bounded below a
+ * second. So an unanswered fault at two seconds is not slow, it is stuck --
+ * and the deadline's job is to turn a silent wedge into a loud, attributed
+ * failure: the fault, the monitor, and this task's kernel backtrace, then
+ * SIGBUS. The alternative was measured: the wait held mmap_read_lock for an
+ * hour and took pkill, ps, rmmod and the whole suite down with it.
+ */
+/*
+ * ...and it is a parameter, because the claim in the paragraph above is exactly
+ * the thing in doubt.
+ *
+ * Note what the loop below actually does with it: the wait is
+ * wait_event_*_timeout(..., VMCTX_MONITOR_POLL) and `waited` advances by a
+ * whole VMCTX_MONITOR_POLL each time round. Both were 2 * HZ, so the deadline
+ * fired on the FIRST poll that came back empty -- a fault answered a hair over
+ * two seconds late had no second chance, and the granularity was the whole
+ * deadline.
+ *
+ * Milliseconds, live, and **0 means never**. That last is the arm that matters:
+ * with the deadline off, a fault that is merely slow completes and the test
+ * passes, while a fault that is genuinely deadlocked hangs until the harness
+ * limit instead of dying at two seconds. One boot answers "slow or stuck?"
+ * without a rebuild and without arguing from the shape of the failure.
+ *
+ * vmctx_fault_deadline_hits counts the kills, so an arm that reports no failures
+ * can be told from an arm where the deadline simply never fired.
+ *
+ * 6000, not 2000, because the budgets nest and this is the OUTERMOST: the
+ * source's page GET socket (4 s) sits inside it, and the destination's GET
+ * handler (pull_wait 500 + claim wait 1000 + take wait 1000 ms) inside that.
+ * At 2000 the outer bound was smaller than the middle one, and under pool
+ * load a GET that merely ran long ended its context (exit 13, 2 of 256 hx2
+ * runs). The tools raise a lower live value to this at start-up
+ * (vmctx_deadline_enforce); the default is here so a reboot agrees with them.
+ */
+static unsigned int vmctx_fault_deadline_ms = 6000;
+static long vmctx_fault_deadline_hits;
+core_param(vmctx_fault_deadline_ms, vmctx_fault_deadline_ms, uint, 0644);
+core_param(vmctx_fault_deadline_hits, vmctx_fault_deadline_hits, long, 0644);
+#define VMCTX_FAULT_DEADLINE (msecs_to_jiffies(READ_ONCE(vmctx_fault_deadline_ms)))
+
+/*
+ * Publish an event, wake the monitor, and wait for its reply. Returns the
+ * monitor's action, or VMCTX_ACT_SELF if there is nobody to ask, the wait was
+ * interrupted, or the monitor did not answer in time.
+ */
+static u32 vmctx_report(struct task_struct *t, struct vmctx_task *vc)
+{
+	long left;
+	u32 action;
+	int withdrew = 0;	/* this side took the event back off the queue */
+
+	/*
+	 * A monitor that is on its way out cannot answer -- but a DEAD
+	 * monitor is not a licence to improvise. This used to return
+	 * ACT_SELF here, and for a context whose memory lives on another
+	 * machine ACT_SELF is an unrecoverable -14 on the first fault:
+	 * measured as nc1's orphaned server, whose monitor was the thread
+	 * that SPAWNED it (the parent context's service), dead an instant
+	 * later when the parent guest exited -- "monitor gone; handling its
+	 * own events", then #PF at a libc address, exit 242, while the
+	 * child's own service thread was mid-attach and retrying. A dead
+	 * monitor is now the same case as no monitor yet: drop it and fall
+	 * through to publish, and the event waits for the successor under
+	 * the fault deadline exactly as a not-yet-attached context's first
+	 * event always has.
+	 */
+	if (vmctx_monitor_drop(vc, true)) {
+		pr_info("vmctx: pid %d: monitor gone; the event waits for a successor\n",
+			task_pid_nr(t));
+	}
+
+	vc->ev.pid   = task_pid_nr(t);
+	spin_lock(&vc->ev_lock);
+	vc->ev_taken      = 0;
+	vc->reply_pending = 0;
+	/* Release: a spinning VMCTX_CTL_WAIT copies vc->ev after this. */
+	smp_store_release(&vc->ev_pending, 1);
+	spin_unlock(&vc->ev_lock);
+	wake_up_interruptible(&vc->ev_wq);
+
+	{
+		unsigned long started = jiffies, waited = 0;
+		int moaned = 0;
+		struct vmctx_spin sp;
+
+		vmctx_spin_begin(&sp, VMCTX_SPIN_REPLY);
+		vmctx_spin_wait(vc, VMCTX_SPIN_REPLY,
+				smp_load_acquire(&vc->reply_pending) ||
+				!READ_ONCE(vc->monitor));
+		for (;;) {
+			/*
+			 * Once the monitor has taken the event, this wait must
+			 * not be cut short by a signal. Giving up here ends in
+			 * VMCTX_ACT_RETRY, which rewinds the instruction and
+			 * runs the syscall a second time — but the first one has
+			 * already executed on the other machine, with its
+			 * effects. A read() that consumed its bytes from a pipe
+			 * consumes the next ones on the retry: links reads the
+			 * resolver's answer, is interrupted by the SIGCHLD its
+			 * own resolver child just sent, reads again, gets the
+			 * one trailing byte that followed the answer, and calls
+			 * the lookup failed. The signal is not lost by waiting —
+			 * it is delivered on the way back to userspace, which is
+			 * where a syscall's signals are delivered anyway.
+			 *
+			 * That makes this sleep TASK_UNINTERRUPTIBLE, which in
+			 * turn decides what may wake it: wake_up(), never
+			 * wake_up_interruptible(), because that one matches
+			 * TASK_INTERRUPTIBLE sleepers and walks past this one.
+			 * It did, and the context then slept out the whole poll
+			 * interval with its reply already sitting in front of
+			 * it — two seconds on a syscall, whenever a signal
+			 * arrived while the monitor held the event. A guest
+			 * that forks is guaranteed one: SIGCHLD, the moment its
+			 * child exits.
+			 */
+			/*
+			 * The uninterruptible form is for syscalls, where a
+			 * re-run has effects (the 26-line rationale below).
+			 * FAULT and RUNTIME events have no such hazard -- asking for a
+			 * page twice is asking for a page -- so a taken fault
+			 * still yields to a fatal signal. What that buys is
+			 * measured, twice: a monitor that took a fault and
+			 * never answered ("monitor still working on one event
+			 * after 60s") left this task asleep here holding
+			 * mmap_read_lock, and pkill, ps and rmmod queued in
+			 * D-state behind it until the box read load 6 at 0%%
+			 * CPU. SIGKILL must end that context, and with the
+			 * uninterruptible wait it could not.
+			 */
+			if (vc->ev_taken && (vc->ev.type == VMCTX_EV_FAULT ||
+					     vc->ev.type == VMCTX_EV_RUNTIME))
+				left = wait_event_killable_timeout(vc->reply_wq,
+						vc->reply_pending || !READ_ONCE(vc->monitor),
+						VMCTX_MONITOR_POLL);
+			else if (vc->ev_taken)
+				left = wait_event_timeout(vc->reply_wq,
+						vc->reply_pending || !READ_ONCE(vc->monitor),
+						VMCTX_MONITOR_POLL);
+			else
+				left = wait_event_interruptible_timeout(vc->reply_wq,
+						vc->reply_pending || !READ_ONCE(vc->monitor),
+						VMCTX_MONITOR_POLL);
+			if (vc->reply_pending || !READ_ONCE(vc->monitor))
+				break;
+			/*
+			 * A taken event is NOT abandoned on a signal, fatal or
+			 * not. That branch was here and pg3 convicted it: dmesg
+			 * showed "pid 432385: a reply arrived for an event its
+			 * waiter had abandoned; the syscall may have run twice"
+			 * with no deadline warning before it -- so the context
+			 * was killed while its monitor was mid-answer, home's
+			 * next syscall for it returned "context gone", every
+			 * subsequent TAKE answered -EINVAL (not a VM context),
+			 * the pull failed -EFAULT, and the guest died fetching
+			 * instructions at 0. The kernel printed the exact
+			 * hazard the uninterruptible-wait comment below warns
+			 * about.
+			 *
+			 * Fatal fault cancellation below ends execution with KILL,
+			 * never RETRY. Nonfatal signals cannot abandon taken work;
+			 * an actual elapsed fault deadline separately bounds a
+			 * monitor that remains alive without answering.
+			 */
+			/* A fatal cancellation ends this context; it never retries the
+			 * instruction or authorizes native fault handling. A killable
+			 * wait interrupted by SIGKILL has consumed no polling interval
+			 * and must not be counted as an expired fault deadline. */
+			if ((vc->ev.type == VMCTX_EV_FAULT || vc->ev.type == VMCTX_EV_RUNTIME) &&
+			    fatal_signal_pending(t)) {
+				spin_lock(&vc->ev_lock);
+				vc->ev_abandoned = vc->ev_taken;
+				vc->ev_pending = 0;
+				spin_unlock(&vc->ev_lock);
+				return VMCTX_ACT_KILL;
+			}
+			if (left != 0 && !vc->ev_taken) {
+				/*
+				 * A signal, and as far as this side can see the
+				 * monitor has not started on the event -- so
+				 * withdraw it and let the guest re-execute the
+				 * instruction once the signal has been handled.
+				 *
+				 * Withdrawing and the monitor's dequeue settle
+				 * the same question, so they are done under one
+				 * lock. They used to be separate unlocked reads
+				 * with the whole exit path of this wait between
+				 * them, and the monitor could take the event in
+				 * that gap: the instruction was rewound anyway
+				 * and the guest ran a syscall the monitor was at
+				 * that moment running. Marking the event
+				 * abandoned made the late *reply* be discarded,
+				 * which does not unmake the write(2) it had
+				 * already performed -- th9 emitted forty lines
+				 * and printed forty-one, "thread 36 ok" twice,
+				 * about once in fifty runs.
+				 *
+				 * If it turns out the monitor did claim it, this
+				 * is not ours to withdraw: go round again, which
+				 * now sleeps uninterruptibly because ev_taken is
+				 * set.
+				 */
+				spin_lock(&vc->ev_lock);
+				withdrew = !vc->ev_taken;
+				if (withdrew)
+					vc->ev_pending = 0;
+				spin_unlock(&vc->ev_lock);
+				if (withdrew)
+					break;
+				continue;
+			}
+			/*
+			 * Nothing yet. That only matters if the monitor is gone;
+			 * if it is alive, it is still working on this event.
+			 */
+			if (!vmctx_monitor_alive(vc))
+				break;
+			waited = jiffies - started;
+			if (vc->ev.type == VMCTX_EV_FAULT &&
+			    READ_ONCE(vmctx_fault_deadline_ms) &&
+			    waited >= VMCTX_FAULT_DEADLINE) {
+				struct task_struct *mon = vmctx_monitor_get(vc);
+				char comm[TASK_COMM_LEN] = "?";
+
+				if (mon)
+					get_task_comm(comm, mon);
+				pr_warn("vmctx: pid %d: fault at 0x%llx (err 0x%llx rip 0x%llx) unanswered for %lus by monitor %d (%s); ending context after elapsed fault deadline; waiter backtrace follows\n",
+					task_pid_nr(t),
+					(unsigned long long)vc->ev.fault_addr,
+					(unsigned long long)vc->ev.fault_err,
+					(unsigned long long)vc->ev.rip,
+					waited / HZ,
+					mon ? task_pid_nr(mon) : -1, comm);
+				dump_stack();
+				/*
+				 * ...and the stack of the MONITOR, which is the
+				 * half that was missing.
+				 *
+				 * The waiter's backtrace only ever says "it is
+				 * waiting", which was never in doubt. What
+				 * decides this is what the monitor is doing
+				 * instead of answering: blocked performing some
+				 * OTHER context's forwarded syscall, asleep on
+				 * a lock, or waiting on the far machine. The
+				 * monitor is alive (tested just above), so it
+				 * is stuck rather than gone, and its kernel
+				 * stack names what it is stuck on.
+				 *
+				 * ev_taken says whether it ever picked this
+				 * event up: "not taken" and "taken and stuck"
+				 * are different bugs and the message could not
+				 * tell them apart.
+				 */
+				pr_warn("vmctx: ...the monitor had%s taken this event; its stack:\n",
+					vc->ev_taken ? "" : " NOT");
+				if (mon) {
+					sched_show_task(mon);
+					put_task_struct(mon);
+				}
+				vmctx_fault_deadline_hits++;
+				spin_lock(&vc->ev_lock);
+				vc->ev_abandoned = vc->ev_taken;
+				vc->ev_pending = 0;
+				spin_unlock(&vc->ev_lock);
+				return VMCTX_ACT_KILL;
+			}
+			if (waited >= VMCTX_MONITOR_LOUD && !moaned) {
+				moaned = 1;
+				pr_info("vmctx: pid %d: monitor still working on one event after %lus (alive; waiting)\n",
+					task_pid_nr(t), waited / HZ);
+			}
+		}
+		vmctx_spin_end(vc, &sp);
+	}
+	if (!vc->reply_pending) {
+		/*
+		 * Three different things end this wait, and they must not be
+		 * treated alike.
+		 *
+		 * A signal says nothing about the monitor. Deciding otherwise
+		 * loses the context's memory: a forked parent is guaranteed a
+		 * SIGCHLD when its child exits, and answering its fault in the
+		 * kernel means fabricating an anonymous zero page — the real
+		 * page is on another machine. It then runs blank memory, dying
+		 * somewhere unrelated with nothing in the log. Leave the monitor
+		 * alone and let the caller re-take the event once the signal has
+		 * been delivered.
+		 */
+		if (withdrew)
+			return VMCTX_ACT_RETRY;
+		spin_lock(&vc->ev_lock);
+		vc->ev_pending = 0;
+		spin_unlock(&vc->ev_lock);
+		/* The monitor is gone, or it detached while we waited. */
+		pr_warn("vmctx: pid %d: monitor is gone; its events are handled in-kernel from now on\n",
+			task_pid_nr(t));
+		vc->monitor_lost = 1;
+		vmctx_drop_monitor(vc);
+		return VMCTX_ACT_SELF;
+	}
+
+	action = vc->reply.action;
+	vc->reply_pending = 0;
+	return action;
+}
+
+/*
+ * Apply to the guest's address space whatever the reply said happened to it.
+ *
+ * Runs in the context's own task, which is the only place it can: vm_mmap,
+ * vm_munmap and vmctx_mprotect all act on current->mm, and there is no remote
+ * form of any of them. The monitor decides *what* changed -- it is the side
+ * that performed the call on the machine owning the program -- and says so in
+ * three words that name no syscall.
+ *
+ * SET maps from the backing object at the address that is also its offset, the
+ * same identity vmctx_back_fault() uses, so a context that shares the object
+ * with its siblings gets the mapping they get. PROT changes permission without
+ * touching contents; re-mapping would have been simpler and would have thrown
+ * away anything mapped privately.
+ */
+static void vmctx_apply_map(struct task_struct *t, struct vmctx_task *vc);
+
+/*
+ * The mapping change itself, taken by value.
+ *
+ * It used to read vc->reply directly, which is fine for the context whose reply
+ * it is and wrong for anyone else's: a sibling is running its own guest and may
+ * have a reply in flight, so borrowing its slot to describe someone else's mmap
+ * corrupts it. VMCTX_CTL_APPLYMAP needs to apply a change to a context that did
+ * not make the call, so the change travels as an argument.
+ */
+/*
+ * Mapping changes a monitor asked to be applied to a task that is not the
+ * caller and that the kernel has no remote form of (SET, PROT): refused, so
+ * that vm_mmap()/do_mprotect_pkey() never act on the MONITOR's own mm.
+ */
+static long vmctx_apply_map_remote_refused;
+core_param(vmctx_apply_map_remote_refused, vmctx_apply_map_remote_refused, long, 0644);
+
+static long vmctx_map_object_page(struct task_struct *target,
+				  unsigned long addr, bool write);
+
+static void vmctx_apply_map_rep(struct task_struct *t, struct vmctx_task *vc,
+				const struct vmctx_reply *rep)
+{
+	unsigned long off = rep->map_addr & ~PAGE_MASK;
+	unsigned long addr = rep->map_addr & PAGE_MASK;
+	unsigned long len = PAGE_ALIGN(rep->map_len + off);
+	struct file *bf;
+	unsigned long got;
+	long r;
+
+	if (rep->map_op == VMCTX_MAP_NONE || !len)
+		return;
+
+	switch (rep->map_op) {
+	case VMCTX_MAP_UNMAP:
+		/*
+		 * The context's own mm, whoever is calling. Every other op here
+		 * is applied by the context itself at resume, where
+		 * current == t and vm_munmap() is right; the ctl form
+		 * (VMCTX_CTL_APPLYMAP) runs on the MONITOR's thread, and an
+		 * unmap through vm_munmap() there would take ranges out of the
+		 * monitor instead of the guest. The monitor needs the cross-
+		 * task form for exactly one job: a successful exec replaced
+		 * the guest's address space at the source, and every mapping
+		 * this context still carries describes the PREVIOUS image --
+		 * present stale pages that never fault again and hand the new
+		 * image's ld.so the old image's data (firefox's fork+exec
+		 * children, byte-identical death at 0x7ffff7fb6188).
+		 */
+		if (t == current) {
+			r = vm_munmap(addr, len);
+		} else {
+			struct mm_struct *mm = get_task_mm(t);
+
+			if (!mm) {
+				r = -ESRCH;
+			} else if (mmap_write_lock_killable(mm)) {
+				mmput(mm);
+				r = -EINTR;
+			} else {
+				r = do_munmap(mm, addr, len, NULL);
+				mmap_write_unlock(mm);
+				mmput(mm);
+			}
+		}
+		if (r)
+			pr_warn_ratelimited("vmctx: pid %d: cannot unmap 0x%lx+0x%lx for the guest: %ld\n",
+					    task_pid_nr(t), addr, len, r);
+		return;
+	case VMCTX_MAP_ZAP: {
+		/*
+		 * Drop the PAGES of the range and leave the mappings: the
+		 * guest-side application of a source MADV_DONTNEED. The next
+		 * touch faults through the ordinary service, which asks the
+		 * machine that owns the program and gets the fresh content
+		 * (zero-fill for private anonymous, the file's bytes for a
+		 * file mapping). A hole in the range is not an error (an
+		 * untouched page has nothing to drop).
+		 *
+		 * The zap loop is written out rather than do_madvise(): the
+		 * remote-mm DONTNEED path through do_madvise is one nothing
+		 * in-tree takes (io_uring advises its own mm; process_madvise
+		 * forbids DONTNEED), and walking it tripped
+		 * untagged_addr_remote()'s held-mmap-lock assertion inside
+		 * get_untagged_addr() before madvise's own per-VMA locking
+		 * had taken anything -- a WARN storm per run on the
+		 * destination, and the same assert firing silently tainted
+		 * the source. What DONTNEED does to pages IS
+		 * zap_page_range_single() per VMA under mmap_read_lock, so
+		 * that is what runs, skipping the VMA kinds madvise itself
+		 * refuses (pfn/IO, locked, hugetlb).
+		 */
+		struct mm_struct *mm = t == current ? current->mm :
+				       get_task_mm(t);
+		struct vm_area_struct *vma;
+		unsigned long s, e;
+
+		if (!mm)
+			return;
+		mmap_read_lock(mm);
+		{
+			VMA_ITERATOR(vmi, mm, addr);
+
+			for_each_vma_range(vmi, vma, addr + len) {
+				if (vma->vm_flags & (VM_PFNMAP | VM_IO |
+						     VM_LOCKED | VM_HUGETLB))
+					continue;
+				s = max(addr, vma->vm_start);
+				e = min(addr + len, vma->vm_end);
+				if (s < e)
+					zap_page_range_single(vma, s, e - s,
+							      NULL);
+			}
+		}
+		mmap_read_unlock(mm);
+		if (t != current)
+			mmput(mm);
+		return;
+	}
+	case VMCTX_MAP_PROT: {
+		/*
+		 * A page at a time, because this address space has holes in it
+		 * by construction.
+		 *
+		 * The guest's memory here is whatever it has faulted on: a
+		 * range of the program as it was loaded exists one page at a
+		 * time, as vmctx_back_fault() supplies them. mprotect(2) refuses
+		 * a range containing an unmapped page outright -- ENOMEM, and it
+		 * changes nothing at all -- so a single call over such a range
+		 * applied the protection to none of it.
+		 *
+		 * That is not a missed optimisation. musl and glibc both make
+		 * the relocation-read-only segment read-only during start-up,
+		 * and it spans more pages than the program has touched by then:
+		 * "cannot set prot 0x1 on 0x4ca000+0x5000 ... -12" is that call,
+		 * and after it the segment stayed writable for the rest of the
+		 * run.
+		 *
+		 * A hole is not an error here. It is an address the guest has
+		 * not asked for yet, and when it does, the fault path supplies
+		 * it -- so the protection that matters is the one on the pages
+		 * that exist now.
+		 */
+		unsigned long p, done = 0, missing = 0;
+
+		/*
+		 * Only the task itself can change its own protections:
+		 * do_mprotect_pkey() acts on current->mm, and there is no
+		 * remote form of it. Applied from VMCTX_CTL_APPLYMAP (the
+		 * monitor is current) it would change the MONITOR's mappings
+		 * -- or, before the SET guard below existed, the guest mappings
+		 * a cross-task SET had put there. The sibling's own next fault
+		 * re-establishes the protection the monitor records.
+		 */
+		if (t != current) {
+			vmctx_apply_map_remote_refused++;
+			pr_warn_ratelimited("vmctx: pid %d: PROT 0x%x on 0x%lx+0x%lx asked for a task that is not the caller; refused -- the kernel cannot change another task's protections, and must not change the monitor's\n",
+					    task_pid_nr(t), rep->map_prot,
+					    addr, len);
+			return;
+		}
+		for (p = addr; p < addr + len; p += PAGE_SIZE) {
+			r = vmctx_mprotect(p, PAGE_SIZE, rep->map_prot);
+			if (!r)
+				done++;
+			else if (r == -ENOMEM)
+				missing++;
+			else
+				pr_warn_ratelimited("vmctx: pid %d: cannot set prot 0x%x on 0x%lx for the guest: %ld\n",
+						    task_pid_nr(t),
+						    rep->map_prot, p, r);
+		}
+		pr_debug("vmctx: pid %d: prot 0x%x on 0x%lx+0x%lx: %lu pages set, %lu not mapped yet\n",
+			 task_pid_nr(t), rep->map_prot, addr, len, done, missing);
+		return;
+	}
+	case VMCTX_MAP_SET_SHARED_PAGE:
+	case VMCTX_MAP_SET_SHARED:
+	case VMCTX_MAP_SET_POPULATE:
+	case VMCTX_MAP_SET: {
+		bool shared = rep->map_op == VMCTX_MAP_SET_SHARED ||
+			      rep->map_op == VMCTX_MAP_SET_SHARED_PAGE;
+		unsigned long extra = rep->map_op == VMCTX_MAP_SET_POPULATE
+				? MAP_POPULATE : 0;
+
+		/*
+		 * The same rule, and this one was measured: vm_mmap() maps
+		 * into current->mm. Applied cross-task, a SET for a sibling
+		 * context mapped the guest's backing object into the
+		 * MONITOR's own address space at the guest address
+		 * (photographed on tests/mf2: 7ffff57f0000-7ffff77f4000
+		 * rw-s /memfd:vmctx-guest in vmremote itself), and every
+		 * context the monitor clone()d afterwards inherited that VMA
+		 * -- a forked child among them, which then read its PARENT's
+		 * stack through it while its own object held the right bytes.
+		 * A sibling not given a SET maps the range on its own next
+		 * fault, in its own task, where the kernel can do it.
+		 */
+		if (t != current) {
+			vmctx_apply_map_remote_refused++;
+			pr_warn_ratelimited("vmctx: pid %d: SET 0x%lx+0x%lx asked for a task that is not the caller; refused -- vm_mmap would map it into the monitor's own mm\n",
+					    task_pid_nr(t), addr, len);
+			return;
+		}
+		/*
+		 * A shared mapping with no object is not a mapping to make
+		 * quietly private.
+		 *
+		 * Below, a NULL file means MAP_PRIVATE|MAP_ANONYMOUS, which is
+		 * the right answer for a context that was given no memory
+		 * object at all. It is the wrong answer for a range the owner
+		 * called shared: the guest gets private zeroed memory, every
+		 * read of it comes back empty, and nothing anywhere says so.
+		 * Refusing leaves no mapping, so the fault path supplies the
+		 * page as it would for any address -- wrong too, but visibly.
+		 */
+		if (rep->map_op == VMCTX_MAP_SET_SHARED_PAGE &&
+		    (off || len != PAGE_SIZE ||
+		     (rep->map_off & ~PAGE_MASK)))
+			return;
+		bf = vmctx_object_file(vc, shared);
+		if (shared && !bf) {
+			pr_warn_ratelimited("vmctx: pid %d: 0x%lx+0x%lx is shared but this context has no shared object; not mapping it\n",
+					    task_pid_nr(t), addr, len);
+			return;
+		}
+
+		if (rep->map_op == VMCTX_MAP_SET_SHARED_PAGE &&
+		    (!bf || !shmem_mapping(bf->f_mapping))) {
+			if (bf) fput(bf);
+			return;
+		}
+		got = vm_mmap(bf, addr, len, rep->map_prot,
+			      (bf ? MAP_SHARED : (MAP_PRIVATE | MAP_ANONYMOUS))
+			      | MAP_FIXED, bf ? rep->map_off : 0);
+		if (bf)
+			fput(bf);
+		if (IS_ERR_VALUE(got)) {
+			pr_warn_ratelimited("vmctx: pid %d: cannot map 0x%lx+0x%lx prot 0x%x for the guest: %ld\n",
+					    task_pid_nr(t), addr, len,
+					    rep->map_prot, (long)got);
+			return;
+		}
+		/*
+		 * POPULATE, by hand rather than MAP_POPULATE: mm_populate()
+		 * refuses to write-fault a shared mapping (dirty accounting),
+		 * so it would install READ-ONLY entries and a writable
+		 * range's every first store would still exit to the monitor
+		 * -- a protection fault per page, which is what this op
+		 * exists to remove. The ordinary fault path is run here in
+		 * the context's own task with FOLL_WRITE where the mapping
+		 * allows writing, exactly as the context's own store would,
+		 * and the reference is dropped on the spot: only the page
+		 * table entry is the point. The monitor names only pages it
+		 * has verified the object holds, so no fault here allocates.
+		 */
+		if (rep->map_op == VMCTX_MAP_SET_SHARED_PAGE) {
+			/* The folio lock spans lookup and PTE installation, like
+			 * TAKEOBJ spans unmap and removal. If it moved meanwhile,
+			 * leave the PTE absent and let the monitor retry. */
+			vmctx_map_object_page(t, addr, !!(rep->map_prot & PROT_WRITE));
+			return;
+		}
+		if (extra) {
+			unsigned int gup = (rep->map_prot & 0x2 /* PROT_WRITE */)
+					   ? FOLL_WRITE : 0;
+			unsigned long p;
+
+			for (p = addr; p < addr + len; p += PAGE_SIZE) {
+				struct page *pg = NULL;
+
+				if (get_user_pages_fast(p, 1, gup, &pg) == 1)
+					put_page(pg);
+			}
+		}
+		return;
+	}
+	default:
+		pr_warn_ratelimited("vmctx: pid %d: unknown map op %u in a reply\n",
+				    task_pid_nr(t), rep->map_op);
+		return;
+	}
+}
+
+/*
+ * There is deliberately no way for this kernel to turn a guest's exception into
+ * a signal.
+ *
+ * vmctx_force_fault() stood here, exported for a backend to call. Nothing
+ * called it: an exception is published to the monitor as a raw vector and the
+ * monitor answers with a register set. Keeping an exported "make this a signal"
+ * primitive invites the destination to decide what a vector means, which is the
+ * owner's business and not portable to a destination that is not Linux.
+ */
+
+/* An execution budget is architectural scheduling information. The source
+ * handles pending work at this boundary and returns complete CPU state; this
+ * kernel never interprets a source clock, signal or syscall identifier. */
+static int vmctx_runtime_checkpoint(struct task_struct *t, struct pt_regs *regs)
+{
+	struct vmctx_task *vc = t->vmctx;
+	u32 action;
+	if (!vc->runtime_quantum ||
+	    vc->runtime_total - vc->runtime_reported < vc->runtime_quantum)
+		return 0;
+	if (!READ_ONCE(vc->monitor)) return -ENOTCONN;
+	vc->runtime_reported = vc->runtime_total;
+	memset(&vc->ev, 0, sizeof(vc->ev));
+	vc->ev.type = VMCTX_EV_RUNTIME;
+	vc->ev.rip = regs->ip;
+	vc->ev.rsp = regs->sp;
+	vc->ev.rflags = regs->flags;
+	action = vmctx_report(t, vc);
+	/* A host fatal signal cancels the executor lifetime. Preserve that
+	 * signal instead of translating it into a normal checkpoint error. */
+	if (fatal_signal_pending(t))
+		do_group_exit(SIGKILL);
+	if (action != VMCTX_ACT_DONE) return -ECANCELED;
+	/* SETCPU supplied the full result. Unlike a syscall, a checkpoint
+	 * has no return value with which to overwrite the guest's AX. */
+	vmctx_apply_map(t, vc);
+	return 0;
+}
+
+int vmctx_redirect_syscall(struct task_struct *t, struct pt_regs *regs)
+{
+	struct vmctx_task *vc = t->vmctx;
+	u32 action;
+
+	if (!vc || !READ_ONCE(vc->monitor) || !(vc->flags & VMCTX_FLAG_REDIRECT_SYSCALL))
+		return 0;
+
+	memset(&vc->ev, 0, sizeof(vc->ev));
+	vc->ev.type    = VMCTX_EV_SYSCALL;
+	vc->ev.nr      = regs->orig_ax;
+	vc->ev.args[0] = regs->di;
+	vc->ev.args[1] = regs->si;
+	vc->ev.args[2] = regs->dx;
+	vc->ev.args[3] = regs->r10;
+	vc->ev.args[4] = regs->r8;
+	vc->ev.args[5] = regs->r9;
+	vc->ev.rip     = regs->ip;
+	vc->ev.rsp     = regs->sp;
+	vc->ev.rflags  = regs->flags;
+
+	action = vmctx_report(t, vc);
+	switch (action) {
+	case VMCTX_ACT_DONE:
+		regs->ax = vc->reply.retval;
+		vmctx_apply_map(t, vc);
+		return 1;
+	case VMCTX_ACT_KILL:
+		return -ECANCELED;
+	case VMCTX_ACT_RETRY:
+		/*
+		 * Nobody serviced this. The module already stepped over the
+		 * SYSCALL instruction, so rewind: the guest re-executes it once
+		 * the signal has been handled, and the monitor sees it then.
+		 * Handling it in the kernel instead would run the guest's
+		 * syscall on the wrong machine.
+		 */
+		regs->ip -= 2;
+		return 1;
+	default:
+		return 0;
+	}
+}
+EXPORT_SYMBOL_GPL(vmctx_redirect_syscall);
+
+/*
+ * What this side knows about the page a fault landed on.
+ *
+ * The monitor otherwise has to infer whether a fault is the protocol's doing
+ * or the program's, and guesses when its own records are silent. The two are
+ * distinguishable here and nowhere else: the VMA is what the program asked
+ * for, the PTE is what coherence has done to it since.
+ *
+ * Nothing here may block on a lock. This runs while a fault is being reported,
+ * and one of the two paths that report faults is the kernel's own -- which
+ * arrives holding mmap_read_lock. Taking it again is not slow, it is a
+ * deadlock: a writer queued in between makes the second down_read wait for a
+ * lock the caller is still holding, and the machine stops. So the mm path says
+ * so and is not inspected, and even the other path only tries for the lock.
+ */
+static void vmctx_page_state(struct vmctx_task *vc, struct mm_struct *mm,
+			     unsigned long addr, __u64 *flags, __u64 *vmaprot)
+{
+	struct vm_area_struct *vma;
+	spinlock_t *ptl;
+	pte_t *ptep;
+
+	*flags = 0;
+	*vmaprot = 0;
+	if (!mm || vc->in_mm_fault) {
+		*flags = VMCTX_PGS_UNKNOWN;
+		return;
+	}
+	if (!mmap_read_trylock(mm)) {
+		*flags = VMCTX_PGS_UNKNOWN;
+		return;
+	}
+	vma = vma_lookup(mm, addr);
+	if (vma) {
+		*flags |= VMCTX_PGS_MAPPED;
+		if (vma->vm_flags & VM_READ)
+			*vmaprot |= PROT_READ;
+		if (vma->vm_flags & VM_WRITE)
+			*vmaprot |= PROT_WRITE;
+		if (vma->vm_flags & VM_EXEC)
+			*vmaprot |= PROT_EXEC;
+		ptep = get_locked_pte(mm, addr, &ptl);
+		if (ptep) {
+			pte_t e = ptep_get(ptep);
+
+			if (pte_present(e)) {
+				*flags |= VMCTX_PGS_PRESENT;
+				if (pte_write(e))
+					*flags |= VMCTX_PGS_WRITABLE;
+			}
+			pte_unmap_unlock(ptep, ptl);
+		}
+	}
+	mmap_read_unlock(mm);
+}
+
+/*
+ * THE CLAIM. A service context's fault on a page is this side asking for it,
+ * and the record says so before anyone is told: from here until the landing,
+ * every SERVE of the page answers "ask again" and every sibling's fault on it
+ * waits -- in the kernel, on pg_wq, for the one transition that resolves
+ * both, instead of each monitor thread fetching its own copy and racing to
+ * install it (the source-side landing race the monitor used to arbitrate
+ * with a 500 us poll and a stamp comparison).
+ *
+ * Returns 0 with the claim written (vc->pg_* set; vc->pg_prior is what the
+ * record said) -- or without it, when the record is off for this mm or
+ * could not be written, which the caller treats as "report as before".
+ * Returns 1 when this fault found a sibling's claim and waited it out: the
+ * access should simply retry, which finds the landed page or claims on the
+ * next fault. -EINTR: a fatal signal ended the wait.
+ *
+ * may_wait is false when the caller holds mmap_read_lock (the non-retry
+ * path): waiting there for a landing that needs the same lock is the ws1
+ * three-way deadlock (a writer queued between), so the fault is reported
+ * with prior == CLAIM and the monitor resolves it (it waits for the landing
+ * itself, off every lock, and answers DONE).
+ */
+static int vmctx_pgrec_claim(struct vmctx_task *vc, struct mm_struct *mm,
+			     unsigned long addr, bool may_wait)
+{
+	struct vmctx_mm_slot *s = vmctx_pgrec_slot(mm);
+	unsigned long idx = addr >> PAGE_SHIFT;
+	unsigned long old, new, flags;
+	long left;
+
+	vc->pg_slot = NULL;
+	vc->pg_claimed = 0;
+	vc->pg_prior = VMCTX_PG_NONE;
+	if (!s)
+		return 0;
+	vc->pg_slot = s;
+	vc->pg_idx = idx;
+	for (;;) {
+		unsigned int st;
+		int changed;
+
+		spin_lock_irqsave(&vmctx_mm_lock, flags);
+		old = vmctx_pgrec_load(s, idx);
+		st = VMCTX_PGREC_STATE(old);
+		if (xa_load(&s->recalls, idx))
+			st = VMCTX_PG_CLAIM;
+		/*
+		 * CLAIM: a sibling context is fetching the page. TRANSIT: a
+		 * serve is handing it to the other machine (bytes on the wire,
+		 * ack pending). Both are transitions in flight, and a fault
+		 * must WAIT for the one in flight rather than start a second:
+		 * a claim stolen from a serve is a page fetched back from the
+		 * machine it is being sent to, two crossings for one page.
+		 * The wait ends when the transition resolves -- the sibling's
+		 * LAND (CLAIM->HOME), the destination's ack (TRANSIT->REMOTE),
+		 * or an unmap -- and the re-read decides.
+		 */
+		if (st == VMCTX_PG_CLAIM || st == VMCTX_PG_TRANSIT) {
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			if (!may_wait) {
+				vc->pg_prior = st;
+				return 0;
+			}
+			vmctx_pgrec_waits++;
+			left = wait_event_killable_timeout(s->pg_wq,
+				({ unsigned int c =
+					VMCTX_PGREC_STATE(vmctx_pgrec_load(s, idx));
+				   c != VMCTX_PG_CLAIM && c != VMCTX_PG_TRANSIT &&
+				   !vmctx_recall_busy(s, idx); }),
+				VMCTX_FAULT_DEADLINE ? : MAX_SCHEDULE_TIMEOUT);
+			if (left < 0)
+				return -EINTR;
+			if (left == 0) {
+				/*
+				 * A transition that never resolved is a defect
+				 * to name, never a reason to park this fault
+				 * for ever: report it as the monitor always saw
+				 * such a fault, with the transition standing.
+				 */
+				vmctx_pgrec_wait_timeouts++;
+				vc->pg_prior = st;
+				return 0;
+			}
+			return 1;	/* resolved: retry the access */
+		}
+		new = vmctx_pgrec_mk(VMCTX_PG_CLAIM, 0, VMCTX_PGREC_GEN(old));
+		changed = vmctx_pgrec_cas(s, idx, old, new);
+		spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+		switch (changed) {
+		case 0:
+			vc->pg_prior = VMCTX_PGREC_STATE(old);
+			vc->pg_claimed = 1;
+			vmctx_pgrec_claims++;
+			return 0;
+		case -EAGAIN:
+			continue;
+		default:
+			vc->pg_prior = VMCTX_PGREC_STATE(old);
+			return 0;	/* unrecorded; reported as before */
+		}
+	}
+}
+
+/*
+ * The landing, from the monitor's answer. DONE and SELF both end with this
+ * side holding the page: DONE after the monitor's LAND (which already
+ * recorded HOME, so this is a no-op) or its finding the page landed by
+ * another path; SELF with the local kernel's fill about to follow -- and
+ * SERVE reads HOME-with-no-page as exactly that fill landing, answering
+ * "ask again" rather than ABSENT. KILL, or an answer that never came, puts
+ * the record back as it was. Only a claim this fault wrote is touched: a
+ * sibling's standing claim (prior == CLAIM, unwritten) is the sibling's to
+ * land.
+ */
+static void vmctx_pgrec_land(struct vmctx_task *vc, u32 action)
+{
+	struct vmctx_mm_slot *s = vc->pg_slot;
+	unsigned long flags;
+	unsigned int to;
+
+	if (!s)
+		return;
+	vc->pg_slot = NULL;
+	if (!vc->pg_claimed)
+		return;
+	vc->pg_claimed = 0;
+	/* Check and settle under the reservation lock. A separate busy probe
+	 * would let BEGIN claim between the probe and this old fault's CAS. */
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (xa_load(&s->recalls, vc->pg_idx))
+		goto out; /* a newer monitor ticket owns this transition */
+	switch (action) {
+	case VMCTX_ACT_DONE:
+	case VMCTX_ACT_SELF:
+		to = VMCTX_PG_HOME;
+		break;
+	default:
+		to = vc->pg_prior;
+		break;
+	}
+	/* Only if the claim still stands: LAND may have settled it already. */
+	for (;;) {
+		unsigned long old = vmctx_pgrec_load(s, vc->pg_idx);
+
+		if (VMCTX_PGREC_STATE(old) != VMCTX_PG_CLAIM)
+			break;
+		if (vmctx_pgrec_cas(s, vc->pg_idx, old,
+				    vmctx_pgrec_mk(to, 0, VMCTX_PGREC_GEN(old)))
+		    != -EAGAIN)
+			break;
+	}
+	wake_up_all(&s->pg_wq);
+out:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+}
+
+int vmctx_redirect_fault(struct task_struct *t, struct pt_regs *regs,
+			 __u64 vec, __u64 addr, __u64 err)
+{
+	struct vmctx_task *vc = t->vmctx;
+	u32 action;
+
+	if (!vc || !READ_ONCE(vc->monitor) || !(vc->flags & VMCTX_FLAG_REDIRECT_FAULT)) {
+		/*
+		 * A context that asked for redirected faults keeps its memory
+		 * somewhere else, so "handle it here" can only mean inventing a
+		 * page. If the monitor was lost rather than detaching on
+		 * purpose, end the context and say why instead.
+		 */
+		if (vc && vc->monitor_lost &&
+		    (vc->flags & VMCTX_FLAG_REDIRECT_FAULT)) {
+			pr_warn("vmctx: pid %d: fault at 0x%llx with no monitor left; ending the context rather than faking its memory\n",
+				task_pid_nr(t), addr);
+			if (vc)
+				vmctx_pgrec_land(vc, VMCTX_ACT_KILL);
+			return -EIO;
+		}
+		if (vc)
+			vmctx_pgrec_land(vc, VMCTX_ACT_SELF);
+		return 0;
+	}
+
+	memset(&vc->ev, 0, sizeof(vc->ev));
+	vc->ev.type       = VMCTX_EV_FAULT;
+	/*
+	 * Which exception this was. The owner decides what a vector
+	 * means -- that 14 is a memory fault and becomes one signal
+	 * while 13 becomes another is its operating system's rule, not
+	 * this one's -- so the number has to reach it unread. Without a
+	 * field for it only page faults could be reported at all, and
+	 * every other exception ended the context here.
+	 */
+	vc->ev.nr         = vec;
+	vc->ev.fault_addr = addr;
+	vc->ev.fault_err  = err;
+	/* Whose fault this is, as far as this side can safely look. */
+	vmctx_page_state(vc, t->mm, (unsigned long)addr & PAGE_MASK,
+			 &vc->ev.args[0], &vc->ev.args[1]);
+	/*
+	 * What kind of mapping it was taken in, when the mm hook is the
+	 * reporter and had the VMA in hand. Zero from every other path; see
+	 * VMCTX_PGC_VALID.
+	 */
+	vc->ev.args[2]    = vc->mm_fault_class;
+	/*
+	 * What the page record said before this fault claimed the page, and
+	 * that there is a record at all (a service context's address space).
+	 * See vmctx_pgrec_claim(): set by the mm hook, zero from a backend.
+	 */
+	vc->ev.args[3]    = vc->pg_slot ? vc->pg_prior : 0;
+	vc->ev.args[4]    = vc->pg_slot ? VMCTX_PGC_VALID : 0;
+	vc->ev.rip        = regs->ip;
+	vc->ev.rsp        = regs->sp;
+	vc->ev.rflags     = regs->flags;
+
+	vmctx_fault_reported();
+	action = vmctx_report(t, vc);
+	vmctx_pgrec_land(vc, action);
+	switch (action) {
+	case VMCTX_ACT_DONE:
+		/*
+		 * A fault's answer may change the address space too, as a
+		 * syscall's always could. The case that needs it: a range the
+		 * owner calls shared has to come from the shared object, and a
+		 * context that inherited the mapping from its parent got it
+		 * from the copy instead -- so the first touch of it is the
+		 * moment to say where it really comes from. Nothing else about
+		 * this path knows what shared means.
+		 */
+		vmctx_apply_map(t, vc);
+		return 1;		/* monitor made the memory good */
+	case VMCTX_ACT_KILL:
+		return -ECANCELED;
+	case VMCTX_ACT_RETRY:
+		/*
+		 * Nobody serviced this fault. Re-take it: returning to the exit
+		 * loop delivers the pending signal, and the same instruction
+		 * faults again afterwards. The one thing we must not do is
+		 * service it here — for a context whose memory lives elsewhere,
+		 * that means handing the guest a blank page.
+		 */
+		return 1;
+	default:
+		return 0;
+	}
+}
+EXPORT_SYMBOL_GPL(vmctx_redirect_fault);
+
+/*
+ * Instrument (kernel #93): name the "fault the monitor never saw" that installs a
+ * stale local copy of a page the other machine also holds = the hx2 both-holder.
+ * vmctx_anon_fault falls back to the local kernel (serves whatever is here,
+ * possibly stale) at four points; a WRITE fault that falls back is the store that
+ * can be lost. These count each reason, with a write-fault breakdown of the two
+ * that mean the monitor could have been asked but was not / declined. Read the
+ * deltas across an hx2 run; the reason whose write-fault count tracks the losses
+ * is the producer. core_param, resettable, zero overhead when nobody reads.
+ */
+static unsigned long vmctx_af_calls;	  /* every anon_fault                */
+static unsigned long vmctx_af_fb_nomon;   /* no monitor / no REDIRECT_FAULT  */
+static unsigned long vmctx_af_fb_lsvc;	  /* in_local_service (nested fault) */
+static unsigned long vmctx_af_fb_foreign; /* fault on an mm that is not ours */
+static unsigned long vmctx_af_fb_unadopted; /* an mm the protocol has not adopted */
+static unsigned long vmctx_af_fb_declined;/* monitor asked, answered SELF(0) */
+static unsigned long vmctx_af_wf_lsvc;	  /* ...of those, a WRITE fault      */
+static unsigned long vmctx_af_wf_declined;/* ...of those, a WRITE fault      */
+static unsigned long vmctx_af_home_local; /* retried SELF fills, not re-asked */
+core_param(vmctx_af_calls, vmctx_af_calls, ulong, 0644);
+core_param(vmctx_af_fb_nomon, vmctx_af_fb_nomon, ulong, 0644);
+core_param(vmctx_af_fb_lsvc, vmctx_af_fb_lsvc, ulong, 0644);
+core_param(vmctx_af_fb_foreign, vmctx_af_fb_foreign, ulong, 0644);
+core_param(vmctx_af_fb_unadopted, vmctx_af_fb_unadopted, ulong, 0644);
+core_param(vmctx_af_fb_declined, vmctx_af_fb_declined, ulong, 0644);
+core_param(vmctx_af_wf_lsvc, vmctx_af_wf_lsvc, ulong, 0644);
+core_param(vmctx_af_wf_declined, vmctx_af_wf_declined, ulong, 0644);
+core_param(vmctx_af_home_local, vmctx_af_home_local, ulong, 0644);
+
+enum { AF_NOMON, AF_LSVC, AF_FOREIGN, AF_UNADOPTED, AF_DECLINED };
+static vm_fault_t vmctx_af_fallback(int reason, int write_fault)
+{
+	switch (reason) {
+	case AF_NOMON:    vmctx_af_fb_nomon++;    break;
+	case AF_LSVC:     vmctx_af_fb_lsvc++;
+			  if (write_fault) vmctx_af_wf_lsvc++;
+			  break;
+	case AF_FOREIGN:  vmctx_af_fb_foreign++;  break;
+	case AF_UNADOPTED: vmctx_af_fb_unadopted++; break;
+	case AF_DECLINED: vmctx_af_fb_declined++;
+			  if (write_fault) vmctx_af_wf_declined++;
+			  break;
+	}
+	return VM_FAULT_FALLBACK;
+}
+
+/*
+ * The page-fault path's way in. See the comment on the declaration: this is how
+ * a context's memory is supplied when the fault was not taken in guest mode.
+ */
+/*
+ * The hold a fault-in takes during an in-flight forwarded syscall, in the one
+ * form both fault paths use. See sys_pages in the struct: a page this call
+ * touched must not change machines while the call can touch it again, whether
+ * the monitor supplied it or the local kernel did, and whether the touch was
+ * a read or a write -- the read exemption was a lifetime defect wearing a
+ * coverage rule's clothes (kernel #43's futex starvation was the TIMER
+ * holding through a block, which vmctx_syscall_holds_one's block-release now
+ * lifts by construction). The write bit is kept per entry so the end-of-call
+ * lost-write audit reports only stores that actually went missing.
+ *
+ * One clock for every stamp: jiffies64, which is what the safety-net compare
+ * in vmctx_syscall_holds_one uses. This function used to stamp ktime_get_ns()
+ * into the same field -- a value so far past any jiffies count that the net
+ * could never fire for its entries.
+ */
+static void vmctx_af_sys_hold(struct vmctx_task *vc, unsigned long addr,
+			      int ret, int write)
+{
+	unsigned long pg = addr & PAGE_MASK;
+	int i, seen = 0;
+
+	if (!(ret == 1 || ret == 0) || !READ_ONCE(vc->in_monitor_syscall))
+		return;
+	spin_lock(&vc->sys_pages_lock);
+	if (vc->in_monitor_syscall) {
+		for (i = 0; i < vc->sys_npages; i++)
+			if (vc->sys_pages[i] == pg) {
+				/* a fresh fault renews the window */
+				vc->sys_pages_when[i] = get_jiffies_64();
+				vc->sys_pages_write[i] |= !!write;
+				seen = 1;
+				break;
+			}
+		if (!seen) {
+			if (vc->sys_npages < (int)ARRAY_SIZE(vc->sys_pages)) {
+				vc->sys_pages_when[vc->sys_npages] =
+					get_jiffies_64();
+				vc->sys_pages_write[vc->sys_npages] = !!write;
+				vc->sys_pages[vc->sys_npages++] = pg;
+			} else if (!vc->sys_pages_over) {
+				vc->sys_pages_over = 1;
+				vc->sys_over_when = get_jiffies_64();
+				pr_warn_ratelimited("vmctx: pid %d: syscall %llu faulted in more than %zu pages; holding every page while it runs\n",
+						    task_pid_nr(current),
+						    vc->sys_nr,
+						    ARRAY_SIZE(vc->sys_pages));
+			}
+		}
+	}
+	spin_unlock(&vc->sys_pages_lock);
+}
+
+vm_fault_t vmctx_anon_fault(struct vm_fault *vmf)
+{
+	struct task_struct *t = current;
+	struct vmctx_task *vc = t->vmctx;
+	int af_wf = !!(vmf->flags & FAULT_FLAG_WRITE);
+	int ret;
+
+	vmctx_af_calls++;
+	if (!vc || !READ_ONCE(vc->monitor) || !(vc->flags & VMCTX_FLAG_REDIRECT_FAULT))
+		return vmctx_af_fallback(AF_NOMON, af_wf);
+	/*
+	 * The backend is already servicing a fault the monitor declined; it
+	 * asked for this page deliberately, so do not ask again.
+	 */
+	if (vc->in_local_service)
+		return vmctx_af_fallback(AF_LSVC, af_wf);
+	/*
+	 * The monitor is another process and holds no context of its own, so
+	 * the write it does to supply the page cannot come back through here.
+	 */
+	/*
+	 * Only this task's own address space is the context's memory. A syscall
+	 * may fault on an mm that is not the caller's, and the monitor has no
+	 * way to reach one: it supplies pages by writing to the *task*, so a
+	 * page it "supplies" for a foreign mm lands somewhere else entirely, the
+	 * access is retried, and it faults again forever.
+	 *
+	 * execve is the case that hangs a real program. It builds the new
+	 * program's argv/envp in a fresh bprm->mm before installing it, whose
+	 * temporary stack starts at STACK_TOP_MAX - PAGE_SIZE — an address the
+	 * old address space very likely also has, so nothing about the fault
+	 * looks foreign from outside. A GTK browser meets this the first time it
+	 * decodes an image: the loader is spawned through bwrap, that child's
+	 * exec never completes, and everything waiting on it stops.
+	 *
+	 * Letting the local kernel have these faults is not a concession — that
+	 * memory *is* this machine's. It was never the context's to serve.
+	 */
+	if (vmf->vma->vm_mm != t->mm)
+		return vmctx_af_fallback(AF_FOREIGN, af_wf);
+	/*
+	 * The other half of the execve case above, and it is the half the
+	 * test against t->mm cannot see: once exec_mmap() has installed the
+	 * new address space, the ELF loader's own writes -- padzero()
+	 * clearing the tail of an interpreter's data page past p_filesz is
+	 * the one that was photographed -- fault with vm_mm == t->mm, and
+	 * redirecting them asks the monitor about an image the protocol has
+	 * never heard of. It answers from the PREVIOUS generation's record
+	 * (truthfully, by its own lights) and the old page is transplanted
+	 * into the fresh image: firefox's fork+exec children booted ld.so on
+	 * a pre-exec _rtld_global page and spun for ever in a self-looped
+	 * namespace list.
+	 *
+	 * So the eligibility rule is the protocol's own, with no exec case in
+	 * it: THE MONITOR IS ASKED ONLY ABOUT THE ADDRESS SPACE IT HAS
+	 * ADOPTED (vc->noted_mm, which vmctx_exec_notify moves to the new
+	 * image only when the exec COMPLETES). The argv-copy reads early in
+	 * an exec fault on the old, adopted mm and redirect as before -- the
+	 * guest's command line lives on the other machine, and gating on
+	 * in_execve alone returned -EFAULT for it, eight execs per firefox
+	 * run. The loader's faults land on an mm the protocol has not adopted
+	 * and are this kernel's own to fill, for every address alike.
+	 */
+	if (vmf->vma->vm_mm != vc->noted_mm)
+		return vmctx_af_fallback(AF_UNADOPTED, af_wf);
+	/*
+	 * An x86 page-fault error code the monitor already understands: bit 1
+	 * is "write", bit 0 stays clear because the page is not present.
+	 */
+	/*
+	 * Say where this came from. The caller holds mmap_read_lock and may
+	 * hold a page-table lock, so nothing reached from here may take either.
+	 */
+	/*
+	 * The mapping's class travels with the report. This is the one place
+	 * the VMA is in hand, and the monitor's answer depends on it: a
+	 * private file page never handed over is the file's and the local
+	 * kernel serves it (the monitor answers SELF, cheaply); one that WAS
+	 * handed over is on the other machine and the file here is stale, so
+	 * the monitor pulls it. Without the class it had to pick one policy
+	 * for every mapping, and each candidate was measured wrong -- see the
+	 * comment in do_fault().
+	 */
+	vc->mm_fault_class = VMCTX_PGC_VALID |
+		(vmf->vma->vm_file ? VMCTX_PGC_FILE : 0) |
+		((vmf->vma->vm_flags & VM_MAYSHARE) ? VMCTX_PGC_SHARED : 0) |
+		((vmf->vma->vm_flags & VM_WRITE) ? VMCTX_PGC_WRITE : 0);
+	/*
+	 * Do not hold mmap_lock across the wait for the monitor.
+	 *
+	 * THE DEADLOCK THIS EXISTS FOR, photographed on ws1 with the fault
+	 * deadline turned off so the hang holds still:
+	 *
+	 *   ctx A (a service context) faults inside a forwarded syscall.
+	 *         handle_mm_fault holds mmap_READ_lock and sleeps here.
+	 *   vmhome serves exactly that fault with a POKE, which is
+	 *         access_process_vm -> __access_remote_vm -> wants mmap_READ_lock.
+	 *   ctx B (main) is in mmap() for a new thread stack (0x801000, a
+	 *         pthread stack) -> queued for mmap_WRITE_lock.
+	 *
+	 * rwsem is fair, so the monitor's *new* reader queues BEHIND the pending
+	 * writer, the writer waits for the reader that is sleeping here, and that
+	 * reader waits for the monitor. Three-way cycle, and nothing is corrupt
+	 * -- which is why every content check in this tree reported zero. It
+	 * needs only a thread creation to overlap another thread's faulting
+	 * forwarded syscall, which is ws1 exactly, and browsers constantly.
+	 *
+	 * The kernel already has the mechanism: drop the lock and return
+	 * VM_FAULT_RETRY, as handle_userfault() does for the same reason. The
+	 * access is re-taken afterwards and nothing is held across the wait.
+	 *
+	 * THE THREE RULES, from userfaultfd's own account of them:
+	 *  - only with FAULT_FLAG_ALLOW_RETRY; without it the caller cannot cope
+	 *    with a dropped lock, so keep the old blocking behaviour;
+	 *  - with FAULT_FLAG_RETRY_NOWAIT, return VM_FAULT_RETRY *without*
+	 *    dropping and without sleeping -- nowait means the caller will not
+	 *    tolerate either;
+	 *  - once the lock is dropped, the answer MUST be VM_FAULT_RETRY.
+	 *    Returning VM_FAULT_SIGBUS there would have the caller unlock a lock
+	 *    this function already released.
+	 *
+	 * NO LOST WAKEUP. The event is not published until vmctx_report(), which
+	 * is called after the drop, so nothing can answer in the window between
+	 * releasing the lock and starting to wait; and once published the wait is
+	 * a wait_event on vc->reply_wq, which re-tests vc->reply_pending after
+	 * prepare_to_wait_event(). A reply landing between publish and sleep is
+	 * seen, not missed.
+	 *
+	 * NOTHING OF vmf SURVIVES THE DROP. After release_fault_lock() another
+	 * thread may munmap the range and free the VMA, so the address and the
+	 * write bit are copied out first and vmf is not touched again. A range
+	 * that really is unmapped by then makes the retry fault on nothing and
+	 * the program earns its SIGSEGV, which is the correct answer and the same
+	 * one userfaultfd gives.
+	 *
+	 * FORWARD PROGRESS. The retry arrives with FAULT_FLAG_TRIED set. It
+	 * used to take the blocking path below on the reasoning that this
+	 * bounds the loop to one drop -- and that blocking pass was the
+	 * reader in a three-way cycle across two machines (session 40, hx2
+	 * ~1 in 100 pool runs, exit 131 at the 6 s deadline): a sibling's
+	 * claim on the page was in flight, the TRIED pass reported it with
+	 * mmap_read_lock held and the monitor waited for the sibling's
+	 * landing; main's mmap of a new thread stack queued for the write
+	 * lock behind that reader; the other machine's SERVE (mmap_read_lock
+	 * in vmctx_ctl_serve) queued behind the writer, so its pull of the
+	 * page stayed "in flight" and its GET handler answered the sibling's
+	 * fetch INFLIGHT for ever. Every serve of the address space sat 6 s
+	 * in the ctl. So the TRIED pass drops the lock as well, exactly as
+	 * handle_userfault() does on every pass: the loop is bounded by
+	 * progress, not by a count -- a page the monitor supplied is present
+	 * on the retry (no fault at all); one the monitor declined is HOME in
+	 * the record and filled locally just below WITHOUT a drop or a
+	 * re-ask; only a page that left again between the landing and the
+	 * retry reports again, and that is a new hand-over, which is progress.
+	 */
+	if ((vmf->flags & FAULT_FLAG_TRIED) && !(vmf->flags & FAULT_FLAG_RETRY_NOWAIT)) {
+		/*
+		 * The retry of a fault the monitor already answered SELF: the
+		 * record was landed HOME by that answer and nothing is in the
+		 * page table yet. The local kernel's fill IS the answer; asking
+		 * again was one monitor round trip per locally served page, and
+		 * dropping the lock for it would loop (the next pass finds the
+		 * same HOME). Read, not claimed: a no-op CLAIM->HOME transition
+		 * bought nothing.
+		 */
+		struct vmctx_mm_slot *hs = vmctx_pgrec_slot(t->mm);
+
+		if (hs && VMCTX_PGREC_STATE(vmctx_pgrec_load(hs,
+				vmf->address >> PAGE_SHIFT)) == VMCTX_PG_HOME) {
+			vc->mm_fault_class = 0;
+			vmctx_af_home_local++;
+			vmctx_af_sys_hold(vc, vmf->address, 0,
+					  !!(vmf->flags & FAULT_FLAG_WRITE));
+			return vmctx_af_fallback(AF_DECLINED, af_wf);
+		}
+	}
+	if (READ_ONCE(vmctx_fault_retry) &&
+	    (vmf->flags & FAULT_FLAG_ALLOW_RETRY)) {
+		unsigned long fa = vmf->address;
+		__u64 fe = (vmf->flags & FAULT_FLAG_WRITE) ? 2 : 0;
+
+		if (vmf->flags & FAULT_FLAG_RETRY_NOWAIT) {
+			vc->mm_fault_class = 0;
+			vmctx_af_nowait++;
+			return VM_FAULT_RETRY;	/* lock kept, per the contract */
+		}
+		if (vmf->flags & FAULT_FLAG_TRIED)
+			vmctx_af_retry_tried++;
+		release_fault_lock(vmf);	/* vmf is dead from here */
+		/*
+		 * ...and the flag that told everything downstream "the caller
+		 * holds mm locks, do not take one" is now false, so clear it.
+		 * The page-state probe the report carries can take mmap_read
+		 * again and give the monitor a real answer instead of UNKNOWN.
+		 */
+		vc->in_mm_fault = 0;
+		vmctx_af_retry++;
+		/*
+		 * The claim, off every lock, so a sibling's claim can be
+		 * waited out here (vmctx_pgrec_claim). A wait that ended is
+		 * not a fault to report: the access retries and finds the
+		 * landed page, or faults again and claims.
+		 */
+		ret = vmctx_pgrec_claim(vc, t->mm, fa, true);
+		if (ret) {
+			vc->mm_fault_class = 0;
+			return VM_FAULT_RETRY;
+		}
+		ret = vmctx_redirect_fault(t, task_pt_regs(t), 14, fa, fe);
+		vc->mm_fault_class = 0;
+		if (ret < 0)
+			vmctx_af_retry_killed++;
+		vmctx_af_sys_hold(vc, fa, ret, !!fe);
+		return VM_FAULT_RETRY;
+	}
+
+	vc->in_mm_fault = 1;
+	/* The claim, under the caller's lock: never waits here (see it). */
+	vmctx_pgrec_claim(vc, t->mm, vmf->address, false);
+	/*
+	 * The retry of a fault the monitor already answered SELF: the first
+	 * pass (above) had to return VM_FAULT_RETRY after dropping the lock,
+	 * the record was landed HOME by that answer, and this is the same
+	 * fault arriving again with nothing in the page table yet. The local
+	 * kernel's fill IS the answer; asking a second time was one monitor
+	 * round trip per locally served page (every read-only text page a
+	 * syscall touches, every fresh zero page).
+	 */
+	if (vc->pg_claimed && vc->pg_prior == VMCTX_PG_HOME &&
+	    (vmf->flags & FAULT_FLAG_TRIED)) {
+		vmctx_pgrec_land(vc, VMCTX_ACT_SELF);
+		vc->in_mm_fault = 0;
+		vc->mm_fault_class = 0;
+		vmctx_af_home_local++;
+		vmctx_af_sys_hold(vc, vmf->address, 0,
+				  !!(vmf->flags & FAULT_FLAG_WRITE));
+		return vmctx_af_fallback(AF_DECLINED, af_wf);
+	}
+	ret = vmctx_redirect_fault(t, task_pt_regs(t), 14, vmf->address,
+				   (vmf->flags & FAULT_FLAG_WRITE) ? 2 : 0);
+	vc->in_mm_fault = 0;
+	vc->mm_fault_class = 0;
+	/*
+	 * A page supplied *to an in-flight assisted syscall* is recorded, and
+	 * held against hand-over while the call can still touch it -- see
+	 * sys_pages in the struct. Recorded here, before the faulting access
+	 * retries, which is the whole point: get_user_pages() has not pinned
+	 * it yet, so this record is the only thing standing between the
+	 * fault-in and a take that hands over pre-DMA bytes. Only the address
+	 * is stored; nothing here may walk a page table, the caller holds mm
+	 * locks.
+	 *
+	 * Reads are recorded as well as writes, whether the monitor supplied
+	 * the page (ret == 1) or the local kernel did (ret == 0). The
+	 * write-only restriction that used to be called load-bearing here was
+	 * a lifetime defect wearing a coverage rule's clothes: kernel #43
+	 * held a futex word's read fault-in on a fixed TTL, the sleeping
+	 * futex_wait then starved the other machine's FUTEX_WAKE writer, and
+	 * the conclusion drawn was "never hold reads" when the true rule is
+	 * "never hold through a block". vmctx_syscall_holds_one() now lifts
+	 * every hold the instant the call blocks, so a sleeping futex holds
+	 * nothing -- and a page a call merely READS genuinely must not change
+	 * machines mid-copy either: what comes back from the round trip is
+	 * whatever the coherence dance holds at that instant, and pg3's
+	 * photographed one-behind was exactly a write(2)'s buffer page taken
+	 * mid-copy and re-pulled one round stale.
+	 */
+	vmctx_af_noretry++;
+	vmctx_af_sys_hold(vc, vmf->address, ret,
+			  !!(vmf->flags & FAULT_FLAG_WRITE));
+	if (ret == 1)
+		return 0;		/* supplied: retry the access */
+	/*
+	 * The context is ending (a fatal signal while the monitor held the
+	 * fault, or the monitor told us to kill it). Falling back would have
+	 * do_anonymous_page() invent a zero page as this task's dying act --
+	 * the one thing no path here is allowed to do. Fail the fault instead;
+	 * the task is already on its way out.
+	 */
+	if (ret < 0)
+		return VM_FAULT_SIGBUS;
+	return vmctx_af_fallback(AF_DECLINED, af_wf);
+}
+EXPORT_SYMBOL_GPL(vmctx_anon_fault);
+
+/* ---- vmctx_ctl(2): the tools a monitor needs -------------------------- */
+
+static void uregs_from_ptregs(struct vmctx_uregs *u, const struct pt_regs *r)
+{
+	u->rax = r->ax;   u->rbx = r->bx;   u->rcx = r->cx;   u->rdx = r->dx;
+	u->rsi = r->si;   u->rdi = r->di;   u->rbp = r->bp;   u->rsp = r->sp;
+	u->r8  = r->r8;   u->r9  = r->r9;   u->r10 = r->r10;  u->r11 = r->r11;
+	u->r12 = r->r12;  u->r13 = r->r13;  u->r14 = r->r14;  u->r15 = r->r15;
+	u->rip = r->ip;   u->rflags = r->flags; u->orig_rax = r->orig_ax;
+	u->fs_base = 0;   u->gs_base = 0;	/* filled by the caller below */
+}
+
+static void ptregs_from_uregs(struct pt_regs *r, const struct vmctx_uregs *u)
+{
+	r->ax = u->rax;   r->bx = u->rbx;   r->cx = u->rcx;   r->dx = u->rdx;
+	r->si = u->rsi;   r->di = u->rdi;   r->bp = u->rbp;   r->sp = u->rsp;
+	r->r8 = u->r8;    r->r9 = u->r9;    r->r10 = u->r10;  r->r11 = u->r11;
+	r->r12 = u->r12;  r->r13 = u->r13;  r->r14 = u->r14;  r->r15 = u->r15;
+	r->ip = u->rip;   r->flags = u->rflags; r->orig_ax = u->orig_rax;
+}
+
+/*
+ * Take a page out of the context and hand its contents to the monitor.
+ *
+ * A page of a context's memory may exist on two machines, and only one of them
+ * may hold it writable at a time — otherwise both write and the loser's changes
+ * are reconstructed by guessing, which is what a diff against a snapshot is.
+ * This is the transfer: the page stops existing here and its last contents go
+ * to whoever asked, so there is exactly one copy and no write set to infer.
+ *
+ * The order is the whole point, and it has three steps rather than two.
+ *
+ * Reading the page and then dropping it leaves it writable while it is being
+ * copied, so another thread of this context can change it in between and have
+ * that change discarded. Dropping it first makes the range unreachable —
+ * zap_page_range_single() clears the PTEs and flushes the TLB — and the
+ * reference taken below is what keeps the page alive afterwards for us to read.
+ * No CPU can reach it, so what we read is exactly its final state.
+ *
+ * All of that is about the copy, and it left the *refusal* unaccounted for: a
+ * page may turn out not to be movable, and finding that out after the drop
+ * means the page is gone either way. So the drop is now the middle step, and
+ * the first one is to ask — vmctx_folio_precheck(), which answers every part of
+ * the question that can be answered while the page is still mapped and changes
+ * nothing. A refused take leaves the address exactly as it found it; the drop
+ * happens only for a take that is going to succeed.
+ */
+/*
+ * Is this page held by an assisted syscall still in flight in this context?
+ *
+ * If it is, it may not change machines: the call faulted it in to touch it,
+ * and the touch may be a device write no page table records. -EBUSY, and the
+ * caller waits -- the wait is bounded by the syscall's own duration, because
+ * the list empties when the call completes.
+ */
+/*
+ * How long a recorded page stays held. Long enough to cover the measured
+ * fault-to-pin window (microseconds; the pin then protects the page by
+ * refcount), short enough that a blocking syscall's transient write
+ * fault-ins -- futex_wait's own stack, via get_futex_key's write GUP --
+ * do not hold the peer's stack hostage against the very wake it sleeps for.
+ */
+/*
+ * How long a syscall's hold on a page lasts, in milliseconds, and it is a
+ * parameter so the question "is the TTL the bug?" can be ASKED rather than
+ * argued. Default unchanged at 100ms.
+ *
+ * The hold is renewed only by a FAULT ("a fresh fault renews the window",
+ * below), so a call that keeps writing a page already present never renews it
+ * and the hold lapses while the call is still writing. pg3 under an 8-way pool
+ * shows what that costs: the forwarded read(2) returns its full 18 bytes, and
+ * the guest reads the PREVIOUS round's bytes out of its own buffer --
+ *   B round 19815: wanted |B00019815-00019815| got |B00019814-00019814|
+ * -- a write the source made into a page the guest no longer shared.
+ */
+static unsigned int vmctx_takeobj_gap_us;	/* widen the named TAKEOBJ window, to test it */
+static long vmctx_takeobj_gaps;		/* hand-overs past the point of no return */
+static long vmctx_takeobj_raced;	/* ...where someone mapped it in the gap */
+/*
+ * No longer the primary release -- a SAFETY NET. A forwarded syscall's write
+ * hold is now lifted by an event (the call blocks or returns; see
+ * vmctx_syscall_holds_one), not by a timer, so this only fires when a page has
+ * been held while the call was RUNNING for this long without blocking or
+ * returning -- which is a red flag, logged, not a routine expiry. Generous
+ * because a legitimately long in-kernel syscall that is actively running should
+ * not be cut off early; if this fires, something is wrong upstream.
+ */
+static unsigned int vmctx_hold_ttl_ms = 2000;
+static long vmctx_syscall_hold_ttl_fired;   /* safety TTL lapsed: investigate  */
+static long vmctx_syscall_hold_blk_release; /* hold lifted because call blocked */
+core_param(vmctx_syscall_hold_ttl_fired, vmctx_syscall_hold_ttl_fired, long, 0644);
+core_param(vmctx_syscall_hold_blk_release, vmctx_syscall_hold_blk_release, long, 0644);
+/*
+ * A/B: whether TAKEOBJ punches the folio out of the object after copying it.
+ * Default 1 (punch) is the shipped behaviour -- it forces a faulter to the owner
+ * (the source) instead of reading a stale in-object copy, the fix hx1 needed. Set
+ * to 0 to leave the folio as a stale fallback: this removes the site8 zero-clobber
+ * (an emptied object handed zeros over live slots when the source answered ABSENT)
+ * at the RISK of reintroducing that very stale-read, which is exactly what this
+ * A/B measures.
+ */
+static bool vmctx_takeobj_punch = true;
+core_param(vmctx_hold_ttl_ms, vmctx_hold_ttl_ms, uint, 0644);
+core_param(vmctx_takeobj_gap_us, vmctx_takeobj_gap_us, uint, 0644);
+core_param(vmctx_takeobj_gaps, vmctx_takeobj_gaps, long, 0644);
+core_param(vmctx_takeobj_raced, vmctx_takeobj_raced, long, 0644);
+core_param(vmctx_takeobj_punch, vmctx_takeobj_punch, bool, 0644);
+
+#define VMCTX_HOLD_TTL (msecs_to_jiffies(READ_ONCE(vmctx_hold_ttl_ms)))
+
+/*
+ * Is this address backed by a present page in that mm right now?
+ *
+ * A plain page-table walk, taken with no lock: the caller uses it to COUNT a
+ * condition, not to decide anything, and a racing answer changes a number by
+ * one rather than changing behaviour. Anything stronger would need the
+ * mmap_lock in a path that has just finished a syscall and holds nothing.
+ */
+static bool vmctx_page_present_in(struct mm_struct *mm, unsigned long addr)
+{
+	pgd_t *pgd; p4d_t *p4d; pud_t *pud; pmd_t *pmd; pte_t *pte;
+	spinlock_t *ptl;
+	bool present = false;
+
+	pgd = pgd_offset(mm, addr);
+	if (pgd_none(*pgd) || unlikely(pgd_bad(*pgd)))
+		return false;
+	p4d = p4d_offset(pgd, addr);
+	if (p4d_none(*p4d) || unlikely(p4d_bad(*p4d)))
+		return false;
+	pud = pud_offset(p4d, addr);
+	if (pud_none(*pud) || unlikely(pud_bad(*pud)))
+		return false;
+	pmd = pmd_offset(pud, addr);
+	if (pmd_none(*pmd) || unlikely(pmd_bad(*pmd)))
+		return false;
+	pte = pte_offset_map_lock(mm, pmd, addr, &ptl);
+	if (!pte)
+		return false;
+	present = pte_present(ptep_get(pte));
+	pte_unmap_unlock(pte, ptl);
+	return present;
+}
+
+/*
+ * Which rule answered "held", so a run says which protection is doing the
+ * work. present = the page was not in the registry but is present in the mm
+ * of a call that is actively running -- the coverage the registry cannot
+ * have, because a call touches an already-present page with no kernel-
+ * visible event at all. mmbusy = the presence walk could not even be tried
+ * (an mmap writer holds the lock), answered conservatively as held.
+ */
+static long vmctx_syscall_hold_present;
+static long vmctx_syscall_hold_mmbusy;
+core_param(vmctx_syscall_hold_present, vmctx_syscall_hold_present, long, 0644);
+core_param(vmctx_syscall_hold_mmbusy, vmctx_syscall_hold_mmbusy, long, 0644);
+/*
+ * The whole mechanism's A/B switch, which should have shipped with it: 0
+ * answers "not held" for everything, which is not #132's weak hold (write
+ * fault-ins on a wall TTL) but NO hold at all -- the arm that bounds the
+ * mechanism's total contribution on one boot. Every armed instrument masks
+ * pg3's residual (CLOBBER: 96/96 pass; PGLOG alone: 48/48; unarmed: 43/48),
+ * so runtime knobs on an unarmed pool are the only measurement left.
+ */
+static bool vmctx_hold_enable = true;
+core_param(vmctx_hold_enable, vmctx_hold_enable, bool, 0644);
+
+/*
+ * @presentp caches the one presence walk across the thread loop: -1 = not yet
+ * asked, 0/1 = the walk's answer, 2 = could not walk (mmap writer active),
+ * which is answered as "present" because a conservative -EBUSY costs a retry
+ * and a wrong "absent" costs a mid-call steal.
+ */
+static int vmctx_syscall_holds_one(struct task_struct *t, struct vmctx_task *vc,
+				   unsigned long pg, struct mm_struct *mm,
+				   int *presentp)
+{
+	int i, registered = 0;
+
+	if (!vc || !READ_ONCE(vc->in_monitor_syscall))
+		return 0;
+	spin_lock(&vc->sys_pages_lock);
+	if (!vc->in_monitor_syscall) {
+		/*
+		 * The call ended between the gate above and here. Without this
+		 * bail the presence rule below would hold every present page
+		 * of a COMPLETED call for as long as the guest keeps running
+		 * -- the exact indefinite hold this function exists to never
+		 * grant.
+		 */
+		spin_unlock(&vc->sys_pages_lock);
+		return 0;
+	}
+	if (vc->sys_pages_over)
+		registered = 1;
+	for (i = 0; !registered && i < vc->sys_npages; i++)
+		if (vc->sys_pages[i] == pg)
+			registered = 1;
+	spin_unlock(&vc->sys_pages_lock);
+
+	/*
+	 * Not in the registry: the registry only sees fault-ins, and a call
+	 * touches a page that was already present at its entry with no fault
+	 * and no event -- pg3's photographed miss ("SYSCALL 1: present pre=1
+	 * post=0", the buffer page stolen mid-write(2), the guest one round
+	 * behind). So while this thread's call is alive, every page PRESENT
+	 * in the adopted mm is treated as touchable and held under the same
+	 * lifetime rule below. The walk is done once per ask (cached in
+	 * *presentp) and under mmap_read_trylock: free_pgtables() runs under
+	 * the write lock, so the trylock is what makes walking another task's
+	 * page tables safe, and a failure to get it means an mmap writer is
+	 * mid-flight -- answered "held" rather than guessed at.
+	 */
+	if (!registered) {
+		if (!mm)
+			return 0;
+		if (*presentp < 0) {
+			if (mmap_read_trylock(mm)) {
+				*presentp = vmctx_page_present_in(mm, pg);
+				mmap_read_unlock(mm);
+			} else {
+				*presentp = 2;
+				vmctx_syscall_hold_mmbusy++;
+			}
+		}
+		if (!*presentp)
+			return 0;
+	}
+
+	/*
+	 * THE LIFETIME, and it is the call's own shape, never a timer. A page
+	 * a forwarded syscall touched stays held for exactly as long as the
+	 * call could touch it again: while its thread is running the call
+	 * (task_is_running) or parked in vmctx serving one of the call's OWN
+	 * faults (ev_pending -- the wait inside vmctx_report, which is not
+	 * the call giving up the page but the machine fetching it). The
+	 * instant the thread blocks in the syscall's own semantics -- futex,
+	 * poll, a read with no data: sleeping, and NOT in a vmctx serve -- it
+	 * cannot be touching anything, so the hold lifts and the peer may
+	 * take the page. If the call then resumes and touches it again the
+	 * touch faults (absent now) or is re-covered by presence (pulled
+	 * back), so nothing is lost; what is bought is that a page in active
+	 * use does not change machines mid-use, and a page whose call has
+	 * blocked does not pin the peer -- the futex-wait starvation that a
+	 * fixed-term hold once caused, and the reason a timer was ever
+	 * reached for.
+	 *
+	 * THE ev_pending ARM COVERS ONLY THE REGISTRY, and that scoping is a
+	 * browser's, not a nicety. During a fault-wait the call is provably
+	 * not touching anything -- it is asleep in vmctx_report -- so the
+	 * registry (pages it demonstrably touched, which it may resume
+	 * touching mid-copy when the fault is answered) is the whole of what
+	 * the wait must protect. Holding every PRESENT page across every
+	 * fault-wait as well read as harmless on the suite and starved a
+	 * browser outright: nine fault-heavy contexts (994 faults against
+	 * 153 syscalls in the run that named it) kept some fault-wait open
+	 * nearly always, every hot page stayed held nearly always, and the
+	 * serve-takes behind the peers' faults span their whole 1s budgets --
+	 * "SLOW coh_lock: held 4103355us", contexts dying 131/251 at
+	 * netsurf's first paint. Presence-rule holds therefore lift the
+	 * moment the call stops RUNNING; the window this reopens (a present
+	 * never-faulted page taken during the call's fault-wait, touched
+	 * event-lessly after it resumes) is the pre-rewrite epsilon narrowed
+	 * to exactly that interleave, and pg3's photographed shape -- torn
+	 * mid-copy while RUNNING -- stays covered.
+	 */
+	/*
+	 * (The ev_pending arm was briefly scoped to the registry alone, on
+	 * the reading that the presence rule held during fault-waits was what
+	 * starved a browser's hand-overs -- pg3 lost 3 of 48 through the gap
+	 * that opened. The starvation's real seat was the SERVE's own retry
+	 * bound: vmhome spun a full second on EBUSY holding the page channel
+	 * and coh_lock, where yielding to CLAIMING after 200ms lets the far
+	 * side do its designed re-fault dance. With that bound fixed the full
+	 * lifetime returns: running or serving-a-fault holds, blocked
+	 * releases.)
+	 */
+	if (!task_is_running(t) && !READ_ONCE(vc->ev_pending)) {
+		vmctx_syscall_hold_blk_release++;
+		return 0;
+	}
+
+	/*
+	 * The safety net, and a red flag. The block-detection above lifts the
+	 * hold on any real block, so reaching this means the page has been
+	 * held while the call accumulated a whole TTL of CPU TIME without
+	 * returning -- a stuck or pathologically long in-kernel syscall, or a
+	 * state this code failed to read as blocked. Say which page and which
+	 * call, then release rather than pin the peer forever. A store that
+	 * lands after this is a genuine lost write, which is exactly why the
+	 * event must be surfaced instead of silently tolerated.
+	 *
+	 * CPU time (se.sum_exec_runtime since dispatch), never wall age: the
+	 * first #133 suite fired the wall-age form on a clock_nanosleep that
+	 * had slept its full 2s and woken -- not a stuck runner, and the
+	 * release landed at the exact wake moment holds exist for. Only what
+	 * the call actually RAN counts against it.
+	 */
+	if ((u64)(READ_ONCE(t->se.sum_exec_runtime) - vc->sys_exec_start) >
+	    (u64)READ_ONCE(vmctx_hold_ttl_ms) * NSEC_PER_MSEC) {
+		vmctx_syscall_hold_ttl_fired++;
+		pr_warn_ratelimited("vmctx: pid %d: syscall %llu has held page 0x%lx across %ums of its own CPU time while %s, without blocking or returning -- releasing on the safety TTL; a store to this page after now is lost. Investigate a stuck or very long in-kernel forwarded syscall.\n",
+				    task_pid_nr(t), vc->sys_nr, pg,
+				    READ_ONCE(vmctx_hold_ttl_ms),
+				    task_is_running(t) ? "running" :
+							 "serving a fault");
+		return 0;
+	}
+	if (!registered)
+		vmctx_syscall_hold_present++;
+	return 1;
+}
+
+/*
+ * The whole thread group, not just the named context. A program's threads are
+ * separate contexts sharing one mm, and a take names whichever context the
+ * caller had in hand -- the measured case (dma1, two threads): the read(2)
+ * faults its buffer in on context A, the take arrives naming context B, and a
+ * check that looked only at B's record stole the page 87us after it was
+ * installed, before get_user_pages() could pin it. Same mm, same page, wrong
+ * ledger.
+ *
+ * get_task_mm() rather than a bare t->mm: the walk the presence rule does
+ * reads another task's page tables, and only a reference on mm_users keeps
+ * exit_mmap() from freeing them under it. One grab covers every thread --
+ * they share the mm, which is the point of asking the whole group.
+ */
+static int vmctx_syscall_holds_mm(struct task_struct *target, unsigned long addr,
+		struct mm_struct *borrowed)
+{
+	unsigned long pg = addr & PAGE_MASK;
+	struct task_struct *t;
+	struct mm_struct *mm;
+	int held = 0, present = -1;
+
+	if (!READ_ONCE(vmctx_hold_enable))
+		return 0;
+	mm = vmctx_control_mm(target, borrowed);
+	rcu_read_lock();
+	for_each_thread(target, t) {
+		if (vmctx_syscall_holds_one(t, READ_ONCE(t->vmctx), pg,
+					    mm, &present)) {
+			held = 1;
+			break;
+		}
+	}
+	rcu_read_unlock();
+	if (mm)
+		mmput(mm);
+	return held;
+}
+
+static int vmctx_syscall_holds(struct task_struct *target,unsigned long addr)
+{ return vmctx_syscall_holds_mm(target,addr,NULL); }
+
+/*
+ * Make a large folio into folios this code can answer for.
+ *
+ * A take moves one 4 KiB page. vmctx_folio_precheck() decides whether it may,
+ * by comparing the folio's mappings and references against what this caller's
+ * unmap is going to remove -- and for a large folio that comparison has no
+ * answer: folio_mapcount() counts the mappings of the whole folio, and how many
+ * of them a zap of one page removes depends on how the folio is mapped. So the
+ * precheck used to decline to answer and let the claim decide after the zap,
+ * where a refusal costs the page. Measured over one suite run: take_large=6,
+ * take_lost=6 -- every page destroyed by a refusal was a large folio.
+ *
+ * Guessing the count is not available (PRINCIPLES.md §7, and a guess that is
+ * wrong here hands a page to another machine while this one can still write
+ * it). The memory-level fix is to stop the folio being large: split it, so the
+ * page this take is about is a folio of its own and every question above has an
+ * exact answer.
+ *
+ * split_huge_page() wants the folio locked and the caller holding exactly one
+ * reference -- which is this caller's FOLL_GET -- and it transfers that
+ * reference to @page, so the caller's put_page() stays correct. The folio
+ * containing @page is left locked whether the split succeeded or not, so it is
+ * unlocked unconditionally.
+ *
+ * Every way this can fail is -EBUSY, "not yet", with the page still mapped and
+ * intact: a folio someone else has locked, a folio with a reference the split's
+ * own freeze refuses (-EAGAIN), hugetlb, which does not split at all. The
+ * caller waits and asks again, which is PRINCIPLES.md §2 and is exactly what
+ * the userspace take loop already does. Nothing here invents or destroys.
+ */
+static long vmctx_split_large(struct page *page, struct folio **foliop,
+			      unsigned long addr)
+{
+	struct folio *folio = *foliop;
+	int order = folio_order(folio);
+	int err;
+
+	vmctx_take_large++;
+
+	if (!vmctx_take_split_large)
+		return 0;	/* the control: leave it to the claim */
+
+	/*
+	 * hugetlb is not splittable, and it is not what a guest's memory is
+	 * made of. Say so rather than calling into a split that would warn.
+	 */
+	if (folio_test_hugetlb(folio)) {
+		vmctx_take_split_fail++;
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx: hugetlb folio order %d cannot be split; not yet\n",
+				    addr, order);
+		return -EBUSY;
+	}
+
+	/*
+	 * Not folio_lock(): this runs with the target's mmap_lock held and the
+	 * caller has its own retry loop, so waiting here for whoever holds the
+	 * folio is a wait taken in the wrong place. Refuse, and be asked again.
+	 */
+	if (!folio_trylock(folio)) {
+		vmctx_take_split_fail++;
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx: large folio order %d locked by someone else; not yet\n",
+				    addr, order);
+		return -EBUSY;
+	}
+
+	err = split_huge_page(page);
+
+	if (err) {
+		struct address_space *m = NULL;
+
+		/*
+		 * Read the mapping under the folio lock we still hold; the
+		 * vma this take walked pins the file, so the mapping stays
+		 * valid past the unlock for the one call below.
+		 */
+		if (!folio_test_anon(folio) && folio_test_dirty(folio))
+			m = folio_mapping(folio);
+		folio_unlock(page_folio(page));
+		vmctx_take_split_fail++;
+		/*
+		 * A dirty FILE folio refuses to split because the split must
+		 * drop its buffers (filemap_release_folio) and dirty buffers
+		 * refuse -- so a binary compiled or copied seconds ago
+		 * stalls EVERY take of its large page-cache folios until
+		 * the flusher's own timer gets around to the file. Measured
+		 * (session 41): pf5's first run after a deploy spent
+		 * 8 x 1.07 s on 0x4b3000, order-1, refs=5 want=4 anon=0,
+		 * self-healing once writeback ran; 45 steady-state runs
+		 * never saw it. The wait was for IO nobody had started, so
+		 * start it: async, ratelimited, only the mapping's own
+		 * file. The caller's retry loop finds clean buffers on a
+		 * later pass and the split then goes through.
+		 */
+		if (m) {
+			static unsigned long vmctx_split_kick_last;
+
+			if (time_after(jiffies,
+				       vmctx_split_kick_last + HZ / 2)) {
+				vmctx_split_kick_last = jiffies;
+				vmctx_take_split_flushed++;
+				filemap_flush(m);
+			}
+		}
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx: split of order-%d folio refused (%d): refs=%d want=%d mapcount=%d anon=%d dirty-file-flush=%d -- not yet\n",
+				    addr, order, err,
+				    folio_ref_count(folio),
+				    folio_expected_ref_count(folio),
+				    folio_mapcount(folio),
+				    folio_test_anon(folio), m != NULL);
+		return -EBUSY;
+	}
+	folio_unlock(page_folio(page));
+
+	/*
+	 * -ENOMEM can leave the folio split, but not all the way down. Ask the
+	 * page what it belongs to now rather than assuming, and refuse if it is
+	 * still large -- the precheck below still could not answer for it.
+	 */
+	folio = page_folio(page);
+	if (folio_test_large(folio)) {
+		vmctx_take_split_fail++;
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx: split left order %d, still large; not yet\n",
+				    addr, folio_order(folio));
+		return -EBUSY;
+	}
+
+	vmctx_take_split++;
+	*foliop = folio;
+	return 0;
+}
+
+/*
+ * A page has just been unmapped or write-protected in the host page tables and
+ * the host TLBs flushed. That flush reaches only the CPUs in the mm's cpumask
+ * and only the host ASID; a guest of THIS or ANY OTHER context may be executing
+ * on another CPU right now with the old translation cached in its own
+ * ASID-tagged TLB, which no host flush touches. (The shared object is mapped by
+ * many single-threaded contexts, each its own mm, so "the mm's cpumask" is not
+ * the set of CPUs that can still write the folio.) Ask the backend to force
+ * those guests out of guest mode: an entry reloads the guest TLB, so once this
+ * returns no guest can reach the page except by faulting. Called while the
+ * folio is still pinned, before it is copied or freed, so a store made through a
+ * stale mapping between the unmap and this call lands in the folio we still
+ * hold and is not lost.
+ */
+static void vmctx_backend_invalidate(struct task_struct *target,
+				     unsigned long addr)
+{
+	struct vmctx_task *vc = target->vmctx;
+
+	if (vc && vc->backend && vc->backend->invalidate)
+		vc->backend->invalidate(target, addr);
+}
+
+/* ---- the invalidations vmctx does not perform itself ------------------ */
+/*
+ * vmctx_backend_invalidate() above is called from the four places this code
+ * takes a page away on purpose. That is not the whole set of ways a folio
+ * stops being where a running guest's TLB says it is: reclaim, migration,
+ * compaction, THP collapse and the guest's own munmap/mprotect all clear PTEs
+ * without going anywhere near vmctx, and the guest's ASID-tagged TLB survives
+ * every host flush they do.
+ *
+ * mmu_notifier is the kernel's own mechanism for a secondary TLB that shares
+ * the CPU's page tables, which is exactly what an NPT/EPT-identity guest
+ * running on the task's own CR3 has. arch_invalidate_secondary_tlbs() is the
+ * op meant for it -- it fires from flush_tlb_mm_range() for every invalidation
+ * in the mm, not only the ones a caller thought to announce.
+ *
+ * The shootdown itself is the one that already exists: the backend's kick,
+ * which forces every CPU currently inside a guest to take a VMEXIT. It is
+ * given no task because there is none to give -- the notifier knows an mm, and
+ * the kick is global by nature (the shared object is mapped by many contexts,
+ * each its own mm, so "this mm's guests" is not the set that can still reach
+ * the folio). A backend's invalidate must therefore tolerate a NULL task.
+ */
+/*
+ * TWO subscriptions, not one, and the kernel forces the split:
+ * __mmu_notifier_register() refuses (WARN + -EINVAL) a subscription whose ops
+ * carry both arch_invalidate_secondary_tlbs and invalidate_range_start -- the
+ * two op families have different synchronisation contracts. Measured the hard
+ * way: a combined ops table made every registration fail SILENTLY (attach
+ * returns void), vmctx_mn_calls read a confident 0, and the change log below
+ * never saw a single unmap. So: the LOG subscription (range_start, the mm
+ * change log) registers always; the KICK subscription (the secondary-TLB
+ * shootdown) registers only while vmctx_mn_enable says the measurement arm is
+ * on.
+ */
+struct vmctx_mn {
+	struct mmu_notifier *log; /* one refcounted subscription per mm */
+	struct mmu_notifier kick;	/* the TLB shootdown; vmctx_mn_enable */
+	int kick_on;
+	struct mm_struct   *mm;
+};
+
+static unsigned long vmctx_mn_calls;	/* notifier reached                  */
+static unsigned long vmctx_mn_kicks;	/* ...and a shootdown was issued     */
+static unsigned long vmctx_mn_unsafe;	/* ...and the context forbade one    */
+/*
+ * OFF by default, and that is a measurement decision rather than a doubt.
+ *
+ * Registration happens from the guest's run loop and is gated on this, so one
+ * boot can carry both arms: run the case with it 0, write 1 to
+ * /sys/module/kernel/parameters/vmctx_mn_enable, run the case again. Comparing
+ * two boots would compare two machines' worth of scheduling noise as well, and
+ * this failure is a race measured in single-digit percentages.
+ *
+ * It also means a kernel that boots with this compiled in is inert until asked,
+ * which matters on a box with no console.
+ *
+ * The deliberate kick has its own switch in the module (kick_enable); this one
+ * is the notifier's.
+ */
+static int vmctx_mn_enable;
+core_param(vmctx_mn_calls, vmctx_mn_calls, ulong, 0644);
+core_param(vmctx_mn_kicks, vmctx_mn_kicks, ulong, 0644);
+core_param(vmctx_mn_unsafe, vmctx_mn_unsafe, ulong, 0644);
+core_param(vmctx_mn_enable, vmctx_mn_enable, int, 0644);
+
+static void vmctx_mn_arch_invalidate(struct mmu_notifier *sub,
+				     struct mm_struct *mm,
+				     unsigned long start, unsigned long end)
+{
+	struct vmctx_backend *be;
+
+	vmctx_mn_calls++;
+	if (!READ_ONCE(vmctx_mn_enable))
+		return;
+	be = READ_ONCE(vmctx_backend);
+	if (!be || !be->invalidate)
+		return;
+	/*
+	 * The kick is a broadcast IPI that is WAITED ON, and that may not be
+	 * issued with interrupts off or from an atomic section -- two CPUs
+	 * doing it at once deadlock. x86 calls this hook at the end of
+	 * flush_tlb_mm_range(), after put_cpu(), where both are fine; the
+	 * header documents other callers that hold a page-table lock. So the
+	 * condition is tested rather than assumed, and the refusals are
+	 * counted: a large vmctx_mn_unsafe means this hook is mostly firing
+	 * somewhere it cannot act, which is a fact about the kernel and not
+	 * about the guest.
+	 */
+	if (!preemptible() || in_interrupt()) {
+		vmctx_mn_unsafe++;
+		return;
+	}
+	vmctx_mn_kicks++;
+	be->invalidate(NULL, start);
+}
+
+/*
+ * The mm-mutation hook: every range the kernel vacates in a context's address
+ * space, appended to that mm's change log for the monitor to drain
+ * (VMCTX_CTL_MMLOG) and propagate. MMU_NOTIFY_UNMAP only -- that is the event
+ * unmap_region/move_vma/mmap-over-live raise when a mapping ceases to exist.
+ * NOT MMU_NOTIFY_CLEAR: CLEAR fires for madvise, page migration, and the
+ * coherence layer's own COW write-protects, where the mapping lives on and
+ * "forget this range" would be wrong.
+ *
+ * Never blocks and always answers 0 (a spinlock append is legal in both the
+ * blockable and the non-blockable notifier contexts), so registering this
+ * unconditionally costs an mm only the notifier bookkeeping.
+ */
+/*
+ * soft says which of two sentences the range is: 0 = the mapping is GONE
+ * (munmap and its relatives -- the consumer must unmap its copy of the
+ * range); 1 = the mapping LIVES but its content was DISCARDED
+ * (MADV_DONTNEED -- the consumer must drop its content copies so the next
+ * touch refetches the fresh zero-fill, while the mapping and its records
+ * stay). The flag rides bit 0 of the page-aligned start address.
+ */
+static void vmctx_mmlog_note(struct mm_struct *mm, u64 start, u64 end,
+			     int soft)
+{
+	unsigned long flags;
+	int i;
+
+	start |= soft ? 1 : 0;
+
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < VMCTX_MM_SLOTS; i++) {
+		struct vmctx_mm_slot *s = &vmctx_mms[i];
+
+		if (s->mm != mm)
+			continue;
+		if (s->rec)
+			vmctx_pgrec_erase_range(s, start & ~1ULL, end);
+		/*
+		 * The record of a vacated or discarded range describes memory
+		 * that no longer exists (unmap) or whose content the program
+		 * threw away (DONTNEED): a REMOTE entry left behind would
+		 * refuse the next serve of whatever the program maps there
+		 * next, and a CLAIM would park its faults. Dropped here, where
+		 * the kernel releases the memory, for both sentences alike --
+		 * the monitor used to do the same from the drained log, one
+		 * round trip later.
+		 */
+		if (s->vac_head - s->vac_tail < VMCTX_MM_VACLOG) {
+			unsigned int h = s->vac_head % VMCTX_MM_VACLOG;
+
+			s->vac[h].start = start;
+			s->vac[h].end = end;
+			/*
+			 * Stamped at the EVENT, not at the drain -- see the
+			 * field's comment on vmctx_mm_slot. The counter bumps
+			 * for a dropped event too, so a construction sampled
+			 * after a drop still outranks it.
+			 */
+			s->vac[h].seq = ++s->vac_seq_ctr;
+			s->vac_head++;
+		} else {
+			s->vac_seq_ctr++;
+			s->vac_dropped++;
+		}
+		break;
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	vmctx_trace_mm(mm, soft ? "discard-note" : "unmap-note",
+		       start & ~1ULL, end, 0);
+}
+
+static int vmctx_mn_range_start(struct mmu_notifier *sub,
+				const struct mmu_notifier_range *range)
+{
+	if (range->event == MMU_NOTIFY_UNMAP)
+		vmctx_mmlog_note(range->mm, range->start, range->end, 0);
+	return 0;
+}
+
+static void vmctx_mn_range_end(struct mmu_notifier *sub,
+			      const struct mmu_notifier_range *range)
+{
+	if (range->event == MMU_NOTIFY_UNMAP) {
+		vmctx_access_commit(range->mm, range->start, range->end,
+				    VMCTX_ACCESS_UNMAP, 0);
+		vmctx_trace_mm(range->mm, "unmap-end", range->start, range->end, 0);
+	}
+}
+
+/*
+ * The discard note, called from the madvise path itself (mm/madvise.c, the
+ * MADV_DONTNEED dispatch) rather than from the notifier: DONTNEED raises
+ * MMU_NOTIFY_CLEAR, and CLEAR cannot be logged wholesale -- it also fires
+ * for page migration and for the coherence layer's own COW write-protects,
+ * where the mapping and its content both live on and "forget this range"
+ * would be wrong. Hooking the one call site that MEANS discard keeps the
+ * rule intact: the report comes from where the memory is actually released,
+ * not from decoding a syscall number in userspace. Measured before this
+ * existed (tests/md1): a guest's DONTNEED'd arena read back its old bytes
+ * from the destination's untouched copies -- the exact stale-ghost class
+ * the change log exists to kill, surfacing as heap corruption wherever an
+ * allocator trusts DONTNEED-means-zero.
+ */
+void vmctx_note_discard(struct mm_struct *mm, unsigned long start,
+			unsigned long end)
+{
+	/*
+	 * Every madvise on the box passes here; the quick-out keeps the
+	 * global slot scan off machines (and boots) with no context live.
+	 * Racy by design and safe both ways: a miss during context birth
+	 * loses a discard for an mm that has no pages anywhere else yet.
+	 */
+	if (!READ_ONCE(vmctx_mm_live))
+		return;
+	vmctx_mmlog_note(mm, start, end, 1);
+}
+
+/*
+ * The shared log subscription is freed after its last context drops its
+ * reference and every SRCU reader has left. It owns no context pointer.
+ */
+static struct mmu_notifier *vmctx_mn_alloc(struct mm_struct *mm)
+{
+	struct mmu_notifier *sub = kzalloc(sizeof(*sub), GFP_KERNEL);
+	return sub ? sub : ERR_PTR(-ENOMEM);
+}
+
+static void vmctx_mn_free(struct mmu_notifier *sub)
+{
+	kfree(sub);
+}
+
+static const struct mmu_notifier_ops vmctx_mn_log_ops = {
+	.invalidate_range_start		= vmctx_mn_range_start,
+	.invalidate_range_end		= vmctx_mn_range_end,
+	.alloc_notifier			= vmctx_mn_alloc,
+	.free_notifier			= vmctx_mn_free,
+};
+
+static const struct mmu_notifier_ops vmctx_mn_kick_ops = {
+	.arch_invalidate_secondary_tlbs = vmctx_mn_arch_invalidate,
+};
+
+/*
+ * Attached lazily, from the context's own step loop -- and UNCONDITIONALLY,
+ * because the change log above is correctness, not measurement. The TLB-kick
+ * op stays self-gated on vmctx_mn_enable (default 0; the standing tlb_ctl=1
+ * flush is what keeps guest ASIDs coherent), so registering always arms only
+ * the log.
+ *
+ * mmu_notifier_register() takes mmap_write_lock and must not be called holding
+ * any VM lock, and it wants an mm that cannot go away -- current->mm satisfies
+ * both, and vmctx_guest_step() runs with current being the context and nothing
+ * of the mm held. Doing it at context creation instead would have to cover the
+ * clone path too, where the new task is not current and its mm is being built.
+ * A SERVICE context must get here too -- it executes none of the program's
+ * instructions, but it is precisely the task whose mm the forwarded syscalls
+ * mutate, so its address space is the one whose vacated ranges the monitor
+ * needs -- which is why the step loop attaches before parking it, not after.
+ *
+ * execve() replaces the mm under a live context; a subscription pinned to the
+ * old mm would log the dead address space and miss the live one, so an attach
+ * that finds the mm changed re-registers.
+ */
+static int vmctx_mn_attach(struct vmctx_task *vc)
+{
+	struct vmctx_mn *m = vc->mn;
+	struct mm_struct *mm = current->mm;
+
+	if (!mm)
+		return -ESRCH;
+	if (m && m->mm != mm) {
+		vmctx_mn_detach(vc);	/* exec swapped the address space */
+		m = NULL;
+	}
+	if (!m) {
+		m = kzalloc(sizeof(*m), GFP_KERNEL);
+		if (!m)
+			return -ENOMEM;
+		m->mm = mm;
+		m->log = mmu_notifier_get(&vmctx_mn_log_ops, mm);
+		if (IS_ERR(m->log)) {
+			int ret = PTR_ERR(m->log);
+			kfree(m);
+			return ret;
+		}
+		vc->mn = m;
+	}
+	/*
+	 * The measurement arm, on its own subscription. Checked on every step
+	 * rather than once, so writing 1 to vmctx_mn_enable arms contexts
+	 * that are already running -- which is the one-boot A/B the switch
+	 * exists for.
+	 */
+	if (!m->kick_on && READ_ONCE(vmctx_mn_enable)) {
+		m->kick.ops = &vmctx_mn_kick_ops;
+		if (!mmu_notifier_register(&m->kick, mm))
+			m->kick_on = 1;
+	}
+	return 0;
+}
+
+static void vmctx_mn_detach(struct vmctx_task *vc)
+{
+	struct vmctx_mn *m = vc->mn;
+
+	if (!m)
+		return;
+	vc->mn = NULL;
+	/* The shared log reference pins m->mm. Unregister the context's
+	 * optional kick first, then drop the log and free the private holder.
+	 * The log callback accesses only the mm registry, never this holder. */
+	if (m->kick_on)
+		mmu_notifier_unregister(&m->kick, m->mm);
+	mmu_notifier_put(m->log);
+	kfree(m);
+}
+
+/*
+ * VMCTX_CTL_MAPOBJ: populate a page in the target context from whatever backs
+ * its VMA -- for a context page that is the address space's own object, so the
+ * page table entry this installs points at the SAME folio every sibling context
+ * maps. No bytes are read and none are written: get_user_pages_remote() with
+ * FOLL_TOUCH runs the ordinary fault path in that mm and drops the reference
+ * again, leaving the mapping behind. (No FOLL_NOFAULT: faulting it in is the
+ * entire point, and it is the ordinary fault, so it maps what the VMA names.)
+ *
+ * FOLL_WRITE so the entry is writable where the VMA allows it. A page the
+ * coherence layer has write-protected is not made writable by this: the protect
+ * is on the folio's mappings, the VMA still says what the program asked for, and
+ * a write to a protected page still arrives as a protection fault to be decided
+ * by the owner. Where the VMA itself is read-only the fault fails and the caller
+ * is told, rather than a private copy being made behind its back.
+ */
+static void vmctx_apply_map(struct task_struct *t, struct vmctx_task *vc)
+{
+	vmctx_apply_map_rep(t, vc, &vc->reply);
+}
+
+/*
+ * How often MAPOBJ was asked to map a hole and refused. Before this counter the
+ * same call ALLOCATED: get_user_pages_remote() without FOLL_NOFAULT runs the
+ * ordinary fault, and shmem_fault() on a hole does not fail -- it inserts a
+ * fresh zero folio into the object, permanently, for an offset whose bytes live
+ * on the other machine. Every sibling context maps the same object, so the
+ * invention replaced the ADDRESS SPACE's memory, with no byte written by
+ * userspace and every install-side detector silent. ARCHITECTURE #9.2g closed
+ * the window for one caller with ctl_lock; the write-grant caller
+ * (page_make_writable) measured WORSE under that lock and stayed open, and its
+ * race is this exact allocation: hx2's "1 zero; stored 9104894 read 0", ws1's
+ * __nptl_nthreads reading 0 in every context at once, a thread descriptor's
+ * list pointers reading 0 in __nptl_deallocate_stack.
+ */
+static long vmctx_mapobj_calls;
+static long vmctx_mapobj_holes;
+core_param(vmctx_mapobj_calls, vmctx_mapobj_calls, long, 0644);
+core_param(vmctx_mapobj_holes, vmctx_mapobj_holes, long, 0644);
+
+static long vmctx_map_object_page(struct task_struct *target,
+				  unsigned long addr, bool write)
+{
+	struct vm_area_struct *vma;
+	struct address_space *mapping;
+	struct mm_struct *mm;
+	struct folio *folio;
+	struct page *page;
+	spinlock_t *ptl;
+	pgoff_t index;
+	pte_t *ptep, old;
+	long ret;
+
+	vmctx_mapobj_calls++;
+
+	mm = get_task_mm(target);
+	if (!mm)
+		return -ESRCH;
+	mmap_read_lock(mm);
+
+	vma = vma_lookup(mm, addr);
+	if (!vma || !vma->vm_file || !(vma->vm_flags & VM_MAYSHARE)) {
+		ret = -ENOENT;		/* not object-backed: the caller falls back */
+		goto out_mm;
+	}
+	if ((write && !(vma->vm_flags & VM_WRITE)) ||
+	    (!write && !(vma->vm_flags & (VM_READ | VM_EXEC)))) {
+		ret = -EFAULT;		/* what FOLL_WRITE answered here before */
+		goto out_mm;
+	}
+	mapping = vma->vm_file->f_mapping;
+	if (!shmem_mapping(mapping)) {
+		ret = -ENOENT;
+		goto out_mm;
+	}
+	index = linear_page_index(vma, addr);
+
+	/*
+	 * The whole repair is this lookup: map a folio the object ALREADY HOLDS,
+	 * and answer "not there" for a hole. filemap_lock_folio() allocates
+	 * nothing, and holding the folio lock across the install is what makes
+	 * the test and the map one operation -- a concurrent TAKEOBJ holds this
+	 * same lock across its unmap-copy-remove, so this either maps the folio
+	 * before the hand-over (whose unmap_mapping_range then removes this PTE
+	 * with the rest) or finds the hole after it and says so. There is no
+	 * moment in between where an allocation can be conjured, which is the
+	 * TOCTOU the callers used to have to close from outside with ctl_lock --
+	 * and could not close for the write-grant path at all.
+	 */
+	folio = filemap_lock_folio(mapping, index);
+	if (IS_ERR(folio)) {
+		vmctx_mapobj_holes++;
+		ret = 0;		/* a hole is an answer, never an allocation */
+		goto out_mm;
+	}
+	if (folio_test_large(folio)) {
+		ret = -ENOENT;		/* not answerable per-page; fall back */
+		goto out_folio;
+	}
+	page = folio_page(folio, 0);
+
+	ptep = get_locked_pte(mm, addr, &ptl);
+	if (!ptep) {
+		ret = -ENOMEM;
+		goto out_folio;
+	}
+	old = ptep_get(ptep);
+	if (pte_present(old)) {
+		if (pte_pfn(old) != page_to_pfn(page)) {
+			/* mapping some other page: not this call's to replace */
+			pte_unmap_unlock(ptep, ptl);
+			ret = -EBUSY;
+			goto out_folio;
+		}
+		/*
+		 * Present and the object's own folio: re-grant the write, which
+		 * is the page_make_writable() half of this call's job. The
+		 * coherence write-protect is a PTE fact, so making the PTE
+		 * writable again is exactly "the protection is spent".
+		 */
+		if (write)
+			ptep_set_access_flags(vma, addr, ptep,
+				pte_mkwrite(pte_mkdirty(pte_mkyoung(old)), vma), 1);
+		pte_unmap_unlock(ptep, ptl);
+		ret = PAGE_SIZE;
+		goto out_folio;
+	}
+	if (!pte_none(old)) {
+		pte_unmap_unlock(ptep, ptl);
+		ret = -EBUSY;		/* swap/PROT_NONE state: not ours */
+		goto out_folio;
+	}
+
+	/*
+	 * The install, exactly as set_pte_range() does it for a file fault:
+	 * rmap first, then the PTE. The reference filemap_lock_folio() took
+	 * becomes the mapping's -- a zap drops it with the rmap -- so this path
+	 * deliberately skips the folio_put the others make.
+	 */
+	{
+		pte_t entry = mk_pte(page, vma->vm_page_prot);
+
+		entry = pte_sw_mkyoung(entry);
+		if (write)
+			entry = pte_mkwrite(pte_mkdirty(entry), vma);
+		else
+			entry = pte_wrprotect(entry);
+		inc_mm_counter(mm, mm_counter_file(folio));
+		folio_add_file_rmap_pte(folio, page, vma);
+		set_pte_at(mm, addr, ptep, entry);
+		update_mmu_cache(vma, addr, ptep);
+	}
+	pte_unmap_unlock(ptep, ptl);
+	folio_unlock(folio);
+	mmap_read_unlock(mm);
+	mmput(mm);
+	return PAGE_SIZE;
+
+out_folio:
+	folio_unlock(folio);
+	folio_put(folio);
+out_mm:
+	mmap_read_unlock(mm);
+	mmput(mm);
+	return ret;
+}
+
+static long vmctx_ctl_mapobj(struct task_struct *target, void __user *arg)
+{
+	struct vmctx_mem m;
+	if (copy_from_user(&m, arg, sizeof(m))) return -EFAULT;
+	if (m.len < PAGE_SIZE) return -EINVAL;
+	return vmctx_map_object_page(target, m.addr & PAGE_MASK, true);
+}
+
+static long vmctx_ctl_mapobj_read(struct task_struct *target, void __user *arg)
+{
+	struct vmctx_mem m;
+
+	if (copy_from_user(&m, arg, sizeof(m))) return -EFAULT;
+	if ((m.addr & ~PAGE_MASK) || m.len != PAGE_SIZE || m.buf)
+		return -EINVAL;
+	return vmctx_map_object_page(target, m.addr, false);
+}
+
+static long vmctx_ctl_protect_mm(struct task_struct *target, void __user *arg)
+{
+	struct vmctx_protection p;
+	struct mm_struct *mm;
+	long ret;
+	if (copy_from_user(&p, arg, sizeof(p))) return -EFAULT;
+	if (p.reserved) return -EINVAL;
+	mm = get_task_mm(target);
+	if (!mm) return -ESRCH;
+	ret = vmctx_mprotect_mm(mm, p.address, p.length, p.protection);
+	mmput(mm);
+	return ret;
+}
+
+/*
+ * VMCTX_CTL_APPLYMAP: apply a mapping change to a context that did not make the
+ * call.
+ *
+ * A guest's threads share one address space. On the source that is one mm, so a
+ * thread's mmap/munmap/mprotect is the whole program's by construction. Here it
+ * is not: each context is its own task with its own mm, sharing only the backing
+ * object, and vmctx_apply_map() runs on the task whose syscall it answered. So a
+ * thread that reshaped the address space left every sibling mapping what no
+ * longer exists -- measured on netsurf, where a new thread's arena setup (mmap
+ * 128MB, two munmaps to trim it, one mprotect) was followed immediately by the
+ * MAIN thread dying on a page fault its owner could not answer (exit 242).
+ *
+ * The monitor knows the members of an address space, so it fans the change out
+ * to them with this. Same code path as the reply's map_op, which is the point:
+ * the sibling ends up with exactly the mapping the caller got.
+ *
+ * The change is passed BY VALUE and never through the target's own reply slot.
+ * The target is not stopped -- it is a sibling running its own guest, and may
+ * have a reply in flight -- so borrowing that slot corrupts it. Doing exactly
+ * that is what broke pf1 and pf2 the first time this was tried.
+ */
+static long vmctx_ctl_applymap(struct task_struct *target, void __user *arg)
+{
+	struct vmctx_task *vc = target->vmctx;
+	struct vmctx_reply m;
+
+	if (!vc)
+		return -ESRCH;
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	if (m.map_op == VMCTX_MAP_NONE)
+		return 0;
+	if (m.map_op == VMCTX_MAP_PROT) {
+		struct mm_struct *mm = get_task_mm(target);
+		long ret;
+		if (!mm) return -ESRCH;
+		ret = vmctx_mprotect_mm(mm, m.map_addr, m.map_len, m.map_prot);
+		mmput(mm);
+		return ret;
+	}
+	/*
+	 * vmctx_apply_map() reads the context's own reply slot. Borrow it and
+	 * put it back: the context is stopped in the monitor while this runs
+	 * (the monitor is the caller), so nothing else is reading it.
+	 */
+	vmctx_apply_map_rep(target, vc, &m);
+	return 0;
+}
+
+/*
+ * Break a copy-on-write share so a take can proceed -- IN THE CALLER'S THREAD.
+ *
+ * Two service contexts of a forked pair map one anonymous folio, so
+ * vmctx_folio_precheck() sees mapcount 2 against the 1 this unmap removes and
+ * answers -EBUSY. -EBUSY means "wait and ask again" (PRINCIPLES §2), and waiting
+ * works only if something will change. Nothing will: the sharing is a property
+ * of the two page tables, not a transient.
+ *
+ * The monitor's answer to that used to be to ask the CONTEXT to break it, with
+ * MADV_POPULATE_WRITE through VMCTX_CTL_SYSCALL. That is a deadlock, and it was
+ * measured as one rather than reasoned about. VMCTX_CTL_SYSCALL needs the
+ * context to reach the return-to-user path before it can run anything, and a
+ * sampler on the stalled breaks caught the context every time in
+ *
+ *     vmctx_report <- vmctx_redirect_fault <- vmctx_anon_fault
+ *                  <- do_anonymous_page <- __handle_mm_fault
+ *
+ * -- parked in a fault of its own, waiting for a page. The machine that would
+ * answer that fault is the machine this take is serving, which is blocked on
+ * this take. Neither side is stuck on a lock; each is waiting for the other,
+ * and the only thing that ever broke the tie was the two-second fault deadline.
+ * The break then took 2011-2064ms and the source's GET, bounded at the same two
+ * seconds, had already expired: 95 stalls and 10 timed-out runs in 1024.
+ *
+ * So do it here. The caller is the monitor's own thread, holding mmap_read_lock
+ * on the target, and it does not need the context to run at all. The page is
+ * PRESENT -- the FOLL_NOFAULT lookup above proved it -- so FOLL_WRITE resolves
+ * in do_wp_page(), which vmctx_wp_fault() lets fall through, so this is a plain
+ * local copy: no monitor round trip, nothing forwarded, nothing to wait for.
+ *
+ * Why not POKE the page's own bytes from userspace, which is the same idea a
+ * layer up: because that reads the bytes and writes them back, and a sibling's
+ * store landing between the two is discarded. It was tried and it cost 4 lost
+ * increments in 512 runs. The copy here is the kernel's own, made under the
+ * page-table lock from whatever is there at that instant, so there is no window
+ * to lose a store in and no bytes cross a boundary.
+ *
+ * Returns 1 if the sharing is gone and the caller should re-ask, 0 otherwise.
+ * It never destroys anything: on any failure the page is exactly as it was.
+ */
+static int vmctx_break_cow_share(struct mm_struct *mm, unsigned long addr,
+				 struct folio *folio)
+{
+	struct page *wpage = NULL;
+	struct vm_area_struct *vma;
+	unsigned int cow_flags = FOLL_WRITE | FOLL_GET;
+	long r;
+
+	if (!vmctx_take_break_cow)
+		return 0;
+	if (folio && folio_test_large(folio))
+		return 0;	/* the precheck cannot answer for these anyway */
+
+	/*
+	 * No FOLL_NOFAULT here, and that is the whole point -- it has to be
+	 * allowed to fault, or it cannot copy. What makes that safe is that the
+	 * page was just found present: the one thing FOLL_NOFAULT is there to
+	 * prevent, inventing a page for an address whose contents live on the
+	 * other machine, cannot arise for a page that is already here. If it
+	 * left in the window, the fault lands in vmctx_foreign_anon_fault(),
+	 * which refuses rather than inventing -- and that case is counted so it
+	 * cannot pass unnoticed.
+	 */
+	/* A private read-only VMA can still owe a fork snapshot. FOLL_FORCE
+	 * asks native COW to materialize that private page without granting a
+	 * write in the VMA or changing the original file/other MM's bytes. */
+	vma = vma_lookup(mm, addr);
+	if (!vma || !(vma->vm_flags & VM_MAYWRITE) || (vma->vm_flags & VM_SHARED))
+		return 0;
+	if (!(vma->vm_flags & VM_WRITE))
+		cow_flags |= FOLL_FORCE;
+	r = get_user_pages_remote(mm, addr, 1, cow_flags, &wpage, NULL);
+	if (r != 1) {
+		vmctx_take_cow_vanished++;
+		pr_warn_ratelimited("vmctx: the copy-on-write break of 0x%lx found nothing there (%ld); the take is refused with the page untouched\n",
+				    addr, r);
+		return 0;
+	}
+
+	/*
+	 * Judged by what THIS mm now maps, before anything else. A write fault
+	 * on a writable-private FILE page replaces the shared page-cache folio
+	 * with a private copy -- the break has worked for the one mapping this
+	 * take is about -- while the OLD folio's mapcount stays high with
+	 * every other process on the machine that maps the same file. Judging
+	 * by that mapcount declared such breaks failed forever: netsurf's
+	 * serve hit a font page "mapped 30 time(s)", the break made the
+	 * private copy on the first try and was disbelieved every time, the
+	 * pull spun its whole budget, and the guest's fault died on the 2s
+	 * deadline (exit 131).
+	 */
+	if (folio && wpage && page_folio(wpage) != folio) {
+		put_page(wpage);
+		vmctx_take_cow_broken++;
+		return 1;
+	}
+	put_page(wpage);
+
+	/*
+	 * Same folio still: the break is worth something only if that folio
+	 * stopped being shared. A private page write-faulted here is not
+	 * progress, and saying so would turn one refusal into an endless
+	 * retry.
+	 */
+	if (folio && folio_mapcount(folio) > 1) {
+		vmctx_take_cow_fail++;
+		return 0;
+	}
+	vmctx_take_cow_broken++;
+	return 1;
+}
+
+/*
+ * The episode sum of a page: the monitor's page_sum(), so the other machine
+ * can echo the sum of what it installed and the ack settle exactly the
+ * hand-over it answers. Adler-shaped, folded to 16 bits by the caller.
+ */
+static u32 vmctx_page_sum(const void *p)
+{
+	const u32 *w = p;
+	u32 a = 1, b = 0;
+	int i;
+
+	for (i = 0; i < PAGE_SIZE / 4; i++) {
+		a += w[i];
+		b += a;
+	}
+	return (b << 16) ^ a ^ (b >> 16);
+}
+
+/*
+ * Take one page out of mm, with mmap_read_lock held by the caller: the whole
+ * of VMCTX_CTL_TAKE after its entry checks, shared with VMCTX_CTL_SERVE.
+ * fault_in lets a page that is not present be faulted in first -- for a
+ * private FILE mapping, whose absent page is the file's and is the right
+ * thing to hand over (the monitor used to PEEK it in for exactly this);
+ * never for anonymous memory, where a foreign fault is refused anyway.
+ * PAGE_SIZE with the bytes in ubuf (and *sum, if asked); 0 = nothing here;
+ * -EBUSY = not yet (the page is as it was).
+ */
+static long vmctx_take_locked(struct task_struct *target, struct mm_struct *mm,
+			      unsigned long addr, void __user *ubuf,
+			      bool fault_in, u32 *sum, void *retained)
+{
+	struct vm_area_struct *vma;
+	struct page *page = NULL;
+	struct folio *folio;
+	void *kaddr;
+	void *snapshot = NULL;
+	int frozen_refs = 0;
+	long ret;
+
+	/*
+	 * FOLL_NOFAULT because asking for a page the context never touched must
+	 * not create one: a zero page invented here becomes present, so the
+	 * context never faults on that address again and reads this machine's
+	 * zeros where its own memory belongs, for good. "Absent" is an answer,
+	 * and the caller keeps its own copy when it hears it.
+	 */
+	ret = get_user_pages_remote(mm, addr, 1,
+				    FOLL_GET | (fault_in ? 0 : FOLL_NOFAULT),
+				    &page, NULL);
+	if (ret != 1) {
+		vmctx_take_absent++;
+		ret = 0;		/* nothing here to take */
+		goto out;
+	}
+	vma = vma_lookup(mm, addr);
+	if (!vma) {
+		put_page(page);
+		vmctx_take_absent++;
+		ret = 0;
+		goto out;
+	}
+
+	folio = page_folio(page);
+	if (vma->vm_flags & VM_SHARED) {
+		put_page(page);
+		ret = -EBUSY;
+		goto out;
+	}
+
+
+	/* A private file PTE can be the last current mapping of a page-cache
+	 * folio, but another process may map it at any instant. A successful
+	 * mapcount precheck cannot authorize destructive removal of that
+	 * shared cache page. Resolve the native private write fault first and
+	 * retain its actual anonymous result. Existing aliases keep the file
+	 * page; no bytes are read and written back by the monitor. */
+	if (!folio_test_anon(folio)) {
+		struct page *private = NULL;
+		struct vmctx_recall_ticket *zero_guard = NULL;
+		unsigned int cow_flags = FOLL_GET | FOLL_WRITE;
+		unsigned long flags;
+
+		if (!(vma->vm_flags & VM_MAYWRITE)) {
+			ret = -EBUSY;
+			put_page(page);
+			goto out;
+		}
+		/* Preserve read-only permissions while detaching the file or
+		 * shared zero page through native private COW. The later exact
+		 * reference freeze still excludes pins and all writable aliases. */
+		if (!(vma->vm_flags & VM_WRITE))
+			cow_flags |= FOLL_FORCE;
+		if (is_zero_page(page)) {
+			struct vmctx_mm_slot *slot;
+			unsigned int state;
+
+			spin_lock_irqsave(&vmctx_mm_lock, flags);
+			slot = vmctx_pgrec_slot(mm);
+			if (slot) {
+				state = VMCTX_PGREC_STATE(vmctx_pgrec_load(slot, addr >> PAGE_SHIFT));
+				zero_guard = xa_load(&slot->recalls, addr >> PAGE_SHIFT);
+				if (state == VMCTX_PG_REMOTE || state == VMCTX_PG_CLAIM ||
+				    !zero_guard || zero_guard->cancelled || zero_guard->zero_cow_task)
+					zero_guard = NULL;
+				else
+					zero_guard->zero_cow_task = current;
+			}
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			if (!zero_guard) {
+				put_page(page);
+				ret = -EBUSY;
+				goto out;
+			}
+		}
+		ret = get_user_pages_remote(mm, addr, 1, cow_flags, &private, NULL);
+		if (zero_guard) {
+			spin_lock_irqsave(&vmctx_mm_lock, flags);
+			zero_guard->zero_cow_task = NULL;
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+		}
+		if (ret != 1 || !folio_test_anon(page_folio(private))) {
+			if (ret == 1) put_page(private);
+			put_page(page);
+			ret = -EBUSY;
+			goto out;
+		}
+		put_page(page);
+		page = private;
+		folio = page_folio(page);
+		vma = vma_lookup(mm, addr);
+		if (!vma) {
+			put_page(page);
+			ret = -EFAULT;
+			goto out;
+		}
+	}
+
+
+	/*
+	 * The shared zero page, named -- because a refusal of it is the one
+	 * -EBUSY in this file that does not mean "not yet".
+	 *
+	 * It gets here because something read the address without writing it,
+	 * and a read fault on untouched anonymous memory installs
+	 * empty_zero_page read-only. FOLL_NOFAULT will not create one, but it
+	 * happily returns one already installed. The zero page is PG_reserved
+	 * with a global reference count, so vmctx_folio_precheck() compares
+	 * refs=2 against want=1(+1) and refuses, and will refuse the same way
+	 * for ever; the caller's wait-and-ask-again then spends its whole
+	 * second and gives up.
+	 *
+	 * Measured, and this is what the counters are for. Sixteen pg2 runs:
+	 * take_refused=4004 and take_zeropage=4004, exactly equal -- every
+	 * remaining pre-zap refusal in pg2 is this page, 1001 of them in each
+	 * of the four runs that died. All 400 dumped refusals were pfn
+	 * 0x23cc25, refcount:2 mapcount:0 mapping:NULL flags reserved, and that
+	 * pfn is what /proc/self/pagemap reports for a page this machine has
+	 * only read. (The earlier reading of this stall -- "refs=3 want=2(+1)
+	 * mapcount=1 lru=1 anon=1" -- was a rate-limited line from a different
+	 * refusal, not the one that repeated. Under pr_warn_ratelimited the
+	 * line you see is not necessarily the line that happened.)
+	 *
+	 * Answering "nothing here" instead was tried, on the argument that a
+	 * zero-page PTE holds no bytes of this address space and so ABSENT is
+	 * the true answer. It is not an improvement: pg2 went 10/16 against the
+	 * refusal's 12/16 on the same boot, and the deaths changed from a named
+	 * FATAL in the monitor to the guest dying of its own accord. So the
+	 * switch stays off and the refusal stays, with a line that says what it
+	 * is. The repair belongs where the zero page was installed -- a guest
+	 * fault serviced by the local kernel instead of by the monitor
+	 * (AUDIT part III E2) -- not here.
+	 */
+	if (is_zero_page(page)) {
+		vmctx_take_zeropage++;
+		if (vmctx_take_zeropage_absent) {
+			put_page(page);
+			vmctx_take_absent++;
+			ret = 0;
+			goto out;
+		}
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx: this is the shared zero page (pfn %lu): nothing has ever written the address on this side, it can never be claimed, and every retry will be refused the same way\n",
+				    addr, page_to_pfn(page));
+	}
+
+	/*
+	 * Ask first, destroy second.
+	 *
+	 * The order used to be the other way round, and the comment above this
+	 * function argued for it: dropping the page first makes the range
+	 * unreachable, so what is read afterwards is the page's final state.
+	 * That argument is right about the copy and silent about the refusal.
+	 * vmctx_folio_claim() may answer "not yet" -- and by then the page
+	 * tables are gone, which for anonymous memory is everything the address
+	 * had. The next take then answers "nothing here" about a page the
+	 * program owned a millisecond ago, and a live stack becomes an empty
+	 * page under a running thread. That is measured, not supposed: with the
+	 * pagemap read either side of one refused take,
+	 *
+	 *     TAKE 0x7fffffffe000: 1 refusal(s); present before=1
+	 *     after the first=0, take finally 0
+	 *
+	 * and it is how tests/pg3 died at rip=0 (AUDIT part VIII.3).
+	 *
+	 * PRINCIPLES.md §2 says -EBUSY means "wait and ask again". Waiting only
+	 * works if the refusal leaves something to come back to. So every
+	 * question that can be answered while the page is still mapped is asked
+	 * here, before zap_page_range_single(), and a refusal at this point
+	 * leaves the page exactly as it was found. The claim below is unchanged
+	 * and still authoritative -- it is the atomic freeze that actually takes
+	 * the page, and nothing here weakens it or hands over a page anything
+	 * else can still reach.
+	 */
+	if (vmctx_take_claim_first) {
+		/*
+		 * A large folio has to stop being one before the question below
+		 * has an answer at all. See vmctx_split_large().
+		 */
+		if (folio_test_large(folio)) {
+			ret = vmctx_split_large(page, &folio, addr);
+			if (ret) {
+				put_page(page);
+				vmctx_take_refused++;
+				goto out;	/* still mapped, intact */
+			}
+		}
+		ret = vmctx_folio_precheck(folio, 1, 1, "TAKE");
+		if (ret == -EBUSY && folio_mapcount(folio) > 1 &&
+		    vmctx_break_cow_share(mm, addr, folio)) {
+			/*
+			 * The share is gone -- but the break replaced only THIS
+			 * mapping's folio with a private copy, so `page` and
+			 * `folio` still name the OLD shared one. For an
+			 * anonymous share that old folio's mapcount simply
+			 * dropped and re-prechecking it was enough. For a
+			 * private-FILE page it is not: the old folio is the
+			 * file's page-cache folio, whose refcount is pinned by
+			 * the page cache and by every other mapping of the file
+			 * (the read-only text alias of a doubly-mapped ELF
+			 * boundary page keeps it), so it prechecks refs=3
+			 * want=2 anon=0 forever -- and worse, the zap/claim
+			 * below would act on a folio the address no longer
+			 * maps. That is exactly where netsurf dies relocating a
+			 * freshly dlopened library, and tests/dl1 reproduces it
+			 * deterministically. Re-look up the page so everything
+			 * from here on is the fresh private copy the break made:
+			 * a first-class anonymous folio, mapcount 1, no
+			 * page-cache reference, which the precheck and the claim
+			 * can move like any other.
+			 */
+			struct page *np = NULL;
+
+			put_page(page);
+			page = NULL;
+			if (get_user_pages_remote(mm, addr, 1,
+						  FOLL_GET | FOLL_NOFAULT,
+						  &np, NULL) == 1) {
+				page  = np;
+				vma   = vma_lookup(mm, addr);
+				folio = page_folio(page);
+			}
+			if (!page || !vma) {
+				if (page)
+					put_page(page);
+				/*
+				 * The broken page left in the window (a
+				 * concurrent take, an unmap). Nothing is here to
+				 * take; the guest refaults and asks again. Never
+				 * fall through to zap/claim with a NULL page.
+				 */
+				vmctx_take_absent++;
+				ret = 0;
+				goto out;
+			}
+			ret = vmctx_folio_precheck(folio, 1, 1, "TAKE");
+		}
+		if (ret) {
+			put_page(page);
+			vmctx_take_refused++;
+			goto out;	/* the page is as it was */
+		}
+	}
+
+	/*
+	 * Asked once more, on the brink. The entry check sampled the call
+	 * state before this function took any locks or waited on anything; a
+	 * forwarded syscall that STARTED since then may be touching this page
+	 * right now, and past the zap a refusal costs the page. The re-ask
+	 * shrinks that window from the whole body of this function to the
+	 * instructions between here and the zap.
+	 */
+	if (vmctx_syscall_holds_mm(target, addr, mm)) {
+		put_page(page);
+		vmctx_take_hold++;
+		ret = -EBUSY;
+		goto out;	/* the page is as it was */
+	}
+
+	/* Admission must hold even when diagnostic prechecks are disabled.
+	 * File pages are detached above using native COW; shared objects use
+	 * TAKEOBJ. Neither can be frozen as a private anonymous page. */
+	if (!folio_test_anon(folio) || folio_test_large(folio) ||
+	    folio_test_ksm(folio)) {
+		put_page(page);
+		ret = -EBUSY;
+		goto out;
+	}
+	/* A user-buffer fault must never sleep with the folio frozen. */
+	snapshot = retained ? retained : (void *)__get_free_page(GFP_KERNEL);
+	if (!snapshot) {
+		put_page(page);
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	zap_page_range_single(vma, addr, PAGE_SIZE, NULL);
+
+	/*
+	 * The host PTE and its host-TLB shootdown reached only this context's mm.
+	 * Kick every guest that may still hold the page in its own TLB, before the
+	 * folio below is claimed and copied, so no store through a stale mapping
+	 * outlives the copy. See vmctx_backend_invalidate().
+	 */
+	vmctx_backend_invalidate(target, addr);
+
+	/*
+	 * The page tables are gone; the references are the question. This is the
+	 * path a monitor uses to give a page back to the machine running the
+	 * program, and this side is the one performing the program's syscalls --
+	 * so this is exactly where a buffer pinned by a read() that is still
+	 * waiting on a device would be handed away while the device is about to
+	 * write it. See vmctx_folio_may_move().
+	 *
+	 * We own the FOLL_GET reference. The claim adds only a stable swap-cache
+	 * reference, under the folio lock, and never includes mapping references.
+	 */
+	{
+		long busy = vmctx_folio_claim(folio, 1, &frozen_refs);
+
+		/*
+		 * Past this point a refusal costs the page, so the wait
+		 * PRINCIPLES.md §2 asks for happens here, where the page can
+		 * still be waited for, rather than in userspace where it can
+		 * only be waited for after it is gone. The precheck above has
+		 * already refused everything that was true before the zap, so
+		 * anything left is a reference taken in the window between the
+		 * two -- a remote CPU's LRU batch, a get_user_pages() about to
+		 * return -- and those end on their own. Bounded, small: the
+		 * caller has its own second of asking behind this.
+		 */
+		if (busy) {
+			int i;
+
+			for (i = 0; busy && i < vmctx_take_retries; i++) {
+				schedule_timeout_uninterruptible(1);
+				busy = vmctx_folio_claim(folio, 1, &frozen_refs);
+			}
+			if (!busy)
+				vmctx_take_regained++;
+		}
+		if (busy) {
+			/*
+			 * The one outcome that still costs a page, named so it
+			 * can be counted rather than inferred. If this is ever
+			 * non-zero the precheck is missing a case, and the case
+			 * is in this line.
+			 */
+			vmctx_take_lost++;
+			pr_err("vmctx: TAKE pid %d 0x%lx: claim refused AFTER the zap (#%ld): refs=%d want=%d mapcount=%d pinned=%d lru=%d anon=%d -- the page is unmapped and was not served\n",
+					    task_pid_nr(target), addr, vmctx_take_lost,
+					    folio_ref_count(folio),
+					    folio_expected_ref_count(folio),
+					    folio_mapcount(folio),
+					    folio_maybe_dma_pinned(folio),
+					    folio_test_lru(folio),
+					    folio_test_anon(folio));
+			/* This anonymous mapping has already been destroyed. It is
+			 * not retryable absence: the source must never license a
+			 * retained old copy or zero-fill after losing these bytes. */
+			send_sig(SIGKILL, target, 1);
+			put_page(page);
+			ret = -ENOTRECOVERABLE;
+			goto out;
+		}
+	}
+
+	kaddr = kmap_local_page(page);
+	memcpy(snapshot, kaddr, PAGE_SIZE);
+	if (sum)
+		*sum = vmctx_page_sum(kaddr);
+	vmctx_watch_check(addr, kaddr, "TAKE");
+	kunmap_local(kaddr);
+	vmctx_folio_release(folio, frozen_refs);
+	ret = retained ? PAGE_SIZE :
+		copy_to_user(ubuf, snapshot, PAGE_SIZE) ? -EFAULT : PAGE_SIZE;
+	/* A bad monitor copyout after destructive removal has the same
+	 * failure semantics. Returning a retryable error would lose the page. */
+	if (ret < 0) {
+		vmctx_take_lost++;
+		send_sig(SIGKILL, target, 1);
+		ret = -ENOTRECOVERABLE;
+	}
+	put_page(page);
+out:
+	if (snapshot && !retained)
+		free_page((unsigned long)snapshot);
+	return ret;
+}
+
+static long vmctx_ctl_take(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct mm_struct *mm;
+	struct vmctx_mem m;
+	struct vmctx_recall_ticket guard;
+	unsigned long addr;
+	long ret;
+
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	if (m.len < PAGE_SIZE)
+		return -EINVAL;
+	addr = m.addr & PAGE_MASK;
+
+	vmctx_take_calls++;
+
+	if (vmctx_syscall_holds_mm(target, addr, borrowed)) {
+		vmctx_take_hold++;
+		pr_warn_ratelimited("vmctx: TAKE 0x%lx pid %d: refused, held by in-flight syscall %llu (asked by %d %s)\n",
+				    addr, task_pid_nr(target),
+				    target->vmctx ? target->vmctx->sys_nr : 0,
+				    task_pid_nr(current), current->comm);
+		return -EBUSY;
+	}
+
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+	mmap_read_lock(mm);
+	ret = vmctx_page_guard_begin(mm, addr, &guard);
+	if (!ret) {
+		ret = vmctx_take_locked(target, mm, addr, (void __user *)m.buf, false,
+					NULL, NULL);
+		vmctx_page_guard_end(&guard);
+	}
+	mmap_read_unlock(mm);
+	mmput(mm);
+	return ret;
+}
+
+/*
+ * Copy one page of mm into ubuf without moving it -- the read-only and the
+ * MAP_SHARED-file serves, where both machines may hold the page (nobody can
+ * write it, or the reclaim before every forwarded call pulls it back). The
+ * caller holds mmap_read_lock. fault_in for a file mapping (the page cache
+ * is the right answer and reading it installs nothing this side must later
+ * disown); an absent anonymous page is reported as such, never created.
+ * PAGE_SIZE, 0 (absent) or -errno.
+ */
+static long vmctx_copy_source_shmem(struct vm_area_struct *vma, unsigned long addr,
+				    void __user *ubuf, u32 *sum, void *retained)
+{
+	struct inode *inode = file_inode(vma->vm_file);
+	pgoff_t index = vma->vm_pgoff + ((addr - vma->vm_start) >> PAGE_SHIFT);
+	struct folio *folio;
+	void *bytes;
+	long ret;
+
+	/* A registered userspace pager must remain the source of its pages.
+	 * It needs an assisted native fault, not an allocation through file ops. */
+	if (userfaultfd_missing(vma) || userfaultfd_minor(vma))
+		return -EOPNOTSUPP;
+	/* This is the source OS's actual file object, held by mmap_lock. SGP_CACHE
+	 * applies shmem's EOF, swap-in and initialization rules and returns the
+	 * complete native page, including its mapped tail after a partial EOF.
+	 * It does not fault a foreign execution-site backing object through GUP. */
+	ret = shmem_get_folio(inode, index, 0, &folio, SGP_CACHE);
+	if (ret)
+		return ret;
+	bytes = kmap_local_page(folio_page(folio, index - folio->index));
+	if (retained) { memcpy(retained, bytes, PAGE_SIZE); ret = PAGE_SIZE; }
+	else ret = copy_to_user(ubuf, bytes, PAGE_SIZE) ? -EFAULT : PAGE_SIZE;
+	if (sum) *sum = vmctx_page_sum(bytes);
+	kunmap_local(bytes);
+	folio_unlock(folio);
+	folio_put(folio);
+	return ret;
+}
+
+static long vmctx_copy_locked(struct mm_struct *mm, unsigned long addr,
+			      void __user *ubuf, bool fault_in, u32 *sum, void *retained)
+{
+	struct page *page = NULL;
+	struct vm_area_struct *vma = vma_lookup(mm, addr);
+	void *kaddr;
+	long ret;
+
+	if (fault_in && vma && vma->vm_file && (vma->vm_flags & VM_SHARED) &&
+	    shmem_mapping(vma->vm_file->f_mapping) && vmctx_pgrec_slot(mm))
+		return vmctx_copy_source_shmem(vma, addr, ubuf, sum, retained);
+	ret = get_user_pages_remote(mm, addr, 1,
+				    FOLL_GET | (fault_in ? 0 : FOLL_NOFAULT),
+				    &page, NULL);
+	if (ret != 1)
+		return fault_in && ret < 0 ? ret : 0;
+	kaddr = kmap_local_page(page);
+	if (retained) { memcpy(retained, kaddr, PAGE_SIZE); ret = PAGE_SIZE; }
+	else ret = copy_to_user(ubuf, kaddr, PAGE_SIZE) ? -EFAULT : PAGE_SIZE;
+	if (sum) *sum = vmctx_page_sum(kaddr);
+	vmctx_watch_check(addr, kaddr, "SERVE-COPY");
+	kunmap_local(kaddr);
+	put_page(page);
+	return ret;
+}
+
+/*
+ * VMCTX_CTL_SERVE: the one question the machine running the program asks
+ * about a page, answered in one step. See the uapi comment for the vocabulary;
+ * the decision table, which is the monitor's old ctx_page_inner() with the
+ * page table, the mapping and the record finally in one hand:
+ *
+ *   no mapping, and no stack to grow         NOMAP   (the owner's SIGSEGV)
+ *   a mapping the program may not touch      DENIED  (likewise)
+ *   read-only (file or anon)                 record REMOTE/CLAIM/TRANSIT:
+ *                                            refuse as below (a RELRO page
+ *                                            taken while writable: the copy
+ *                                            here is stale); else COPIED,
+ *                                            record untouched, absent: ABSENT
+ *   writable MAP_SHARED file (or shmem)      COPIED + GRANT, record TRANSIT;
+ *                                            receiver installation ACK makes
+ *                                            it REMOTE before a recall
+ *   writable private, anon or file           the record decides first:
+ *     CLAIM                                  CLAIMING (this side is fetching)
+ *     TRANSIT                                CLAIMING until exact settlement
+ *     REMOTE                                 ABSENT (the asker's side holds it:
+ *                                            its object, a sibling's landing)
+ *     HOME, no page here                     CLAIMING (a local fill is landing)
+ *     HOME or NONE, page here                TAKEN: record TRANSIT(sum), then
+ *                                            zap, claim, copy -- in that order,
+ *                                            so nothing lands between the
+ *                                            record and the page table
+ *     NONE, no page (anon)                   ABSENT, record REMOTE: the asker
+ *                                            fills it (its object or zeros)
+ *                                            and holds it from then on
+ *     a syscall hold                         -EBUSY: not yet (record untouched)
+ *
+ * PROBE answers the record, the class and presence and changes nothing.
+ */
+static long vmctx_serve_capture(struct task_struct *target, struct vmctx_serve *result,
+		bool probe_only, struct mm_struct *borrowed, void *retained,
+		struct vmctx_recall_ticket *held)
+{
+	struct vmctx_serve sv=*result;
+	struct vmctx_mm_slot *slot;
+	struct vm_area_struct *vma;
+	struct mm_struct *mm;
+	struct vmctx_recall_ticket take_guard;
+	unsigned long addr, idx, rec;
+	unsigned int st;
+	bool ro, shared, filed, present = false, probe;
+	bool take_guarded = false;
+	long ret = 0;
+	u32 sum = 0;
+
+	addr = sv.addr & PAGE_MASK;
+	idx = addr >> PAGE_SHIFT;
+	probe = probe_only || (sv.flags & VMCTX_SERVE_PROBE);
+	sv.status = 0;
+	sv.class = 0;
+	sv.state = VMCTX_PG_NONE;
+	sv.gen = 0;
+	sv.sum = 0;
+
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+	slot = vmctx_pgrec_slot(mm);
+	if (!slot) {
+		mmput(mm);
+		return -ENXIO;		/* not a service context's address space */
+	}
+	rec = vmctx_pgrec_load(slot, idx);
+	st = VMCTX_PGREC_STATE(rec);
+	sv.state = st;
+	sv.gen = VMCTX_PGREC_GEN(rec);
+	if (probe_only) {
+		mmput(mm);
+		goto out_copy;
+	}
+
+	mmap_read_lock(mm);
+	/* Refresh after acquiring the map lock: a ticket may have claimed this
+	 * page while the caller was waiting. All mapping classes honor it. */
+	rec = vmctx_pgrec_load(slot, idx);
+	st = VMCTX_PGREC_STATE(rec);
+	sv.state = st;
+	sv.gen = VMCTX_PGREC_GEN(rec);
+	if (held && READ_ONCE(held->cancelled)) { ret=-ESTALE; goto out_unlock; }
+	if (!held && vmctx_recall_busy(slot, idx)) {
+		sv.status = VMCTX_SERVE_CLAIMING;
+		goto out_unlock;
+	}
+	/*
+	 * The fault path's own lookup rule: a hole below a grow-down stack is
+	 * grown (expand_stack takes over the read lock -- re-held on success,
+	 * dropped on failure), exactly as VMCTX_CTL_TRYFAULT does. No address
+	 * is special; the mm's shape is the answer.
+	 */
+	vma = find_vma(mm, addr);
+	if (vma && vma->vm_start > addr) {
+		vma = expand_stack(mm, addr);
+		if (!vma) {
+			mmput(mm);
+			sv.status = VMCTX_SERVE_NOMAP;
+			goto out_copy;
+		}
+	}
+	if (!vma) {
+		sv.status = VMCTX_SERVE_NOMAP;
+		goto out_unlock;
+	}
+	filed  = !!vma->vm_file;
+	shared = !!(vma->vm_flags & VM_MAYSHARE);
+	ro     = !(vma->vm_flags & VM_WRITE);
+	sv.class = VMCTX_PGC_VALID | (filed ? VMCTX_PGC_FILE : 0) |
+		   (shared ? VMCTX_PGC_SHARED : 0) |
+		   (ro ? VMCTX_PGC_RO : VMCTX_PGC_WRITE);
+	if (!(vma->vm_flags & (VM_READ | VM_WRITE | VM_EXEC))) {
+		sv.status = VMCTX_SERVE_DENIED;
+		goto out_unlock;
+	}
+	if (probe) {
+		struct page *page = NULL;
+
+		if (get_user_pages_remote(mm, addr, 1, FOLL_GET | FOLL_NOFAULT,
+					  &page, NULL) == 1) {
+			present = true;
+			put_page(page);
+		}
+		if (present)
+			sv.class |= VMCTX_PGC_PRESENT;
+		sv.status = present ? VMCTX_SERVE_COPIED : VMCTX_SERVE_ABSENT;
+		goto out_unlock;
+	}
+
+	/* A private page that may later become writable must have one owner
+	 * even while its VMA is read-only. Native COW below detaches a private
+	 * anonymous folio without changing VMA permissions; TAKE then revokes
+	 * this MM's PTE, freezes the exact references and retains the bytes in
+	 * the transfer ticket. A later mprotect cannot expose a second copy.
+	 * Read-only shared mappings and private VMAs without VM_MAYWRITE still
+	 * follow the copy path; their separate coherence contract is unchanged. */
+	if (ro && (shared || !(vma->vm_flags & VM_MAYWRITE))) {
+		/*
+		 * A page of a range the program cannot write, recorded as
+		 * handed over or in flight: a loader wrote it while the range
+		 * was writable, the take moved it, then mprotect sealed the
+		 * range (RELRO). The current bytes are the other machine's;
+		 * what is here -- the pristine file, or nothing -- is the
+		 * stale copy the record exists to keep off the wire.
+		 */
+		if (st == VMCTX_PG_CLAIM || st == VMCTX_PG_TRANSIT) {
+			sv.status = VMCTX_SERVE_CLAIMING;
+			vmctx_pgrec_serve_claiming++;
+			goto out_unlock;
+		}
+		if (st == VMCTX_PG_REMOTE) {
+			sv.status = VMCTX_SERVE_ABSENT;
+			vmctx_pgrec_serve_absent++;
+			goto out_unlock;
+		}
+		ret = vmctx_copy_locked(mm, addr, (void __user *)sv.buf, filed, NULL, retained);
+		if (ret < 0)
+			goto out_unlock;
+		if (ret == PAGE_SIZE) {
+			sv.class |= VMCTX_PGC_PRESENT;
+			sv.status = VMCTX_SERVE_COPIED;
+			vmctx_pgrec_serve_copied++;
+		} else {
+			sv.status = VMCTX_SERVE_ABSENT;
+			vmctx_pgrec_serve_absent++;
+		}
+		ret = 0;
+		goto out_unlock;
+	}
+	if (shared) {
+		unsigned long flags, claim;
+		struct vmctx_recall_ticket *guard=held ? held : &take_guard;
+		if (st==VMCTX_PG_CLAIM || st==VMCTX_PG_TRANSIT) {
+			sv.status=VMCTX_SERVE_CLAIMING; goto out_unlock;
+		}
+		if (st==VMCTX_PG_REMOTE) { sv.status=VMCTX_SERVE_ABSENT; goto out_unlock; }
+		if (vmctx_syscall_holds_mm(target,addr,borrowed)) { ret=-EBUSY; goto out_unlock; }
+		if (!held) {
+			ret=vmctx_capture_guard_begin(mm,addr,&take_guard);
+			if (ret) goto out_unlock;
+			take_guarded=true;
+		}
+		spin_lock_irqsave(&vmctx_mm_lock,flags);
+		claim=vmctx_pgrec_mk(VMCTX_PG_CLAIM,0,VMCTX_PGREC_GEN(rec));
+		ret=guard->cancelled ? -ESTALE : vmctx_pgrec_cas(slot,idx,rec,claim);
+		spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+		if (ret) goto out_unlock;
+		ret=vmctx_copy_locked(mm,addr,(void __user *)sv.buf,true,&sum,retained);
+		spin_lock_irqsave(&vmctx_mm_lock,flags);
+		if (guard->cancelled) ret=-ESTALE;
+		else if (ret==PAGE_SIZE) {
+			long changed=vmctx_pgrec_cas(slot,idx,claim,
+				vmctx_pgrec_mk(VMCTX_PG_TRANSIT,sum,VMCTX_PGREC_GEN(rec)));
+			if (changed) ret=changed;
+		} else {
+			vmctx_pgrec_cas(slot,idx,claim,rec);
+			if (!ret) ret=-EIO;
+		}
+		spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+		if (ret==PAGE_SIZE) {
+			sv.class|=VMCTX_PGC_PRESENT; sv.status=VMCTX_SERVE_COPIED;
+			sv.flags|=VMCTX_SERVE_GRANT; sv.sum=sum & 0xffff;
+			vmctx_pgrec_serve_copied++; ret=0;
+		}
+		goto out_unlock;
+	}
+
+	/* Private transferable memory: the record decides, then the take. */
+	switch (st) {
+	case VMCTX_PG_CLAIM:
+		sv.status = VMCTX_SERVE_CLAIMING;
+		vmctx_pgrec_serve_claiming++;
+		goto out_unlock;
+	case VMCTX_PG_TRANSIT:
+		sv.status=VMCTX_SERVE_CLAIMING;
+		vmctx_pgrec_serve_claiming++;
+		goto out_unlock;
+	case VMCTX_PG_REMOTE:
+		sv.status = VMCTX_SERVE_ABSENT;
+		vmctx_pgrec_serve_absent++;
+		goto out_unlock;
+	default:
+		break;
+	}
+	if (vmctx_syscall_holds_mm(target, addr, borrowed)) {
+		vmctx_pgrec_serve_busy++;
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (!held) {
+		ret = vmctx_capture_guard_begin(mm, addr, &take_guard);
+		if (ret) goto out_unlock;
+		take_guarded = true;
+	}
+	/*
+	 * The record first, the page table second: from the moment the entry
+	 * reads TRANSIT every other transition on the page -- a fault's
+	 * claim, a sibling serve -- sees the hand-over and waits for it; a
+	 * landing that finds TRANSIT (the monitor's LAND) is the page coming
+	 * back from the machine it is being sent to, which is in order. A
+	 * refusal puts the entry back exactly as it was.
+	 */
+	for (;;) {
+		rec = vmctx_pgrec_load(slot, idx);
+		st = VMCTX_PGREC_STATE(rec);
+		if (st != VMCTX_PG_HOME && st != VMCTX_PG_NONE) {
+			sv.status = VMCTX_SERVE_CLAIMING;	/* moved under us */
+			vmctx_pgrec_serve_claiming++;
+			goto out_unlock;
+		}
+		ret = vmctx_pgrec_cas(slot, idx, rec,
+				      vmctx_pgrec_mk(VMCTX_PG_TRANSIT, 0,
+						     VMCTX_PGREC_GEN(rec)));
+		if (ret == 0)
+			break;
+		if (ret != -EAGAIN) {
+			ret = -EBUSY;		/* unrecordable: not yet */
+			goto out_unlock;
+		}
+	}
+	ret = vmctx_take_locked(target, mm, addr, (void __user *)sv.buf, filed,
+				&sum, retained);
+	/*
+	 * The outcome, written only if the entry still reads the TRANSIT this
+	 * serve wrote (sum 0). A fault of this side's own may have CLAIMED the
+	 * page meanwhile -- TRANSIT -> CLAIM is the context asking for a page
+	 * that is leaving, and its monitor's GET brings it back once the
+	 * other machine has it -- and that claim is the fault's to land, not
+	 * this serve's to overwrite: a clobbered claim is a sibling's fault no
+	 * longer parked and a second fetch in flight. The sum is then lost and
+	 * the ack matches nothing, which is the cheap side of that race.
+	 */
+	{
+		unsigned long cur = vmctx_pgrec_load(slot, idx);
+		unsigned int to;
+		unsigned int tosum = 0;
+
+		if (ret == PAGE_SIZE) {
+			sv.class |= VMCTX_PGC_PRESENT;
+			sv.status = VMCTX_SERVE_TAKEN;
+			sv.sum = sum & 0xffff;
+			to = VMCTX_PG_TRANSIT;
+			tosum = sv.sum;
+			vmctx_pgrec_serve_taken++;
+		} else if (ret < 0) {
+			/* Not yet (-EBUSY) or unreadable: the record goes back. */
+			to = st;
+			if (ret == -EBUSY)
+				vmctx_pgrec_serve_busy++;
+		} else if (st == VMCTX_PG_HOME) {
+			/* Repeated absence is not proof that anyone received the page. */
+			to=VMCTX_PG_HOME; sv.status=VMCTX_SERVE_CLAIMING;
+			vmctx_pgrec_serve_home_absent++;
+
+		} else {
+			/*
+			 * NONE and absent, anonymous (a file page would have
+			 * been faulted in): nobody has ever written the
+			 * address on this side. The asker fills it -- its
+			 * object, or its kernel's zeros, and it knows which --
+			 * and holds it from then on, which is what the record
+			 * says.
+			 */
+			to = retained ? VMCTX_PG_TRANSIT : VMCTX_PG_REMOTE;
+			if (retained) sv.flags |= VMCTX_SERVE_GRANT;
+			sv.status = VMCTX_SERVE_ABSENT;
+			vmctx_pgrec_serve_absent++;
+		}
+		if (VMCTX_PGREC_STATE(cur) == VMCTX_PG_TRANSIT &&
+		    VMCTX_PGREC_SUM(cur) == 0) {
+			vmctx_pgrec_cas(slot, idx, cur,
+					vmctx_pgrec_mk(to, tosum,
+						       VMCTX_PGREC_GEN(cur)));
+			/*
+			 * A fault may be parked on this page's TRANSIT. On a
+			 * successful take it stays parked until the ack
+			 * (TRANSIT with a sum is still in flight); on any other
+			 * outcome the page is back HOME/REMOTE and the waiter
+			 * must re-decide, so wake it.
+			 */
+			if (to != VMCTX_PG_TRANSIT)
+				wake_up_all(&slot->pg_wq);
+		}
+		if (ret == PAGE_SIZE)
+			ret = 0;
+	}
+out_unlock:
+	if (take_guarded) vmctx_page_guard_end(&take_guard);
+	mmap_read_unlock(mm);
+	mmput(mm);
+out_copy:
+	if (ret)
+		return ret;
+	*result=sv;
+	return 0;
+}
+
+static long vmctx_ctl_serve(struct task_struct *target, void __user *arg,
+		bool probe_only, struct mm_struct *borrowed)
+{
+	struct vmctx_serve sv;
+	long ret;
+	if (copy_from_user(&sv,arg,sizeof(sv))) return -EFAULT;
+	ret=vmctx_serve_capture(target,&sv,probe_only,borrowed,NULL,NULL);
+	if (ret) return ret;
+	return copy_to_user(arg,&sv,sizeof(sv)) ? -EFAULT : 0;
+}
+
+#include "vmctx-transfer-core.h"
+
+/*
+ * VMCTX_CTL_LAND: the monitor installs the page it fetched and the record
+ * says HOME, stamped with the other machine's generation. The write is the
+ * POKE's (a forced write, so a private file page becomes this side's own
+ * anonymous copy); IF_ABSENT refuses first when a page is already mapped
+ * there. Every fault parked on the page is woken.
+ */
+static long vmctx_ctl_land(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_land l;
+	struct vmctx_recall_ticket guard;
+	struct mm_struct *mm;
+	struct page *page = NULL;
+	unsigned long addr, flags;
+	void *kbuf, *mapped;
+	long ret;
+
+	if (copy_from_user(&l, arg, sizeof(l)))
+		return -EFAULT;
+	addr = l.addr & PAGE_MASK;
+	kbuf = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+	if (copy_from_user(kbuf, (void __user *)l.buf, PAGE_SIZE)) {
+		kfree(kbuf);
+		return -EFAULT;
+	}
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm) {
+		kfree(kbuf);
+		return -ESRCH;
+	}
+	mmap_read_lock(mm);
+	ret = vmctx_page_guard_begin(mm, addr, &guard);
+	if (ret) { mmap_read_unlock(mm); goto out; }
+	if (l.flags & VMCTX_LAND_IF_ABSENT) {
+		if (get_user_pages_remote(mm, addr, 1, FOLL_GET | FOLL_NOFAULT,
+					  &page, NULL) == 1) {
+			put_page(page);
+			page = NULL;
+			mmap_read_unlock(mm);
+			vmctx_pgrec_land_present++;
+			ret = -EEXIST;
+			goto release;
+		}
+	}
+	ret = get_user_pages_remote(mm, addr, 1,
+				    FOLL_GET | FOLL_WRITE | FOLL_FORCE, &page, NULL);
+	mmap_read_unlock(mm);
+	if (ret != 1) { if (!ret) ret = -EFAULT; goto release; }
+	mapped = kmap_local_page(page);
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (guard.cancelled) {
+		ret = -ESTALE;
+	} else {
+		memcpy(mapped, kbuf, PAGE_SIZE);
+		ret = PAGE_SIZE;
+		if (guard.slot) {
+			vmctx_pgrec_set(guard.slot, addr >> PAGE_SHIFT, VMCTX_PG_HOME,
+					0, false, l.gen);
+			vmctx_pgrec_lands++;
+		}
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	kunmap_local(mapped);
+	if (ret == PAGE_SIZE) {
+		flush_dcache_page(page);
+		set_page_dirty_lock(page);
+	}
+	put_page(page);
+release:
+	vmctx_page_guard_end(&guard);
+out:
+	mmput(mm);
+	kfree(kbuf);
+	return ret;
+}
+
+static long vmctx_ctl_pgack(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_pgack a;
+	struct vmctx_mm_slot *slot;
+	struct mm_struct *mm;
+	unsigned long idx, rec, flags;
+	long ret = 0;
+
+	if (copy_from_user(&a, arg, sizeof(a)))
+		return -EFAULT;
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+	slot = vmctx_pgrec_slot(mm);
+	if (!slot) {
+		mmput(mm);
+		return -ENXIO;
+	}
+	idx = (a.addr & PAGE_MASK) >> PAGE_SHIFT;
+	spin_lock_irqsave(&vmctx_mm_lock,flags);
+	if (slot->access_error) { ret=-(long)slot->access_error; goto unlock; }
+	if (xa_load(&slot->recalls,idx)) { ret=-EBUSY; goto unlock; }
+	for (;;) {
+		rec = vmctx_pgrec_load(slot, idx);
+		if (VMCTX_PGREC_STATE(rec) != VMCTX_PG_TRANSIT ||
+		    VMCTX_PGREC_SUM(rec) != (a.sum & 0xffff)) {
+			vmctx_pgrec_ack_stale++;
+			break;
+		}
+		ret=vmctx_pgrec_cas(slot, idx, rec,
+				    vmctx_pgrec_mk(VMCTX_PG_REMOTE, 0,
+						   VMCTX_PGREC_GEN(rec)));
+		if (!ret) {
+			vmctx_pgrec_acks++;
+			wake_up_all(&slot->pg_wq);
+			ret = 1;
+			break;
+		}
+		if (ret!=-EAGAIN) break;
+	}
+unlock:
+	spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+	mmput(mm);
+	return ret;
+}
+
+static long vmctx_ctl_pgscan(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_pgscan *sc;
+	struct vmctx_mm_slot *slot;
+	struct mm_struct *mm;
+	unsigned long idx, last;
+	void *entry;
+	long ret = 0;
+
+	sc = kmalloc(sizeof(*sc), GFP_KERNEL);
+	if (!sc)
+		return -ENOMEM;
+	if (copy_from_user(sc, arg, sizeof(*sc))) {
+		ret = -EFAULT;
+		goto out;
+	}
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm) {
+		ret = -ESRCH;
+		goto out;
+	}
+	slot = vmctx_pgrec_slot(mm);
+	if (!slot) {
+		mmput(mm);
+		ret = -ENXIO;
+		goto out;
+	}
+	sc->n = 0;
+	if (sc->max > VMCTX_PGSCAN_MAX)
+		sc->max = VMCTX_PGSCAN_MAX;
+	if (sc->end > sc->start) {
+		last = (sc->end - 1) >> PAGE_SHIFT;
+		xa_for_each_range(&slot->pg, idx, entry, sc->start >> PAGE_SHIFT,
+				  last) {
+			unsigned int st = VMCTX_PGREC_STATE(vmctx_pgrec_of(entry));
+
+			if (!(sc->mask & (1u << st)))
+				continue;
+			if (sc->n >= sc->max)
+				break;
+			sc->page[sc->n++] = (u64)idx << PAGE_SHIFT;
+		}
+	}
+	mmput(mm);
+	if (copy_to_user(arg, sc, sizeof(*sc)))
+		ret = -EFAULT;
+out:
+	kfree(sc);
+	return ret;
+}
+
+static long vmctx_ctl_pgset(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_pgset ps;
+	struct vmctx_mm_slot *slot;
+	struct mm_struct *mm;
+	unsigned long flags;
+	long ret = 0;
+
+	if (copy_from_user(&ps, arg, sizeof(ps)))
+		return -EFAULT;
+	if (ps.state > VMCTX_PG_TRANSIT)
+		return -EINVAL;
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+	slot = vmctx_pgrec_slot(mm);
+	if (!slot) {
+		mmput(mm);
+		return -ENXIO;
+	}
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (xa_load(&slot->recalls, ps.addr >> PAGE_SHIFT))
+		ret = -EBUSY;
+	else if (ps.state == VMCTX_PG_CLAIM &&
+		 (VMCTX_PGREC_STATE(vmctx_pgrec_load(slot, ps.addr >> PAGE_SHIFT)) == VMCTX_PG_CLAIM ||
+		  VMCTX_PGREC_STATE(vmctx_pgrec_load(slot, ps.addr >> PAGE_SHIFT)) == VMCTX_PG_TRANSIT))
+		ret = -EAGAIN;
+	else
+		vmctx_pgrec_set(slot, (ps.addr & PAGE_MASK) >> PAGE_SHIFT, ps.state, 0,
+				false, ps.gen);
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	wake_up_all(&slot->pg_wq);
+	mmput(mm);
+	return ret;
+}
+
+/*
+ * Take write permission away from a page of the context, leaving it readable.
+ *
+ * This is the state the "one writer" rule needs that removing a page cannot
+ * express: both machines may hold a page at once as long as neither can write
+ * it. Without it every page a syscall so much as *reads* has to be taken out of
+ * the guest, and a page both sides read — a stack that syscall arguments point
+ * into, while the guest is running on it — moves on nearly every fault.
+ *
+ * Only the page table is touched. Nothing here changes the VMA, so the guest's
+ * own mprotect and the fault handler still see the permissions the program
+ * asked for; a write lands as a protection fault, the monitor settles who owns
+ * the page, and the page is made writable again by removing it and writing it
+ * back (POKE forces write access, which allocates a fresh writable page). That
+ * keeps this operation one-directional and means it cannot hand out write
+ * permission to a page that was shared for copy-on-write.
+ */
+/* Successful claim retains the folio lock and returns the exact frozen
+ * count. Mapping references NEVER authorize a claim, even if a mapping
+ * appears after the early folio_mapped() observation. */
+static long vmctx_folio_claim(struct folio *folio, int extra_refs,
+			      int *frozen_refs)
+{
+	int expected;
+
+	if (!folio_trylock(folio))
+		return -EBUSY;
+	folio_wait_writeback(folio);
+	if (!folio_test_anon(folio) || folio_test_large(folio) ||
+	    folio_test_ksm(folio) || folio_mapped(folio) ||
+	    folio_maybe_dma_pinned(folio))
+		goto busy;
+
+	/* Only our GUP reference and the optional swap-cache reference are
+	 * owned here. The folio lock stabilizes swap-cache membership. A
+	 * racing mapping or GUP holder adds a reference and defeats the
+	 * atomic freeze; its reference must never be counted as ours. */
+	expected = extra_refs + folio_test_swapcache(folio);
+	if (!folio_ref_freeze(folio, expected)) {
+		/* The zap may have queued a munlock batch on another CPU. */
+		lru_add_drain_all();
+		if (!folio_ref_freeze(folio, expected))
+			goto busy;
+		vmctx_take_drained++;
+	}
+	*frozen_refs = expected;
+	return 0;
+busy:
+	folio_unlock(folio);
+	return -EBUSY;
+}
+
+/*
+ * The same question, asked while it is still free to ask.
+ *
+ * vmctx_folio_claim() is the answer -- an atomic freeze, taken only once the
+ * mappings are gone, because a folio that is still mapped can be written
+ * without ever taking a reference. But the only way to remove the mappings is
+ * to destroy them, and for anonymous memory that is the whole of what the
+ * address had. So a claim that refuses has already taken the page away from the
+ * program in order to decide it may not be taken away from the program.
+ *
+ * This asks the same things beforehand, changing nothing:
+ *
+ *   writeback  -- waited for, exactly as the claim does; it ends on its own.
+ *   dma-pinned -- a device may write this page. True before the zap and after
+ *                 it, so it costs nothing to hear it first.
+ *   mappings   -- the caller says how many its own unmap will remove
+ *                 (@max_maps, or -1 for "all of them"). A folio mapped more
+ *                 times than that is one the claim will refuse for "still
+ *                 mapped", which is knowable now.
+ *   references -- the count the claim will compare against, compared now.
+ *                 folio_expected_ref_count() counts one per page-table mapping,
+ *                 and an unmap drops both a mapping and its reference, so the
+ *                 *difference* between the real count and the expected one is
+ *                 what survives the unmap. Zero now means zero after, unless
+ *                 something takes a reference in between -- which is a race,
+ *                 not a state, and is what the retry in the caller is for.
+ *
+ * Large folios are the one case this cannot answer: the caller's unmap covers
+ * one page of them, and how many mappings that removes depends on how the folio
+ * is mapped. They are counted (vmctx_take_large) and left to the claim, which
+ * is exactly the behaviour they had before this existed.
+ *
+ * Upstream says the same thing about the same helper, in
+ * folio_expected_ref_count()'s own comment: it can be used "to detect
+ * unexpected references early (for example, if it makes sense to even lock the
+ * folio and unmap it)". This is that.
+ *
+ * Returns 0 if the hand-over may proceed, -EBUSY -- "not yet", never "no" --
+ * with the page untouched otherwise.
+ */
+static long vmctx_folio_precheck(struct folio *folio, int max_maps,
+				 int extra_refs, const char *what)
+{
+	int refs, want;
+
+	folio_wait_writeback(folio);
+
+	if (folio_maybe_dma_pinned(folio)) {
+		pr_warn_ratelimited("vmctx: %s refused before the unmap: dma-pinned refs=%d mapcount=%d\n",
+				    what, folio_ref_count(folio),
+				    folio_mapcount(folio));
+		return -EBUSY;
+	}
+
+	if (folio_test_large(folio)) {
+		/*
+		 * Still not answerable here. The TAKE path no longer arrives
+		 * with one -- vmctx_split_large() has made it into folios this
+		 * can answer for -- so this counts what is left: TAKEOBJ, and
+		 * TAKE with vmctx_take_split_large switched off.
+		 */
+		vmctx_precheck_large++;
+		return 0;	/* not answerable here; the claim still answers */
+	}
+
+	if (max_maps >= 0 && folio_mapcount(folio) > max_maps) {
+		pr_warn_ratelimited("vmctx: %s refused before the unmap: mapped %d time(s), more than the %d this unmap removes, refs=%d\n",
+				    what, folio_mapcount(folio), max_maps,
+				    folio_ref_count(folio));
+		return -EBUSY;
+	}
+
+	refs = folio_ref_count(folio);
+	want = folio_expected_ref_count(folio) + extra_refs;
+	if (refs != want) {
+		int was = refs;
+
+		/*
+		 * The holder is most likely some CPU's folio batch, whose slot
+		 * is a reference folio_expected_ref_count() does not count.
+		 * Drain them all -- _all, because the guest faults its pages in
+		 * on whichever CPU it was running on, and draining only this
+		 * one was kernel #38's mistake -- and ask again.
+		 *
+		 * This used to happen only for a folio that was NOT on the LRU,
+		 * on the reasoning that the batch in question is the LRU-*add*
+		 * batch, which is the one a folio sits in before it is on the
+		 * LRU. That reasoning excluded the case actually measured:
+		 * pg2 stalls on 0x7ffff7ff6000 with refs=3 want=2(+1)
+		 * mapcount=1 lru=1 anon=1 for a full second and then gives up.
+		 * lru=1, so the drain never ran; and folio_activate(),
+		 * lru_deactivate_file(), lru_lazyfree() and the mlock batches
+		 * all hold a reference to a folio that is already on the LRU.
+		 * So the condition was the instrument's blind spot rather than
+		 * a property of the folio, and it is gone.
+		 */
+		if (vmctx_take_drain_always || !folio_test_lru(folio)) {
+			lru_add_drain_all();
+			refs = folio_ref_count(folio);
+			want = folio_expected_ref_count(folio) + extra_refs;
+			if (refs == want) {
+				vmctx_take_drained++;
+				return 0;
+			}
+		}
+
+		/*
+		 * Still held. Name the holder rather than describing it:
+		 * dump_page() prints the flags, the mapping, the index, the
+		 * memcg and the type, which is what tells a swapcache
+		 * reference from an isolated-for-migration one from a pin.
+		 * Counted down so it costs nothing after the first few, and
+		 * re-armable by writing vmctx_take_dump again.
+		 */
+		pr_warn_ratelimited("vmctx: %s refused before the unmap: refs=%d want=%d(+%d) (was %d before the drain) mapcount=%d lru=%d anon=%d swapcache=%d writeback=%d dirty=%d mlocked=%d unevictable=%d ksm=%d private=%d order=%d\n",
+				    what, refs, want, extra_refs, was,
+				    folio_mapcount(folio),
+				    folio_test_lru(folio),
+				    folio_test_anon(folio),
+				    folio_test_swapcache(folio),
+				    folio_test_writeback(folio),
+				    folio_test_dirty(folio),
+				    folio_test_mlocked(folio),
+				    folio_test_unevictable(folio),
+				    folio_test_ksm(folio),
+				    folio_test_private(folio),
+				    folio_order(folio));
+		if (vmctx_take_dump > 0) {
+			vmctx_take_dump--;
+			dump_page(&folio->page, "vmctx: refused before the unmap");
+		}
+		return -EBUSY;
+	}
+	return 0;
+}
+
+/* Give back what vmctx_folio_claim() froze, once the bytes are out. */
+static void vmctx_folio_release(struct folio *folio, int frozen_refs)
+{
+	folio_ref_unfreeze(folio, frozen_refs);
+	folio_unlock(folio);
+}
+
+/*
+ * Take a page out of an *address space*, rather than out of one context.
+ *
+ * This is the operation the model always needed and never had, and its absence
+ * is why "the page has been handed over" was never quite true.
+ *
+ * A guest address space on this machine is one backing object mapped into
+ * several contexts, each with page tables of its own. VMCTX_CTL_TAKE works on
+ * one of those: it pins the page, zaps that one VMA, and copies the bytes
+ * afterwards out of the pinned page. Everything that makes the copy safe is
+ * therefore missing. The other contexts still map the same physical page and
+ * are not stopped, so the bytes can change under the copy; nothing removes the
+ * page from the object, so any of them can fault it straight back in; and the
+ * TLB flush that comes with the zap reaches only the CPUs of that one mm, so a
+ * sibling's vCPU keeps a translation to a page it has been told it lost.
+ * Userspace then issues one of these per context and punches the object
+ * separately, which turns a single hand-over into a sequence with a gap at
+ * every join.
+ *
+ * There is no way to close those gaps from above, because each one is a window
+ * inside an operation userspace cannot enter. So the hand-over becomes one
+ * operation here:
+ *
+ *   - lock the folio. From this point a fault anywhere in any mm that wants
+ *     this offset blocks in shmem_fault() on exactly this lock, so no context
+ *     can acquire the page while the hand-over is in progress.
+ *   - unmap_mapping_range() over the object's mapping, which removes the page
+ *     from *every* mm that has it, with each mm's own TLB flush, rather than
+ *     from the one this call happens to name.
+ *   - copy, with no mapping left anywhere and every would-be faulter parked.
+ *   - remove it from the object, so this side can no longer answer for it and
+ *     the next touch has to ask the machine that now holds it.
+ *
+ *   - and remove it from the object WITHOUT LETTING GO OF THE LOCK, which is
+ *     what closes the last window.
+ *
+ * That window used to be here, named rather than hidden: the folio lock had to
+ * be dropped before shmem_truncate_range(), because that takes it itself, and a
+ * context parked in shmem_fault() could be woken in the gap, map the page,
+ * write it, and have the truncate discard the write. It was described as a
+ * strictly smaller hole than the userspace loop it replaced, and it was -- but
+ * it was still a hole, and a guest's store falling into it is silent: the
+ * source is handed the copy taken before the store, and hands that copy back
+ * later. tests/hx1.c reproduces it, four threads writing their own words in one
+ * page while a forwarded read(2) keeps wanting that page.
+ *
+ * filemap_remove_folio() is what shmem_truncate_range() would have reached, and
+ * it REQUIRES the folio locked -- so the removal happens with every would-be
+ * faulter still parked, and they wake to a hole and go and ask the machine that
+ * owns the page. There is no longer a moment in this operation when the page is
+ * both absent from every page table and still available in the object.
+ *
+ * Returns PAGE_SIZE with the bytes, 0 if the address space does not have the
+ * page (not an error: the caller keeps whatever it already had), or -ENOENT if
+ * the range is not object-backed, which is the caller's signal to fall back.
+ */
+static long vmctx_ctl_takeobj(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct address_space *mapping;
+	struct vm_area_struct *vma;
+	struct mm_struct *mm;
+	struct vmctx_mem m;
+	struct folio *folio;
+	struct file *file;
+	unsigned long addr;
+	struct inode *inode;
+	pgoff_t index;
+	loff_t pos;
+	void *kaddr;
+	void *shadow;
+	long ret;
+
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	if (m.len < PAGE_SIZE)
+		return -EINVAL;
+	addr = m.addr & PAGE_MASK;
+
+	if (vmctx_syscall_holds_mm(target, addr, borrowed)) {
+		pr_warn_ratelimited("vmctx: TAKEOBJ 0x%lx pid %d: refused, held by in-flight syscall %llu (asked by %d %s)\n",
+				    addr, task_pid_nr(target),
+				    target->vmctx ? target->vmctx->sys_nr : 0,
+				    task_pid_nr(current), current->comm);
+		return -EBUSY;
+	}
+
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+
+	mmap_read_lock(mm);
+	vma = vma_lookup(mm, addr);
+	/*
+	 * Only a mapping of the backing object can be handed over this way. A
+	 * private or anonymous range has no object to remove the page from, and
+	 * answering for one here would hand over a copy while leaving the
+	 * original in place -- two holders, which is the state all of this
+	 * exists to prevent.
+	 */
+	if (!vma || !vma->vm_file || !(vma->vm_flags & VM_SHARED)) {
+		mmap_read_unlock(mm);
+		mmput(mm);
+		return -ENOENT;
+	}
+	file = get_file(vma->vm_file);
+	index = linear_page_index(vma, addr);
+	mmap_read_unlock(mm);
+	mmput(mm);
+
+	mapping = file->f_mapping;
+	inode = file->f_inode;
+	if (!shmem_mapping(mapping)) {
+		fput(file);
+		return -ENOENT;
+	}
+	pos = (loff_t)index << PAGE_SHIFT;
+
+	/*
+	 * The re-read detector's copy of what was handed over (see below).
+	 * Taken before the folio lock, where sleeping is free; a failed
+	 * allocation only switches the detector off for this one hand-over.
+	 */
+	shadow = (void *)__get_free_page(GFP_KERNEL);
+
+	folio = filemap_lock_folio(mapping, index);
+	if (IS_ERR(folio)) {
+		free_page((unsigned long)shadow);
+		fput(file);
+		return 0;		/* the address space does not have it */
+	}
+	/*
+	 * A large folio covers more than the page being handed over, and
+	 * removing it would take memory the caller never asked about. Refused
+	 * rather than guessed at; the caller falls back to the per-context
+	 * path, which is no worse than what it did before this existed.
+	 */
+	if (folio_test_large(folio)) {
+		folio_unlock(folio);
+		folio_put(folio);
+		free_page((unsigned long)shadow);
+		fput(file);
+		return -ENOENT;
+	}
+
+	/*
+	 * DMA pin is the one writer the folio lock cannot stop; check it before
+	 * unmapping (a cheap early-out) and again after (the check that counts).
+	 */
+	folio_wait_writeback(folio);
+	if (folio_maybe_dma_pinned(folio)) {
+		vmctx_takeobj_refused++;
+		folio_unlock(folio);
+		folio_put(folio);
+		free_page((unsigned long)shadow);
+		fput(file);
+		return -EBUSY;
+	}
+
+	/*
+	 * Asked once more, on the brink. The entry check ran before this
+	 * function waited for the folio lock -- a wait that can sit behind a
+	 * whole concurrent hand-over -- and a forwarded syscall that started
+	 * in that time may be mid-touch on this page right now. Refusing here
+	 * destroys nothing: the folio is still in the object, every parked
+	 * faulter wakes to it, and the caller retries.
+	 */
+	if (vmctx_syscall_holds_mm(target, addr, borrowed)) {
+		vmctx_takeobj_refused++;
+		folio_unlock(folio);
+		folio_put(folio);
+		free_page((unsigned long)shadow);
+		fput(file);
+		return -EBUSY;
+	}
+
+	unmap_mapping_range(mapping, pos, PAGE_SIZE, 0);
+
+	/*
+	 * unmap_mapping_range flushed each mapper's host TLB, but not the guests'
+	 * own ASID-tagged TLBs. Kick every running guest out before the folio is
+	 * examined and copied below, so a store made through a stale mapping in
+	 * the window since the unmap is captured in the folio we still hold rather
+	 * than lost. See vmctx_backend_invalidate().
+	 */
+	vmctx_backend_invalidate(target, addr);
+
+	/*
+	 * After the unmap under the lock no CPU has a PTE and none can make one
+	 * (a fault for this offset blocks in shmem_fault on the lock we hold),
+	 * so references held by parked faulters cannot write and no freeze is
+	 * needed -- the lock is the exclusion. The freeze this used to do was a
+	 * livelock under multi-context contention (the count is never the
+	 * expected value). The only writer left is a device pin, which is a
+	 * refcount not a mapping and survives the unmap, so it is re-checked
+	 * here, the last instant one can exist.
+	 */
+	if (folio_mapped(folio) || folio_maybe_dma_pinned(folio)) {
+		pr_warn_ratelimited("vmctx: TAKEOBJ 0x%lx: after unmap under the lock, mapped=%d dma_pinned=%d refs=%d; refusing\n",
+				    addr, folio_mapcount(folio),
+				    folio_maybe_dma_pinned(folio),
+				    folio_ref_count(folio));
+		vmctx_takeobj_lost++;
+		folio_unlock(folio);
+		folio_put(folio);
+		free_page((unsigned long)shadow);
+		fput(file);
+		return -EBUSY;
+	}
+
+	kaddr = kmap_local_folio(folio, 0);
+	if (shadow)
+		memcpy(shadow, kaddr, PAGE_SIZE);
+	ret = copy_to_user((void __user *)m.buf, kaddr, PAGE_SIZE) ?
+		-EFAULT : PAGE_SIZE;
+	vmctx_watch_check(addr, kaddr, "TAKEOBJ");
+	kunmap_local(kaddr);
+
+	/*
+	 * And OUT OF THE OBJECT WHILE STILL HOLDING ITS LOCK. This is the whole
+	 * of the fix, and the window it closes was named in this function's own
+	 * comment from the day it was written:
+	 *
+	 *   "the folio lock has to be dropped before shmem_truncate_range(),
+	 *    which takes it itself. A context that was blocked in shmem_fault()
+	 *    can be woken in that gap, map the page and write it, and the
+	 *    truncate then discards the write."
+	 *
+	 * Every context that wants this offset is parked in shmem_fault() on
+	 * this lock right now. Unlocking first wakes one of them onto a page
+	 * that is still in the object -- it maps it, writes it, and the truncate
+	 * that follows throws that write away. The guest stored a value and the
+	 * value is gone, with nothing anywhere reporting it: the source is given
+	 * the copy taken before the store, and the page it hands back later is
+	 * that copy. tests/hx1.c is that, minimised: a thread stores to its own
+	 * eight bytes, reads them straight back, and gets a value thousands of
+	 * rounds old.
+	 *
+	 * filemap_remove_folio() is the operation shmem_truncate_range() would
+	 * have reached anyway, minus the lock dance: it requires the folio
+	 * LOCKED, which is precisely the property that makes it safe here.
+	 * After it the offset is a hole, every parked faulter wakes to find
+	 * nothing, and the fault goes where it must -- to the machine that now
+	 * owns the page.
+	 *
+	 * shmem_recalc_inode() is the accounting shmem_undo_range() does after
+	 * removing a folio, and skipping it would leak the inode's alloced count
+	 * once per hand-over. It has no public declaration because nothing
+	 * outside mm/shmem.c has needed it; this is in-tree code, so it is
+	 * declared above rather than duplicated.
+	 *
+	 * ZERO, not -1, and the difference is a block leaked per hand-over.
+	 *
+	 * shmem_recalc_inode() does not take "how many pages went away" -- it
+	 * DERIVES that, from
+	 *
+	 *     freed = alloced - swapped - i_mapping->nrpages
+	 *
+	 * and only then unaccounts the blocks. Every call site in mm/shmem.c
+	 * passes 0 for `alloced` after removing a folio for exactly this reason
+	 * (shmem_undo_range: `shmem_recalc_inode(inode, 0, -nr_swaps_freed)`),
+	 * because filemap_remove_folio() has already dropped nrpages.
+	 *
+	 * Passing -1 subtracts the page a second time: alloced falls by one AND
+	 * nrpages falls by one, so `freed` computes 0, shmem_inode_unacct_blocks()
+	 * is never reached, and inode->i_blocks keeps the block for ever. The
+	 * kernel says so itself at teardown --
+	 *
+	 *   WARNING: mm/shmem.c:1430 at shmem_evict_inode+0xf8/0x2b0
+	 *
+	 * which is WARN_ON(inode->i_blocks) as the backing memfd is finally
+	 * evicted, one leaked block per punched hand-over. It also hardcoded a
+	 * single page for a folio that may be larger; deriving the count cannot
+	 * get that wrong either.
+	 *
+	 * The order is copy -> remove -> unlock, the lock spanning all of it.
+	 */
+	if (ret == PAGE_SIZE && vmctx_takeobj_punch) {
+		vmctx_takeobj_gaps++;
+		filemap_remove_folio(folio);
+		shmem_recalc_inode(inode, 0, 0);
+	}
+
+	/*
+	 * THE RE-READ (NOTES §6.1a). Everything above says no guest can still
+	 * reach this folio: unmap_mapping_range cleared every PTE, the kick
+	 * retired every guest translation, the lock parks every faulter. If
+	 * that is true the folio cannot have changed since the copy. If it
+	 * HAS changed, a guest stored through a translation the unmap+kick did
+	 * not retire -- the sub-microsecond producer of the pools' residual
+	 * invented-zeros deaths (exit 242 over a live thread stack, every
+	 * userspace crossing counter at 0), which no userspace instrument can
+	 * see because it happens inside this function.
+	 *
+	 * Read as LATE as possible: after the punch, because the folio's
+	 * memory stays ours (reference + lock) until the put below and a
+	 * stale store lands on the physical page regardless of whether the
+	 * object still names it. A change is counted and named (offset, old
+	 * and new word, cpu, pid), and the NEWER bytes are handed over in
+	 * place of the stale copy -- the store is then not lost, only late.
+	 * Bounded: a page still changing at the third re-read is counted as
+	 * unresolved; the last bytes read are what go out.
+	 */
+	if (ret == PAGE_SIZE && shadow) {
+		int pass;
+
+		kaddr = kmap_local_folio(folio, 0);
+		for (pass = 0; pass < 3 && memcmp(shadow, kaddr, PAGE_SIZE);
+		     pass++) {
+			const u64 *o = shadow, *n = kaddr;
+			unsigned int off = 0;
+
+			while (off < PAGE_SIZE / 8 && o[off] == n[off])
+				off++;
+			if (pass == 0)
+				vmctx_takeobj_stale_store++;
+			pr_warn_ratelimited("vmctx: TAKEOBJ 0x%lx pid %d: the folio CHANGED after the unmap, the kick and the copy (#%ld, re-read %d, cpu %d): +0x%x was %016llx now %016llx -- a guest stored through a translation the kick did not retire; handing over the newer bytes\n",
+					    addr, task_pid_nr(target),
+					    vmctx_takeobj_stale_store, pass,
+					    raw_smp_processor_id(), off * 8,
+					    (unsigned long long)o[off],
+					    (unsigned long long)n[off]);
+			memcpy(shadow, kaddr, PAGE_SIZE);
+			if (copy_to_user((void __user *)m.buf, kaddr,
+					 PAGE_SIZE))
+				ret = -EFAULT;
+			else
+				vmctx_takeobj_stale_recopied++;
+		}
+		if (pass == 3)
+			vmctx_takeobj_stale_unresolved++;
+		kunmap_local(kaddr);
+	}
+	/* An all-zero capture names the folio's maker (see vmctx_shmem_alloced). */
+	if (ret == PAGE_SIZE && shadow && !memchr_inv(shadow, 0, PAGE_SIZE))
+		vmctx_shm_explain_zero(mapping, index, addr, target);
+
+	folio_unlock(folio);
+	folio_put(folio);
+	free_page((unsigned long)shadow);
+	fput(file);
+	return ret;
+}
+
+/* Only the object's shared mappings -- the guest contexts -- are the ones
+ * promised read-only; a private mapping of the folio, if there were one, has no
+ * such promise to keep. This is invalid_mkclean_vma() by another name. */
+static bool vmctx_wrprotect_invalid_vma(struct vm_area_struct *vma, void *arg)
+{
+	return !(vma->vm_flags & VM_SHARED);
+}
+
+/*
+ * The per-mapping half of the object-wide protect. It does exactly what
+ * vmctx_ctl_protect() does to a single context, and no more: clear the write
+ * bit, keep the dirty bit, flush.
+ *
+ * folio_mkclean() was the obvious primitive and it is the wrong one. Besides
+ * write-protecting it also pte_mkclean()s, and a *clean* write-protected shmem
+ * page takes its next write fault down a path the guest does not come back
+ * from: pg1's stamper wrote its counter once, the source protected the page,
+ * and the stamper never advanced it again -- "the source holding a page the
+ * guest can no longer reach". Preserving the dirty bit, as ptep_set_wrprotect()
+ * does, is what keeps that write fault on the road back to the coherence layer.
+ */
+static bool vmctx_wrprotect_one(struct folio *folio, struct vm_area_struct *vma,
+				unsigned long address, void *arg)
+{
+	DEFINE_FOLIO_VMA_WALK(pvmw, folio, vma, address, PVMW_SYNC);
+	int *count = arg;
+
+	while (page_vma_mapped_walk(&pvmw)) {
+		pte_t old, new;
+
+		if (!pvmw.pte)
+			continue;	/* huge folios are refused upstream */
+		old = ptep_get(pvmw.pte);
+		if (!pte_present(old) || !pte_write(old))
+			continue;
+		switch (vmctx_protobj_mode) {
+		default:
+		case 0:	/* keep dirty, no not-present window */
+			ptep_set_wrprotect(vma->vm_mm, pvmw.address, pvmw.pte);
+			flush_tlb_page(vma, pvmw.address);
+			break;
+		case 1:	/* keep dirty, with window (ptep_clear_flush) */
+			old = ptep_clear_flush(vma, pvmw.address, pvmw.pte);
+			set_pte_at(vma->vm_mm, pvmw.address, pvmw.pte,
+				   pte_wrprotect(old));
+			break;
+		case 2:	/* clear dirty, with window (== folio_mkclean) */
+			old = ptep_clear_flush(vma, pvmw.address, pvmw.pte);
+			set_pte_at(vma->vm_mm, pvmw.address, pvmw.pte,
+				   pte_mkclean(pte_wrprotect(old)));
+			break;
+		case 3:	/* clear dirty, no window */
+			new = pte_mkclean(pte_wrprotect(old));
+			set_pte_at(vma->vm_mm, pvmw.address, pvmw.pte, new);
+			flush_tlb_page(vma, pvmw.address);
+			break;
+		}
+		(*count)++;
+		vmctx_protobj_prot++;
+	}
+	return true;
+}
+
+/*
+ * Write-protect every mapping of the folio at once, holding its lock so no new
+ * mapping can appear mid-walk (a faulter blocks in shmem_fault on this lock).
+ * The flush in vmctx_wrprotect_one() is a broadcast shootdown; it forces any
+ * guest running a mapping to VMEXIT, and the backend re-enters with the guest
+ * TLB flushed, so once this returns no context can write the page until it
+ * faults. That is the atomicity the per-context loop cannot give. Returns the
+ * number of mappings actually write-protected.
+ */
+static int vmctx_folio_wrprotect_all(struct folio *folio)
+{
+	int count = 0;
+	struct rmap_walk_control rwc = {
+		.arg = &count,
+		.rmap_one = vmctx_wrprotect_one,
+		.invalid_vma = vmctx_wrprotect_invalid_vma,
+	};
+
+	rmap_walk(folio, &rwc);
+	return count;
+}
+
+/*
+ * The read-claim counterpart of vmctx_ctl_takeobj: write-protect the object
+ * folio in EVERY mapping at once, atomically, then hand back its bytes. The
+ * per-context VMCTX_CTL_PROTECT loop in userspace protects one sibling at a
+ * time, and between protecting sibling A and sibling B, B can still write the
+ * page the source has just been promised nobody will -- the both-hold lost
+ * write. Doing it under the folio lock, over the whole rmap, closes that window.
+ */
+static long vmctx_ctl_protectobj(struct task_struct *target,
+				  struct vmctx_task *vc, void __user *arg, bool backing)
+{
+	struct address_space *mapping;
+	struct vm_area_struct *vma;
+	struct mm_struct *mm;
+	struct vmctx_mem m;
+	struct folio *folio;
+	struct file *file;
+	unsigned long addr;
+	pgoff_t index;
+	void *kaddr;
+	long ret;
+
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	if (m.len < PAGE_SIZE || (backing && (m.len != PAGE_SIZE || m.buf ||
+					    (m.addr & ~PAGE_MASK))))
+		return -EINVAL;
+	addr = m.addr & PAGE_MASK;
+
+	/*
+	 * The same exclusion vmctx_ctl_takeobj() makes, for the same reason: an
+	 * in-flight forwarded syscall is a writer this side is about to admit to
+	 * the page after the copy below. Its result is written into guest memory
+	 * with FOLL_WRITE, which re-grants write on the shared vma through a
+	 * fault the protect cannot stop, so a page read-claimed underneath it
+	 * would leave this side one write newer than the copy the source was
+	 * given -- the read-claim's version of the lost write. Refuse; the caller
+	 * answers ABSENT and the source keeps its own copy until the hold ends.
+	 */
+	if (vmctx_syscall_holds(target, addr)) {
+		pr_warn_ratelimited("vmctx: PROTECTOBJ 0x%lx pid %d: refused, held by in-flight syscall %llu (asked by %d %s)\n",
+				    addr, task_pid_nr(target),
+				    target->vmctx ? target->vmctx->sys_nr : 0,
+				    task_pid_nr(current), current->comm);
+		return -EBUSY;
+	}
+
+	mm = get_task_mm(target);
+	if (!mm)
+		return -ESRCH;
+
+	if (backing) {
+		if (!(vc->flags & VMCTX_FLAG_USERCODE) || !vmctx_quiesce_owned(mm)) {
+			mmput(mm); return -EPERM;
+		}
+		/* A lazily inherited backing page may have no virtual mapping in
+		 * any member. Resolve the configured private object itself. */
+		file = vmctx_object_file(vc, false);
+		index = addr >> PAGE_SHIFT;
+		mmput(mm);
+		if (!file) return -EBADF;
+	} else {
+		mmap_read_lock(mm);
+		vma = vma_lookup(mm, addr);
+		if (!vma || !vma->vm_file || !(vma->vm_flags & VM_SHARED)) {
+			mmap_read_unlock(mm);
+			mmput(mm);
+			return -ENOENT;		/* not object-backed */
+		}
+		file = get_file(vma->vm_file);
+		index = linear_page_index(vma, addr);
+		mmap_read_unlock(mm);
+		mmput(mm);
+	}
+
+	mapping = file->f_mapping;
+	if (!shmem_mapping(mapping)) {
+		fput(file);
+		return -ENOENT;
+	}
+
+	folio = filemap_lock_folio(mapping, index);
+	if (IS_ERR(folio)) {
+		fput(file);
+		return backing && PTR_ERR(folio) != -ENOENT ? PTR_ERR(folio) : 0;
+	}
+	if (folio_test_large(folio)) {
+		folio_unlock(folio);
+		folio_put(folio);
+		fput(file);
+		return -ENOENT;
+	}
+
+	/*
+	 * A device pin is the writer the write-protect below cannot reach: DMA
+	 * writes bypass the PTE the folio lock and folio_mkclean() act on, so a
+	 * pinned folio could be advanced after the copy and the source given a
+	 * page one write old. vmctx_ctl_takeobj() refuses it for the same reason;
+	 * so does this. Nothing is being removed, so no writeback wait is needed
+	 * -- writeback reads the folio, it does not write it.
+	 */
+	if (folio_maybe_dma_pinned(folio)) {
+		folio_unlock(folio);
+		folio_put(folio);
+		fput(file);
+		return -EBUSY;
+	}
+
+	/*
+	 * A folio in the object that no context maps is reported absent, exactly
+	 * as the per-context loop this replaces did: it protected on VMR_PG_SIZE
+	 * ("this context had it and it is now read-only") and never on the
+	 * kernel's "not present here", so a page nobody mapped was a failure and
+	 * the source fell back to its own copy. Widening that to success measured
+	 * worse in the per-context form for reasons that were never pinned down;
+	 * the single thing changing here is the atomicity of the protect, so that
+	 * predicate is held fixed. folio_mapped() under the folio lock is the
+	 * object-wide form of "some context had it".
+	 */
+	if (!folio_mapped(folio)) {
+		folio_unlock(folio);
+		folio_put(folio);
+		fput(file);
+		return 0;
+	}
+
+	/*
+	 * Asked once more, on the brink, for the same reason as the take
+	 * paths: the entry check ran before the folio-lock wait, and a
+	 * forwarded syscall that started since may be mid-write -- the copy
+	 * below would then be one write old, which is this call's whole
+	 * failure mode. Nothing is destroyed by refusing here.
+	 */
+	if (vmctx_syscall_holds(target, addr)) {
+		folio_unlock(folio);
+		folio_put(folio);
+		fput(file);
+		return -EBUSY;
+	}
+
+	/*
+	 * Write-protect the folio in every mapping at once -- clearing the write
+	 * bit only, keeping dirty, exactly as the per-context VMCTX_CTL_PROTECT
+	 * does but over the whole rmap under the folio lock. See
+	 * vmctx_folio_wrprotect_all() and vmctx_wrprotect_one() for why this is
+	 * not folio_mkclean().
+	 */
+	vmctx_folio_wrprotect_all(folio);
+
+	/*
+	 * The per-mapping shootdown above clears the host TLBs but not a running
+	 * guest's own ASID-tagged TLB, which may still hold the page WRITABLE.
+	 * Force every guest out so its next entry reloads the now-read-only
+	 * mapping; without this the "nothing can have changed the bytes since the
+	 * protect" claim below is false -- a guest keeps writing through the stale
+	 * writable entry. See vmctx_backend_invalidate().
+	 */
+	vmctx_backend_invalidate(target, addr);
+
+	/*
+	 * And read the bytes under the same lock: nothing can have changed them
+	 * since the protect above, so this copy is the page as of the protect,
+	 * not one write old. A caller that only needs the protection (not the
+	 * bytes) passes buf == 0 and gets PAGE_SIZE without a copy -- the atomic
+	 * downgrade is the whole product, and the folio stays where it is.
+	 */
+	if (m.buf) {
+		kaddr = kmap_local_folio(folio, 0);
+		ret = copy_to_user((void __user *)m.buf, kaddr, PAGE_SIZE) ?
+			-EFAULT : PAGE_SIZE;
+		vmctx_watch_check(addr, kaddr, "PROTECTOBJ");
+		kunmap_local(kaddr);
+	} else {
+		ret = PAGE_SIZE;
+	}
+
+	folio_unlock(folio);
+	folio_put(folio);
+	fput(file);
+	return ret;
+}
+
+static long vmctx_ctl_protect(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vm_area_struct *vma;
+	struct mm_struct *mm;
+	struct vmctx_mem m;
+	unsigned long addr;
+	spinlock_t *ptl;
+	pte_t *ptep;
+	long ret = 0;
+
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	if (m.len < PAGE_SIZE)
+		return -EINVAL;
+	addr = m.addr & PAGE_MASK;
+
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm)
+		return -ESRCH;
+
+	mmap_read_lock(mm);
+	vma = vma_lookup(mm, addr);
+	if (!vma) {
+		ret = -ENOENT;
+		goto out;
+	}
+	ptep = get_locked_pte(mm, addr, &ptl);
+	if (!ptep) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	if (!pte_present(ptep_get(ptep))) {
+		/*
+		 * Nothing mapped, so nothing to take away. Not an error: the
+		 * page is already unreachable, which is stronger than
+		 * read-only, and the caller wants it no more writable than it
+		 * asked for.
+		 */
+		pte_unmap_unlock(ptep, ptl);
+		goto out;
+	}
+	ptep_set_wrprotect(mm, addr, ptep);
+	pte_unmap_unlock(ptep, ptl);
+	/*
+	 * The write bit is only gone once no CPU still has the old translation.
+	 * Skipping this is invisible on the machine that ran the ioctl and lets
+	 * another CPU keep writing a page it has been told it may not.
+	 */
+	flush_tlb_mm_range(mm, addr, addr + PAGE_SIZE, PAGE_SHIFT, false);
+	/* Host flush done; kick the guest's own TLB the same way. See
+	 * vmctx_backend_invalidate(). */
+	vmctx_backend_invalidate(target, addr);
+	ret = PAGE_SIZE;
+out:
+	mmap_read_unlock(mm);
+	mmput(mm);
+	return ret;
+}
+
+/* A monitor write may cross two pages. Reserve and pin both before copying;
+ * neither a recall nor replacement mapping may interleave with the write. */
+static long vmctx_poke_guarded(struct task_struct *target, unsigned long addr,
+                              const void *bytes, size_t len,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_recall_ticket guard[2];
+	struct page *pages[2] = { NULL, NULL };
+	void *mapped[2];
+	struct mm_struct *mm;
+	unsigned long base = addr & PAGE_MASK, flags;
+	unsigned int count, held = 0, pinned = 0, i;
+	long ret;
+	size_t off = addr & ~PAGE_MASK, copied = 0;
+
+	if (len > ULONG_MAX - addr) return -EINVAL;
+	count = DIV_ROUND_UP(off + len, PAGE_SIZE);
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm) return -ESRCH;
+	mmap_read_lock(mm);
+	for (i = 0; i < count; i++) {
+		ret = vmctx_page_guard_begin(mm, base + i * PAGE_SIZE, &guard[i]);
+		if (ret) goto unlock;
+		held++;
+	}
+	/* Recall COMMIT releases its ticket before the monitor's following
+	 * write. A new SERVE may have lent the page away in that window.
+	 * Reserve every page first, then validate ownership before GUP: a
+	 * supplier's forced write fault must never recreate a remote page.
+	 * The reservations exclude all new handovers until the copy ends. */
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (i = 0; i < count; i++) {
+		unsigned int state;
+		if (!guard[i].slot) continue; /* execution adapter: no source record */
+		state = VMCTX_PGREC_STATE(vmctx_pgrec_load(guard[i].slot, guard[i].idx));
+		if (state != VMCTX_PG_HOME && state != VMCTX_PG_NONE) {
+			ret = -EAGAIN;
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			goto unlock;
+		}
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	ret = get_user_pages_remote(mm, base, count,
+				    FOLL_GET | FOLL_WRITE | FOLL_FORCE, pages, NULL);
+	if (ret > 0) pinned = ret;
+	if (ret != count) { ret = ret < 0 ? ret : -EFAULT; goto unlock; }
+	mmap_read_unlock(mm);
+	for (i = 0; i < count; i++) mapped[i] = kmap_local_page(pages[i]);
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	ret = -ESTALE;
+	for (i = 0; i < count; i++)
+		if (guard[i].cancelled) goto no_copy;
+	for (i = 0; i < count; i++) {
+		size_t n = min_t(size_t, len - copied, PAGE_SIZE - off);
+		memcpy(mapped[i] + off, bytes + copied, n);
+		copied += n;
+		off = 0;
+		if (guard[i].slot)
+			vmctx_pgrec_set(guard[i].slot, guard[i].idx,
+					VMCTX_PG_HOME, 0, true, 0);
+	}
+	ret = len;
+no_copy:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	for (i = count; i > 0; i--) kunmap_local(mapped[i - 1]);
+	if (ret > 0)
+		for (i = 0; i < count; i++) {
+			flush_dcache_page(pages[i]);
+			set_page_dirty_lock(pages[i]);
+		}
+	goto out;
+unlock:
+	mmap_read_unlock(mm);
+out:
+	for (i = 0; i < pinned; i++) put_page(pages[i]);
+	while (held) vmctx_page_guard_end(&guard[--held]);
+	mmput(mm);
+	return ret;
+}
+
+static long vmctx_ctl_mem(struct task_struct *target, void __user *arg, bool write,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_mem m;
+	void *kbuf;
+	long ret;
+	size_t len;
+
+	if (copy_from_user(&m, arg, sizeof(m)))
+		return -EFAULT;
+	len = min_t(size_t, m.len, PAGE_SIZE);
+	if (!len)
+		return 0;
+
+	kbuf = kmalloc(len, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	if (write) {
+		if (copy_from_user(kbuf, (void __user *)m.buf, len)) {
+			ret = -EFAULT;
+			goto out;
+		}
+		ret = vmctx_poke_guarded(target, m.addr, kbuf, len, borrowed);
+	} else {
+		ret = borrowed ? access_remote_vm(borrowed, m.addr, kbuf, len, 0) :
+			access_process_vm(target, m.addr, kbuf, len, 0);
+		if (ret > 0 && copy_to_user((void __user *)m.buf, kbuf, ret))
+			ret = -EFAULT;
+	}
+out:
+	kfree(kbuf);
+	return ret;
+}
+
+/* task_call_func holds the scheduler locks against wakeup and execution.
+ * Unlike a delay followed by GETREGS, this establishes that the target's
+ * architectural FPU registers have been saved and cannot change during the
+ * copy. All allocation and user access happen outside these spinlocks.
+ */
+struct vmctx_cpu_copy {
+	struct vmctx_task *vc;
+	struct vmctx_cpu_state *state;
+	void *raw;
+	bool write;
+};
+
+static int vmctx_cpu_copy_stopped(struct task_struct *t, void *arg)
+{
+	struct vmctx_cpu_copy *copy = arg;
+	struct vmctx_task *vc = copy->vc;
+	struct vmctx_cpu_state *s = copy->state;
+	int ret;
+
+	if (READ_ONCE(t->vmctx) != vc || READ_ONCE(vc->dead) ||
+	    (READ_ONCE(t->flags) & PF_EXITING))
+		return -ESRCH;
+	if (READ_ONCE(vc->sys_pending) ||
+	    (!(vc->flags & VMCTX_FLAG_SERVICE) && READ_ONCE(vc->released) &&
+	     (!READ_ONCE(vc->ev_pending) || READ_ONCE(vc->reply_pending))))
+		return -EBUSY;
+	if (task_curr(t) || task_is_running(t))
+		return -EAGAIN;
+#ifdef CONFIG_SMP
+	/* A task switching out may already have changed rq->curr. Its FPU
+	 * save precedes the scheduler's release store to on_cpu. */
+	if (smp_load_acquire(&t->on_cpu))
+		return -EAGAIN;
+#endif
+	if (!copy->write && (vc->flags & VMCTX_FLAG_SERVICE) &&
+	    !smp_load_acquire(&vc->service_ready))
+		return -EAGAIN;
+	if (copy->write) {
+		ret = xstateregs_set(t, NULL, 0, fpu_user_cfg.max_size,
+				    copy->raw, NULL);
+		if (ret)
+			return ret;
+		ptregs_from_uregs(task_pt_regs(t), &s->regs);
+		vc->guest_fsbase = s->regs.fs_base;
+		vc->guest_gsbase = s->regs.gs_base;
+		vc->fsgs_valid = 1;
+		x86_fsbase_write_task(t, s->regs.fs_base);
+		x86_gsbase_write_task(t, s->regs.gs_base);
+		return 0;
+	}
+	ret = xstateregs_get(t, NULL, (struct membuf){
+		.p = copy->raw, .left = fpu_user_cfg.max_size });
+	if (ret)
+		return ret;
+	uregs_from_ptregs(&s->regs, task_pt_regs(t));
+	s->regs.fs_base = vc->fsgs_valid ? vc->guest_fsbase : t->thread.fsbase;
+	s->regs.gs_base = vc->fsgs_valid ? vc->guest_gsbase : t->thread.gsbase;
+	return 0;
+}
+
+static long vmctx_ctl_cpu(struct task_struct *t, struct vmctx_task *vc,
+			  void __user *arg, bool write)
+{
+	struct vmctx_cpu_state *s;
+	struct vmctx_cpu_copy copy;
+	void *raw;
+	u64 active;
+	u32 cursor, i;
+	int ret;
+
+	if (!cpu_feature_enabled(X86_FEATURE_XSAVE) ||
+	    fpu_user_cfg.max_size > VMCTX_XSTATE_MAX)
+		return -EOPNOTSUPP;
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	raw = kzalloc(VMCTX_XSTATE_MAX, GFP_KERNEL);
+	if (!raw) {
+		kfree(s);
+		return -ENOMEM;
+	}
+	if (write) {
+		if (copy_from_user(s, arg, sizeof(*s))) {
+			ret = -EFAULT;
+			goto out;
+		}
+		if (s->reserved || s->xstate_size < 576 ||
+		    s->xstate_size > sizeof(s->xstate) ||
+		    s->regs.fs_base >= TASK_SIZE_MAX ||
+		    s->regs.gs_base >= TASK_SIZE_MAX) {
+			ret = -EINVAL;
+			goto out;
+		}
+		memcpy(raw, s->xstate, 576);
+		memcpy(&active, s->xstate + 512, sizeof(active));
+		if ((active & ~fpu_user_cfg.max_features) ||
+		    (vc->cpu_model_ready && (active & ~vc->cpu_model.xcr0))) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+		cursor = 576;
+		for (i = 2; i < 64; i++) {
+			u32 bytes, offset, ecx, edx, id, size;
+
+			if (!(active & BIT_ULL(i)))
+				continue;
+			if (s->xstate_size - cursor < 8) {
+				ret = -EINVAL;
+				goto out;
+			}
+			memcpy(&id, s->xstate + cursor, 4);
+			memcpy(&size, s->xstate + cursor + 4, 4);
+			cursor += 8;
+			cpuid_count(0xd, i, &bytes, &offset, &ecx, &edx);
+			if (id != i || size != bytes || !bytes ||
+			    size > s->xstate_size - cursor ||
+			    offset > fpu_user_cfg.max_size ||
+			    bytes > fpu_user_cfg.max_size - offset) {
+				ret = -EINVAL;
+				goto out;
+			}
+			memcpy(raw + offset, s->xstate + cursor, bytes);
+			cursor += bytes;
+		}
+		if (cursor != s->xstate_size) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	copy = (struct vmctx_cpu_copy){ .vc = vc, .state = s, .raw = raw, .write = write };
+	ret = task_call_func(t, vmctx_cpu_copy_stopped, &copy);
+	if (!ret && !write) {
+		memcpy(s->xstate, raw, 576);
+		/* Linux's ptrace metadata is not architectural CPU state. */
+		memset(s->xstate + 464, 0, 48);
+		memcpy(&active, s->xstate + 512, sizeof(active));
+		cursor = 576;
+		for (i = 2; i < 64; i++) {
+			u32 bytes, offset, ecx, edx;
+
+			if (!(active & BIT_ULL(i)))
+				continue;
+			cpuid_count(0xd, i, &bytes, &offset, &ecx, &edx);
+			if (!bytes || cursor > VMCTX_XSTATE_MAX - 8 ||
+			    bytes > VMCTX_XSTATE_MAX - cursor - 8 ||
+			    offset > fpu_user_cfg.max_size ||
+			    bytes > fpu_user_cfg.max_size - offset) {
+				ret = -EOVERFLOW;
+				goto out;
+			}
+			memcpy(s->xstate + cursor, &i, 4);
+			memcpy(s->xstate + cursor + 4, &bytes, 4);
+			memcpy(s->xstate + cursor + 8, raw + offset, bytes);
+			cursor += 8 + bytes;
+		}
+		s->xstate_size = cursor;
+		if (copy_to_user(arg, s, sizeof(*s)))
+			ret = -EFAULT;
+	}
+out:
+	kfree(raw);
+	kfree(s);
+	return ret;
+}
+
+#include "vmctx-runtime-core.h"
+#include "vmctx-cpu-model-core.h"
+#include "vmctx-recall-core.h"
+#include "vmctx-mapping-core.h"
+#include "vmctx-access-core.h"
+#include "vmctx-object-core.h"
+
+long vmctx_ctl_impl(pid_t pid, unsigned int cmd, void __user *arg)
+{
+	struct task_struct *target;
+	struct vmctx_task *vc = NULL;
+	long ret = 0;
+	bool cpu_locked = false, from_handle = pid < 0;
+	bool object_read = false, object_write = false;
+	struct mm_struct *fenced_mm = NULL;
+	u64 expected_mm = 0;
+	bool terminal_read = from_handle &&
+		(cmd == VMCTX_CTL_CONTEXT || cmd == VMCTX_CTL_SYSCALL_GATE);
+
+	if (cmd == VMCTX_CTL_MEMORY) {
+		struct vmctx_memory memory;
+		if (!pid) return vmctx_memory_caps(arg);
+		if (copy_from_user(&memory,arg,sizeof(memory))) return -EFAULT;
+		if (memory.version!=VMCTX_MEMORY_ABI || memory.size!=sizeof(memory) ||
+		    memory.op!=VMCTX_MEMORY_CALL || !memory.mm_identity ||
+		    memory.features || memory.reserved ||
+		    !vmctx_memory_command(memory.command)) return -EINVAL;
+		expected_mm=memory.mm_identity;
+		cmd=memory.command;
+		arg=u64_to_user_ptr(memory.argument);
+	}
+
+	if (cmd == VMCTX_CTL_OBJECT && !pid)
+		return vmctx_ctl_object(NULL, NULL, arg);
+
+	if (cmd == VMCTX_CTL_CONTEXT && !pid)
+		return vmctx_context_global(arg);
+
+	if (cmd == VMCTX_CTL_RUNTIME && !pid)
+		return vmctx_ctl_runtime(NULL, NULL, arg);
+
+	if (cmd == VMCTX_CTL_QUIESCE && !pid)
+		return vmctx_ctl_quiesce(NULL, NULL, arg);
+
+	if (cmd == VMCTX_CTL_ACCESS_LOG && !pid)
+		return vmctx_ctl_access(NULL, arg, NULL);
+
+	if (cmd == VMCTX_CTL_SOURCE_EXIT_CAPS) {
+		struct vmctx_source_exit_caps caps = {
+			.version = VMCTX_SOURCE_EXIT_ABI,
+			.size = sizeof(caps),
+			.features = VMCTX_SOURCE_EXIT_NATIVE_MM_RELEASE,
+		};
+		if (pid != 0) return -EINVAL;
+		return copy_to_user(arg, &caps, sizeof(caps)) ? -EFAULT : 0;
+	}
+
+	if (cmd == VMCTX_CTL_TRANSFER && !pid)
+		return vmctx_ctl_transfer(NULL,arg,NULL);
+
+	if (cmd == VMCTX_CTL_RECALL && !pid)
+		return vmctx_ctl_recall(NULL, arg, NULL);
+
+	if (cmd == VMCTX_CTL_EXECUTOR_MAP_CAPS) {
+		struct vmctx_executor_map_caps caps = {
+			.version = VMCTX_EXECUTOR_MAP_ABI,
+			.size = sizeof(caps),
+			.features = VMCTX_EXECUTOR_MAP_PROTECT_MM |
+				    VMCTX_EXECUTOR_MAP_SHARED_PAGE |
+				    VMCTX_EXECUTOR_MAP_READ_OBJECT |
+				    VMCTX_EXECUTOR_MAP_PRESERVE_WRITE,
+		};
+		if (pid != 0) return -EINVAL;
+		return copy_to_user(arg, &caps, sizeof(caps)) ? -EFAULT : 0;
+	}
+
+	if (cmd == VMCTX_CTL_CPU_CAPS) {
+		struct vmctx_cpu_model caps;
+		if (pid != 0) return -EINVAL;
+		ret = vmctx_cpu_caps_all(&caps);
+		if (ret) return ret;
+		return copy_to_user(arg, &caps, sizeof(caps)) ? -EFAULT : 0;
+	}
+
+	if (from_handle) {
+		ret = vmctx_context_resolve(pid, &target, &vc);
+		if (ret) return ret;
+		/* The descriptor already proves this monitor owns the retained
+		 * lifetime. Terminal INFO/CHILD/QUERY inspect its stored record;
+		 * they do not attach to a native task. In particular Yama denies
+		 * ptrace access after release_task() removes the PID. Live control
+		 * still requires the current native credential/LSM checks. Recheck
+		 * death after a denial to cover exit racing the access check. The
+		 * acquired_vc and per-operation gates reject all terminal mutation.
+		 */
+		if (!smp_load_acquire(&vc->dead) &&
+		    !ptrace_may_access(target, PTRACE_MODE_ATTACH_REALCREDS) &&
+		    !smp_load_acquire(&vc->dead)) {
+			ret = -EPERM; goto out_vc;
+		}
+		goto acquired_vc;
+	}
+	target = find_get_task_by_vpid(pid);
+	if (!target)
+		return -ESRCH;
+	if (!ptrace_may_access(target, PTRACE_MODE_ATTACH_REALCREDS)) {
+		ret = -EPERM;
+		goto out_put;
+	}
+
+	if (!expected_mm && (cmd == VMCTX_CTL_ACCESS_LOG || cmd == VMCTX_CTL_RECALL)) {
+		ret = cmd == VMCTX_CTL_ACCESS_LOG ? vmctx_ctl_access(target, arg, fenced_mm) :
+			vmctx_ctl_recall(target, arg, fenced_mm);
+		goto out_put;
+	}
+	if (cmd == VMCTX_CTL_SOURCE_EXEC) {
+		if (target != current || arg)
+			ret = -EINVAL;
+		else
+			current->vmctx_source_exec = true;
+		goto out_put;
+	}
+
+	if (cmd == VMCTX_CTL_ADOPT) {
+		struct vmctx_task *nvc = kzalloc(sizeof(*nvc), GFP_KERNEL);
+
+		if (!nvc) {
+			ret = -ENOMEM;
+			goto out_put;
+		}
+		kref_init(&nvc->kref);
+		vmctx_object_init(nvc);
+		/*
+		 * Its faults go to the monitor, and they have to.
+		 *
+		 * A service context holds the program's real address space, so
+		 * source-side reads of it are right by construction. Its
+		 * *writes* are not: the program's stores happen on the machine
+		 * running its instructions, into memory this task has never
+		 * seen. So a page this side touches may be one the other side
+		 * has since written, and the only thing that can supply it is
+		 * the monitor.
+		 *
+		 * Without this the context faults, no one is asked, and
+		 * do_anonymous_page() invents a zero page -- which is how a
+		 * nine-element iovec the guest had just built on its own stack
+		 * was read here as nine zero lengths.
+		 */
+		nvc->flags = VMCTX_FLAG_SERVICE | VMCTX_FLAG_REDIRECT_FAULT;
+		nvc->backend = NULL;	/* a service context never enters one */
+		init_waitqueue_head(&nvc->ev_wq);
+		init_waitqueue_head(&nvc->reply_wq);
+		init_waitqueue_head(&nvc->sys_wq);
+		spin_lock_init(&nvc->ev_lock);
+	mutex_init(&nvc->cpu_ctl_lock);
+		spin_lock_init(&nvc->sys_pages_lock);
+		get_task_struct(current);
+		nvc->monitor = current;
+
+		task_lock(target);
+		if (target->vmctx) {
+			task_unlock(target);
+			put_task_struct(current);
+			kfree(nvc);
+			ret = -EEXIST;
+			goto out_put;
+		}
+		target->vmctx = nvc;
+		task_unlock(target);
+
+		/*
+		 * Armed last. From here the task's next return to user mode
+		 * parks it (see vmctx_guest_step), so it holds the program
+		 * without ever running it.
+		 */
+		nvc->noted_mm = target->mm;
+		vmctx_mm_note(target->mm, true, task_tgid_nr(current));
+		atomic_inc(&vmctx_nr_active);
+		smp_store_release(&nvc->active, 1);
+		pr_info("vmctx: pid %d adopted as a service context by pid %d\n",
+			task_pid_nr(target), task_pid_nr(current));
+		ret = 0;
+		goto out_put;
+	}
+
+	task_lock(target);
+	vc = target->vmctx;
+	if (vc)
+		kref_get(&vc->kref);
+	task_unlock(target);
+	if (!vc) {
+		ret = -EINVAL;		/* not a VM context */
+		goto out_put;
+	}
+acquired_vc:
+	if (smp_load_acquire(&vc->dead) && !terminal_read) {
+		ret = -ESRCH; goto out_vc;
+	}
+	if (!smp_load_acquire(&vc->active) && !terminal_read) {
+		ret = -EAGAIN; goto out_vc;
+	}
+	if (from_handle && !smp_load_acquire(&vc->dead)) {
+		bool same;
+		task_lock(target);
+		same = target->vmctx == vc;
+		task_unlock(target);
+		if (!same) { ret = -ESRCH; goto out_vc; }
+	}
+	/*
+	 * Every command except ATTACH requires that we are the monitor. Any
+	 * thread of the monitoring process counts: a monitor typically has one
+	 * thread blocked in WAIT while another services page requests.
+	 */
+	if (cmd != VMCTX_CTL_ATTACH && !vmctx_monitor_authorized(vc, terminal_read)) {
+		ret = -EPERM;
+		/*
+		 * out_vc, not out_put: a reference to vc was taken above and
+		 * out_put skips the kref_put. This leaked one reference on
+		 * every refused call, so a context that was probed by anything
+		 * other than its own monitor was never freed.
+		 */
+		goto out_vc;
+	}
+	/*
+	 * Passing the gate above PROVES current is the monitor's thread
+	 * group, so use the proof: an mm whose slot never learned its
+	 * monitor (a context that inherited its monitor across fork and
+	 * never passed through ATTACH; session 41c measured pgrep, Xvfb and
+	 * gnome-shell inventing pages into exactly such mms because the
+	 * refusal could not attribute them) acquires it from the first ctl
+	 * that services it. First-binder-wins inside; no-op once set. Not
+	 * for ATTACH -- it is exempt from the gate, so a caller that is
+	 * ABOUT to lose the attach race must not stamp the slot; the ATTACH
+	 * case records the winner itself.
+	 */
+	if (cmd != VMCTX_CTL_ATTACH && !smp_load_acquire(&vc->dead)) {
+		struct mm_struct *mm = get_task_mm(target);
+		if (mm) {
+			vmctx_mm_set_monitor(mm, task_tgid_nr(current));
+			mmput(mm);
+		}
+	}
+
+	if (expected_mm) {
+		if (!(vc->flags & VMCTX_FLAG_SERVICE)) { ret=-EOPNOTSUPP; goto out_vc; }
+		fenced_mm=vmctx_memory_hold(target,expected_mm);
+		if (IS_ERR(fenced_mm)) {
+			ret=PTR_ERR(fenced_mm);fenced_mm=NULL;goto out_vc;
+		}
+	}
+
+	if (cmd == VMCTX_CTL_GETCPU || cmd == VMCTX_CTL_SETCPU ||
+	    cmd == VMCTX_CTL_GETREGS || cmd == VMCTX_CTL_SETREGS ||
+	    cmd == VMCTX_CTL_SYSCALL || cmd == VMCTX_CTL_EXCEPTION ||
+	    cmd == VMCTX_CTL_CPU_MODEL || cmd == VMCTX_CTL_RUNTIME ||
+	    cmd == VMCTX_CTL_BOUNDARY || cmd == VMCTX_CTL_SYSCALL_GATE ||
+	    cmd == VMCTX_CTL_DETACH || cmd == VMCTX_CTL_OBJECT ||
+	    (cmd == VMCTX_CTL_RESUME && !(vc->flags & VMCTX_FLAG_SERVICE))) {
+		if (!mutex_trylock(&vc->cpu_ctl_lock)) {
+			ret = -EBUSY;
+			goto out_vc;
+		}
+		cpu_locked = true;
+		/* A control may have passed the first check before teardown took
+		 * this lock. Never use a destroyed backend through that old check. */
+		if (smp_load_acquire(&vc->dead) && !terminal_read) {
+			ret = -ESRCH; goto out_vc;
+		}
+	}
+	/* Lock order: cpu_ctl_lock -> object_sem -> mmap/folio locks.
+	 * Source memory service can wait on a monitor; it must not acquire
+	 * this execution-only gate. WAIT must also remain outside the gate. */
+	if (!(vc->flags & VMCTX_FLAG_SERVICE)) {
+		if (cmd == VMCTX_CTL_OBJECT) {
+			if (down_write_killable(&vc->object_sem)) { ret = -EINTR; goto out_vc; }
+			object_write = true;
+		} else if (vmctx_object_memory_control(cmd)) {
+			if (down_read_killable(&vc->object_sem)) { ret = -EINTR; goto out_vc; }
+			object_read = true;
+		}
+		if (smp_load_acquire(&vc->dead) && !terminal_read) { ret = -ESRCH; goto out_vc; }
+	}
+	switch (cmd) {
+	case VMCTX_CTL_OBJECT:
+		ret = vmctx_ctl_object(target, vc, arg);
+		break;
+	case VMCTX_CTL_CONTEXT:
+		ret = vmctx_ctl_context(target, vc, from_handle, arg);
+		break;
+	case VMCTX_CTL_ACCESS_LOG:
+		ret = vmctx_ctl_access(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_TRANSFER:
+		ret = (vc->flags & VMCTX_FLAG_SERVICE) && fenced_mm ?
+			vmctx_ctl_transfer(target,arg,fenced_mm) : -EOPNOTSUPP;
+		break;
+	case VMCTX_CTL_RECALL:
+		ret = vmctx_ctl_recall(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_SYSCALL_GATE: {
+		struct vmctx_syscall_gate rq, *gate = &vc->syscall_gate;
+		u32 state;
+
+		if (copy_from_user(&rq, arg, sizeof(rq))) { ret = -EFAULT; break; }
+		if (rq.version != VMCTX_SYSCALL_GATE_ABI || rq.size != sizeof(rq) ||
+		    rq.reserved || !rq.ticket || rq.op < VMCTX_GATE_BEGIN ||
+		    rq.op > VMCTX_GATE_CANCEL || !(vc->flags & VMCTX_FLAG_SERVICE)) {
+			ret = -EINVAL; break;
+		}
+		if (smp_load_acquire(&vc->dead) && rq.op != VMCTX_GATE_QUERY) {
+			ret = -ESRCH; break;
+		}
+		if (!vmctx_monitor_authorized(vc, from_handle && rq.op == VMCTX_GATE_QUERY)) {
+			ret = smp_load_acquire(&vc->dead) ? -ESRCH : -EPERM; break;
+		}
+		state = smp_load_acquire(&gate->state);
+		if (rq.op == VMCTX_GATE_BEGIN && rq.ticket != gate->ticket) {
+			if (rq.ticket < gate->ticket) { ret = -ESTALE; break; }
+			if (READ_ONCE(vc->sys_pending) || vc->assist_nr) { ret = -EBUSY; break; }
+			if (gate->ticket == U64_MAX) { ret = -EOVERFLOW; break; }
+			if (rq.ticket != gate->ticket + 1) { ret = -EINVAL; break; }
+			if (!smp_load_acquire(&vc->service_ready)) { ret = -EAGAIN; break; }
+			if (vc->sys_gate_owner)
+				put_task_struct(vc->sys_gate_owner);
+			get_task_struct(current);
+			vc->sys_gate_owner = current;
+			if (vc->gate_child_task) put_task_struct(vc->gate_child_task);
+			if (vc->gate_child_vc) kref_put(&vc->gate_child_vc->kref, vmctx_task_free);
+			vc->gate_child_task = NULL;
+			vc->gate_child_vc = NULL;
+			memset(gate, 0, sizeof(*gate));
+			gate->ticket = rq.ticket;
+			vc->sys_exception = 3;
+			vc->sys_done = 0;
+			gate->state = VMCTX_GATE_ENTERING;
+			smp_store_release(&vc->sys_pending, 1);
+			wake_up(&vc->reply_wq);
+			wake_up(&vc->sys_wq);
+			wake_up_process(target);
+		} else if (rq.ticket != gate->ticket) {
+			ret = -ESTALE; break;
+		} else if (rq.op == VMCTX_GATE_COMMIT) {
+			if (state == VMCTX_GATE_ENTERING) { ret = -EAGAIN; break; }
+			if (state == VMCTX_GATE_ADMITTED) {
+				smp_store_release(&gate->state, VMCTX_GATE_RUNNING);
+				wake_up(&vc->sys_wq);
+			}
+		} else if (rq.op == VMCTX_GATE_CANCEL) {
+			ret = send_sig(SIGKILL, target, 1);
+			break;
+		}
+		rq.dispatch_ret = 0;
+		memset(&rq.call, 0, sizeof(rq.call));
+		rq.child_host_pid = rq.child_pid = 0;
+		rq.child_shared_mm = 0;
+		rq.state = smp_load_acquire(&gate->state);
+		if (rq.state >= VMCTX_GATE_ADMITTED) {
+			rq.call.nr = gate->call.nr;
+			memcpy(rq.call.args, gate->call.args, sizeof(rq.call.args));
+		}
+		if (rq.state == VMCTX_GATE_COMPLETE) {
+			/* COMPLETE must also retire the assisted slot before a
+			 * client can capture the returned extended CPU state. */
+			if (smp_load_acquire(&vc->sys_pending) && !smp_load_acquire(&vc->dead)) { ret = -EAGAIN; break; }
+			rq.call = gate->call;
+			rq.dispatch_ret = gate->dispatch_ret;
+		}
+		rq.child_host_pid = smp_load_acquire(&gate->child_host_pid);
+		if (rq.child_host_pid) {
+			rq.child_pid = gate->child_pid;
+			rq.child_shared_mm = gate->child_shared_mm;
+		}
+		ret = copy_to_user(arg, &rq, sizeof(rq)) ? -EFAULT : 0;
+		break;
+	}
+	case VMCTX_CTL_RUNTIME:
+		ret = vmctx_ctl_runtime(target, vc, arg);
+		break;
+	case VMCTX_CTL_QUIESCE:
+		ret = vmctx_ctl_quiesce(target, vc, arg);
+		break;
+	case VMCTX_CTL_CPU_MODEL:
+		ret = vmctx_ctl_cpu_model(target, vc, arg);
+		break;
+	case VMCTX_CTL_GETCPU:
+	case VMCTX_CTL_SETCPU:
+		ret = vmctx_ctl_cpu(target, vc, arg, cmd == VMCTX_CTL_SETCPU);
+		break;
+	case VMCTX_CTL_ATTACH:
+		ret = vmctx_attach_monitor(vc);
+		if (!ret) {
+			vmctx_mm_set_monitor(target->mm, task_tgid_nr(current));
+			wake_up(&vc->reply_wq);
+		}
+		break;
+	case VMCTX_CTL_DETACH:
+		if (READ_ONCE(vc->sys_pending)) { ret = -EBUSY; break; }
+		vmctx_drop_monitor(vc);
+		wake_up(&vc->reply_wq);		/* unblock the context */
+		break;
+	case VMCTX_CTL_WAIT: {
+		struct vmctx_event ev;
+		struct vmctx_spin sp;
+
+		vmctx_spin_begin(&sp, VMCTX_SPIN_EVENT);
+		vmctx_spin_wait(vc, VMCTX_SPIN_EVENT,
+				smp_load_acquire(&vc->ev_pending) ||
+				READ_ONCE(vc->dead));
+		for (;;) {
+			ret = wait_event_interruptible(vc->ev_wq,
+						       vc->ev_pending || vc->dead);
+			if (ret)
+				goto wait_out;
+			if (vc->dead) {
+				ret = -ESRCH;	/* gone; stop monitoring */
+				goto wait_out;
+			}
+			/*
+			 * Claim it under the lock, and copy from the claimed
+			 * snapshot rather than from the context.
+			 *
+			 * ev_pending is re-tested here because the waiter may
+			 * have withdrawn the event between the wake-up and now
+			 * -- that is the whole point of the lock, and taking an
+			 * event that has been withdrawn is how the same syscall
+			 * gets run twice. A withdrawn event simply means going
+			 * back to sleep.
+			 */
+			spin_lock(&vc->ev_lock);
+			if (vc->ev_pending) {
+				ev = vc->ev;
+				vc->ev_taken = 1;   /* a reply to this is owed */
+				spin_unlock(&vc->ev_lock);
+				break;
+			}
+			spin_unlock(&vc->ev_lock);
+		}
+		vmctx_spin_end(vc, &sp);
+		if (copy_to_user(arg, &ev, sizeof(ev))) {
+			ret = -EFAULT;
+			spin_lock(&vc->ev_lock);
+			vc->ev_taken = 0;
+			spin_unlock(&vc->ev_lock);
+		}
+wait_out:
+		break;
+	}
+	case VMCTX_CTL_RESUME: {
+		struct vmctx_reply rep;
+
+		if (copy_from_user(&rep, arg, sizeof(rep))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (vc->ev_abandoned) {
+			/*
+			 * This answers an event whose waiter gave up (a signal
+			 * arrived). Accepting it would leave a reply sitting in
+			 * the context for the next, unrelated event.
+			 *
+			 * Drop the reply and nothing else. The context has very
+			 * likely re-published by now — it retries as soon as the
+			 * signal is delivered — and clearing ev_pending here
+			 * unpublishes that new event: the context then waits for
+			 * a reply to something the monitor will never be told
+			 * about, and the monitor waits for an event that has
+			 * already been taken off the queue. Both sides sleep,
+			 * neither is at fault, and the run simply stops.
+			 *
+			 * Nothing sets ev_abandoned any more: a waiter may only
+			 * withdraw an event the monitor has not taken, and the
+			 * two are decided under ev_lock. This is kept as the
+			 * check that says so, and it says it out loud, because
+			 * an event that was both taken and abandoned means the
+			 * syscall has run twice.
+			 */
+			pr_warn("vmctx: pid %d: a reply arrived for an event its waiter had abandoned; the syscall may have run twice\n",
+				task_pid_nr(target));
+			vc->ev_abandoned = 0;
+			smp_store_release(&vc->released, 1);
+			break;
+		}
+		vc->reply = rep;
+		vc->ev_pending    = 0;
+		/* Release: a spinning vmctx_report reads the reply after this. */
+		smp_store_release(&vc->reply_pending, 1);
+		/* Publish installed CPU state before releasing a restoring task. */
+		smp_store_release(&vc->released, 1);
+		wake_up(&vc->reply_wq);
+		break;
+	}
+	case VMCTX_CTL_GETREGS: {
+		struct vmctx_uregs u;
+
+		if (READ_ONCE(vc->sys_pending)) { ret = -EBUSY; break; }
+
+		uregs_from_ptregs(&u, task_pt_regs(target));
+		/*
+		 * A guest's bases come from the vmctx-owned copy, which a
+		 * context switch cannot clobber; thread.fsbase answers only
+		 * for a task nothing has SETREGS'd (a service context, or a
+		 * child whose frame is being read before its monitor speaks).
+		 * See guest_fsbase in the struct for the measured failure.
+		 */
+		if (vc->fsgs_valid) {
+			u.fs_base = vc->guest_fsbase;
+			u.gs_base = vc->guest_gsbase;
+		} else {
+			u.fs_base = target->thread.fsbase;
+			u.gs_base = target->thread.gsbase;
+		}
+		if (copy_to_user(arg, &u, sizeof(u)))
+			ret = -EFAULT;
+		break;
+	}
+	case VMCTX_CTL_SETREGS: {
+		struct vmctx_uregs u;
+
+		if (READ_ONCE(vc->sys_pending)) { ret = -EBUSY; break; }
+
+		if (copy_from_user(&u, arg, sizeof(u))) {
+			ret = -EFAULT;
+			break;
+		}
+		ptregs_from_uregs(task_pt_regs(target), &u);
+		/*
+		 * The thread pointer travels with the registers -- into the
+		 * vmctx-owned copy first, which is what a guest's entry path
+		 * reads and what no context switch can undo. thread.fsbase is
+		 * still written: a SERVICE context has no backend to load the
+		 * VMCB from the copy, and its forwarded calls compare against
+		 * thread.fsbase (vmctx_do_monitor_syscall). Zero still means
+		 * "leave it alone", as it always has.
+		 */
+		if (u.fs_base) {
+			vc->guest_fsbase = u.fs_base;
+			vc->fsgs_valid = 1;
+			x86_fsbase_write_task(target, u.fs_base);
+		}
+		if (u.gs_base) {
+			vc->guest_gsbase = u.gs_base;
+			vc->fsgs_valid = 1;
+			x86_gsbase_write_task(target, u.gs_base);
+		}
+		break;
+	}
+	case VMCTX_CTL_PEEK:
+		ret = vmctx_ctl_mem(target, arg, false, fenced_mm);
+		break;
+	case VMCTX_CTL_MAPPING:
+		ret = (vc->flags & VMCTX_FLAG_SERVICE) ?
+			vmctx_ctl_mapping(target, arg, fenced_mm) : -EOPNOTSUPP;
+		break;
+	case VMCTX_CTL_POKE:
+		ret = vmctx_ctl_mem(target, arg, true, fenced_mm);
+		break;
+	case VMCTX_CTL_TAKE:
+		ret = vmctx_ctl_take(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_SERVE:
+		ret = vmctx_ctl_serve(target, arg, false, fenced_mm);
+		break;
+	case VMCTX_CTL_PGSTATE:
+		ret = vmctx_ctl_serve(target, arg, true, fenced_mm);
+		break;
+	case VMCTX_CTL_LAND:
+		ret = vmctx_ctl_land(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_PGACK:
+		ret = vmctx_ctl_pgack(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_PGSCAN:
+		ret = vmctx_ctl_pgscan(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_PGSET:
+		ret = vmctx_ctl_pgset(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_TAKEOBJ:
+		ret = vmctx_ctl_takeobj(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_PROTECT:
+		ret = vmctx_ctl_protect(target, arg, fenced_mm);
+		break;
+	case VMCTX_CTL_PROTECT_BACKING:
+		ret = vmctx_ctl_protectobj(target, vc, arg, true);
+		break;
+	case VMCTX_CTL_PROTECTOBJ:
+		ret = vmctx_ctl_protectobj(target, vc, arg, false);
+		break;
+	case VMCTX_CTL_MAPOBJ:
+		ret = vmctx_ctl_mapobj(target, arg);
+		break;
+	case VMCTX_CTL_MAPOBJ_READ:
+		ret = vmctx_ctl_mapobj_read(target, arg);
+		break;
+	case VMCTX_CTL_PROTECT_MM:
+		ret = vmctx_ctl_protect_mm(target, arg);
+		break;
+	case VMCTX_CTL_APPLYMAP:
+		ret = vmctx_ctl_applymap(target, arg);
+		break;
+	case VMCTX_CTL_BOUNDARY:
+	case VMCTX_CTL_EXCEPTION:
+	case VMCTX_CTL_SYSCALL: {
+		struct vmctx_syscall rq;
+		long left;
+
+		if (copy_from_user(&rq, arg, sizeof(rq))) {
+			ret = -EFAULT;
+			break;
+		}
+		/*
+		 * The slot's contract, and all three clauses are the same rule:
+		 * work is never handed to a context whose execution has not
+		 * been stopped or proven idle.
+		 *
+		 * A context that is mid-exit will never reach the return-to-
+		 * user path again, so a request queued on it is a 30-second
+		 * wedge ending in nothing -- and the measured cost was not the
+		 * 30 seconds but WHERE they sat: vmhome's teardown wake for a
+		 * dead thread's joiner queued behind exactly this, so the wake
+		 * that would have ended a forwarded futex WAIT arrived after
+		 * the run was over. Refuse instantly; the caller has a sibling
+		 * fallback that works in microseconds.
+		 *
+		 * assist_nr guards the OTHER half: a previous assisted call
+		 * whose requester timed out and walked away may STILL BE
+		 * EXECUTING (a blocked futex wait does this legitimately).
+		 * Accepting a new request then lets the old call's completion
+		 * pair with the new call's wait -- a futex's -EAGAIN returned
+		 * as a writev's result. One frame, one request, ever.
+		 */
+		if (vc->dead || (target->flags & PF_EXITING)) {
+			ret = -ESRCH;
+			break;
+		}
+		if (vc->sys_pending || vc->assist_nr) {
+			ret = -EBUSY;
+			break;
+		}
+		if (cmd == VMCTX_CTL_EXCEPTION) {
+			if (rq.args[2] || rq.args[3] || rq.args[4] || rq.args[5]) {
+				ret = -EINVAL;
+				break;
+			}
+			/* Reserved status bits are not causes. No debug address or
+			 * architectural error code exists for a user #DB. */
+			if (rq.nr == X86_TRAP_DB &&
+			    (rq.args[1] || (rq.args[0] & ~0x1e80fULL))) {
+				ret = -EINVAL;
+				break;
+			}
+			switch (rq.nr) {
+			case X86_TRAP_DB:
+			case X86_TRAP_DE: case X86_TRAP_UD: case X86_TRAP_BP:
+			case X86_TRAP_GP: case X86_TRAP_PF: case X86_TRAP_AC:
+			case X86_TRAP_MF: case X86_TRAP_XF:
+				break;
+			default:
+				ret = -EINVAL;
+				goto out_vc;
+			}
+		}
+		if (cmd == VMCTX_CTL_BOUNDARY &&
+		    (!(vc->flags & VMCTX_FLAG_SERVICE) || rq.nr ||
+		     rq.args[0] || rq.args[1] || rq.args[2] || rq.args[3] || rq.args[4] || rq.args[5])) {
+			ret = -EINVAL;
+			break;
+		}
+		vc->sys_exception = cmd == VMCTX_CTL_BOUNDARY ? 2 : cmd == VMCTX_CTL_EXCEPTION;
+		vc->sys_nr   = rq.nr;
+		memcpy(vc->sys_args, rq.args, sizeof(vc->sys_args));
+		vc->sys_ret     = 0;
+		vc->sys_done    = 0;
+		/* Release: a spinning service park reads the request after this. */
+		smp_store_release(&vc->sys_pending, 1);
+		/*
+		 * Nudge it: a context parked waiting for its monitor is asleep
+		 * on reply_wq, and it has to reach the return-to-user path
+		 * before it can run anything for us.
+		 */
+		wake_up(&vc->reply_wq);
+		wake_up_process(target);
+		/*
+		 * Uninterruptibly, and deliberately. Giving up here would leave
+		 * the request pending and the context would perform it later,
+		 * with nobody to take the answer -- and a syscall performed
+		 * twice, or performed after the caller has stopped caring, is
+		 * the class of bug this file has been bitten by before.
+		 *
+		 * In one-second slices, RE-NUDGING each time, because one nudge
+		 * measurably does not suffice: a context still EXECUTING an
+		 * earlier assisted call -- a pthread_join's futex wait whose
+		 * requester timed out and walked away -- sat in futex_do_wait
+		 * through a single wake_up_process and thirty seconds of this
+		 * wait, photographed twice (its word page still absent, so it
+		 * never even re-read the word). A woken futex re-reads its word
+		 * and returns EAGAIN when the value moved, which is exactly
+		 * what ends that occupation; how many nudges that takes is
+		 * counted, so the log says whether one was lost or many.
+		 */
+		{
+			int slice;
+
+			/*
+			 * UNBOUNDED, because a blocking syscall blocking is not
+			 * a failure: a forwarded futex WAIT sleeps exactly as
+			 * long as a native one would, and the old 30-second
+			 * deadline did not end the sleep -- it abandoned it,
+			 * fabricated -EIO for a call that was still running,
+			 * and left a zombie occupying the slot. Killable, so a
+			 * wedged monitor can still be ended BY PID; a dead
+			 * context ends it through vc->dead. The 30s mark is
+			 * kept as a diagnostic line, not a deadline.
+			 */
+			struct vmctx_spin sp;
+
+			left = 0;
+			vmctx_spin_begin(&sp, VMCTX_SPIN_SYSDONE);
+			vmctx_spin_wait(vc, VMCTX_SPIN_SYSDONE,
+					(smp_load_acquire(&vc->sys_done) &&
+					 !smp_load_acquire(&vc->sys_pending)) ||
+					READ_ONCE(vc->dead));
+			for (slice = 0;; slice++) {
+				long w = wait_event_killable_timeout(vc->sys_wq,
+							  (smp_load_acquire(&vc->sys_done) &&
+							   !smp_load_acquire(&vc->sys_pending)) ||
+							  vc->dead, HZ);
+				if (w < 0) {	/* fatal signal to the caller */
+					/* The executing call still owns the slot. */
+					break;
+				}
+				if (w || (smp_load_acquire(&vc->sys_done) &&
+					  !smp_load_acquire(&vc->sys_pending)) || vc->dead) {
+					left = 1;
+					break;
+				}
+				wake_up(&vc->reply_wq);
+				wake_up_process(target);
+				vmctx_sys_renudge++;
+				if (slice == 30)
+					pr_warn("vmctx: pid %d: assisted syscall %llu still executing after 30s -- blocking is legitimate, this is a diagnostic and not a deadline\n",
+						task_pid_nr(target), rq.nr);
+			}
+			vmctx_spin_end(vc, &sp);
+		}
+		if (!vc->sys_done) {
+			/* Completion, not caller timeout, releases the slot. */
+			pr_warn("vmctx: pid %d: did not perform the monitor's syscall %llu%s\n",
+				task_pid_nr(target), rq.nr,
+				left == 0 ? " (timed out)" : " (context gone)");
+			/*
+			 * Name the call that is SITTING ON the slot, not only
+			 * the one that lost it. A photograph of a hung run
+			 * showed the context parked in futex_do_wait under
+			 * vmctx_dispatch_syscall while a writev timed out
+			 * behind it -- an assisted call that blocks
+			 * indefinitely starves every later one, and this line
+			 * is how that stops needing a photographer. For a
+			 * futex the word's current value is the whole
+			 * question: 0 means the wake this wait is waiting for
+			 * already happened and was lost across the machines;
+			 * nonzero means the clear it watches never arrived.
+			 */
+			if (vc->assist_nr) {
+				u32 word = 0xdead;
+				int got = 0;
+
+				if (vc->assist_nr == __NR_futex)
+					got = access_process_vm(target,
+						vc->assist_arg0, &word,
+						sizeof(word), FOLL_FORCE);
+				pr_warn("vmctx: pid %d: the slot is occupied by assisted syscall %llu(0x%llx)%s%08x -- still executing\n",
+					task_pid_nr(target), vc->assist_nr,
+					vc->assist_arg0,
+					got == sizeof(word) ?
+					", and the futex word there reads 0x" :
+					", word unread 0x", word);
+				sched_show_task(target);
+			}
+			ret = -ETIMEDOUT;
+			break;
+		}
+		rq.ret     = vc->sys_ret;
+		rq.changed = vc->sys_changed;
+		rq.regs    = vc->sys_regs;
+		ret = copy_to_user(arg, &rq, sizeof(rq)) ? -EFAULT : 0;
+		break;
+	}
+	case VMCTX_CTL_FUTEXWAKE: {
+		struct vmctx_mem m;
+		struct mm_struct *mm;
+
+		if (copy_from_user(&m, arg, sizeof(m))) {
+			ret = -EFAULT;
+			break;
+		}
+		mm = vmctx_control_mm(target, fenced_mm);
+		if (!mm) {
+			ret = -ESRCH;
+			break;
+		}
+		/*
+		 * See futex_wake_mm(): the waiter queue belongs to the address
+		 * space, so the wake is performed on the mm from this thread,
+		 * needing nothing of any context -- which is the point, since
+		 * the context that would otherwise carry it is typically the
+		 * one blocked in the WAIT being woken.
+		 */
+		ret = futex_wake_mm(mm, m.addr, INT_MAX);
+		mmput(mm);
+		break;
+	}
+	case VMCTX_CTL_BREAKCOW: {
+		struct vmctx_mem m;
+		struct mm_struct *mm;
+
+		if (copy_from_user(&m, arg, sizeof(m))) {
+			ret = -EFAULT;
+			break;
+		}
+		mm = vmctx_control_mm(target, fenced_mm);
+		if (!mm) {
+			ret = -ESRCH;
+			break;
+		}
+		vmctx_breakcow_calls++;
+		mmap_read_lock(mm);
+		/*
+		 * No folio to judge against: the caller is not mid-take and has
+		 * not looked one up. The break is asked for unconditionally and
+		 * "already private" is success -- there is nothing to report,
+		 * and reporting it would only give the caller something to
+		 * retry.
+		 */
+		vmctx_break_cow_share(mm, m.addr & PAGE_MASK, NULL);
+		mmap_read_unlock(mm);
+		mmput(mm);
+		ret = 0;
+		break;
+	}
+	case VMCTX_CTL_LASTCHILD: {
+		/*
+		 * The init-ns pid of the target's last clone child, recorded by
+		 * kernel_clone() (vmctx_clone_noted). The clone's own return
+		 * value is relative to the parent's pid namespace, which a
+		 * sandbox makes a different number from the one every ctl and
+		 * kill here must use.
+		 */
+		u64 hostpid = (u64)READ_ONCE(vc->last_child_hostpid);
+
+		ret = copy_to_user(arg, &hostpid, sizeof(hostpid)) ? -EFAULT : 0;
+		break;
+	}
+	case VMCTX_CTL_GET_CLEAR_TID: {
+		/*
+		 * The clear_child_tid the real clone recorded. Handed to the
+		 * monitor so it can clear that word coherently at thread exit --
+		 * take the page, write zero, wake a joiner -- instead of do_exit
+		 * writing it into a page the machine running the guest may hold,
+		 * which the guest never sees and pthread_join then spins on.
+		 */
+		u64 word = (u64)(unsigned long)target->clear_child_tid;
+
+		ret = copy_to_user(arg, &word, sizeof(word)) ? -EFAULT : 0;
+		break;
+	}
+	case VMCTX_CTL_TRYFAULT: {
+		struct vmctx_mem m;
+		struct mm_struct *mm;
+
+		if (copy_from_user(&m, arg, sizeof(m))) {
+			ret = -EFAULT;
+			break;
+		}
+		mm = vmctx_control_mm(target, fenced_mm);
+		if (!mm) {
+			ret = -ESRCH;
+			break;
+		}
+		ret = vmctx_access_check(mm, (unsigned long)m.addr, m.len);
+		mmput(mm);
+		break;
+	}
+	case VMCTX_CTL_MMLOG: {
+		/*
+		 * Drain the target's address-space change log: the ranges the
+		 * mm-mutation hook saw vacated since the last drain, whatever
+		 * vacated them. The monitor calls this after every forwarded
+		 * syscall and ships the ranges to the machine running the
+		 * program, so its copies die with the mapping. dropped is
+		 * reported and reset -- a non-zero dropped means the ring
+		 * overflowed between drains and a range was LOST, which the
+		 * far side treats as the defect it is.
+		 */
+		struct vmctx_mmlog ml;
+		struct mm_struct *mm;
+		unsigned long flags;
+		u32 n = 0;
+		int i;
+
+		if (copy_from_user(&ml, arg, sizeof(ml))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (ml.max > VMCTX_MMLOG_MAX)
+			ml.max = VMCTX_MMLOG_MAX;
+		mm = vmctx_control_mm(target, fenced_mm);
+		if (!mm) {
+			ret = -ESRCH;
+			break;
+		}
+		ml.dropped = 0;
+		ml.cur = 0;
+		spin_lock_irqsave(&vmctx_mm_lock, flags);
+		for (i = 0; i < VMCTX_MM_SLOTS; i++) {
+			struct vmctx_mm_slot *s = &vmctx_mms[i];
+
+			if (s->mm != mm)
+				continue;
+			while (s->vac_tail != s->vac_head && n < ml.max) {
+				unsigned int tl = s->vac_tail %
+						  VMCTX_MM_VACLOG;
+
+				ml.ent[n].start = s->vac[tl].start;
+				ml.ent[n].end   = s->vac[tl].end;
+				ml.ent[n].seq   = s->vac[tl].seq;
+				n++;
+				s->vac_tail++;
+			}
+			ml.dropped = s->vac_dropped;
+			s->vac_dropped = 0;
+			/*
+			 * The counter at this drain, read under the same lock
+			 * that stamps the events: the caller's reply carries
+			 * it as the stamp of whatever the call CONSTRUCTED,
+			 * and every event logged before this instant has a
+			 * smaller seq. See the field's comment on
+			 * vmctx_mm_slot.
+			 */
+			ml.cur = s->vac_seq_ctr;
+			break;
+		}
+		spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+		mmput(mm);
+		ml.n = n;
+		ret = copy_to_user(arg, &ml, sizeof(ml)) ? -EFAULT : 0;
+		break;
+	}
+	default:
+		ret = -EINVAL;
+	}
+
+out_vc:
+	vmctx_memory_put(fenced_mm);
+	if (object_read) up_read(&vc->object_sem);
+	if (object_write) up_write(&vc->object_sem);
+	if (cpu_locked)
+		mutex_unlock(&vc->cpu_ctl_lock);
+	kref_put(&vc->kref, vmctx_task_free);
+out_put:
+	put_task_struct(target);
+	return ret;
+}
+
+SYSCALL_DEFINE3(vmctx_ctl, pid_t, pid, unsigned int, cmd, void __user *, arg)
+{
+	return vmctx_ctl_impl(pid, cmd, arg);
+}
+
+SYSCALL_DEFINE1(vmctx_run, struct vmctx_run_config __user *, ucfg)
+{
+	return vmctx_run_current(ucfg);
+}
