+/*
+ * Spin before sleeping, where the other side usually answers in microseconds.
+ *
+ * A forwarded syscall on loopback is a ring of four tasks handing one message
+ * round: the guest context (asleep in vmctx_report for its reply), the
+ * monitor's service thread (asleep in VMCTX_CTL_WAIT for the event), the
+ * owner's connection thread (asleep in VMCTX_CTL_SYSCALL for the answer) and
+ * the service context (parked in vmctx_guest_step for the request). Every
+ * hand-over was a sleep and a wake -- an IPI, a schedule, and often an idle
+ * exit -- and `perf sched timehist` on a getppid storm measured 3-10 us of
+ * wake-to-run per hop, six hops per call, on a 35-60 us call. The sleeping
+ * also let the frequency governor read the CPUs as idle and clock them down:
+ * the same call measured 35-40 us under the performance governor and 42-114 us
+ * under schedutil, on one boot.
+ *
+ * So each site spins first, for at most vmctx_spin_us, checking its own
+ * condition, and sleeps only when the answer has not come by then. Adaptive
+ * per site and per context: a wait that ends within the budget arms the next
+ * spin, a wait that outlives it disarms it -- so a service context whose
+ * program is computing for seconds, or a guest across a LAN whose reply takes
+ * 250 us, measures one long wait and sleeps from then on until a short one
+ * arms it again. need_resched() ends a spin at once, so a runnable task never
+ * waits behind one. 0 disables it (the old behaviour, the control arm).
+ */
+static unsigned int vmctx_spin_us = 100;
+static long vmctx_spin_hits;		/* spins the answer arrived inside     */
+static long vmctx_spin_misses;		/* spins that ran out and slept after  */
+core_param(vmctx_spin_us, vmctx_spin_us, uint, 0644);
+core_param(vmctx_spin_hits, vmctx_spin_hits, long, 0644);
+core_param(vmctx_spin_misses, vmctx_spin_misses, long, 0644);
