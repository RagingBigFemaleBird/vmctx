+struct vmctx_spin {
+	u64 t0;
+	int slot;
+};
+
+static inline void vmctx_spin_begin(struct vmctx_spin *s, int slot)
+{
+	s->t0 = ktime_get_ns();
+	s->slot = slot;
+}
+
+/* After the whole wait (spin and sleep): arm or disarm the next spin. */
+static inline void vmctx_spin_end(struct vmctx_task *vc, struct vmctx_spin *s)
+{
+	u64 cap = (u64)READ_ONCE(vmctx_spin_us) * NSEC_PER_USEC;
+
+	WRITE_ONCE(vc->spin_ok[s->slot], ktime_get_ns() - s->t0 <= cap);
+}
