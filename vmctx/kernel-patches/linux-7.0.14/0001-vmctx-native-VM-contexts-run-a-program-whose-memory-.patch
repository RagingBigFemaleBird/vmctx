+/*
+ * Spin until @cond holds, the budget runs out, or someone wants this CPU.
+ * @cond must read its flags with smp_load_acquire/READ_ONCE; the writers pair
+ * with smp_store_release. True if @cond came true while spinning.
+ */
+#define vmctx_spin_wait(vc, slot, cond) ({					\
+	struct vmctx_task *__vc = (vc);						\
+	unsigned int __us = READ_ONCE(vmctx_spin_us);				\
+	bool __hit = false;							\
+										\
+	if (__us && READ_ONCE(__vc->spin_ok[slot]) && !(cond)) {		\
+		u64 __t0 = ktime_get_ns();					\
+		u64 __cap = (u64)__us * NSEC_PER_USEC;				\
+										\
+		for (;;) {							\
+			cpu_relax();						\
+			if (cond) {						\
+				__hit = true;					\
+				break;						\
+			}							\
+			if (need_resched() || ktime_get_ns() - __t0 > __cap)	\
+				break;						\
+		}								\
+		if (__hit)							\
+			vmctx_spin_hits++;					\
+		else								\
+			vmctx_spin_misses++;					\
+	}									\
+	__hit;									\
+})
