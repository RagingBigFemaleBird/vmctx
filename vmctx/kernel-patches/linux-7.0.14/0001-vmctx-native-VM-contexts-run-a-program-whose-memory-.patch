diff --git a/kernel/vmctx-access-core.h b/kernel/vmctx-access-core.h
new file mode 100755
index 000000000..e37e01f83
--- /dev/null
+++ b/kernel/vmctx-access-core.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by kernel/vmctx.c. A single monitor owns each MM journal. It may
+ * read a batch repeatedly and ACK only an offered prefix of that lifetime. */
+static long vmctx_ctl_access(struct task_struct *task, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_access_log out;
+	u32 op;
+	u64 mm_id, cursor;
+	struct vmctx_access_node *node, *next;
+	struct mm_struct *mm;
+	struct vmctx_mm_slot *s;
+	unsigned long flags;
+	long ret = 0;
+
+	if (copy_from_user(&out, arg, sizeof(out)))
+		return -EFAULT;
+	if (out.version != VMCTX_ACCESS_ABI || out.size != sizeof(out) ||
+	    out.op > VMCTX_ACCESS_ACK || out.reserved || out.n)
+		return -EINVAL;
+	/* Retain only request fields; reuse the full-size copy buffer for the
+	 * answer without shortening input validation or allocating under load. */
+	op = out.op; mm_id = out.mm_id; cursor = out.cursor;
+	memset(&out, 0, sizeof(out));
+	out.version = VMCTX_ACCESS_ABI;
+	out.size = sizeof(out);
+	out.op = op;
+	if (!task) {
+		if (op != VMCTX_ACCESS_INFO || mm_id || cursor)
+			return -EINVAL;
+		return copy_to_user(arg, &out, sizeof(out)) ? -EFAULT : 0;
+	}
+	mm = vmctx_control_mm(task, borrowed);
+	if (!mm) {
+		ret = -ESRCH;
+		return ret;
+	}
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_pgrec_slot(mm);
+	if (!s) { ret = -ESRCH; goto unlock; }
+	if (s->mon_tgid != task_tgid_nr(current)) { ret = -EPERM; goto unlock; }
+	if ((mm_id && mm_id != s->trace_id) ||
+	    (op == VMCTX_ACCESS_ACK && !mm_id)) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	if (s->access_error) { ret = -(long)s->access_error; goto unlock; }
+	out.mm_id = s->trace_id;
+	out.head = s->vac_seq_ctr;
+	out.acked = s->access_acked;
+	node = NULL;
+	{
+		void *v = xa_load(&s->constructions, task_pid_nr(task));
+		out.construction = v ? xa_to_value(v) : 0;
+	}
+	if (op == VMCTX_ACCESS_ACK) {
+		if (cursor < s->access_acked || cursor > s->access_offered) {
+			ret = -ERANGE;
+			goto unlock;
+		}
+		list_for_each_entry_safe(node, next, &s->access_log, link) {
+			if (node->event.seq > cursor)
+				break;
+			list_del(&node->link);
+			kfree(node);
+			s->access_count--;
+		}
+		s->access_acked = cursor;
+		out.acked = cursor;
+	} else if (op == VMCTX_ACCESS_READ) {
+		if (cursor != s->access_acked) { ret = -ESTALE; goto unlock; }
+		list_for_each_entry(node, &s->access_log, link) {
+			out.event[out.n++] = node->event;
+			if (out.n == VMCTX_ACCESS_MAX)
+				break;
+		}
+	}
+	out.cursor = out.n ? out.event[out.n - 1].seq : out.acked;
+unlock:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (!ret && copy_to_user(arg, &out, sizeof(out)))
+		ret = -EFAULT;
+	/* Publishing the offered prefix after the copy makes a bad user pointer
+	 * wholly non-consuming. The MM reference and identity prevent slot ABA. */
+	if (!ret && op == VMCTX_ACCESS_READ) {
+		spin_lock_irqsave(&vmctx_mm_lock, flags);
+		s = vmctx_pgrec_slot(mm);
+		if (!s || s->trace_id != out.mm_id)
+			ret = -ESTALE;
+		else
+			s->access_offered = max(s->access_offered, out.cursor);
+		spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	}
+	mmput(mm);
+	return ret;
+}
diff --git a/kernel/vmctx-context-core.h b/kernel/vmctx-context-core.h
new file mode 100755
index 000000000..d6a602250
--- /dev/null
+++ b/kernel/vmctx-context-core.h
@@ -0,0 +1,261 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/file.h>
+/* Descriptor ownership is independent of vc->monitor, which teardown
+ * drops. A retained struct pid prevents monitor TGID reuse from granting access. */
+struct vmctx_context_handle {
+	struct task_struct *task;
+	struct vmctx_task *vc;
+	struct pid *owner;
+};
+static DEFINE_SPINLOCK(vmctx_context_id_lock);
+static u64 vmctx_context_next;
+static atomic_long_t vmctx_context_handles = ATOMIC_LONG_INIT(0);
+static int vmctx_context_count_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%ld\n", atomic_long_read(kp->arg));
+}
+static const struct kernel_param_ops vmctx_context_count_ops = {
+	.get = vmctx_context_count_get,
+};
+__core_param_cb(vmctx_context_handles, &vmctx_context_count_ops,
+	       &vmctx_context_handles, 0444);
+
+static u64 vmctx_context_identity(struct vmctx_task *vc, struct task_struct *task)
+{
+	unsigned long flags;
+	u64 id;
+	spin_lock_irqsave(&vmctx_context_id_lock, flags);
+	if (!vc->context_native_pid) vc->context_native_pid = task_pid_nr(task);
+	if (!vc->context_identity && vmctx_context_next != U64_MAX)
+		vc->context_identity = ++vmctx_context_next;
+	id = vc->context_identity;
+	spin_unlock_irqrestore(&vmctx_context_id_lock, flags);
+	return id;
+}
+
+/* The caller retains mm, or is its native task before exit_mm releases it. */
+static u64 vmctx_context_mm_identity(struct mm_struct *mm)
+{
+	unsigned long flags;
+	u64 id = 0;
+	if (!mm) return 0;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	for (int i = 0; i < VMCTX_MM_SLOTS; i++) {
+		if (vmctx_mms[i].mm == mm) { id = vmctx_mms[i].trace_id; break; }
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return id;
+}
+
+static void vmctx_context_names(struct task_struct *task,
+		struct vmctx_task *vc, struct vmctx_context *rq)
+{
+	if (rq->version == 1) {
+		rq->native_pid = vc->context_native_pid;
+		return;
+	}
+	/* These names aid later validated lookups only. Identity is provided by
+	 * the retained task/vc, including when exec changes the native name. */
+	rcu_read_lock();
+	rq->native_pid = task_pid_vnr(task);
+	rq->native_tgid = task_tgid_vnr(task);
+	rcu_read_unlock();
+}
+
+static long vmctx_context_global(void __user *arg)
+{
+	struct vmctx_context rq;
+	unsigned long flags;
+	long ret = 0;
+	if (copy_from_user(&rq, arg, sizeof(rq))) return -EFAULT;
+	if (rq.version == VMCTX_CONTEXT_ABI && rq.size == sizeof(rq) &&
+	    rq.op == VMCTX_CONTEXT_CAPS) {
+		if (rq.flags || rq.ticket || rq.identity || rq.mm_identity ||
+		    rq.fd || rq.native_pid || rq.exit_status || rq.reserved)
+			return -EINVAL;
+		rq.flags = VMCTX_CONTEXT_CAP_REFERENCE | VMCTX_CONTEXT_CAP_SIGNAL |
+			VMCTX_CONTEXT_CAP_EXECUTOR;
+		if (READ_ONCE(vmctx_mm_refcount)) rq.flags |= VMCTX_CONTEXT_CAP_MMINFO;
+#ifdef VMCTX_CTL_SYSCALL_GATE
+		rq.flags |= VMCTX_CONTEXT_CAP_SOURCE;
+#endif
+		return copy_to_user(arg, &rq, sizeof(rq)) ? -EFAULT : 0;
+	}
+	if (rq.version != VMCTX_CONTEXT_ABI || rq.size != sizeof(rq) ||
+	    rq.op != VMCTX_CONTEXT_MMINFO || rq.flags || rq.ticket ||
+	    rq.identity || !rq.mm_identity || rq.fd || rq.native_pid ||
+	    rq.exit_status || rq.reserved) return -EINVAL;
+	if (!capable(CAP_SYS_PTRACE)) return -EPERM;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (!vmctx_mm_refcount) { ret = -EOPNOTSUPP; goto out; }
+	if (rq.mm_identity > vmctx_mm_trace_next) { ret = -ENOENT; goto out; }
+	rq.flags = VMCTX_CONTEXT_MM_ENDED;
+	for (int i = 0; i < VMCTX_MM_SLOTS; i++) {
+		if (vmctx_mms[i].mm && vmctx_mms[i].trace_id == rq.mm_identity) {
+			rq.flags = VMCTX_CONTEXT_MM_LIVE;
+			break;
+		}
+	}
+out:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (ret) return ret;
+	return copy_to_user(arg, &rq, sizeof(rq)) ? -EFAULT : 0;
+}
+
+static int vmctx_context_release(struct inode *inode, struct file *file)
+{
+	struct vmctx_context_handle *h = file->private_data;
+	put_pid(h->owner);
+	put_task_struct(h->task);
+	kref_put(&h->vc->kref, vmctx_task_free);
+	kfree(h);
+	atomic_long_dec(&vmctx_context_handles);
+	return 0;
+}
+static const struct file_operations vmctx_context_fops = {
+	.release = vmctx_context_release,
+};
+
+static long vmctx_context_export(struct task_struct *task, struct vmctx_task *vc,
+				struct vmctx_context *rq, void __user *arg)
+{
+	struct vmctx_context_handle *h;
+	struct file *file;
+	int fd;
+	u64 id = vmctx_context_identity(vc, task);
+	if (!id) return -EOVERFLOW;
+	h = kzalloc(sizeof(*h), GFP_KERNEL);
+	if (!h) return -ENOMEM;
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) { kfree(h); return fd; }
+	h->task = task;
+	h->vc = vc;
+	h->owner = get_task_pid(current, PIDTYPE_TGID);
+	get_task_struct(task);
+	kref_get(&vc->kref);
+	file = anon_inode_getfile("vmctx-context", &vmctx_context_fops, h, O_RDONLY);
+	if (IS_ERR(file)) {
+		put_pid(h->owner);
+		put_task_struct(task);
+		kref_put(&vc->kref, vmctx_task_free);
+		kfree(h);
+		put_unused_fd(fd);
+		return PTR_ERR(file);
+	}
+	atomic_long_inc(&vmctx_context_handles);
+	rq->fd = fd;
+	rq->identity = id;
+	vmctx_context_names(task, vc, rq);
+	if (copy_to_user(arg, rq, sizeof(*rq))) {
+		put_unused_fd(fd);
+		fput(file);
+		return -EFAULT;
+	}
+	fd_install(fd, file);
+	return 0;
+}
+
+/* Return private task/context references; the descriptor may close immediately
+ * afterward without changing which lifetime this operation addresses. */
+static int vmctx_context_resolve(pid_t selector, struct task_struct **task,
+				 struct vmctx_task **vc)
+{
+	struct fd f = fdget((unsigned int)(-(s64)selector - 1));
+	struct vmctx_context_handle *h;
+	int ret = 0;
+	if (fd_empty(f)) return -EBADF;
+	if (fd_file(f)->f_op != &vmctx_context_fops) { ret = -EBADF; goto out; }
+	h = fd_file(f)->private_data;
+	if (h->owner != task_tgid(current)) { ret = -EPERM; goto out; }
+	*task = h->task;
+	*vc = h->vc;
+	get_task_struct(*task);
+	kref_get(&(*vc)->kref);
+out:
+	fdput(f);
+	return ret;
+}
+
+/* Only CHILD needs the CPU lock: ticket retirement can release its references.
+ * INFO and OPEN must remain available to a fault service while an assisted
+ * syscall holds that lock and waits for the fault service to supply memory. */
+static long vmctx_context_child(struct vmctx_task *vc,
+			       struct vmctx_context *rq, void __user *arg)
+{
+#ifdef VMCTX_CTL_SYSCALL_GATE
+	long ret;
+	if (!(vc->flags & VMCTX_FLAG_SERVICE)) return -EOPNOTSUPP;
+	if (!mutex_trylock(&vc->cpu_ctl_lock)) return -EBUSY;
+	if (!vmctx_monitor_authorized(vc, true))
+		ret = -EPERM;
+	else if (!rq->ticket || rq->ticket != vc->syscall_gate.ticket)
+		ret = -ESTALE;
+	else if (!smp_load_acquire(&vc->syscall_gate.child_host_pid))
+		ret = -EAGAIN;
+	else if (!vc->gate_child_task || !vc->gate_child_vc)
+		ret = -EPROTO;
+	else
+		ret = vmctx_context_export(vc->gate_child_task, vc->gate_child_vc, rq, arg);
+	mutex_unlock(&vc->cpu_ctl_lock);
+	return ret;
+#else
+	(void)vc; (void)rq; (void)arg;
+	return -EOPNOTSUPP;
+#endif
+}
+
+static long vmctx_ctl_context(struct task_struct *task, struct vmctx_task *vc,
+			      bool from_handle, void __user *arg)
+{
+	struct vmctx_context rq;
+	struct mm_struct *mm;
+	bool dead;
+#ifndef VMCTX_CTL_SYSCALL_GATE
+	/* This adapter does not implement retained source admission records. */
+	if (vc->flags & VMCTX_FLAG_SERVICE) return -EOPNOTSUPP;
+#endif
+	if (copy_from_user(&rq, arg, sizeof(rq))) return -EFAULT;
+	if ((rq.version != 1 && rq.version != VMCTX_CONTEXT_ABI) ||
+	    rq.size != sizeof(rq) || rq.flags ||
+	    rq.identity || rq.mm_identity || rq.fd || rq.native_pid ||
+	    (rq.exit_status && rq.op != VMCTX_CONTEXT_SIGNAL) || rq.reserved ||
+	    rq.op < VMCTX_CONTEXT_OPEN || rq.op > VMCTX_CONTEXT_SIGNAL ||
+	    rq.op == VMCTX_CONTEXT_MMINFO ||
+	    (rq.version == 1 && rq.op > VMCTX_CONTEXT_CHILD) ||
+	    (rq.op != VMCTX_CONTEXT_CHILD && rq.ticket)) return -EINVAL;
+	dead = smp_load_acquire(&vc->dead);
+	if (rq.op == VMCTX_CONTEXT_SIGNAL) {
+		if (!from_handle) return -EINVAL;
+		if (dead) return -ESRCH;
+		if (!valid_signal(rq.exit_status)) return -EINVAL;
+		return rq.exit_status ? send_sig(rq.exit_status, task, 0) : 0;
+	}
+	if (rq.op == VMCTX_CONTEXT_OPEN) {
+		if (from_handle) return -EINVAL;
+		if (dead || !smp_load_acquire(&vc->active)) return -ESRCH;
+		return vmctx_context_export(task, vc, &rq, arg);
+	}
+	if (rq.op == VMCTX_CONTEXT_CHILD)
+		return vmctx_context_child(vc, &rq, arg);
+	rq.identity = vmctx_context_identity(vc, task);
+	if (!rq.identity) return -EOVERFLOW;
+	vmctx_context_names(task, vc, &rq);
+	mm = get_task_mm(task);
+	rq.mm_identity = vmctx_context_mm_identity(mm);
+	if (mm) mmput(mm);
+	/* Death publishes the terminal record after retiring the mm slot. A
+	 * query may overlap that retirement; use the published record or retry
+	 * instead of returning an apparently live context with no MM identity. */
+	if (smp_load_acquire(&vc->dead)) {
+		rq.flags = VMCTX_CONTEXT_ENDED;
+		rq.exit_status = (vc->flags & VMCTX_FLAG_SERVICE) ? vc->terminal_status : 0;
+		rq.mm_identity = vc->terminal_mm_identity;
+	} else {
+		if (!rq.mm_identity) return -EAGAIN;
+#ifdef VMCTX_CTL_SYSCALL_GATE
+		if ((vc->flags & VMCTX_FLAG_SERVICE) && smp_load_acquire(&vc->service_ready))
+			rq.flags = VMCTX_CONTEXT_READY;
+#endif
+	}
+	return copy_to_user(arg, &rq, sizeof(rq)) ? -EFAULT : 0;
+}
diff --git a/kernel/vmctx-cpu-model-core.h b/kernel/vmctx-cpu-model-core.h
new file mode 100644
index 000000000..4d6a4a5f4
--- /dev/null
+++ b/kernel/vmctx-cpu-model-core.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by the source and execution Linux adapters' kernel/vmctx.c. */
+#include <linux/cpu.h>
+#include <asm/fpu/xcr.h>
+
+/* Caller is pinned to one CPU. Never use another kernel's XSAVE offsets. */
+void vmctx_cpu_caps_current(struct vmctx_cpu_model *m)
+{
+	u32 a, b, c, d, max;
+	memset(m, 0, sizeof(*m));
+	cpuid(0, &max, &b, &c, &d);
+	cpuid(1, &a, &b, &m->leaf1_ecx, &m->leaf1_edx);
+	if (max >= 7)
+		cpuid_count(7, 0, &a, &m->leaf7_ebx, &c, &d);
+	cpuid(0x80000000, &a, &b, &c, &d);
+	if (a >= 0x80000001)
+		cpuid(0x80000001, &a, &b, &m->ext1_ecx, &m->ext1_edx);
+	if (cpu_feature_enabled(X86_FEATURE_XSAVE)) {
+		m->xcr0 = xgetbv(0) & fpu_user_cfg.max_features;
+		if (m->xcr0 & 4) {
+			cpuid_count(0xd, 2, &a, &b, &c, &d);
+			if (a != 256 || b != 576 || c || d)
+				m->xcr0 &= ~4ULL;
+		}
+	}
+	vmctx_cpu_model_trim(m);
+}
+EXPORT_SYMBOL_GPL(vmctx_cpu_caps_current);
+
+static void vmctx_cpu_caps_ipi(void *arg)
+{
+	vmctx_cpu_caps_current(arg);
+}
+
+static long vmctx_cpu_caps_all(struct vmctx_cpu_model *caps)
+{
+	struct vmctx_cpu_model one;
+	int cpu, ret = 0;
+	bool first = true;
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		ret = smp_call_function_single(cpu, vmctx_cpu_caps_ipi, &one, true);
+		if (ret) break;
+		if (first) *caps = one;
+		else vmctx_cpu_model_intersect(caps, caps, &one);
+		first = false;
+	}
+	cpus_read_unlock();
+	return ret ? ret : first || !vmctx_cpu_model_valid(caps) ? -EOPNOTSUPP : 0;
+}
+
+struct vmctx_cpu_model_copy {
+	struct vmctx_task *vc;
+	struct vmctx_cpu_model model;
+};
+
+static int vmctx_cpu_model_stopped(struct task_struct *t, void *arg)
+{
+	struct vmctx_cpu_model_copy *copy = arg;
+	struct vmctx_task *vc = copy->vc;
+	if (READ_ONCE(t->vmctx) != vc || vc->dead || (t->flags & PF_EXITING))
+		return -ESRCH;
+	if (vc->cpu_model_ready)
+		return memcmp(&vc->cpu_model, &copy->model, sizeof(copy->model)) ? -EPERM : 0;
+	if (vc->enters || vc->sys_pending ||
+	    (!(vc->flags & VMCTX_FLAG_SERVICE) && vc->released))
+		return -EBUSY;
+	if (task_curr(t) || task_is_running(t)) return -EAGAIN;
+#ifdef CONFIG_SMP
+	if (smp_load_acquire(&t->on_cpu)) return -EAGAIN;
+#endif
+	vc->cpu_model = copy->model;
+	smp_store_release(&vc->cpu_model_ready, true);
+	return 0;
+}
+
+static long vmctx_ctl_cpu_model(struct task_struct *t, struct vmctx_task *vc,
+	void __user *arg)
+{
+	struct vmctx_cpu_model_copy copy = { .vc = vc };
+	struct vmctx_cpu_model caps;
+	long ret;
+	if (copy_from_user(&copy.model, arg, sizeof(copy.model))) return -EFAULT;
+	if (!vmctx_cpu_model_valid(&copy.model)) return -EINVAL;
+	ret = vmctx_cpu_caps_all(&caps);
+	if (ret) return ret;
+	if (!vmctx_cpu_model_subset(&copy.model, &caps)) return -EOPNOTSUPP;
+	return task_call_func(t, vmctx_cpu_model_stopped, &copy);
+}
diff --git a/kernel/vmctx-mapping-core.h b/kernel/vmctx-mapping-core.h
new file mode 100755
index 000000000..999e7fc30
--- /dev/null
+++ b/kernel/vmctx-mapping-core.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Source-local mapping inspection. The monitor gate precedes this call. */
+static long vmctx_ctl_mapping(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_mapping q;
+	struct mm_struct *mm;
+	struct vm_area_struct *vma;
+	struct file *file = NULL;
+	long ret;
+	int fd = -1;
+
+	if (copy_from_user(&q, arg, sizeof(q))) return -EFAULT;
+	if (q.reserved) return -EINVAL;
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm) return -ESRCH;
+	ret = mmap_read_lock_killable(mm);
+	if (ret) goto out_mm;
+	vma = vma_lookup(mm, q.addr);
+	if (!vma) { ret = -ENOENT; goto out_unlock; }
+	q.start = vma->vm_start;
+	q.len = vma->vm_end - vma->vm_start;
+	q.offset = (u64)vma->vm_pgoff << PAGE_SHIFT;
+	q.prot = ((vma->vm_flags & VM_READ) ? PROT_READ : 0) |
+		 ((vma->vm_flags & VM_WRITE) ? PROT_WRITE : 0) |
+		 ((vma->vm_flags & VM_EXEC) ? PROT_EXEC : 0);
+	/* Linux clears VM_SHARED for a MAP_SHARED file opened read-only.
+	 * VM_MAYSHARE retains the mapping's shared identity in that case. */
+	q.flags = (vma->vm_flags & VM_MAYSHARE) ? VMCTX_MAPPING_SHARED : 0;
+	if (vma->vm_file) file = get_file(vma->vm_file);
+out_unlock:
+	mmap_read_unlock(mm);
+out_mm:
+	mmput(mm);
+	if (ret) return ret;
+	if (file) {
+		fd = get_unused_fd_flags(O_CLOEXEC);
+		if (fd < 0) { fput(file); return fd; }
+	}
+	q.fd = fd;
+	/* Publish only after the result copy succeeds: no inaccessible file
+	 * reference is installed on a bad output pointer. The VMA lock is no
+	 * longer held during monitor faults or file-table allocation. */
+	if (copy_to_user(arg, &q, sizeof(q))) {
+		if (fd >= 0) put_unused_fd(fd);
+		if (file) fput(file);
+		return -EFAULT;
+	}
+	if (file) fd_install(fd, file);
+	return 0;
+}
diff --git a/kernel/vmctx-memory-core.h b/kernel/vmctx-memory-core.h
new file mode 100755
index 000000000..9bdea973f
--- /dev/null
+++ b/kernel/vmctx-memory-core.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Explicit borrowed MM parameter, never a per-task override or exec lock.
+ * Source exec itself can fault and need monitor memory service, so holding
+ * exec_update_lock while servicing such a callback would deadlock. */
+static struct mm_struct *vmctx_control_mm(struct task_struct *target,
+		struct mm_struct *borrowed)
+{
+	if (borrowed) { mmget(borrowed); return borrowed; }
+	return get_task_mm(target);
+}
+
+static bool vmctx_memory_command(unsigned command)
+{
+	switch (command) {
+	case VMCTX_CTL_PEEK: case VMCTX_CTL_POKE: case VMCTX_CTL_TAKE:
+	case VMCTX_CTL_SERVE: case VMCTX_CTL_PGSTATE: case VMCTX_CTL_LAND:
+	case VMCTX_CTL_PGACK: case VMCTX_CTL_PGSCAN: case VMCTX_CTL_PGSET:
+	case VMCTX_CTL_PROTECT: case VMCTX_CTL_TAKEOBJ: case VMCTX_CTL_RECALL:
+	case VMCTX_CTL_MAPPING: case VMCTX_CTL_ACCESS_LOG: case VMCTX_CTL_MMLOG:
+	case VMCTX_CTL_TRANSFER:
+	case VMCTX_CTL_TRYFAULT: case VMCTX_CTL_FUTEXWAKE: case VMCTX_CTL_BREAKCOW:
+		return true;
+	default: return false;
+	}
+}
+
+static long vmctx_memory_caps(void __user *arg)
+{
+	struct vmctx_memory q;
+	if (copy_from_user(&q,arg,sizeof(q))) return -EFAULT;
+	if (q.version!=VMCTX_MEMORY_ABI || q.size!=sizeof(q) ||
+	    q.op!=VMCTX_MEMORY_CAPS || q.command || q.mm_identity ||
+	    q.argument || q.features || q.reserved) return -EINVAL;
+	if (!READ_ONCE(vmctx_mm_refcount)) return -EOPNOTSUPP;
+	q.features=VMCTX_MEMORY_EXPECTED_MM|VMCTX_MEMORY_RETAINED_METADATA;
+	return copy_to_user(arg,&q,sizeof(q)) ? -EFAULT : 0;
+}
+
+static struct mm_struct *vmctx_memory_hold(struct task_struct *target,u64 identity)
+{
+	struct mm_struct *mm=get_task_mm(target);
+	struct vmctx_mm_slot *slot;
+	unsigned long flags;
+	int error=0;
+	if (!mm) return ERR_PTR(-ESRCH);
+	spin_lock_irqsave(&vmctx_mm_lock,flags);
+	slot=vmctx_pgrec_slot(mm);
+	if (!vmctx_mm_refcount) error=-EOPNOTSUPP;
+	else if (!slot || slot->trace_id!=identity) error=-ESTALE;
+	else if (slot->mon_tgid!=task_tgid_nr(current)) error=-EPERM;
+	else if (slot->n==INT_MAX) error=-EOVERFLOW;
+	else slot->n++;
+	spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+	if (error) { mmput(mm); return ERR_PTR(error); }
+	return mm;
+}
+
+static void vmctx_memory_put(struct mm_struct *mm)
+{
+	if (!mm) return;
+	vmctx_mm_forget(mm);
+	mmput(mm);
+}
diff --git a/kernel/vmctx-monitor-core.h b/kernel/vmctx-monitor-core.h
new file mode 100644
index 000000000..649730a25
--- /dev/null
+++ b/kernel/vmctx-monitor-core.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included by kernel/vmctx.c after struct vmctx_task is available.
+ * ev_lock protects the attached task reference. A borrowed pointer may only
+ * be compared with NULL; dereferencing requires this lock or a private ref. */
+static struct task_struct *vmctx_monitor_get(struct vmctx_task *vc)
+{
+	struct task_struct *mon;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vc->ev_lock, flags);
+	mon = vc->monitor;
+	if (mon)
+		get_task_struct(mon);
+	spin_unlock_irqrestore(&vc->ev_lock, flags);
+	return mon;
+}
+
+static bool vmctx_monitor_task_alive(struct task_struct *mon)
+{
+	return mon && !(READ_ONCE(mon->flags) & PF_EXITING) && pid_alive(mon);
+}
+
+static bool vmctx_monitor_alive(struct vmctx_task *vc)
+{
+	struct task_struct *mon = vmctx_monitor_get(vc);
+	bool alive = vmctx_monitor_task_alive(mon);
+
+	if (mon)
+		put_task_struct(mon);
+	return alive;
+}
+
+static inline bool vmctx_monitor_owned(struct vmctx_task *vc)
+{
+	struct task_struct *mon = vmctx_monitor_get(vc);
+	bool owned = mon && same_thread_group(mon, current);
+
+	if (mon)
+		put_task_struct(mon);
+	return owned;
+}
+
+/* Retained descriptor readers remain authorized after terminal publication.
+ * Observe death and attachment in one ev_lock critical section: reading live
+ * first and then a detached monitor can otherwise reject the owner's QUERY
+ * during exit. The descriptor resolver separately proves terminal ownership. */
+static bool vmctx_monitor_authorized(struct vmctx_task *vc, bool terminal)
+{
+	unsigned long flags;
+	bool allowed;
+
+	spin_lock_irqsave(&vc->ev_lock, flags);
+	allowed = smp_load_acquire(&vc->dead) ? terminal :
+		vc->monitor && same_thread_group(vc->monitor, current);
+	spin_unlock_irqrestore(&vc->ev_lock, flags);
+	return allowed;
+}
+
+static inline pid_t vmctx_monitor_tgid(struct vmctx_task *vc)
+{
+	struct task_struct *mon = vmctx_monitor_get(vc);
+	pid_t pid = mon ? task_tgid_nr(mon) : 0;
+
+	if (mon)
+		put_task_struct(mon);
+	return pid;
+}
+
+/* Clear only a dead owner when requested. A concurrent replacement's task
+ * reference must never be dropped by an observation of the previous owner. */
+static bool vmctx_monitor_drop(struct vmctx_task *vc, bool dead_only)
+{
+	struct task_struct *mon;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vc->ev_lock, flags);
+	mon = vc->monitor;
+	if (mon && (!dead_only || !vmctx_monitor_task_alive(mon))) {
+		WRITE_ONCE(vc->monitor, NULL);
+		/* An unreleased restore cannot transfer to a successor monitor:
+		 * its partially installed frame belongs to the original owner. */
+		if ((vc->flags & VMCTX_FLAG_RESTORE) && !smp_load_acquire(&vc->released))
+			WRITE_ONCE(vc->monitor_lost, 1);
+	} else {
+		mon = NULL;
+	}
+	spin_unlock_irqrestore(&vc->ev_lock, flags);
+	if (mon) {
+		put_task_struct(mon);
+		wake_up(&vc->reply_wq);
+	}
+	return mon != NULL;
+}
+
+static void vmctx_drop_monitor(struct vmctx_task *vc)
+{
+	vmctx_monitor_drop(vc, false);
+}
+
+static int vmctx_attach_monitor(struct vmctx_task *vc)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&vc->ev_lock, flags);
+	if (READ_ONCE(vc->dead))
+		ret = -ESRCH;
+	else if (!smp_load_acquire(&vc->active))
+		ret = -EAGAIN;
+	else if ((vc->flags & VMCTX_FLAG_RESTORE) && READ_ONCE(vc->monitor_lost))
+		ret = -ESHUTDOWN;
+	else if (vc->monitor && vc->monitor != current)
+		ret = -EBUSY;
+	else if (!vc->monitor) {
+		get_task_struct(current);
+		WRITE_ONCE(vc->monitor, current);
+	}
+	spin_unlock_irqrestore(&vc->ev_lock, flags);
+	return ret;
+}
+
+/* The caller already waited a bounded interval for initial attachment. Once
+ * bound, readiness is an owner-lifetime condition, not a wall-clock deadline.
+ * Keep the referenced owner stable across detach, exit and possible PID reuse. */
+static long vmctx_wait_restore(struct vmctx_task *vc, long attached)
+{
+	struct task_struct *mon = vmctx_monitor_get(vc);
+	long ret = attached < 0 ? attached : -ETIMEDOUT;
+
+	if (!mon)
+		return READ_ONCE(vc->monitor_lost) ? -ENOTCONN : ret;
+	for (;;) {
+		if (!vmctx_monitor_task_alive(mon) || READ_ONCE(vc->monitor) != mon ||
+		    READ_ONCE(vc->monitor_lost) || READ_ONCE(vc->dead)) {
+			ret = -ENOTCONN;
+			break;
+		}
+		if (fatal_signal_pending(current)) {
+			ret = -EINTR;
+			break;
+		}
+		if (smp_load_acquire(&vc->released)) {
+			ret = 0;
+			break;
+		}
+		ret = wait_event_killable_timeout(vc->reply_wq,
+			smp_load_acquire(&vc->released) || READ_ONCE(vc->monitor) != mon ||
+			READ_ONCE(vc->monitor_lost) || READ_ONCE(vc->dead), HZ);
+		if (ret < 0)
+			break;
+	}
+	put_task_struct(mon);
+	return ret;
+}
diff --git a/kernel/vmctx-object-core.h b/kernel/vmctx-object-core.h
new file mode 100755
index 000000000..fb54b04d3
--- /dev/null
+++ b/kernel/vmctx-object-core.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Native execution object replacement. cpu_ctl_lock excludes SETCPU/RESUME;
+ * object_sem excludes independent memory controls during replacement, and
+ * object_lock protects file-reference acquisition by the backend.
+ * The old object remains intact for other native MMs that still map it. */
+static int vmctx_object_stopped(struct task_struct *task, void *argument)
+{
+	struct vmctx_task *vc = argument;
+	if (READ_ONCE(task->vmctx) != vc || smp_load_acquire(&vc->dead) ||
+	    (READ_ONCE(task->flags) & PF_EXITING)) return -ESRCH;
+	/* A reported native MM fault may still hold mmap_lock. It is not a
+	 * point at which a monitor can replace the MM's guest mappings. */
+	if (READ_ONCE(vc->in_mm_fault) || READ_ONCE(vc->sys_pending)) return -EBUSY;
+	if (!((!READ_ONCE(vc->released) && (vc->flags & VMCTX_FLAG_WAIT_MONITOR)) ||
+	      (READ_ONCE(vc->ev_pending) && READ_ONCE(vc->ev_taken) &&
+	       !READ_ONCE(vc->reply_pending)))) return -EBUSY;
+	if (task_curr(task) || task_is_running(task)) return -EAGAIN;
+#ifdef CONFIG_SMP
+	if (smp_load_acquire(&task->on_cpu)) return -EAGAIN;
+#endif
+	return 0;
+}
+
+static long vmctx_ctl_object(struct task_struct *target, struct vmctx_task *vc,
+			     void __user *arg)
+{
+	struct vmctx_object q;
+	struct file *next = NULL, *old = NULL, *shared = NULL, *reported;
+	struct mm_struct *mm = NULL;
+	long ret = 0;
+	bool changed = false;
+
+	if (copy_from_user(&q, arg, sizeof(q))) return -EFAULT;
+	if (q.version != VMCTX_OBJECT_ABI || q.size != sizeof(q) ||
+	    q.features || q.reserved || q.device || q.inode) return -EINVAL;
+	if (!target) {
+		if (q.op != VMCTX_OBJECT_CAPS || q.expected_epoch || q.epoch ||
+		    q.backing_fd != -1) return -EINVAL;
+		q.features = VMCTX_OBJECT_RETAINED | VMCTX_OBJECT_REPLACE_MM;
+		return copy_to_user(arg, &q, sizeof(q)) ? -EFAULT : 0;
+	}
+	if (!(vc->flags & VMCTX_FLAG_USERCODE) || (vc->flags & VMCTX_FLAG_SERVICE))
+		return -EOPNOTSUPP;
+	if (q.op == VMCTX_OBJECT_INFO) {
+		if (q.expected_epoch || q.epoch || q.backing_fd != -1) return -EINVAL;
+	} else if (q.op == VMCTX_OBJECT_REPLACE) {
+		if (!q.expected_epoch || q.expected_epoch == U64_MAX ||
+		    q.epoch != q.expected_epoch + 1 || q.backing_fd < 0) return -EINVAL;
+		next = fget(q.backing_fd);
+		if (!next) return -EBADF;
+		if (!shmem_mapping(next->f_mapping) ||
+		    (next->f_mode & (FMODE_READ | FMODE_WRITE)) != (FMODE_READ | FMODE_WRITE)) {
+			ret = -EINVAL; goto out;
+		}
+		/* Native epoch and object identity fence result-copy retries.
+		 * Reopening an FD can make a different struct file for one object. */
+		if (q.epoch == vc->object_epoch) {
+			old = vmctx_object_file(vc, false);
+			ret = old && old->f_mapping == next->f_mapping ? 0 : -ESTALE;
+			if (ret) goto out;
+			goto report;
+		}
+		if (q.expected_epoch != vc->object_epoch) { ret = -ESTALE; goto out; }
+		ret = task_call_func(target, vmctx_object_stopped, vc);
+		if (ret) goto out;
+		old = vmctx_object_file(vc, false);
+		shared = vmctx_object_file(vc, true);
+		if (!old || next->f_mapping == old->f_mapping ||
+		    (shared && next->f_mapping == shared->f_mapping)) {
+			ret = -EINVAL; goto out;
+		}
+		mm = get_task_mm(target);
+		if (!mm) { ret = -ESRCH; goto out; }
+		if (mmap_write_lock_killable(mm)) { ret = -EINTR; goto out; }
+		/* Exactly the stopped target plus our get_task_mm reference.
+		 * In particular, never remove maps shared by another native task.
+		 * A transient extra MM reference is a retryable refusal, not proof
+		 * that it is safe to change the address space underneath its user. */
+		if (atomic_read(&mm->mm_users) != 2) {
+			mmap_write_unlock(mm); ret = -EBUSY; goto out;
+		}
+		for (unsigned long address = 0; ; ) {
+			struct vm_area_struct *vma = find_vma(mm, address);
+			unsigned long start, end;
+			if (!vma) break;
+			start = vma->vm_start; end = vma->vm_end;
+			address = end;
+			if (!vma->vm_file ||
+			    (vma->vm_file->f_mapping != old->f_mapping &&
+			     (!shared || vma->vm_file->f_mapping != shared->f_mapping)))
+				continue;
+			ret = do_munmap(mm, start, end - start, NULL);
+			if (ret) break;
+			changed = true;
+		}
+		mmap_write_unlock(mm);
+		if (ret) {
+			/* No successful reset may be reported after partial removal. */
+			if (changed) send_sig(SIGKILL, target, 0);
+			goto out;
+		}
+		spin_lock(&vc->object_lock);
+		reported = vc->backing_object;
+		vc->backing_object = get_file(next);
+		vc->object_epoch = q.epoch;
+		spin_unlock(&vc->object_lock);
+		if (reported) fput(reported);
+	} else { ret = -EINVAL; goto out; }
+report:
+	q.features = VMCTX_OBJECT_RETAINED | VMCTX_OBJECT_REPLACE_MM;
+	q.expected_epoch = 0; q.epoch = vc->object_epoch; q.backing_fd = -1;
+	reported = vmctx_object_file(vc, false);
+	if (reported) {
+		q.device = new_encode_dev(file_inode(reported)->i_sb->s_dev);
+		q.inode = file_inode(reported)->i_ino;
+		fput(reported);
+	}
+	ret = copy_to_user(arg, &q, sizeof(q)) ? -EFAULT : 0;
+out:
+	if (mm) mmput(mm);
+	if (old) fput(old);
+	if (shared) fput(shared);
+	if (next) fput(next);
+	return ret;
+}
diff --git a/kernel/vmctx-object-files.h b/kernel/vmctx-object-files.h
new file mode 100755
index 000000000..c362ff9b0
--- /dev/null
+++ b/kernel/vmctx-object-files.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Retained native storage, independent of descriptor table reuse. */
+static void vmctx_object_init(struct vmctx_task *vc)
+{
+	spin_lock_init(&vc->object_lock);
+	init_rwsem(&vc->object_sem);
+	vc->object_epoch = 1;
+}
+
+struct file *vmctx_object_file(struct vmctx_task *vc, bool shared)
+{
+	struct file *file;
+	spin_lock(&vc->object_lock);
+	file = shared ? vc->shared_object : vc->backing_object;
+	if (file) get_file(file);
+	spin_unlock(&vc->object_lock);
+	return file;
+}
+EXPORT_SYMBOL_GPL(vmctx_object_file);
+
+static int vmctx_object_bind_initial(struct vmctx_task *vc)
+{
+	/* Preserve the original zero-initialized run-config convention: only
+	 * positive descriptor values select an object at initial creation. */
+	if (vc->backing_fd > 0) {
+		vc->backing_object = fget(vc->backing_fd);
+		if (!vc->backing_object) return -EBADF;
+	}
+	if (vc->shared_fd > 0) {
+		vc->shared_object = fget(vc->shared_fd);
+		if (!vc->shared_object) return -EBADF;
+	}
+	return 0;
+}
+
+static void vmctx_object_copy(struct vmctx_task *dst, struct vmctx_task *src)
+{
+	spin_lock(&src->object_lock);
+	dst->backing_object = src->backing_object;
+	dst->shared_object = src->shared_object;
+	dst->object_epoch = src->object_epoch;
+	if (dst->backing_object) get_file(dst->backing_object);
+	if (dst->shared_object) get_file(dst->shared_object);
+	spin_unlock(&src->object_lock);
+}
+
+static void vmctx_object_drop(struct vmctx_task *vc)
+{
+	/* Called only at final context retirement, after all controls and the
+	 * backend are gone. fput defers final file cleanup from RCU context. */
+	if (vc->backing_object) fput(vc->backing_object);
+	if (vc->shared_object) fput(vc->shared_object);
+}
+
+static bool vmctx_object_memory_control(unsigned int cmd)
+{
+	switch (cmd) {
+	case VMCTX_CTL_PEEK: case VMCTX_CTL_POKE: case VMCTX_CTL_MAPPING:
+	case VMCTX_CTL_TAKE: case VMCTX_CTL_SERVE: case VMCTX_CTL_PGSTATE:
+	case VMCTX_CTL_LAND: case VMCTX_CTL_PGACK: case VMCTX_CTL_PGSCAN:
+	case VMCTX_CTL_PGSET: case VMCTX_CTL_TAKEOBJ: case VMCTX_CTL_PROTECT:
+	case VMCTX_CTL_PROTECT_BACKING: case VMCTX_CTL_PROTECTOBJ:
+	case VMCTX_CTL_MAPOBJ: case VMCTX_CTL_MAPOBJ_READ: case VMCTX_CTL_PROTECT_MM:
+	case VMCTX_CTL_APPLYMAP: case VMCTX_CTL_BREAKCOW:
+		return true;
+	default:
+		return false;
+	}
+}
diff --git a/kernel/vmctx-quiesce-core.h b/kernel/vmctx-quiesce-core.h
new file mode 100644
index 000000000..e3830f2da
--- /dev/null
+++ b/kernel/vmctx-quiesce-core.h
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included after the MM registry helpers. Lock order: native MM/PTE locks
+ * may enter vmctx_mm_lock; this code never acquires them under that lock.
+ * Leases keep the MM slot and mm alive and are cancelled on monitor exit. */
+struct vmctx_quiesce_lease {
+	struct list_head link;
+	struct task_struct *owner;
+	struct mm_struct *mm;
+	struct vmctx_mm_slot *slot;
+	u64 token;
+};
+static LIST_HEAD(vmctx_quiesce_leases);
+static DECLARE_WAIT_QUEUE_HEAD(vmctx_execution_wq);
+static u64 vmctx_quiesce_next;
+static struct vmctx_backend *vmctx_execution_backend;
+
+static struct vmctx_mm_slot *vmctx_execution_slot(struct mm_struct *mm)
+{
+	int i;
+	for (i = 0; i < VMCTX_MM_SLOTS; i++)
+		if (vmctx_mms[i].mm == mm)
+			return &vmctx_mms[i];
+	return NULL;
+}
+
+static bool vmctx_execution_unpaused(struct mm_struct *mm)
+{
+	struct vmctx_mm_slot *s;
+	unsigned long flags;
+	bool ready;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_execution_slot(mm);
+	ready = !s || !s->execution_paused;
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return ready;
+}
+
+/* A repeating interrupt bounds checkpoints even on tickless CPUs. The
+ * execution task owns this timer only between enter/leave, and cancellation
+ * joins a callback before that task or its context can be released. CPU time
+ * still comes from task_sched_runtime, never from the timer's wall interval. */
+static enum hrtimer_restart vmctx_runtime_interrupt(struct hrtimer *timer)
+{
+	struct vmctx_task *vc = container_of(timer, struct vmctx_task, runtime_timer);
+	kick_process(vc->runtime_timer_task);
+	hrtimer_forward_now(timer, ns_to_ktime(vc->runtime_quantum));
+	return HRTIMER_RESTART;
+}
+
+/* Backends call before disabling preemption/interrupts and pair every success
+ * with leave, including failed hardware entry. This excludes the entire
+ * hardware entry and its exit-state capture, but never a forwarded call or a
+ * page-service wait. A paused context may therefore still be serviced. */
+int vmctx_execution_enter(void)
+{
+	struct vmctx_mm_slot *s;
+	unsigned long flags;
+	if (!current->vmctx)
+		return 0; /* module self-test, not a native execution context */
+	for (;;) {
+		spin_lock_irqsave(&vmctx_mm_lock, flags);
+		s = vmctx_execution_slot(current->mm);
+		if (!s) {
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			return -ESRCH;
+		}
+		if (!s->execution_paused) {
+			s->execution_running++;
+			spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+			/* rq locks must never be acquired under vmctx_mm_lock. */
+			if (current->vmctx->runtime_quantum) {
+				struct vmctx_task *vc = current->vmctx;
+				if (!vc->runtime_timer_task) {
+					hrtimer_setup(&vc->runtime_timer, vmctx_runtime_interrupt,
+						CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+					vc->runtime_timer_task = current;
+				}
+				hrtimer_start(&vc->runtime_timer, ns_to_ktime(vc->runtime_quantum),
+					      HRTIMER_MODE_REL);
+			}
+			current->vmctx->runtime_started = task_sched_runtime(current);
+			return 0;
+		}
+		spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+		if (wait_event_killable(vmctx_execution_wq,
+				       vmctx_execution_unpaused(current->mm)))
+			return -EINTR;
+	}
+}
+EXPORT_SYMBOL_GPL(vmctx_execution_enter);
+
+void vmctx_execution_leave(void)
+{
+	struct vmctx_mm_slot *s;
+	unsigned long flags;
+	bool wake;
+	if (!current->vmctx)
+		return;
+	{
+		struct vmctx_task *vc = current->vmctx;
+		u64 now;
+		if (vc->runtime_timer_task) hrtimer_cancel(&vc->runtime_timer);
+		now = task_sched_runtime(current);
+		if (now < vc->runtime_started || now - vc->runtime_started > S64_MAX - vc->runtime_total)
+			vc->runtime_error = EOVERFLOW;
+		else
+			vc->runtime_total += now - vc->runtime_started;
+	}
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_execution_slot(current->mm);
+	if (WARN_ON_ONCE(!s || !s->execution_running)) {
+		spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+		return;
+	}
+	s->execution_running--;
+	wake = s->execution_paused && !s->execution_running;
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (wake)
+		wake_up_all(&vmctx_execution_wq);
+}
+EXPORT_SYMBOL_GPL(vmctx_execution_leave);
+
+static long vmctx_quiesce_end(u64 token, struct task_struct *owner)
+{
+	struct vmctx_quiesce_lease *l, *found = NULL;
+	unsigned long flags;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	list_for_each_entry(l, &vmctx_quiesce_leases, link) {
+		if (l->owner == owner && (!token || l->token == token)) {
+			list_del(&l->link);
+			l->slot->execution_paused--;
+			found = l;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (!found)
+		return -ESTALE;
+	wake_up_all(&vmctx_execution_wq);
+	vmctx_mm_forget(found->mm);
+	mmput(found->mm);
+	put_task_struct(found->owner);
+	kfree(found);
+	return 0;
+}
+
+static void vmctx_quiesce_owner_exit(struct task_struct *owner)
+{
+	while (!vmctx_quiesce_end(0, owner)) {}
+}
+
+static bool vmctx_quiesce_owned(struct mm_struct *mm)
+{
+	struct vmctx_quiesce_lease *l;
+	unsigned long flags;
+	bool owned = false;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	list_for_each_entry(l, &vmctx_quiesce_leases, link)
+		if (l->owner == current && l->mm == mm) { owned = true; break; }
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	return owned;
+}
+
+static long vmctx_ctl_quiesce(struct task_struct *target, struct vmctx_task *vc,
+			      void __user *arg)
+{
+	struct vmctx_quiesce q;
+	struct vmctx_quiesce_lease *l;
+	struct vmctx_mm_slot *s;
+	struct mm_struct *mm;
+	unsigned long flags;
+	long ret;
+	if (copy_from_user(&q, arg, sizeof(q))) return -EFAULT;
+	if (q.version != VMCTX_QUIESCE_ABI || q.size != sizeof(q) || q.reserved)
+		return -EINVAL;
+	if (!target) {
+		if (q.op == VMCTX_QUIESCE_END && q.token)
+			return vmctx_quiesce_end(q.token, current);
+		if (q.op != VMCTX_QUIESCE_INFO || q.token || q.mm_id)
+			return -EINVAL;
+		if (!READ_ONCE(vmctx_execution_backend)) return -EOPNOTSUPP;
+		return copy_to_user(arg, &q, sizeof(q)) ? -EFAULT : 0;
+	}
+	if (q.op != VMCTX_QUIESCE_BEGIN || q.token || target == current)
+		return -EINVAL;
+	if (!vc || !(vc->flags & VMCTX_FLAG_USERCODE) || !vc->backend ||
+	    vc->backend != READ_ONCE(vmctx_execution_backend)) return -EOPNOTSUPP;
+	mm = get_task_mm(target);
+	if (!mm) return -ESRCH;
+	l = kzalloc(sizeof(*l), GFP_KERNEL);
+	if (!l) { mmput(mm); return -ENOMEM; }
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_execution_slot(mm);
+	if (!s || (q.mm_id && q.mm_id != s->trace_id)) {
+		ret = -ESTALE; goto fail_locked;
+	}
+	if (s->execution_paused == UINT_MAX || s->n == INT_MAX ||
+	    vmctx_quiesce_next == U64_MAX) {
+		ret = -EOVERFLOW; goto fail_locked;
+	}
+	l->slot = s; l->mm = mm; l->owner = current;
+	get_task_struct(current);
+	l->token = ++vmctx_quiesce_next;
+	s->n++;
+	s->execution_paused++;
+	list_add_tail(&l->link, &vmctx_quiesce_leases);
+	q.token = l->token; q.mm_id = s->trace_id;
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	/* Set the gate before the synchronous kick. An entrant either counted
+	 * itself before the gate and must exit, or waits without entering. */
+	if (vc->backend->invalidate)
+		vc->backend->invalidate(target, 0);
+	ret = wait_event_killable_timeout(vmctx_execution_wq,
+					 !READ_ONCE(s->execution_running), 3 * HZ);
+	if (ret <= 0) {
+		vmctx_quiesce_end(q.token, current);
+		return ret < 0 ? ret : -ETIMEDOUT;
+	}
+	if (copy_to_user(arg, &q, sizeof(q))) {
+		vmctx_quiesce_end(q.token, current);
+		return -EFAULT;
+	}
+	return 0;
+fail_locked:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	kfree(l); mmput(mm);
+	return ret;
+}
diff --git a/kernel/vmctx-recall-core.h b/kernel/vmctx-recall-core.h
new file mode 100755
index 000000000..47072f630
--- /dev/null
+++ b/kernel/vmctx-recall-core.h
@@ -0,0 +1,214 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included after the source adapter's page-record and mm lifetime helpers. */
+
+/* Caller holds vmctx_mm_lock. No page-table action or remote wait here. */
+static void vmctx_recall_unlink(struct vmctx_recall_ticket *t, bool landed, u32 gen)
+{
+	struct vmctx_mm_slot *s = t->slot;
+
+	if (!t->cancelled) {
+		unsigned long rec = vmctx_pgrec_load(s, t->idx);
+		if (VMCTX_PGREC_STATE(rec) == VMCTX_PG_CLAIM)
+			vmctx_pgrec_cas(s, t->idx, rec, landed ?
+				vmctx_pgrec_mk(VMCTX_PG_HOME, 0, gen) : t->prior);
+	}
+	xa_erase(&s->recalls, t->idx);
+	list_del(&t->owner_link);
+	vmctx_recall_live--;
+	wake_up_all(&s->pg_wq);
+}
+
+static void vmctx_recall_free(struct vmctx_recall_ticket *t)
+{
+	vmctx_mm_forget(t->mm); /* release the slot pin before the mm reference */
+	mmput(t->mm);
+	put_task_struct(t->owner);
+	kfree(t);
+}
+
+static void vmctx_recall_owner_exit(struct task_struct *owner)
+{
+	struct vmctx_recall_ticket *t, *next;
+	unsigned long flags;
+	LIST_HEAD(dispose);
+
+	if (list_empty_careful(&vmctx_recall_tickets))
+		return;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	list_for_each_entry_safe(t, next, &vmctx_recall_tickets, owner_link) {
+		if (t->owner != owner)
+			continue;
+		vmctx_recall_unlink(t, false, 0);
+		list_add_tail(&t->owner_link, &dispose);
+	}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	list_for_each_entry_safe(t, next, &dispose, owner_link) {
+		list_del(&t->owner_link);
+		vmctx_recall_free(t);
+	}
+}
+
+static long vmctx_recall_begin(struct task_struct *target, struct vmctx_recall *rq,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_recall_ticket *t;
+	struct vmctx_mm_slot *s;
+	struct mm_struct *mm;
+	unsigned long flags, rec, claim;
+	void *old;
+	long ret;
+
+	if (rq->ticket || rq->buf || rq->gen || (rq->addr & ~PAGE_MASK))
+		return -EINVAL;
+	t = kzalloc(sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+	mm = vmctx_control_mm(target, borrowed);
+	if (!mm) { kfree(t); return -ESRCH; }
+	ret = mmap_read_lock_killable(mm);
+	if (ret) goto out_mm;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	s = vmctx_pgrec_slot(mm);
+	if (!s) { ret = -ENXIO; goto out_unlock; }
+	t->idx = rq->addr >> PAGE_SHIFT;
+	if (xa_load(&s->recalls, t->idx)) {
+		ret = -EAGAIN;
+		goto out_unlock;
+	}
+	/* An absent record at a recycled address is not an outstanding loan. */
+	rec = vmctx_pgrec_load(s, t->idx);
+	if (VMCTX_PGREC_STATE(rec) == VMCTX_PG_CLAIM ||
+	    VMCTX_PGREC_STATE(rec) == VMCTX_PG_TRANSIT) {
+		ret = -EAGAIN;
+		goto out_unlock;
+	}
+	if (VMCTX_PGREC_STATE(rec) != VMCTX_PG_REMOTE) {
+		ret = 1;
+		goto out_unlock;
+	}
+	if (!vma_lookup(mm, rq->addr)) { ret = -ESTALE; goto out_unlock; }
+	if (vmctx_recall_next == U64_MAX) { ret = -EOVERFLOW; goto out_unlock; }
+	t->id = ++vmctx_recall_next;
+	t->mm = mm;
+	t->slot = s;
+	t->owner = current;
+	t->prior = rec;
+	old = xa_store(&s->recalls, t->idx, t, GFP_ATOMIC);
+	if (xa_is_err(old)) { ret = xa_err(old); goto out_unlock; }
+	claim = vmctx_pgrec_mk(VMCTX_PG_CLAIM, 0, VMCTX_PGREC_GEN(rec));
+	ret = vmctx_pgrec_cas(s, t->idx, rec, claim);
+	if (ret) {
+		xa_erase(&s->recalls, t->idx);
+		goto out_unlock;
+	}
+	/* The mm slot cannot be destroyed/reused while a reply is outstanding. */
+	s->n++;
+	get_task_struct(current);
+	list_add_tail(&t->owner_link, &vmctx_recall_tickets);
+	vmctx_recall_live++;
+	rq->ticket = t->id;
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	mmap_read_unlock(mm);
+	return 0;
+out_unlock:
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	mmap_read_unlock(mm);
+out_mm:
+	mmput(mm);
+	kfree(t);
+	return ret;
+}
+
+static long vmctx_recall_finish(struct vmctx_recall *rq)
+{
+	struct vmctx_recall_ticket *t, *found = NULL;
+	struct page *page = NULL;
+	unsigned long flags;
+	void *bytes = NULL, *mapped;
+	long ret = 0;
+
+	if (!rq->ticket || rq->op < VMCTX_RECALL_COMMIT ||
+	    rq->op > VMCTX_RECALL_CANCEL || (rq->addr & ~PAGE_MASK))
+		return -EINVAL;
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	list_for_each_entry(t, &vmctx_recall_tickets, owner_link)
+		if (t->id == rq->ticket && t->owner == current) {
+			found = t;
+			break;
+		}
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	if (!found)
+		return -ENOENT;
+	t = found; /* only this monitor thread can consume its ticket */
+	if (t->idx != rq->addr >> PAGE_SHIFT)
+		return -EINVAL;
+	if (rq->op == VMCTX_RECALL_CANCEL)
+		goto consume;
+	bytes = memdup_user((void __user *)rq->buf, PAGE_SIZE);
+	if (IS_ERR(bytes)) { ret = PTR_ERR(bytes); bytes = NULL; goto consume; }
+	ret = mmap_read_lock_killable(t->mm);
+	if (ret) goto consume;
+	/* The notifier invalidates under the same mm lock ordering. GUP pins
+	 * the exact page; the final check below also catches unmap/discard
+	 * after this read section, without copying to a reused virtual address. */
+	if (READ_ONCE(t->cancelled)) {
+		ret = -ESTALE;
+	} else {
+		ret = get_user_pages_remote(t->mm, rq->addr, 1,
+				FOLL_GET | FOLL_WRITE | FOLL_FORCE, &page, NULL);
+		ret = ret == 1 ? 0 : ret < 0 ? ret : -EFAULT;
+	}
+	mmap_read_unlock(t->mm);
+	if (ret) goto consume;
+	mapped = kmap_local_page(page);
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (t->cancelled)
+		ret = -ESTALE;
+	else if (VMCTX_PGREC_STATE(vmctx_pgrec_load(t->slot, t->idx)) != VMCTX_PG_CLAIM)
+		ret = -EPROTO;
+	else {
+		/* No faultable access under the spinlock. A mapping invalidation
+		 * is ordered wholly before or after these bytes and the record. */
+		memcpy(mapped, bytes, PAGE_SIZE);
+		ret = PAGE_SIZE;
+	}
+	vmctx_recall_unlink(t, ret == PAGE_SIZE, rq->gen);
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+	kunmap_local(mapped);
+	if (ret == PAGE_SIZE) {
+		flush_dcache_page(page);
+		set_page_dirty_lock(page);
+	}
+	goto out;
+consume:
+	spin_lock_irqsave(&vmctx_mm_lock, flags);
+	if (t->cancelled)
+		ret = -ESTALE;
+	vmctx_recall_unlink(t, false, 0);
+	spin_unlock_irqrestore(&vmctx_mm_lock, flags);
+out:
+	if (page) put_page(page);
+	kfree(bytes);
+	vmctx_recall_free(t);
+	return ret;
+}
+
+static long vmctx_ctl_recall(struct task_struct *target, void __user *arg,
+		struct mm_struct *borrowed)
+{
+	struct vmctx_recall rq;
+	long ret;
+
+	if (copy_from_user(&rq, arg, sizeof(rq)))
+		return -EFAULT;
+	if (rq.op != VMCTX_RECALL_BEGIN)
+		return target ? -EINVAL : vmctx_recall_finish(&rq);
+	if (!target) return -ESRCH;
+	ret = vmctx_recall_begin(target, &rq, borrowed);
+	if (!ret && copy_to_user(arg, &rq, sizeof(rq))) {
+		rq.op = VMCTX_RECALL_CANCEL;
+		vmctx_recall_finish(&rq);
+		return -EFAULT;
+	}
+	return ret;
+}
diff --git a/kernel/vmctx-runtime-core.h b/kernel/vmctx-runtime-core.h
new file mode 100644
index 000000000..bd19bddbb
--- /dev/null
+++ b/kernel/vmctx-runtime-core.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included with native CPU-state controls. The monitor's cpu_ctl_lock is
+ * held. Scheduler locks establish a parked task; sighand -> scheduler lock
+ * order serializes source credit with activation of process CPU timers. */
+struct vmctx_runtime_copy {
+	struct vmctx_task *vc;
+	struct vmctx_runtime *runtime;
+};
+
+static int vmctx_runtime_stopped(struct task_struct *t, void *arg)
+{
+	struct vmctx_runtime_copy *copy = arg;
+	struct vmctx_task *vc = copy->vc;
+	struct vmctx_runtime *q = copy->runtime;
+	u64 previous, delta;
+	if (READ_ONCE(t->vmctx) != vc || READ_ONCE(vc->dead) ||
+	    (READ_ONCE(t->flags) & PF_EXITING)) return -ESRCH;
+	if (READ_ONCE(vc->sys_pending) ||
+	    (!(vc->flags & VMCTX_FLAG_SERVICE) && READ_ONCE(vc->released) &&
+	     (!READ_ONCE(vc->ev_pending) || READ_ONCE(vc->reply_pending))))
+		return -EBUSY;
+	if (task_curr(t) || task_is_running(t)) return -EAGAIN;
+#ifdef CONFIG_SMP
+	if (smp_load_acquire(&t->on_cpu)) return -EAGAIN;
+#endif
+	if (q->op == VMCTX_RUNTIME_CREDIT) {
+		if (!(vc->flags & VMCTX_FLAG_SERVICE)) return -EOPNOTSUPP;
+		if (vc->runtime_credit_epoch && vc->runtime_credit_epoch != q->epoch)
+			return -ESTALE;
+		previous = READ_ONCE(t->vmctx_remote_runtime_ns);
+		if (q->total_ns < previous) return -ESTALE;
+		if (q->total_ns > S64_MAX - t->se.sum_exec_runtime) return -EOVERFLOW;
+		delta = q->total_ns - previous;
+		vc->runtime_credit_epoch = q->epoch;
+		WRITE_ONCE(t->vmctx_remote_runtime_ns, q->total_ns);
+		/* No source CPU or runqueue executed this work. Update the task's
+		 * public clocks and active group timers, never host CPU totals or
+		 * the scheduler's internal se.sum_exec_runtime/fair-share state. */
+		account_group_user_time(t, delta);
+		account_group_exec_runtime(t, delta);
+		return 0;
+	}
+	if (!(vc->flags & VMCTX_FLAG_USERCODE) || !vc->backend ||
+	    vc->backend != READ_ONCE(vmctx_execution_backend)) return -EOPNOTSUPP;
+	if (vc->runtime_error) return -vc->runtime_error;
+	if (q->op == VMCTX_RUNTIME_ARM) {
+		if (vc->released) return -EBUSY;
+		vc->runtime_quantum = q->quantum_ns;
+	}
+	q->epoch = t->start_boottime;
+	q->total_ns = vc->runtime_total;
+	q->quantum_ns = vc->runtime_quantum;
+	vc->runtime_reported = vc->runtime_total;
+	return 0;
+}
+
+static long vmctx_ctl_runtime(struct task_struct *t, struct vmctx_task *vc,
+			     void __user *arg)
+{
+	struct vmctx_runtime q;
+	struct vmctx_runtime_copy copy = {vc, &q};
+	struct sighand_struct *sighand = NULL;
+	unsigned long flags = 0;
+	int ret;
+	if (copy_from_user(&q, arg, sizeof(q))) return -EFAULT;
+	if (q.version != VMCTX_RUNTIME_ABI || q.size != sizeof(q) || q.reserved)
+		return -EINVAL;
+	if (!t) {
+		if (q.op != VMCTX_RUNTIME_INFO || q.epoch || q.total_ns || q.quantum_ns)
+			return -EINVAL;
+		q.quantum_ns = VMCTX_RUNTIME_QUANTUM_NS;
+		return copy_to_user(arg, &q, sizeof(q)) ? -EFAULT : 0;
+	}
+	switch (q.op) {
+	case VMCTX_RUNTIME_READ:
+		if (q.epoch || q.total_ns || q.quantum_ns) return -EINVAL;
+		break;
+	case VMCTX_RUNTIME_ARM:
+		if (q.epoch || q.total_ns || q.quantum_ns < 1000000 ||
+		    q.quantum_ns > 100000000) return -EINVAL;
+		break;
+	case VMCTX_RUNTIME_CREDIT:
+		if (!q.epoch || q.quantum_ns || q.total_ns > S64_MAX) return -EINVAL;
+		sighand = lock_task_sighand(t, &flags);
+		if (!sighand) return -ESRCH;
+		break;
+	default:
+		return -EINVAL;
+	}
+	ret = task_call_func(t, vmctx_runtime_stopped, &copy);
+	if (sighand) unlock_task_sighand(t, &flags);
+	if (ret) return ret;
+	/* CREDIT is cumulative: a failed copyout can be retried without
+	 * charging the task twice, including a first credit of zero. */
+	return copy_to_user(arg, &q, sizeof(q)) ? -EFAULT : 0;
+}
diff --git a/kernel/vmctx-transfer-core.h b/kernel/vmctx-transfer-core.h
new file mode 100755
index 000000000..2df2848d5
--- /dev/null
+++ b/kernel/vmctx-transfer-core.h
@@ -0,0 +1,235 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Included after the source page capture engine. The creating native thread
+ * alone operates its tickets; invalidation only sets guard.cancelled under
+ * vmctx_mm_lock. No user copy or MM/PTE operation holds that spinlock. */
+struct vmctx_transfer_ticket {
+    struct list_head link;
+    struct vmctx_recall_ticket guard;
+    struct mm_struct *mm;
+    struct vmctx_mm_slot *slot;
+    struct task_struct *owner, *target;
+    struct vmctx_serve result;
+    void *bytes;
+    u64 id, mm_identity;
+    long capture_result, ack_result;
+    bool attempted, acknowledged, offered, poisoned;
+};
+static LIST_HEAD(vmctx_transfer_tickets);
+static u64 vmctx_transfer_next;
+static long vmctx_transfer_live, vmctx_transfer_captures;
+static long vmctx_transfer_reads, vmctx_transfer_abandoned;
+core_param(vmctx_transfer_live, vmctx_transfer_live, long, 0444);
+core_param(vmctx_transfer_captures, vmctx_transfer_captures, long, 0444);
+core_param(vmctx_transfer_reads, vmctx_transfer_reads, long, 0444);
+core_param(vmctx_transfer_abandoned, vmctx_transfer_abandoned, long, 0444);
+
+static bool vmctx_transfer_grants(const struct vmctx_transfer_ticket *t)
+{
+    return t->attempted && !t->capture_result &&
+        (t->result.status==VMCTX_SERVE_TAKEN || (t->result.flags&VMCTX_SERVE_GRANT));
+}
+
+static void vmctx_transfer_drop_guard(struct vmctx_transfer_ticket *t)
+{
+    vmctx_page_guard_end(&t->guard);
+    t->guard.slot=NULL;
+}
+
+static void vmctx_transfer_free(struct vmctx_transfer_ticket *t)
+{
+    vmctx_transfer_drop_guard(t);
+    if(t->bytes)free_page((unsigned long)t->bytes);
+    vmctx_mm_forget(t->mm);
+    mmput(t->mm);
+    put_task_struct(t->target);
+    put_task_struct(t->owner);
+    kfree(t);
+}
+
+static void vmctx_transfer_owner_exit(struct task_struct *owner)
+{
+    struct vmctx_transfer_ticket *t,*next;
+    unsigned long flags;
+    LIST_HEAD(dispose);
+    if(list_empty_careful(&vmctx_transfer_tickets))return;
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    list_for_each_entry_safe(t,next,&vmctx_transfer_tickets,link) {
+        if(t->owner!=owner)continue;
+        if(vmctx_transfer_grants(t) && !t->acknowledged && !t->guard.cancelled) {
+            /* Lost custody is terminal, never inferred delivery or local
+             * ownership. TRANSIT remains closed to faults and legacy ACKs. */
+            t->slot->access_error=ENOTRECOVERABLE;t->poisoned=true;
+            vmctx_transfer_abandoned++;
+        }
+        list_move_tail(&t->link,&dispose);
+        vmctx_transfer_live--;
+    }
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+    list_for_each_entry_safe(t,next,&dispose,link) {
+        list_del(&t->link);
+        if(t->poisoned)
+            send_sig(SIGKILL,t->target,1);
+        vmctx_transfer_free(t);
+    }
+}
+
+static long vmctx_transfer_begin(struct task_struct *target,
+        struct mm_struct *borrowed,struct vmctx_transfer *q,
+        struct vmctx_transfer_ticket **out)
+{
+    struct vmctx_transfer_ticket *t;
+    struct mm_struct *mm;
+    struct vmctx_mm_slot *slot;
+    unsigned long flags;
+    long ret=0;
+    if(!target || !borrowed || !q->mm_identity || q->ticket || q->buf ||
+       q->features || q->status || q->flags || q->class || q->state || q->gen || q->sum ||
+       (q->address & ~PAGE_MASK))return -EINVAL;
+    t=kzalloc(sizeof(*t),GFP_KERNEL);
+    if(!t)return -ENOMEM;
+    t->bytes=(void *)__get_free_page(GFP_KERNEL);
+    if(!t->bytes) {kfree(t);return -ENOMEM;}
+    mm=vmctx_control_mm(target,borrowed);
+    if(!mm) {free_page((unsigned long)t->bytes);kfree(t);return -ESRCH;}
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    slot=vmctx_pgrec_slot(mm);
+    if(!slot || slot->trace_id!=q->mm_identity)ret=-ESTALE;
+    else if(slot->mon_tgid!=task_tgid_nr(current))ret=-EPERM;
+    else if(slot->access_error)ret=-(long)slot->access_error;
+    else if(slot->n==INT_MAX || vmctx_transfer_next==U64_MAX)ret=-EOVERFLOW;
+    if(!ret) {
+        t->id=++vmctx_transfer_next;t->mm=mm;t->slot=slot;
+        t->mm_identity=q->mm_identity;t->owner=current;t->target=target;
+        t->result.addr=q->address;
+        slot->n++;get_task_struct(current);get_task_struct(target);
+        list_add_tail(&t->link,&vmctx_transfer_tickets);vmctx_transfer_live++;
+        q->ticket=t->id;*out=t;
+    }
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+    if(ret) {mmput(mm);free_page((unsigned long)t->bytes);kfree(t);}
+    return ret;
+}
+
+static void vmctx_transfer_unlink(struct vmctx_transfer_ticket *t)
+{
+    unsigned long flags;
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    list_del(&t->link);vmctx_transfer_live--;
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+}
+
+static long vmctx_transfer_capture(struct vmctx_transfer_ticket *t)
+{
+    unsigned long flags;
+    if(t->acknowledged)return -EALREADY;
+    if(t->attempted)return READ_ONCE(t->guard.cancelled) ? -ESTALE : t->capture_result;
+    t->attempted=true;
+    t->capture_result=vmctx_capture_guard_begin(t->mm,t->result.addr,&t->guard);
+    if(!t->capture_result && !t->guard.slot)t->capture_result=-ESTALE;
+    if(!t->capture_result)
+        t->capture_result=vmctx_serve_capture(t->target,&t->result,false,t->mm,t->bytes,&t->guard);
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    vmctx_transfer_captures++;
+    if(t->guard.cancelled)t->capture_result=-ESTALE;
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+    return t->capture_result;
+}
+
+static long vmctx_transfer_ack(struct vmctx_transfer_ticket *t,bool cancel)
+{
+    unsigned long flags;
+    long ret=0;
+    if(t->acknowledged)return cancel ? 0 : t->ack_result;
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    if(cancel && vmctx_transfer_grants(t) && !t->guard.cancelled)ret=-EBUSY;
+    else if(!cancel && (!t->attempted || t->capture_result || !t->offered))ret=-EINVAL;
+    else {
+        if(t->guard.cancelled)ret=-ESTALE;
+        else if(!cancel && vmctx_transfer_grants(t)) {
+            unsigned long rec=vmctx_pgrec_load(t->slot,t->guard.idx);
+            if(VMCTX_PGREC_STATE(rec)!=VMCTX_PG_TRANSIT)ret=-EPROTO;
+            else ret=vmctx_pgrec_cas(t->slot,t->guard.idx,rec,
+                vmctx_pgrec_mk(VMCTX_PG_REMOTE,0,VMCTX_PGREC_GEN(rec)));
+        }
+        if(!ret || ret==-ESTALE) {t->acknowledged=true;t->ack_result=ret;}
+    }
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+    if(t->acknowledged) {
+        vmctx_transfer_drop_guard(t);
+        free_page((unsigned long)t->bytes);t->bytes=NULL;
+    }
+    return cancel && t->acknowledged ? 0 : ret;
+}
+
+static long vmctx_ctl_transfer(struct task_struct *target,void __user *arg,
+        struct mm_struct *borrowed)
+{
+    struct vmctx_transfer q;
+    struct vmctx_transfer_ticket *t=NULL,*entry;
+    unsigned long flags;
+    long ret=0;
+    if(copy_from_user(&q,arg,sizeof(q)))return -EFAULT;
+    if(q.version!=VMCTX_TRANSFER_ABI || q.size!=sizeof(q) || q.reserved ||
+       q.op>VMCTX_TRANSFER_ABANDON)return -EINVAL;
+    if(q.op==VMCTX_TRANSFER_ABANDON) {
+        if(target || q.features || q.mm_identity || q.address || q.ticket || q.buf ||
+           q.status || q.flags || q.class || q.state || q.gen || q.sum)return -EINVAL;
+        /* Explicit connection teardown must precede waiting for a source's
+         * native exit-memory work. Waiting first can retain the very page
+         * guard that exit needs. This is the same terminal operation as
+         * monitor-thread exit, and repeated teardown owns no further work. */
+        vmctx_transfer_owner_exit(current);
+        return 0;
+    }
+    if(q.op==VMCTX_TRANSFER_CAPS) {
+        if(target || q.features || q.mm_identity || q.address || q.ticket || q.buf ||
+           q.status || q.flags || q.class || q.state || q.gen || q.sum)return -EINVAL;
+        q.features=VMCTX_TRANSFER_FEATURES;
+        return copy_to_user(arg,&q,sizeof(q)) ? -EFAULT : 0;
+    }
+    if(q.op==VMCTX_TRANSFER_BEGIN) {
+        ret=vmctx_transfer_begin(target,borrowed,&q,&t);
+        if(ret)return ret;
+        if(copy_to_user(arg,&q,sizeof(q))) {
+            /* BEGIN has not touched any page or ownership record. */
+            vmctx_transfer_unlink(t);vmctx_transfer_free(t);return -EFAULT;
+        }
+        return 0;
+    }
+    if(target || !q.ticket || !q.mm_identity || (q.address & ~PAGE_MASK) ||
+       (q.op!=VMCTX_TRANSFER_READ && q.buf))return -EINVAL;
+    spin_lock_irqsave(&vmctx_mm_lock,flags);
+    list_for_each_entry(entry,&vmctx_transfer_tickets,link)
+        if(entry->id==q.ticket && entry->owner==current) {t=entry;break;}
+    spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+    if(!t)return -ENOENT;
+    if(t->mm_identity!=q.mm_identity || t->result.addr!=q.address)return -ESTALE;
+    switch(q.op) {
+    case VMCTX_TRANSFER_CAPTURE: ret=vmctx_transfer_capture(t);break;
+    case VMCTX_TRANSFER_READ:
+        if(!t->attempted)ret=-EINVAL;
+        else if(t->acknowledged)ret=-EALREADY;
+        else if(READ_ONCE(t->guard.cancelled))ret=-ESTALE;
+        else if(t->capture_result)ret=t->capture_result;
+        else {
+            t->offered=true;
+            if(t->result.status==VMCTX_SERVE_TAKEN || t->result.status==VMCTX_SERVE_COPIED)
+                ret=copy_to_user(u64_to_user_ptr(q.buf),t->bytes,PAGE_SIZE) ? -EFAULT : 0;
+            spin_lock_irqsave(&vmctx_mm_lock,flags);vmctx_transfer_reads++;
+            if(t->guard.cancelled)ret=-ESTALE;
+            spin_unlock_irqrestore(&vmctx_mm_lock,flags);
+        }
+        break;
+    case VMCTX_TRANSFER_ACK: ret=vmctx_transfer_ack(t,false);break;
+    case VMCTX_TRANSFER_CANCEL: ret=vmctx_transfer_ack(t,true);break;
+    case VMCTX_TRANSFER_FORGET:
+        if(!t->acknowledged)return -EBUSY;
+        vmctx_transfer_unlink(t);vmctx_transfer_free(t);return 0;
+    default:return -EINVAL;
+    }
+    if(ret)return ret;
+    q.features=VMCTX_TRANSFER_FEATURES;
+    q.status=t->result.status;q.flags=t->result.flags;q.class=t->result.class;
+    q.state=t->result.state;q.gen=t->result.gen;q.sum=t->result.sum;
+    return copy_to_user(arg,&q,sizeof(q)) ? -EFAULT : 0;
+}
diff --git a/kernel/vmctx.c b/kernel/vmctx.c
new file mode 100755
index 000000000..7aa092dc3
--- /dev/null
+++ b/kernel/vmctx.c
@@ -0,0 +1,9422 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * vmctx — native "VM context" for Linux (avm.md project).
+ *
+ * Core: makes a VM context a first-class process. A task that calls
+ * vmctx_run(2) becomes a VM context — it keeps its pid, /proc entry,
+ * signal handling and scheduler treatment, but its execution is carried by
+ * a hardware guest via the registered backend.
+ *
+ * Guest entry happens in the context-switch / return-to-user path: the
+ * generic exit_to_user_mode_loop() calls vmctx_guest_step() for a VM-context
+ * task, so the guest is (re)entered whenever the scheduler switches the task
+ * in and heads back to user space, and a guest VMEXIT that sets need_resched
+ * is followed by that same loop's schedule() — VM enter/exit at the switch
+ * boundary. kill/wait/nice/ps therefore work because it is an ordinary task.
+ *
+ * The backend (AMD SVM / Intel VMX) is registered by a module and does the
+ * actual VMRUN; see struct vmctx_backend.
+ */
+#include <linux/mman.h>
+#include <linux/sched/debug.h>
+#include <linux/vmctx.h>
